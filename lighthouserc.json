{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/ar/index.html",
        "/ar/person/ibn-sina/index.html",
        "/en/index.html",
        "/en/accessibility/index.html",
        "/ur/index.html",
        "/ur/accessibility/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}