{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@webgpu/types"],
    "baseUrl": ".",
    "paths": {
      "@im/kernel/*": ["packages/kernel/src/*"],
      "@im/worldkit/*": ["packages/worldkit/src/*"],
      "@im/atlas/*": ["games/atlas/src/*"],
      "@im/audio/*": ["packages/audio/src/*"],
      "@im/golden-age/*": ["games/golden-age/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "labs/**/*.ts", "games/**/*.ts", "tools/**/*.ts", "*.ts"]
}
