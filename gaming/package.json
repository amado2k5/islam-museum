{
  "name": "islam-museum-gaming",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "islam.museum Gaming Platform: an independently built and released subsystem of the museum repository.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "bench": "tsx tools/bench.ts",
    "shot": "tsx tools/shot.ts",
    "probe": "tsx tools/probe-district.ts",
    "daily:pack": "tsx --tsconfig tsconfig.json packages/daily/tools/build-pack.ts",
    "daily:check": "tsx --tsconfig tsconfig.json tools/daily-check.ts",
    "atlas:pack": "tsx --tsconfig tsconfig.json games/atlas/tools/build-pack.ts",
    "atlas:images": "tsx --tsconfig tsconfig.json games/atlas/tools/survey-images.ts",
    "atlas:play": "tsx tools/atlas-play.ts",
    "simlab": "tsx --tsconfig tsconfig.json tools/simlab.ts",
    "simtrace": "tsx --tsconfig tsconfig.json tools/simtrace.ts",
    "golden-age:play": "tsx --tsconfig tsconfig.json tools/golden-age-play.ts",
    "golden-age:shot": "tsx tools/golden-age-shot.ts",
    "golden-age:links": "tsx --tsconfig tsconfig.json games/golden-age/tools/build-links.ts",
    "music:import": "tsx tools/music-import.ts",
    "strings": "python3 tools/check-strings.py games/granada/i18n games/atlas/i18n games/golden-age/i18n games/hudhud/i18n games/hudhud/i18n-atlas packages/audio/i18n packages/platform/i18n packages/daily/i18n games/five-questions/i18n games/kalima/i18n games/thread/i18n games/lantern/i18n games/lamp/i18n",
    "granada:records": "tsx --tsconfig tsconfig.json games/granada/tools/build-records.ts",
    "granada:mutations": "python3 games/granada/tools/mutate-economy.py",
    "build:release": "tsx --tsconfig tsconfig.json tools/build.ts",
    "check:release": "node tools/check-release.mjs dist/release",
    "release:smoke": "tsx --tsconfig tsconfig.json tools/release-smoke.ts",
    "release:serve": "tsx --tsconfig tsconfig.json tools/local-host.ts",
    "granada:village-lab": "tsx --tsconfig tsconfig.json games/granada/tools/village-lab.ts",
    "granada:play": "tsx --tsconfig tsconfig.json tools/granada-play.ts",
    "build:release:music": "tsx --tsconfig tsconfig.json tools/build.ts --music-base ../media/music/",
    "traceability": "python3 tools/traceability.py",
    "art:mill": "blender --background --factory-startup --python art/blender/granada_mill.py -- media/models/granada/2",
    "art:town": "blender --background --factory-startup --python art/blender/granada_town.py -- media/models/granada/2",
    "art:palace-c": "blender --background --factory-startup --python art/blender/granada_palace_c.py -- media/models/granada/c",
    "art:manifest": "python3 art/manifest.py",
    "build:release:media": "tsx --tsconfig tsconfig.json tools/build.ts --music-base ../media/music/ --models-base ../media/models/",
    "qa:package": "python3 tools/qa-package.py",
    "release:regression": "tsx --tsconfig tsconfig.json tools/release-regression.ts",
    "save:carry": "tsx --tsconfig tsconfig.json tools/save-carry.ts",
    "measure": "tsx --tsconfig tsconfig.json tools/measure.ts",
    "hudhud:play": "tsx --tsconfig tsconfig.json tools/hudhud-play.ts",
    "hudhud:checks": "tsx --tsconfig tsconfig.json tools/hudhud-checks.ts",
    "hudhud:uat": "tsx --tsconfig tsconfig.json tools/hudhud-uat.ts",
    "platform:save": "tsx --tsconfig tsconfig.json tools/platform-save.ts",
    "platform:gate": "tsx --tsconfig tsconfig.json tools/platform-gate.ts",
    "lamp:records": "tsx --tsconfig tsconfig.json games/lamp/tools/build-records.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.37.2",
    "d3-geo": "3.1.1",
    "phaser": "4.2.1",
    "three": "0.187.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/node": "22.19.1",
    "@types/three": "0.187.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@webgpu/types": "0.1.74",
    "playwright-core": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  }
}
