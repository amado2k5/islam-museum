{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "preview",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "site-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "gaming-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "gaming/node_modules/vite/bin/vite.js",
        "--config",
        "gaming/vite.config.ts"
      ],
      "port": 4330
    }
  ]
}
