    given-names: "Ahmed"
    orcid: "https://orcid.org/0009-0000-9215-2906"
    affiliation: "islam.museum"
repository-code: "https://github.com/amado2k5/islam-museum"
url: "https://islam.museum"
license: "MIT"
keywords:
  - Islamic history
  - digital museum
  - knowledge graph
  - open data
  - digital humanities
