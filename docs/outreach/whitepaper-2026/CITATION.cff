    affiliation: "islam.museum (independent)"
    email: "discover@islam.museum"
version: "1.0"
date-released: "2026-11-15"
license: CC-BY-4.0
keywords:
  - Islamic history
  - digital museum
  - knowledge graph
  - open data
  - digital humanities
  - Arabic-first
  - Zenodo
  - CC0
