# Link headers on the homepage for agent discovery (RFC 8288, RFC 9727 §3).

/
  Link: </.well-known/api-catalog>; rel="api-catalog", <https://islam.museum/openapi/v1.json>; rel="service-desc", <https://github.com/amado2k5/islam-museum/blob/main/docs/data/README.md>; rel="service-doc", </sitemap.xml>; rel="describedby"

# API catalog for automated discovery (RFC 9727). Cloudflare Pages does not infer a
# media type for an extensionless file, so the linkset type is set here.
/.well-known/api-catalog
  Content-Type: application/linkset+json

# Cloudflare Pages added these three to every response on its own. The site Worker
# (workers/site) applies this file to every response it serves, so they are set here
# explicitly and the two origins answer alike.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Access-Control-Allow-Origin: *
  # GorillaQA #11: defence-in-depth. script-src keeps 'unsafe-inline' because the site ships
  # inline scripts by design (BaseLayout theme/font/menu, is:inline component scripts, JSON-LD
  # is unaffected); removing it needs a refactor to external files — flagged for the founder.
  # 'wasm-unsafe-eval' is for Pagefind search. style-src keeps 'unsafe-inline' for Astro scoped
  # styles and style attributes. No frame-ancestors: /{lang}/embed/* is meant to be iframed elsewhere.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.islam.museum https://uat-api.islam.museum; worker-src 'self' blob:; media-src 'self'; manifest-src 'self'; form-action 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

# Hashed build assets never change under the same name: cache them for a year.
# (Workers static assets served them with max-age=0; Pages with four hours.)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The shell scripts (/shell/shell.js, /shell/entity.js): plain files under names that do NOT change when their content does
# (that is the point: an edit is one file, not 160,000 pages that name a new hash; see
# docs/engineering/16-deploy-churn-proposal.md). So they must not be cached as immutable. Five minutes fresh, then served
# stale for a day while the browser revalidates in the background (a 304 when nothing changed).
/shell/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# The root page is served by the asset layer, which omits the charset.
/
  Content-Type: text/html; charset=utf-8

