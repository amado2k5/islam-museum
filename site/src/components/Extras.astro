---
// Panels for the additions of docs 12-14: themes, place in the story, conflict sides, screen facts, tensions, on screen.
import { existsSync } from "node:fs";
import { repoPath } from "../lib/paths";
import { byId, edgesFrom, href, labelOf } from "../lib/graph";
import { ui, type Lang } from "../lib/i18n";
import { formatDate } from "../lib/dates";
import { onScreen, themeLabel, traditionLabel } from "../lib/entity";
import type { Node } from "../../../scripts/build-graph";

const { node: n, lang } = Astro.props as { node: Node; lang: Lang };
const T = ui(lang);
const d = n.data;
const lab = (id: string) => { const x = byId.get(id); return x ? labelOf(x, lang) : id; };
const range = (s: any, e: any) => [formatDate(s, lang).text, formatDate(e, lang).text].filter(Boolean).join(" – ");
const screens = onScreen(n.id);
const graphAbout = (id: string) => edgesFrom(id).filter((e) => e.type === "about" && !e.inverse).map((e) => byId.get(e.to)!).filter(Boolean);
const mapMedia = d.media?.map ? byId.get(d.media.map) : undefined;
const mapFileRel = mapMedia?.data.files?.[`webp_${lang}`] ?? mapMedia?.data.files?.webp_en;
// media files live in the media repo; show the figure only when the file is present at build time
const mapFile = mapFileRel && existsSync(repoPath("site", "public", mapFileRel)) ? mapFileRel : undefined;
const faithText = (d.faith ?? []) as any[];
---
{mapMedia && mapFile && (
  <figure class="panel" style="margin:0 0 1.2rem">
    <img src={`/${mapFile}`} alt={mapMedia.data.alt?.[lang] ?? mapMedia.data.alt?.en} width="1536" height="1024" loading="lazy" style="width:100%;height:auto;border-radius:10px;background:var(--bg)" />
    <figcaption class="ui muted" style="font-size:.85rem;margin-top:8px">
      {T.map.caption} · {T.map.precision[mapMedia.data.precision] ?? mapMedia.data.precision}
      {d.map?.note && <> · {d.map.note[lang] ?? d.map.note.en}</>}
      · <a href={href(lang, mapMedia.id)}>{T.map.details}</a>
    </figcaption>
  </figure>
)}

{n.class === "passage" && d.text && d.work === "work/quran" && (
  <section class="panel" style="margin-bottom:1.2rem" aria-label={n.label[lang] ?? n.label.en}>
    <p lang="ar" dir="rtl" style="font-family:var(--ar-quran);font-size:clamp(1.6rem,4vw,2.4rem);line-height:2.2;margin:0">{d.text}</p>
    <p class="ui muted" style="margin:10px 0 0;font-size:.85rem">{T.passage.attribution} <a href="https://tanzil.net" rel="noopener">tanzil.net</a> · {T.passage.verbatim}
      {d.aya > 1 && <> · <a href={href(lang, `passage/quran-${d.sura}-${d.aya - 1}`)}>{T.passage.prev}</a></>}
      {byId.has(`passage/quran-${d.sura}-${d.aya + 1}`) && <> · <a href={href(lang, `passage/quran-${d.sura}-${d.aya + 1}`)}>{T.passage.next}</a></>}
    </p>
  </section>
)}
{n.class === "passage" && d.text && d.work !== "work/quran" && (
  <section class="panel" style="margin-bottom:1.2rem" aria-label={n.label[lang] ?? n.label.en}>
    <p lang="ar" dir="rtl" style="font-size:clamp(1.15rem,2.5vw,1.45rem);line-height:2;margin:0">«{d.text}»</p>
    <p class="ui muted" style="margin:10px 0 0;font-size:.85rem">{T.passage.excerpt}</p>
  </section>
)}

{n.themes.length > 0 && (
  <p class="ui no-print" style="margin:0 0 1rem" aria-label={T.themes.on_this_theme}>
    {n.themes.map((t) => <a class="chip" style="margin-inline-end:6px" href={`/${lang}/themes/${t}/`}>{themeLabel(t, lang)}</a>)}
  </p>
)}

{n.class === "screen" && (
  <section class="panel ui" style="margin-bottom:1.2rem" aria-labelledby="screen-facts">
    <h2 id="screen-facts" style="font-size:1rem;margin:0 0 8px">{T.screen.title}</h2>
    <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:.92rem">
      <dt class="muted">{T.screen.format}</dt><dd style="margin:0">{T.screen.format_values[d.format] ?? d.format} · {T.screen.relevance_values[d.relevance]}</dd>
      {d.released && <><dt class="muted">{T.screen.released}</dt><dd style="margin:0">{formatDate(d.released, lang).text}</dd></>}
      {d.countries?.length > 0 && <><dt class="muted">{T.screen.countries}</dt><dd style="margin:0" class="ltr" dir="ltr">{d.countries.map((c: string) => c.toUpperCase()).join(" · ")}</dd></>}
      {d.languages && <><dt class="muted">{T.screen.languages}</dt><dd style="margin:0" class="ltr" dir="ltr">{[...(d.languages.original ?? []).map((l: string) => `${l} (${T.screen.original})`), ...(d.languages.dubbed ?? []).map((l: string) => `${l} (${T.screen.dubbed})`)].join(" · ")}</dd></>}
      {d.approach && <><dt class="muted">{T.screen.approach}</dt><dd style="margin:0">{T.screen.approach_values?.[d.approach] ?? d.approach}</dd></>}
      {d.depiction && <><dt class="muted">{T.screen.depiction}</dt><dd style="margin:0">
        {T.screen.prophet}: {T.screen.depiction_values[d.depiction.prophet]} · {T.screen.companions}: {T.screen.depiction_values[d.depiction.companions]} · {T.screen.imams}: {T.screen.depiction_values[d.depiction.imams]}
        {d.depiction.note && <span class="muted"> ({d.depiction.note})</span>}</dd></>}
      {d.titles?.length > 1 && <><dt class="muted">{T.screen.titles}</dt><dd style="margin:0">{d.titles.map((t: any) => <span lang={t.lang} style="margin-inline-end:12px">{t.value}</span>)}</dd></>}
    </dl>
    {d.reception?.length > 0 && <>
      <h3 style="font-size:.95rem;margin:14px 0 6px">{T.screen.reception}</h3>
      <ul style="margin:0;padding-inline-start:1.2rem;font-size:.92rem">
        {d.reception.map((r: any) => <li><b>{T.screen.reception_values[r.kind] ?? r.kind}</b>{r.by ? ` — ${Array.isArray(r.by) ? r.by.join(", ") : r.by}` : ""}{r.where ? ` (${r.where.join(", ").toUpperCase()})` : ""}{r.date ? `, ${formatDate(r.date, lang).text}` : ""}{r.note ? `. ${r.note}` : ""}{r.status ? <span class="chip" style="margin-inline-start:6px">{T.claim[r.status]}</span> : null}</li>)}
      </ul></>}
    <p class="muted" style="margin:12px 0 0;font-size:.9rem">{T.screen.watch}: {(d.watch ?? []).length ? (d.watch as any[]).map((w) => <a href={w.url} rel="noopener" style="margin-inline-end:10px">{w.kind}</a>) : T.screen.no_watch} · {T.screen.not_endorsed}</p>
    {(n.id && graphAbout(n.id).length > 0) && <p style="margin:10px 0 0"><b>{T.screen.check}:</b> {graphAbout(n.id).map((x, i) => <><a href={href(lang, x.id)}>{labelOf(x, lang)}</a>{i < graphAbout(n.id).length - 1 ? " · " : ""}</>)}</p>}
  </section>
)}

{(d.story_roles?.length > 0 || d.labelled?.length > 0 || faithText.length > 0) && (
  <section class="panel ui" style="margin-bottom:1.2rem" aria-labelledby="story">
    <h2 id="story" style="font-size:1rem;margin:0 0 8px">{T.story.title}</h2>
    <ul style="margin:0;padding-inline-start:1.2rem;font-size:.92rem">
      {(d.story_roles ?? []).map((r: any) => <li><b>{T.roles[r.role] ?? r.role}</b>{r.toward ? <> {T.story.toward} <a href={href(lang, r.toward)}>{lab(r.toward)}</a></> : null}{range(r.start, r.end) ? <span class="muted"> · {range(r.start, r.end)}</span> : null}{r.status ? <span class="chip" style="margin-inline-start:6px">{T.claim[r.status]}</span> : null}{r.perspective ? <span class="muted"> · {traditionLabel(r.perspective, lang)}</span> : null}</li>)}
    </ul>
    {faithText.length > 0 && <p class="muted" style="margin:8px 0 0;font-size:.88rem">{faithText.map((f) => `${T.faith[f.value] ?? f.value} (${T.basis[f.basis] ?? f.basis})`).join(" · ")}</p>}
    {d.labelled?.length > 0 && <>
      <h3 style="font-size:.95rem;margin:12px 0 6px">{T.story.others}</h3>
      <ul style="margin:0;padding-inline-start:1.2rem;font-size:.92rem">{d.labelled.map((l: any) => <li lang={lang}>“{l.label[lang] ?? l.label.en}” <span class="muted">— {typeof l.by === "string" && l.by.includes("/") ? lab(l.by) : (T.by_values?.[l.by] ?? l.by)}</span></li>)}</ul></>}
    <p class="muted" style="margin:8px 0 0;font-size:.82rem">{T.story.stance_note}</p>
  </section>
)}

{d.sides?.length > 0 && (
  <section class="panel ui" style="margin-bottom:1.2rem" aria-labelledby="sides">
    <h2 id="sides" style="font-size:1rem;margin:0 0 8px">{T.conflict.sides}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px">
      {d.sides.map((s: any) => (
        <div><h3 style="font-size:.95rem;margin:0 0 4px">{s.label[lang] ?? s.label.en}</h3>
          {s.participants?.length > 0 && <p style="margin:0;font-size:.9rem">{s.participants.map((p: string, i: number) => <><a href={href(lang, p)}>{lab(p)}</a>{i < s.participants.length - 1 ? " · " : ""}</>)}</p>}
          {s.commanders?.length > 0 && <p class="muted" style="margin:2px 0 0;font-size:.88rem">{T.conflict.commanders}: {s.commanders.map((p: string, i: number) => <><a href={href(lang, p)}>{lab(p)}</a>{i < s.commanders.length - 1 ? " · " : ""}</>)}</p>}
          {s.strength && <p class="muted" style="margin:2px 0 0;font-size:.88rem">{T.conflict.strength}: {s.strength.range ? s.strength.range.join("–") : s.strength.value}</p>}
        </div>
      ))}
    </div>
  </section>
)}

{(d.tensions ?? []).map((t: any) => (
  <section class="panel" style="margin-bottom:1.2rem;border-inline-start:4px solid var(--gold)" aria-labelledby={`t-${t.id}`}>
    <h2 id={`t-${t.id}`} class="ui" style="font-size:1rem;margin:0 0 6px">{T.tension.title} <span class="chip">{T.tension.kinds[t.kind]}</span></h2>
    <p style="margin:0 0 8px"><b>{T.tension.statement}:</b> {t.statement[lang] ?? t.statement.en}</p>
    {t.raised_by?.length > 0 && <p class="muted ui" style="margin:0 0 8px;font-size:.9rem">{T.tension.raised}: {t.raised_by.map((r: any) => r.who).join(" · ")}</p>}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px">
      {t.responses.map((r: any) => <div class="ui" style="background:var(--bg);border-radius:10px;padding:10px 12px"><b style="font-size:.9rem">{traditionLabel(r.tradition, lang)}</b><p style="margin:4px 0 0;font-size:.92rem">{r.summary}</p></div>)}
    </div>
    <p class="muted ui" style="margin:8px 0 0;font-size:.85rem">{T.tension.no_verdict}</p>
  </section>
))}

{screens.length > 0 && (
  <section class="panel ui" style="margin-bottom:1.2rem" aria-labelledby="onscreen">
    <h2 id="onscreen" style="font-size:1rem;margin:0 0 8px">{T.screen.on_screen}</h2>
    <ul style="margin:0;padding-inline-start:1.2rem;font-size:.92rem">
      {screens.map(({ node: s, how }) => <li><a href={href(lang, s.id)}>{labelOf(s, lang)}</a> <span class="muted">· {T.screen.format_values[s.data.format] ?? s.data.format}{s.data.released?.edtf ? `, ${s.data.released.edtf.slice(0, 4)}` : ""} · {T.screen[how]}{s.data.approach ? ` · ${T.screen.approach_values?.[s.data.approach] ?? s.data.approach}` : ""}</span></li>)}
    </ul>
  </section>
)}
