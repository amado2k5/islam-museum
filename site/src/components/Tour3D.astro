---
// 3D virtual museum tour («الجولة الافتراضية»).
// Renders the fullscreen tour shell; the client script (site/src/scripts/tour.ts)
// loads three.js lazily (dynamic import, only after the visitor presses Enter).
// Localized strings arrive via `t` (see the key contract below); journey
// narration via `journeys`; wing names via `wingTitles`. The 3D UI only appears
// via JS — without JS this root stays display:none and the page's own fallback
// content is what visitors see (this component never hides it).
//
// t key contract (all required; {wing}/{tour}/{sub} are placeholders):
//   brand_name, brand_sub, journey_button, exit_button, loc_hall, hall_sub,
//   hint_desktop, hint_touch, joy_label, panel_more, panel_close,
//   gallery_back, gallery_hall ("قاعة {wing}"), gallery_sub ("جناح {wing} · {tour}"),
//   journey_tag, portal_toast ("…«{wing}»…"), portal_explore,
//   kind_event, kind_place, kind_time,
//   jp_title, jp_sub, jp_close, jc_back,
//   enter_title, enter_lede (plain text, \n for line breaks),
//   enter_button, logo_alt, loading, failed,
//   stop_of ("{n} / {total}"), stop_prev, stop_next, near_prompt, near_prompt_touch,
//   help_button, help_title, help_walk, help_look, help_go, help_stops, help_esc, help_close, canvas_label,
//   look_day, help_light, lite_label, lite_offer, lite_offer_btn
// halls: the other eight wings' stops (tour/halls.yaml), same shape as exhibits plus
//   art/artAlt (an existing site illustration, or "" for a name plaque); t.art_note labels illustrations.
// exhibits: Objects-hall stops from tour/exhibits.yaml, joined to their object records in 3d.astro.
// journeys[].kind must be one of: "event" | "place" | "time".
import { ARABIC_SCRIPT, type Lang } from "../lib/i18n";
interface JourneyView {
  id: string;
  kind: string;
  build: string;
  title: string;
  sub: string;
  lines: string[];
}
interface ExhibitView {
  id: string;
  build: string;
  label: string;
  desc: string;
  material: string;
  museum: string;
  date: string;
  note: string;
  href: string;
  art?: string;
  artAlt?: string;
}
interface Props {
  lang: Lang;
  t: Record<string, string>;
  journeys: JourneyView[];
  exhibits: ExhibitView[];
  halls: Array<{ wing: string; stops: ExhibitView[] }>;
  wingTitles: Record<string, string>;
}
const { lang, t, journeys, exhibits, halls, wingTitles } = Astro.props;
const dir = ARABIC_SCRIPT.includes(lang) ? "rtl" : "ltr";
// Defensive: journeys carry no HTML, but never let a stray "<" break the
// JSON script block (in particular "</script>").
const payloadJson = JSON.stringify({ lang, t, journeys, exhibits, halls, wingTitles }).replace(/</g, "\\u003c");
---
<div id="tour3d-root" dir={dir} lang={lang}>
  <div id="app"></div>

  <div id="hud">
    <div id="topbar">
      <div id="brand">🏛️ {t.brand_name}<small id="wingLabel">{t.hall_sub}</small></div>
      <div id="topBtns">
        <button type="button" id="mapBtn" aria-haspopup="dialog" aria-controls="mapPanel">{t.map_button}</button>
        <button type="button" id="lookBtn" aria-pressed="false">{t.look_day}</button>
        <button type="button" id="helpBtn" aria-haspopup="dialog" aria-controls="helpPanel">{t.help_button}</button>
        <button type="button" id="journeyBtn" aria-label={t.journey_button}>{t.journey_button}</button>
        <button type="button" id="exitBtn" aria-label={t.exit_button}>{t.exit_button}</button>
      </div>
    </div>
    <div id="loc" role="status">{t.loc_hall}</div>
    <div id="cross" aria-hidden="true"></div>
    <div id="hint">{t.hint_desktop}</div>
  </div>

  <div id="joy" aria-label={t.joy_label}><div id="joyKnob"></div></div>

  <div id="panel" role="dialog" aria-labelledby="panelTitle" aria-describedby="panelMeta panelNote panelArt panelDesc">
    <div class="count" id="panelCount"></div>
    <h2 id="panelTitle" tabindex="-1"></h2>
    <p id="panelMeta" class="meta"></p>
    <p id="panelNote" class="note"></p>
    <p id="panelArt" class="note"></p>
    <p id="panelDesc"></p>
    <div class="row nav">
      <button type="button" id="panelPrev">{t.stop_prev}</button>
      <button type="button" id="panelNext">{t.stop_next}</button>
    </div>
    <div class="row">
      <a id="panelLink" class="more" href="#">{t.panel_more}</a>
      <button type="button" id="panelClose" class="close" aria-label={t.panel_close}>{t.panel_close}</button>
    </div>
  </div>

  <div id="journeyPanel" role="dialog" aria-live="polite" aria-labelledby="jpTitle">
    <h2 id="jpTitle">{t.jp_title}</h2>
    <div class="sub">{t.jp_sub}</div>
    <div id="journeyChips"></div>
    <button type="button" id="journeyClose" class="close" aria-label={t.jp_close}>{t.jp_close}</button>
  </div>

  <div id="journeyCard" role="dialog" aria-live="polite" aria-labelledby="jTitle">
    <h2 id="jTitle"></h2><div class="jsub" id="jSub"></div><div id="jLines"></div>
    <button type="button" id="jBack">{t.jc_back}</button>
  </div>

  <div id="helpPanel" role="dialog" aria-labelledby="helpTitle">
    <h2 id="helpTitle" tabindex="-1">{t.help_title}</h2>
    <ul>
      <li>{t.help_walk}</li>
      <li>{t.help_look}</li>
      <li>{t.help_go}</li>
      <li>{t.help_stops}</li>
      <li>{t.help_map}</li>
      <li>{t.help_light}</li>
      <li>{t.help_esc}</li>
    </ul>
    <label class="lite"><input type="checkbox" id="liteHelp" /> {t.lite_label}</label>
    <button type="button" id="helpClose" class="close">{t.help_close}</button>
  </div>

  <div id="mapPanel" role="dialog" aria-labelledby="mapTitle">
    <h2 id="mapTitle" tabindex="-1">{t.map_title}</h2>
    <div id="mapPlan" dir="ltr"></div>
    <p id="mapHere"></p>
    <button type="button" id="mapClose" class="close">{t.map_close}</button>
  </div>

  <nav id="strip" aria-label={t.strip_label}>
    <button type="button" id="stripToggle" aria-expanded="true" aria-controls="stripItems">{t.strip_hide}</button>
    <ul id="stripItems"></ul>
  </nav>

  <div id="toast" role="status"></div>
  <div id="fade" aria-hidden="true"></div>

  <div id="enterCard">
    <div class="box">
      <div class="cube"><img id="logoImg" src="/brand/logo-mark.svg" alt={t.logo_alt} width="150" height="150" /></div>
      <h1>{t.enter_title}</h1>
      <p class="lede">{t.enter_lede}</p>
      <p class="fail" data-fail role="alert" hidden></p>
      <button type="button" id="enterBtn">{t.enter_button}</button>
      <label class="lite"><input type="checkbox" id="liteEnter" /> {t.lite_label}</label>
    </div>
  </div>

  <div id="loading" aria-hidden="true"><div class="cube">🧊</div><p>{t.loading}</p></div>

  <script type="application/json" set:html={payloadJson} />
</div>
<script src="../scripts/tour.ts"></script>
<style is:global>
/* 3D tour styles — every rule is prefixed with #tour3d-root so the fullscreen
   tour never leaks into site chrome. The prototype's bare `*` reset and
   `html,body{overflow:hidden}` are intentionally NOT ported. */
#tour3d-root {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 60;
  background: #0d1b2e;
  color: #f2f5fc;
  font-family: "Segoe UI", Tahoma, "Noto Naskh Arabic", sans-serif;
  overflow: hidden;
}
body:has(#tour3d-root) { overflow: hidden; }
#tour3d-root #app { position: absolute; inset: 0; }
#tour3d-root #app canvas { display: block; }
#tour3d-root #app canvas:focus-visible { outline: 3px solid #f5d67b; outline-offset: -3px; }
#tour3d-root button { font-family: inherit; }
#tour3d-root button:focus-visible,
#tour3d-root a:focus-visible {
  outline: 3px solid #f5d67b;
  outline-offset: 2px;
}

/* ---------- HUD ---------- */
#tour3d-root #hud { position: absolute; inset: 0; pointer-events: none; z-index: 10; }
#tour3d-root #topbar {
  position: absolute; top: 0; right: 0; left: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
  background: linear-gradient(to bottom, rgba(5,10,20,.65), transparent);
}
#tour3d-root #brand { color: #f5d67b; font-weight: 800; font-size: 1.05rem; text-shadow: 0 2px 8px #000; }
#tour3d-root #brand small { display: block; color: #cfe0f5; font-weight: 400; font-size: .75rem; }
#tour3d-root #exitBtn,
#tour3d-root #mapBtn,
#tour3d-root #lookBtn,
#tour3d-root #helpBtn,
#tour3d-root #journeyBtn {
  pointer-events: auto; cursor: pointer;
  border: 2px solid #d4a017; border-radius: 999px;
  background: rgba(10,18,34,.8); color: #f5d67b;
  font-weight: 700; font-size: .9rem; padding: 8px 18px;
}
@media (hover: hover) {
  #tour3d-root #exitBtn:hover,
  #tour3d-root #mapBtn:hover,
  #tour3d-root #lookBtn:hover,
  #tour3d-root #helpBtn:hover,
  #tour3d-root #journeyBtn:hover { background: #d4a017; color: #1a1206; }
}
#tour3d-root #exitBtn:active,
#tour3d-root #mapBtn:active,
#tour3d-root #lookBtn:active,
#tour3d-root #helpBtn:active,
#tour3d-root #journeyBtn:active { background: #d4a017; color: #1a1206; }
#tour3d-root #topBtns { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
#tour3d-root #mapBtn[hidden] { display: none; }
@media (max-width: 480px) {
  #tour3d-root #topBtns { gap: 6px; }
  #tour3d-root #exitBtn,
  #tour3d-root #mapBtn,
  #tour3d-root #lookBtn,
  #tour3d-root #helpBtn,
  #tour3d-root #journeyBtn { font-size: .8rem; padding: 6px 12px; }
}
#tour3d-root #hint {
  position: absolute; bottom: 64px; right: 50%; transform: translateX(50%);
  color: #e8eefb; background: rgba(8,14,28,.62);
  border: 1px solid rgba(212,160,23,.45);
  padding: 8px 18px; border-radius: 999px; font-size: .82rem; white-space: nowrap;
  text-shadow: 0 1px 4px #000;
}
#tour3d-root #cross {
  position: absolute; top: 50%; right: 50%; width: 6px; height: 6px; margin: -3px;
  border-radius: 50%; background: rgba(245,214,123,.85); box-shadow: 0 0 6px #000;
}
#tour3d-root #loc {
  position: absolute; top: 64px; right: 50%; transform: translateX(50%);
  color: #f5d67b; font-size: .85rem; font-weight: 700; text-shadow: 0 2px 6px #000;
  background: rgba(8,14,28,.5); padding: 4px 16px; border-radius: 999px;
}

/* ---------- overlays ---------- */
#tour3d-root #fade {
  position: absolute; inset: 0; background: #05080f; opacity: 1;
  transition: opacity .7s; z-index: 40; pointer-events: none;
}
#tour3d-root #loading {
  position: absolute; inset: 0; z-index: 50; display: none;
  flex-direction: column; gap: 14px; align-items: center; justify-content: center;
  background: #0d1b2e; color: #f5d67b;
}
#tour3d-root #loading .cube { font-size: 3rem; animation: tour-spin 2.4s linear infinite; }
@keyframes tour-spin { to { transform: rotateY(360deg); } }
#tour3d-root #loading p { color: #cfe0f5; font-size: .9rem; }

#tour3d-root #panel {
  position: absolute; z-index: 30; bottom: 84px; right: 50%;
  transform: translateX(50%) translateY(20px);
  width: min(420px, calc(100vw - 32px));
  background: rgba(13,22,40,.94);
  border: 2px solid #d4a017; border-radius: 18px; padding: 18px 20px; color: #f2f5fc;
  opacity: 0; pointer-events: none; transition: opacity .3s, transform .3s;
  box-shadow: 0 18px 60px rgba(0,0,0,.6);
}
#tour3d-root #panel.show { opacity: 1; pointer-events: auto; transform: translateX(50%) translateY(0); }
#tour3d-root #panel h2 { color: #f5d67b; font-size: 1.25rem; margin: 0 0 6px; }
#tour3d-root #panel p { font-size: .95rem; line-height: 1.8; color: #dbe4f5; margin: 0 0 12px; }
#tour3d-root #panel .row { display: flex; gap: 10px; }
#tour3d-root #panel .row.nav { margin-bottom: 10px; }
#tour3d-root #panel .row.nav button {
  flex: 1; border: 1.5px solid #5a6b8c; background: rgba(30,44,74,.8); color: #eef2fb;
  border-radius: 12px; padding: 8px 12px; cursor: pointer; font-weight: 700;
}
#tour3d-root #panel .count { color: #aeb9d4; font-size: .8rem; margin-bottom: 2px; }
#tour3d-root #panel h2:focus { outline: none; }
#tour3d-root #panel h2:focus-visible { outline: 3px solid #f5d67b; outline-offset: 2px; }
#tour3d-root #panel p.meta { color: #f0d9a0; font-size: .85rem; line-height: 1.7; margin: 0 0 6px; }
#tour3d-root #panel p.meta:empty { display: none; }
#tour3d-root #panel p.note { color: #c9d3d6; font-size: .8rem; line-height: 1.6; margin: 0 0 6px; }
#tour3d-root #panel p.note:empty { display: none; }
#tour3d-root #helpPanel {
  position: absolute; z-index: 32; top: 64px; right: 50%;
  transform: translateX(50%) translateY(-12px);
  width: min(440px, calc(100vw - 32px)); max-height: calc(100vh - 140px); overflow: auto;
  background: rgba(13,22,40,.96); border: 2px solid #d4a017; border-radius: 18px;
  padding: 18px 20px; color: #f2f5fc;
  opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .3s, transform .3s, visibility .3s;
}
#tour3d-root #helpPanel.show { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(50%) translateY(0); transition: opacity .3s, transform .3s, visibility 0s; }
#tour3d-root #helpPanel h2 { color: #f5d67b; font-size: 1.2rem; margin: 0 0 8px; }
#tour3d-root #helpPanel ul { margin: 0 0 12px; padding-inline-start: 1.2em; line-height: 1.9; font-size: .92rem; color: #dbe4f5; }
#tour3d-root #helpPanel .close {
  width: 100%; border: 2px solid #5a6b8c; background: transparent;
  color: #dbe4f5; border-radius: 12px; padding: 10px; cursor: pointer; font-weight: 700;
}
#tour3d-root #mapPanel {
  position: absolute; z-index: 32; top: 64px; right: 50%;
  transform: translateX(50%) translateY(-12px);
  width: min(420px, calc(100vw - 32px)); max-height: calc(100vh - 140px); overflow: auto;
  background: rgba(13,22,40,.96); border: 2px solid #d4a017; border-radius: 18px;
  padding: 16px 18px; color: #f2f5fc;
  opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .3s, transform .3s, visibility .3s;
}
#tour3d-root #mapPanel.show { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(50%) translateY(0); transition: opacity .3s, transform .3s, visibility 0s; }
#tour3d-root #mapPanel h2 { color: #f5d67b; font-size: 1.2rem; margin: 0 0 8px; }
#tour3d-root #mapPanel h2:focus { outline: none; }
#tour3d-root #mapPanel h2:focus-visible,
#tour3d-root #helpPanel h2:focus-visible { outline: 3px solid #f5d67b; outline-offset: 2px; }
#tour3d-root #mapPlan { position: relative; width: 100%; aspect-ratio: 1; margin: 0 0 10px; }
#tour3d-root #mapPlan.gallery { aspect-ratio: 34 / 20; margin-top: 18px; }
#tour3d-root #mapPlan svg { position: absolute; inset: 0; width: 100%; height: 100%; }
#tour3d-root #mapPlan .mk {
  position: absolute; transform: translate(-50%, -50%);
  min-width: 26px; min-height: 26px; padding: 3px 8px; white-space: nowrap;
  border: 1.5px solid #d4a017; border-radius: 999px; background: rgba(10,18,34,.92);
  color: #f5d67b; font-size: .74rem; font-weight: 700; cursor: pointer;
}
#tour3d-root #mapPlan .mk[aria-current],
#tour3d-root #mapPlan .mk:active { background: #d4a017; color: #1a1206; }
#tour3d-root #mapHere { color: #dbe4f5; font-size: .88rem; line-height: 1.7; margin: 0 0 10px; }
#tour3d-root #mapPanel .close {
  width: 100%; border: 2px solid #5a6b8c; background: transparent;
  color: #dbe4f5; border-radius: 12px; padding: 10px; cursor: pointer; font-weight: 700;
}
#tour3d-root #strip {
  position: absolute; z-index: 15; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 8px; padding: 8px 10px;
  background: linear-gradient(to top, rgba(5,10,20,.8), transparent);
}
#tour3d-root #strip[hidden] { display: none; }
#tour3d-root #stripItems {
  display: flex; gap: 6px; list-style: none; margin: 0; padding: 2px;
  flex: 1; min-width: 0; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin;
}
#tour3d-root #stripItems[hidden] { display: none; }
#tour3d-root #stripItems li { flex: none; scroll-snap-align: start; }
#tour3d-root #strip button {
  display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; cursor: pointer;
  border: 1.5px solid #5a6b8c; background: rgba(30,44,74,.88); color: #eef2fb;
  border-radius: 999px; padding: 6px 12px; font-size: .8rem; font-weight: 700;
}
#tour3d-root #strip #stripToggle { flex: none; }
#tour3d-root #strip button[aria-current],
#tour3d-root #strip button:active { border-color: #d4a017; color: #f5d67b; background: rgba(60,46,10,.92); }
#tour3d-root #strip .sw { width: 10px; height: 10px; border-radius: 50%; flex: none; }
@media (hover: hover) {
  #tour3d-root #mapPlan .mk:hover { background: #d4a017; color: #1a1206; }
  #tour3d-root #strip button:hover { border-color: #d4a017; color: #f5d67b; }
}
#tour3d-root #panel a.more {
  flex: 1; text-align: center; background: #d4a017; color: #1a1206; font-weight: 800;
  text-decoration: none; padding: 10px; border-radius: 12px;
}
#tour3d-root #panel button.close {
  border: 2px solid #5a6b8c; background: transparent; color: #dbe4f5;
  border-radius: 12px; padding: 10px 16px; cursor: pointer; font-weight: 700;
}

#tour3d-root #toast {
  position: absolute; z-index: 30; top: 110px; right: 50%;
  transform: translateX(50%) translateY(-12px);
  background: rgba(13,22,40,.94); border: 1.5px solid #d4a017; color: #f2f5fc;
  border-radius: 14px; padding: 12px 20px; font-size: .92rem;
  opacity: 0; pointer-events: none; transition: opacity .3s, transform .3s;
  max-width: min(440px, calc(100vw - 32px)); text-align: center;
}
#tour3d-root #toast.show { opacity: 1; pointer-events: auto; transform: translateX(50%) translateY(0); }
#tour3d-root #toast a { color: #f5d67b; font-weight: 800; }
#tour3d-root #toast button {
  margin-top: 8px; cursor: pointer; background: #d4a017; color: #1a1206; border: none;
  border-radius: 999px; padding: 8px 18px; font-weight: 800;
}
#tour3d-root #lookBtn[aria-pressed="true"] { background: #d4a017; color: #1a1206; }
#tour3d-root label.lite {
  display: flex; align-items: center; justify-content: center; gap: 8px; margin: 14px 0 0;
  font-size: .9rem; color: #dbe4f5; cursor: pointer;
}
#tour3d-root #helpPanel label.lite { justify-content: flex-start; margin: 0 0 12px; }
#tour3d-root label.lite input { width: 20px; height: 20px; accent-color: #d4a017; margin: 0; }

/* ---------- daytime look: cream panels, dark text (every pair 4.5:1 or more) ---------- */
#tour3d-root[data-look="day"] { background: #f1e6cf; }
#tour3d-root[data-look="day"] #topbar { background: linear-gradient(to bottom, rgba(250,245,233,.8), transparent); }
#tour3d-root[data-look="day"] #brand { color: #5a3d0c; text-shadow: none; }
#tour3d-root[data-look="day"] #brand small { color: #3d3324; }
#tour3d-root[data-look="day"] :is(#exitBtn, #lookBtn, #mapBtn, #helpBtn, #journeyBtn) {
  background: rgba(250,245,233,.94); color: #5a3d0c; border-color: #a8741a;
}
#tour3d-root[data-look="day"] #lookBtn[aria-pressed="true"],
#tour3d-root[data-look="day"] :is(#exitBtn, #lookBtn, #mapBtn, #helpBtn, #journeyBtn):active { background: #d4a017; color: #1a1206; }
@media (hover: hover) {
  #tour3d-root[data-look="day"] :is(#exitBtn, #lookBtn, #mapBtn, #helpBtn, #journeyBtn):hover { background: #d4a017; color: #1a1206; }
}
#tour3d-root[data-look="day"] :is(#hint, #loc) { color: #2a2113; background: rgba(250,245,233,.9); text-shadow: none; }
#tour3d-root[data-look="day"] :is(#panel, #helpPanel, #mapPanel, #journeyPanel, #journeyCard, #toast) {
  background: rgba(251,247,238,.97); color: #2a2113; border-color: #a8741a; box-shadow: 0 18px 50px rgba(60,40,10,.25);
}
#tour3d-root[data-look="day"] :is(#panel, #helpPanel, #mapPanel, #journeyPanel, #journeyCard) h2 { color: #5a3d0c; }
#tour3d-root[data-look="day"] :is(#panel p, #helpPanel ul, #mapHere, #journeyCard p, label.lite) { color: #2a2113; }
#tour3d-root[data-look="day"] #panel p.meta { color: #5a3d0c; }
#tour3d-root[data-look="day"] :is(#panel p.note, #panel .count, #journeyPanel .sub, #journeyCard .jsub, .jchip small) { color: #4a3f2c; }
#tour3d-root[data-look="day"] #journeyPanel h3 { color: #7a5410; }
#tour3d-root[data-look="day"] :is(#panel .row.nav button, #strip button, .jchip) { background: #fffaf0; color: #2a2113; border-color: #8a7a5c; }
#tour3d-root[data-look="day"] :is(#panel button.close, #helpPanel .close, #mapPanel .close, #journeyPanel .close) { color: #2a2113; border-color: #8a7a5c; }
#tour3d-root[data-look="day"] #strip { background: linear-gradient(to top, rgba(250,245,233,.85), transparent); }
#tour3d-root[data-look="day"] :is(#strip button[aria-current], #strip button:active) { background: #f5e3b3; color: #3d2a06; border-color: #a8741a; }
@media (hover: hover) {
  #tour3d-root[data-look="day"] :is(#strip button, .jchip):hover { border-color: #a8741a; color: #3d2a06; }
}
#tour3d-root[data-look="day"] #toast a { color: #5a3d0c; }
