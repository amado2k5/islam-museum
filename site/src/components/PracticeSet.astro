---
// PracticeSet (docs/delegation/education-master-plan.md §5 E4): a 10-question self-marking set.
// Native radio inputs keep it keyboard-first and readable without JavaScript; scripts/practice.ts
// only adds the marking, the score and the "try again". Every option carries its own explanation —
// revealed after marking so a wrong pick still teaches.
import type { Lang } from "../lib/i18n";
import type { Topic } from "../lib/topics";

interface Props {
  lang: Lang;
  topic: Topic;
  markLabel: string;
  againLabel: string;
  unansweredLabel: string;
  correctLabel: string;
  wrongLabel: string;
  resultLabel: string;
}
const { lang, topic, markLabel, againLabel, unansweredLabel, correctLabel, wrongLabel, resultLabel } =
  Astro.props;
---
<div
  class="practice"
  data-practice={topic.id}
  data-i18n-unanswered={unansweredLabel}
  data-i18n-correct={correctLabel}
  data-i18n-wrong={wrongLabel}
  data-i18n-result={resultLabel}
>
  <ol class="pr-list">
    {topic.practice.map((q, qi) => {
      const answer = q.options.findIndex((o) => o.correct);
      return (
        <li class="pr-q" data-q data-answer={answer}>
          <fieldset>
            <legend>{qi + 1}. {q.q[lang]}</legend>
            <div class="pr-opts">
              {q.options.map((o, oi) => (
                <div class="pr-opt" data-opt={oi}>
                  <label>
                    <input type="radio" name={`${topic.id}-${qi}`} value={oi} />
                    <span>{o.text[lang]}</span>
                  </label>
                  <p class="pr-why" data-why hidden>{o.why[lang]}</p>
                </div>
              ))}
            </div>
            <p class="ui pr-fb" data-fb aria-live="polite"></p>
          </fieldset>
        </li>
      );
    })}
  </ol>
  <div class="pr-foot">
    <p class="ui" aria-live="polite"><strong data-score></strong> <span data-msg></span></p>
    <button type="button" class="edu-btn" data-check>{markLabel}</button>
    <button type="button" class="edu-btn ghost" data-again hidden>{againLabel}</button>
  </div>
</div>
<style>
  .pr-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; max-width: 46rem; }
  .pr-q { border: 1px solid var(--line); border-radius: 14px; padding: 12px 16px; background: var(--card); }
  .pr-q fieldset { border: 0; margin: 0; padding: 0; }
  .pr-q legend { font-weight: 600; font-size: 1.02rem; padding: 0; }
  .pr-opts { display: grid; gap: 6px; margin-top: .4rem; }
  .pr-opt label { display: flex; gap: .55rem; align-items: baseline; padding: 6px 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); cursor: pointer; }
  .pr-opt input { accent-color: var(--gold); inline-size: 1.05rem; block-size: 1.05rem; margin: 0; }
  .pr-q.done .pr-opt label { cursor: default; }
  .pr-q.done .pr-opt[data-right] label { border-color: var(--ok, #2e7d4f); background: color-mix(in srgb, var(--ok, #2e7d4f) 10%, var(--bg)); }
  .pr-q.done .pr-opt[data-picked]:not([data-right]) label { border-color: var(--ko, #b3452e); }
  .pr-why { margin: .25rem 0 .1rem; padding-inline-start: 1.6rem; color: var(--muted); font-size: .92rem; }
  .pr-fb { margin: .3rem 0 0; font-weight: 600; }
  .pr-q.ok .pr-fb { color: var(--ok, #2e7d4f); }
  .pr-q.ko .pr-fb { color: var(--ko, #b3452e); }
  .pr-foot { margin-top: 1.2rem; display: grid; gap: .6rem; max-width: 46rem; }
  .edu-btn { justify-self: start; }
</style>
<noscript><style>.pr-why { display: block !important; }</style></noscript>
