---
// Kindness Quest: 30 tap-to-reveal day stickers with localStorage persistence.
// All deeds server-render (no-JS readable via the full list); the client script
// (site/src/scripts/kindness.ts) reveals stickers, paints progress and handles erase/print.
import type { DeedView } from "../lib/kids";
import { fmt, type Lang } from "../lib/i18n";
import Qr from "./Qr.astro";

interface Props { lang: Lang; t: Record<string, string>; deeds: DeedView[] }
const { lang, t, deeds } = Astro.props;
const q = lang === "ar" ? "؟" : "?";
const dayLabel = (n: number) => fmt(t.kindness_day, { n: String(n) });
---
<div class="kids kindness" data-kindness
  data-i18n-day={t.kindness_day}
  data-i18n-tap={t.kindness_tap_day}
  data-i18n-progress={t.kindness_progress}
  data-i18n-done={t.kindness_done}
  data-i18n-erase-done={t.erase_done}>
  <h1>{t.kindness_title}</h1>
  <p class="lede">{t.kindness_lede}</p>

  <p class="progress-line" data-progress role="status">{fmt(t.kindness_progress, { n: "0" })}</p>
  <progress class="kindness-bar" data-bar max="30" value="0">0 / 30</progress>

  <section class="kindness-play no-print" aria-label={t.kindness_title}>
    <p class="hint">{t.kindness_tap_day}</p>
    <div class="day-grid">
      {deeds.map((d) => (
        <button type="button" class="day-btn" data-day={d.day} aria-pressed="false"
          aria-label={`${dayLabel(d.day)} — ${t.kindness_tap_day}`}>
          <span class="day-front" aria-hidden="true">
            <span class="day-num">{dayLabel(d.day)}</span>
            <span class="day-q">{q}</span>
          </span>
          <span class="day-back" aria-hidden="true">
            <span class="sticker">{d.icon}</span>
            <span class="deed-text">{d.deed}</span>
          </span>
        </button>
      ))}
    </div>
    <p class="earn-msg" data-earn-msg role="status"></p>
    <p class="kindness-erase">
      <button type="button" class="kids-btn ghost" data-erase data-confirm={t.erase_confirm}>{t.erase}</button>
    </p>
    <p class="erase-msg" data-erase-msg role="status"></p>
  </section>

  <section class="kindness-chart print-only" id="kindness-chart" aria-label={t.kindness_print}>
    <h2>{t.kindness_print}</h2>
    <p class="no-print"><button type="button" class="kids-btn" data-print>{t.kindness_print}</button></p>
    <Qr lang={lang} path={`/${lang}/sighar/kindness/`} />
    <ol class="sticker-chart">
      {deeds.map((d) => (
        <li data-day={d.day}>
          <span class="box" data-box={d.day} aria-hidden="true">☐</span>
          <span class="chart-deed"><b>{dayLabel(d.day)}</b> — {d.deed}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="kindness-all no-print" aria-label={t.kindness_all}>
    <h2>{t.kindness_all}</h2>
    <ol>
      {deeds.map((d) => (
        <li><b>{dayLabel(d.day)}</b> — {d.deed}</li>
      ))}
    </ol>
  </section>
</div>
<script src="../scripts/kindness.ts"></script>
<style>
.kindness { max-width: 920px; margin-inline: auto; }
.progress-line { font-weight: 700; font-size: 1.15rem; margin: 0 0 .5rem; }
.kindness-bar { width: 100%; height: 18px; margin-bottom: 1rem; }
.hint { font-size: 1.05rem; }
.day-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 12px;
  margin: 1rem 0;
}
.day-btn {
  min-height: 96px;
  min-width: 48px;
  padding: 12px;
  border: 2px solid #c9a227;
  border-radius: 14px;
  background: #fffdf6;
  color: inherit;
  font-size: 1.05rem;
  line-height: 1.4;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.day-btn:focus-visible { outline: 3px solid #1d3a6e; outline-offset: 2px; }
.day-btn .day-front { display: flex; flex-direction: column; gap: 4px; }
.day-btn .day-num { font-weight: 700; }
.day-btn .day-q { font-size: 1.8rem; color: #8a6d1c; }
.day-btn .day-back { display: none; flex-direction: column; gap: 6px; align-items: center; }
.day-btn.earned { background: #fdf3d7; border-color: #8a6d1c; }
.day-btn.earned .day-front { display: none; }
.day-btn.earned .day-back { display: flex; }
.day-btn.earned .sticker { font-size: 2rem; display: inline-block; animation: pop .35s ease; }
@keyframes pop {
  0% { transform: scale(.5); }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); }
}
.earn-msg { min-height: 1.6em; font-size: 1.1rem; font-weight: 700; }
.kindness-erase { margin-top: 1.5rem; }
.erase-msg { min-height: 1.4em; }
.sticker-chart {
  list-style: none;
  padding: 0;
  margin: 1rem 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 8px;
}
.sticker-chart li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  border: 1px solid #c9a22788;
  border-radius: 10px;
  padding: 8px 10px;
  background: #fff;
}
.sticker-chart .box { font-size: 1.4rem; line-height: 1.2; flex: none; }
.kindness-all ol { columns: 2; column-gap: 2rem; }
.kindness-all li { break-inside: avoid; margin-bottom: .4rem; }
@media (max-width: 560px) { .kindness-all ol { columns: 1; } }
@media print {
  .kindness-play, .kindness-all { display: none !important; }
  .sticker-chart { grid-template-columns: 1fr 1fr; }
  .sticker-chart li { break-inside: avoid; }
  .day-btn { break-inside: avoid; }
}
@media (prefers-reduced-motion: reduce) {
  .day-btn.earned .sticker { animation: none; }
}
</style>
