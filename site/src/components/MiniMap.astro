---
import { href, labelOf } from "../lib/graph";
import type { Lang } from "../lib/i18n";
import type { Node } from "../../../scripts/build-graph";
import basemap from "../data/basemap-mena.json";
// Schematic equirectangular map, no tiles and no third-party requests: land from a self-hosted Natural Earth extract (scripts/map/build_basemap.py),
// places and the route from the graph. The interactive MapLibre map replaces it in Phase 1.
const { places, lang, width = 100, height = 55 } = Astro.props as { places: Node[]; lang: Lang; width?: number; height?: number };
const pts = places.filter((p) => p.coordinates);
const lons = pts.map((p) => p.coordinates![1]);
const lats = pts.map((p) => p.coordinates![0]);
const pad = 6;
const minLon = Math.min(...lons) - pad, maxLon = Math.max(...lons) + pad;
const minLat = Math.min(...lats) - pad * 0.6, maxLat = Math.max(...lats) + pad * 0.6;
const X = (lon: number) => ((lon - minLon) / (maxLon - minLon || 1)) * width;
const Y = (lat: number) => height - ((lat - minLat) / (maxLat - minLat || 1)) * height;
// Only the land that can appear in this frame is drawn into the page.
const inFrame = (ring: number[][]) => ring.some(([lon, lat]) => lon >= minLon && lon <= maxLon && lat >= minLat && lat <= maxLat);
const landD = (basemap.rings as number[][][]).filter(inFrame)
  .map((r) => "M" + r.map(([lon, lat]) => `${X(lon).toFixed(2)},${Y(lat).toFixed(2)}`).join("L") + "Z").join("");
---
{pts.length > 0 && (
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={pts.map((p) => labelOf(p, lang)).join(", ")} style="width:100%;height:auto;display:block;background:var(--panel);border-radius:10px;direction:ltr">
    <path d={landD} fill="currentColor" fill-opacity=".12" stroke="currentColor" stroke-opacity=".35" stroke-width=".15" style="color:var(--fg)" />
    {pts.length > 1 && <polyline points={pts.map((p) => `${X(p.coordinates![1])},${Y(p.coordinates![0])}`).join(" ")} fill="none" stroke="var(--gold)" stroke-width=".4" stroke-dasharray="1 1" opacity=".9" />}
    {pts.map((p, i) => {
      const cx = X(p.coordinates![1]), cy = Y(p.coordinates![0]);
      // Waypoints a few hundred metres apart (Mecca and Thawr, Medina and Quba) would print on top of each other: a label that collides with an earlier one drops below its dot.
      const clash = pts.slice(0, i).some((q) => Math.abs(X(q.coordinates![1]) - cx) < 14 && Math.abs(Y(q.coordinates![0]) - cy) < 4);
      return (
        <g>
          <circle cx={cx} cy={cy} r="1.3" fill="var(--lapis)" />
          <a href={href(lang, p.id)}><text x={cx + 2} y={cy + (clash ? 4.6 : 1)} font-size="3.2" fill="var(--fg)" paint-order="stroke" stroke="var(--panel)" stroke-width=".8">{labelOf(p, lang)}</text></a>
        </g>
      );
    })}
  </svg>
)}
