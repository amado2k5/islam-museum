---
import { href, labelOf } from "../lib/graph";
import type { Lang } from "../lib/i18n";
import type { Node } from "../../../scripts/build-graph";
import basemap from "../data/basemap-mena.json";
// Schematic equirectangular map, no tiles and no third-party requests: land from a self-hosted Natural Earth extract (scripts/map/build_basemap.py),
// places and the route from the graph. The interactive MapLibre map replaces it in Phase 1.
// declutter (the place wing's overview of every place): no route line, and labels are placed best-connected first, each
// right, left, above or below its dot, wherever it overlaps no label already placed; a label with no free spot is left
// out. Every dot is then a link with its name as a tooltip, so a place without a printed label is still reachable.
const { places, lang, width = 100, height = 55, declutter = false } = Astro.props as { places: Node[]; lang: Lang; width?: number; height?: number; declutter?: boolean };
const pts = places.filter((p) => p.coordinates);
const lons = pts.map((p) => p.coordinates![1]);
const lats = pts.map((p) => p.coordinates![0]);
const pad = 6;
const minLon = Math.min(...lons) - pad, maxLon = Math.max(...lons) + pad;
const minLat = Math.min(...lats) - pad * 0.6, maxLat = Math.max(...lats) + pad * 0.6;
const X = (lon: number) => ((lon - minLon) / (maxLon - minLon || 1)) * width;
const Y = (lat: number) => height - ((lat - minLat) / (maxLat - minLat || 1)) * height;
// Only the land that can appear in this frame is drawn into the page.
const inFrame = (ring: number[][]) => ring.some(([lon, lat]) => lon >= minLon && lon <= maxLon && lat >= minLat && lat <= maxLat);
// The basemap's largest ring holds the whole Eurasian-African coastline (~20k points); drawn raw it puts ~300KB of path data into every
// page. Two passes in screen space keep the visible shape and drop the rest: Ramer–Douglas–Peucker at ~1.5px tolerance once rendered,
// then out-of-frame excursions collapse to the two points where the ring crosses the frame edge.
const rdp = (pts: number[][], eps: number) => {
  if (pts.length < 4) return pts;
  const keep = new Uint8Array(pts.length); keep[0] = keep[pts.length - 1] = 1;
  const stack: number[][] = [[0, pts.length - 1]];
  while (stack.length) {
    const [a, b] = stack.pop()!;
    let dmax = 0, idx = -1;
    const [ax, ay] = pts[a], [bx, by] = pts[b];
    const dx = bx - ax, dy = by - ay, len = Math.hypot(dx, dy) || 1;
    for (let i = a + 1; i < b; i++) {
      const d = Math.abs(dy * pts[i][0] - dx * pts[i][1] + bx * ay - by * ax) / len;
      if (d > dmax) { dmax = d; idx = i; }
    }
    if (dmax > eps && idx > 0) { keep[idx] = 1; stack.push([a, idx], [idx, b]); }
  }
  return pts.filter((_, i) => keep[i]);
};
const margin = 12;
const inView = (x: number, y: number) => x >= -margin && x <= width + margin && y >= -margin && y <= height + margin;
const simplifyRing = (ring: number[][]) => {
  const projected = ring.map(([lon, lat]) => [X(lon), Y(lat)]);
  // Rotate so the walk starts just after an out-of-view point (or at 0 when the whole ring is visible).
  let start = 0;
  for (let i = 0; i < projected.length; i++) {
    if (!inView(projected[i][0], projected[i][1]) && inView(projected[(i + 1) % projected.length][0], projected[(i + 1) % projected.length][1])) { start = (i + 1) % projected.length; break; }
  }
  const seq = projected.slice(start).concat(projected.slice(0, start));
  const out: number[][] = [];
  let gap: number[][] = [];
  for (const p of seq) {
    if (inView(p[0], p[1])) {
      if (gap.length && out.length) out.push(gap[gap.length - 1]); // re-entry: land once at the frame edge
      gap = [];
      out.push(p);
    } else gap.push(p);
  }
  if (gap.length && out.length) out.push(gap[0]); // exit point
  return out.length > 2 ? rdp(out, 0.15) : out;
};
const FONT = 3.2;
type Box = { x0: number; y0: number; x1: number; y1: number };
type Placed = { x: number; y: number; anchor: "start" | "end" } | null;
const placement = new Map<string, Placed>();
if (declutter) {
  const boxes: Box[] = [];
  // Labels are drawn above every dot with a halo (below), so only label-on-label collisions are avoided.
  const hits = (b: Box) => boxes.some((o) => b.x0 < o.x1 && b.x1 > o.x0 && b.y0 < o.y1 && b.y1 > o.y0);
  // Deterministic: best-connected places first, then by id.
  const order = [...pts].sort((a, b) => (b.degree ?? 0) - (a.degree ?? 0) || a.id.localeCompare(b.id));
  for (const p of order) {
    const cx = X(p.coordinates![1]), cy = Y(p.coordinates![0]);
    // Width from the character count, generous for the serif and for Arabic script, so a kept label never touches another.
    const w = labelOf(p, lang).length * FONT * 0.62 + 1;
    const tries: { x: number; y: number; anchor: "start" | "end" }[] = [
      { x: cx + 2, y: cy + 1, anchor: "start" }, { x: cx - 2, y: cy + 1, anchor: "end" },
      { x: cx - w / 2, y: cy - 2, anchor: "start" }, { x: cx - w / 2, y: cy + 4.6, anchor: "start" },
    ];
    let spot: Placed = null;
    for (const t of tries) {
      const x0 = t.anchor === "start" ? t.x : t.x - w;
      // The rendered line box: about 1.1 em above the baseline and 0.65 em below it (Arabic descenders), measured in a browser.
      const b = { x0, y0: t.y - FONT * 1.1, x1: x0 + w, y1: t.y + FONT * 0.65 };
      if (b.x0 < 0 || b.x1 > width || b.y0 < 0 || b.y1 > height || hits(b)) continue;
      boxes.push(b); spot = t; break;
    }
    placement.set(p.id, spot);
  }
}
const landD = (basemap.rings as number[][][]).filter(inFrame).map(simplifyRing).filter((r) => r.length > 2)
  .map((r) => "M" + r.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join("L") + "Z").join("");
---
{pts.length > 0 && (
  <svg viewBox={`0 0 ${width} ${height}`} role="group" aria-label={pts.map((p) => labelOf(p, lang)).join(", ")} style="width:100%;height:auto;display:block;background:var(--panel);border-radius:10px;direction:ltr">
    <path d={landD} fill="currentColor" fill-opacity=".12" stroke="currentColor" stroke-opacity=".35" stroke-width=".15" style="color:var(--fg)" />
    {pts.length > 1 && !declutter && <polyline points={pts.map((p) => `${X(p.coordinates![1])},${Y(p.coordinates![0])}`).join(" ")} fill="none" stroke="var(--gold)" stroke-width=".4" stroke-dasharray="1 1" opacity=".9" />}
    {declutter && pts.map((p) => <circle cx={X(p.coordinates![1])} cy={Y(p.coordinates![0])} r="1.3" fill="var(--lapis)" />)}
    {declutter && pts.map((p) => {
      const cx = X(p.coordinates![1]), cy = Y(p.coordinates![0]);
      const spot = placement.get(p.id);
      // Drawn after every dot, so no dot covers a label: one link per place, its target the dot (a transparent disc over it) and its label.
      return (
        <a href={href(lang, p.id)}>
          <title>{labelOf(p, lang)}</title>
          <circle cx={cx} cy={cy} r="1.3" fill="transparent" />
          {spot && <text x={spot.x} y={spot.y} text-anchor={spot.anchor} font-size={FONT} fill="var(--fg)" paint-order="stroke" stroke="var(--panel)" stroke-width=".8">{labelOf(p, lang)}</text>}
        </a>
      );
    })}
    {!declutter && pts.map((p, i) => {
      const cx = X(p.coordinates![1]), cy = Y(p.coordinates![0]);
      // Waypoints a few hundred metres apart (Mecca and Thawr, Medina and Quba) would print on top of each other: a label that collides with an earlier one drops below its dot.
      const clash = pts.slice(0, i).some((q) => Math.abs(X(q.coordinates![1]) - cx) < 14 && Math.abs(Y(q.coordinates![0]) - cy) < 4);
      return (
        <g>
          <circle cx={cx} cy={cy} r="1.3" fill="var(--lapis)" />
          <a href={href(lang, p.id)}><text x={cx + 2} y={cy + (clash ? 4.6 : 1)} font-size="3.2" fill="var(--fg)" paint-order="stroke" stroke="var(--panel)" stroke-width=".8">{labelOf(p, lang)}</text></a>
        </g>
      );
    })}
  </svg>
)}
