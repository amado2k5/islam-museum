---
// Hand-drawn SVG scenes for the /future/ page — the museum's own imagination of Muslim life in 2077.
// All figures are stylized and faceless (no likeness of any real person); no text is drawn inside any scene.
interface Props { name: "mosque" | "hifz" | "isnad" | "hajj" | "space" | "city"; alt: string }
const { name, alt } = Astro.props as Props;
const G = "#c5a059", S = "#e6d5b8", T = "#2a7b88", N1 = "#071723", N2 = "#0d2a3e", W = "#f9f8f6";
---
<figure class="fut-scene" role="img" aria-label={alt}>
  {name === "mosque" && (
    <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="400" height="260" fill={N1}/>
      <path d="M0 190 Q200 40 400 190 V260 H0 Z" fill={N2}/>
      <path d="M60 190 Q200 70 340 190" fill="none" stroke={G} stroke-width="2" opacity=".5"/>
      <path d="M90 190 Q200 100 310 190" fill="none" stroke={G} stroke-width="1.4" opacity=".35"/>
      <circle cx="330" cy="46" r="17" fill={S} opacity=".9"/><circle cx="336" cy="42" r="15" fill={N1}/>
      {/* a row of worshippers standing — faceless, non-identifiable */}
      <g fill={S} opacity=".92">
        <g transform="translate(96,206)"><circle cx="0" cy="-26" r="7"/><rect x="-8" y="-19" width="16" height="22" rx="7"/></g>
        <g transform="translate(128,210)"><circle cx="0" cy="-26" r="7"/><rect x="-8" y="-19" width="16" height="22" rx="7"/></g>
        <g transform="translate(160,213)"><circle cx="0" cy="-26" r="7"/><rect x="-8" y="-19" width="16" height="22" rx="7"/></g>
        <g transform="translate(192,214)"><circle cx="0" cy="-26" r="7"/><rect x="-8" y="-19" width="16" height="22" rx="7"/></g>
        <g transform="translate(224,213)"><circle cx="0" cy="-26" r="7"/><rect x="-8" y="-19" width="16" height="22" rx="7"/></g>
      </g>
      {/* a translucent holographic worshipper joining the row */}
      <g fill={T} opacity=".55" transform="translate(256,210)">
        <circle cx="0" cy="-26" r="7"/><rect x="-8" y="-19" width="16" height="22" rx="7"/>
      </g>
      <ellipse cx="256" cy="216" rx="16" ry="4" fill="none" stroke={T} stroke-width="1" opacity=".6"/>
      {/* a small service robot carrying a water flask */}
      <g transform="translate(322,212)">
        <rect x="-12" y="-26" width="24" height="26" rx="8" fill={T}/>
        <circle cx="0" cy="-33" r="8" fill={T}/><circle cx="0" cy="-34" r="3" fill={S}/>
        <rect x="-16" y="-16" width="6" height="10" rx="2" fill={S}/>
        <rect x="10" y="-16" width="6" height="10" rx="2" fill={S}/>
        <rect x="-14" y="-4" width="28" height="4" rx="2" fill={G} opacity=".8"/>
        <rect x="-3" y="-52" width="6" height="14" rx="3" fill={S} opacity=".8"/>
      </g>
      {/* hanging lamps / translation halo */}
      <line x1="200" y1="58" x2="200" y2="92" stroke={G} stroke-width="1" opacity=".6"/>
      <circle cx="200" cy="98" r="6" fill={G} opacity=".85"/>
      <ellipse cx="200" cy="98" rx="26" ry="8" fill="none" stroke={G} stroke-width="1" opacity=".45"/>
      <g fill={S} opacity=".7"><circle cx="150" cy="60" r="1.4"/><circle cx="250" cy="50" r="1.2"/><circle cx="300" cy="90" r="1.3"/><circle cx="70" cy="80" r="1.2"/><circle cx="110" cy="40" r="1.4"/></g>
    </svg>
  )}
  {name === "hifz" && (
    <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="400" height="260" fill={N1}/>
      <rect x="40" y="180" width="320" height="10" rx="4" fill={N2}/>
      {/* a learner at a low desk, faceless */}
      <g transform="translate(160,180)">
        <rect x="-16" y="-58" width="32" height="40" rx="12" fill={S}/>
        <circle cx="0" cy="-70" r="14" fill={S}/>
        <rect x="-30" y="-44" width="14" height="26" rx="6" fill={S}/>
        <rect x="16" y="-44" width="14" height="26" rx="6" fill={S}/>
      </g>
      <rect x="128" y="172" width="64" height="8" rx="3" fill={G} opacity=".9"/>
      {/* an open glowing book */}
      <g transform="translate(160,158)">
        <path d="M-26 6 Q-13 -4 0 4 Q13 -4 26 6 V16 Q13 8 0 16 Q-13 8 -26 16 Z" fill={S}/>
        <path d="M-26 6 Q-13 -4 0 4 Q13 -4 26 6" fill="none" stroke={N2} stroke-width="1"/>
      </g>
      {/* the AI companion orb listening, with sound rings */}
      <g transform="translate(258,110)">
        <circle cx="0" cy="0" r="16" fill={T}/>
        <circle cx="0" cy="0" r="6" fill={G}/>
        <circle cx="0" cy="0" r="30" fill="none" stroke={T} stroke-width="1.4" opacity=".5"/>
        <circle cx="0" cy="0" r="44" fill="none" stroke={T} stroke-width="1" opacity=".3"/>
        <circle cx="0" cy="0" r="58" fill="none" stroke={T} stroke-width=".8" opacity=".18"/>
      </g>
      {/* sound path from the reader to the orb */}
      <path d="M200 150 Q236 132 244 118" fill="none" stroke={G} stroke-width="1.6" stroke-dasharray="3 5" opacity=".8"/>
      <g fill={S} opacity=".7"><circle cx="80" cy="60" r="1.5"/><circle cx="120" cy="34" r="1.1"/><circle cx="330" cy="50" r="1.4"/><circle cx="300" cy="180" r="1.2"/><circle cx="60" cy="130" r="1.2"/><circle cx="220" cy="40" r="1.3"/></g>
      {/* a hanging chain of small beads — the isnad the companion keeps */}
      <g stroke={G} stroke-width="1" fill={G} opacity=".75">
        <line x1="66" y1="86" x2="66" y2="150"/>
        <circle cx="66" cy="90" r="3.4"/><circle cx="66" cy="106" r="3"/><circle cx="66" cy="121" r="2.6"/><circle cx="66" cy="135" r="2.2"/><circle cx="66" cy="148" r="1.8"/>
      </g>
    </svg>
  )}
  {name === "isnad" && (
    <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="400" height="260" fill={N1}/>
      {/* a golden chain of narrators winding across the centuries */}
      <path d="M30 200 C80 150 110 190 150 140 S230 150 250 100 S330 110 370 60" fill="none" stroke={G} stroke-width="2" opacity=".8"/>
      <g fill={S}>
        <circle cx="30" cy="200" r="9"/><circle cx="78" cy="168" r="8"/><circle cx="118" cy="176" r="8"/><circle cx="150" cy="140" r="9"/>
        <circle cx="192" cy="132" r="8"/><circle cx="230" cy="122" r="8"/><circle cx="250" cy="100" r="9"/><circle cx="296" cy="94" r="8"/><circle cx="330" cy="88" r="8"/><circle cx="370" cy="60" r="10"/>
      </g>
      {/* small faceless figures at two links */}
      <g transform="translate(150,140)" fill={S} opacity=".9"><circle cx="0" cy="-16" r="5"/><rect x="-5" y="-11" width="10" height="8" rx="4"/></g>
      <g transform="translate(370,60)" fill={G} opacity=".95"><circle cx="0" cy="-18" r="5.5"/><rect x="-6" y="-12" width="12" height="9" rx="4"/></g>
      {/* verification rays: two nodes checked against each other */}
      <path d="M78 168 Q150 90 296 94" fill="none" stroke={T} stroke-width="1" stroke-dasharray="2 4" opacity=".7"/>
      <circle cx="78" cy="168" r="14" fill="none" stroke={T} stroke-width="1.2" opacity=".7"/>
      <circle cx="296" cy="94" r="14" fill="none" stroke={T} stroke-width="1.2" opacity=".7"/>
      {/* a scanning ring — the machine doing the candlelight work */}
      <circle cx="230" cy="122" r="18" fill="none" stroke={W} stroke-width="1" opacity=".5"/>
      <path d="M230 104 A18 18 0 0 1 248 122" fill="none" stroke={G} stroke-width="2"/>
      <g fill={S} opacity=".6"><circle cx="50" cy="60" r="1.4"/><circle cx="100" cy="40" r="1.1"/><circle cx="180" cy="70" r="1.3"/><circle cx="280" cy="40" r="1.2"/><circle cx="350" cy="140" r="1.4"/><circle cx="60" cy="230" r="1.1"/><circle cx="320" cy="210" r="1.3"/></g>
      {/* century ticks under the chain */}
      <g stroke={G} stroke-width="1" opacity=".45">
        <line x1="60" y1="238" x2="60" y2="246"/><line x1="140" y1="238" x2="140" y2="246"/><line x1="220" y1="238" x2="220" y2="246"/><line x1="300" y1="238" x2="300" y2="246"/>
      </g>
      <line x1="30" y1="242" x2="370" y2="242" stroke={G} stroke-width="1" opacity=".3"/>
    </svg>
  )}
  {name === "hajj" && (
    <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="400" height="260" fill={N1}/>
      {/* the sanctuary roofline and minarets */}
      <g fill={N2}>
        <rect x="0" y="150" width="400" height="110"/>
        <rect x="36" y="66" width="10" height="90"/><rect x="30" y="60" width="22" height="8" rx="3"/><path d="M41 44 L47 60 H35 Z"/>
        <rect x="354" y="66" width="10" height="90"/><rect x="348" y="60" width="22" height="8" rx="3"/><path d="M359 44 L365 60 H353 Z"/>
      </g>
      <circle cx="345" cy="36" r="12" fill={S} opacity=".85"/><circle cx="350" cy="33" r="10.5" fill={N1}/>
      {/* the Kaaba — architecture only */}
      <g transform="translate(200,168)">
        <rect x="-34" y="-40" width="68" height="72" fill="#0b0b10"/>
        <rect x="-34" y="-40" width="68" height="14" fill={G}/>
        <line x1="-34" y1="-24" x2="34" y2="-24" stroke={G} stroke-width="1" opacity=".7"/>
      </g>
      {/* a flowing ring of pilgrims — dots in tawaf */}
      <ellipse cx="200" cy="196" rx="120" ry="34" fill="none" stroke={S} stroke-width="1.2" opacity=".35"/>
      <ellipse cx="200" cy="196" rx="86" ry="24" fill="none" stroke={S} stroke-width="1" opacity=".3"/>
      <g fill={S} opacity=".9">
        <circle cx="86" cy="186" r="3"/><circle cx="112" cy="176" r="3"/><circle cx="146" cy="170" r="3"/><circle cx="182" cy="168" r="3"/>
        <circle cx="222" cy="169" r="3"/><circle cx="258" cy="174" r="3"/><circle cx="290" cy="182" r="3"/><circle cx="312" cy="192" r="3"/>
        <circle cx="296" cy="206" r="3"/><circle cx="262" cy="216" r="3"/><circle cx="222" cy="221" r="3"/><circle cx="182" cy="222" r="3"/>
        <circle cx="142" cy="218" r="3"/><circle cx="108" cy="208" r="3"/>
      </g>
      {/* guide robots on the edge of the flow */}
      <g transform="translate(60,196)"><rect x="-8" y="-16" width="16" height="16" rx="5" fill={T}/><circle cx="0" cy="-20" r="5" fill={T}/><circle cx="0" cy="-21" r="1.8" fill={S}/></g>
      <g transform="translate(340,206)"><rect x="-8" y="-16" width="16" height="16" rx="5" fill={T}/><circle cx="0" cy="-20" r="5" fill={T}/><circle cx="0" cy="-21" r="1.8" fill={S}/></g>
      {/* crowd-flow sensing arcs */}
      <path d="M60 158 Q200 118 340 158" fill="none" stroke={T} stroke-width="1" stroke-dasharray="3 5" opacity=".6"/>
      <path d="M100 138 Q200 108 300 138" fill="none" stroke={T} stroke-width="1" stroke-dasharray="3 5" opacity=".4"/>
      <g fill={S} opacity=".6"><circle cx="90" cy="40" r="1.4"/><circle cx="150" cy="60" r="1.1"/><circle cx="240" cy="36" r="1.3"/><circle cx="300" cy="70" r="1.2"/></g>
    </svg>
  )}
  {name === "space" && (
    <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="400" height="260" fill="#02070c"/>
      {/* station window frame */}
      <path d="M40 40 H360 V210 H40 Z" fill="none" stroke={N2} stroke-width="10"/>
      <path d="M40 40 H360 V210 H40 Z" fill="none" stroke={G} stroke-width="1.4" opacity=".5"/>
      {/* Earth filling the lower window */}
      <circle cx="200" cy="330" r="150" fill={T} opacity=".9"/>
      <circle cx="200" cy="330" r="150" fill="none" stroke={S} stroke-width="2" opacity=".5"/>
      <path d="M80 250 Q140 232 190 252 T330 240" fill="none" stroke={S} stroke-width="6" opacity=".25"/>
      <path d="M120 268 Q200 250 280 268" fill="none" stroke={S} stroke-width="5" opacity=".2"/>
      {/* a golden qibla point on the Earth */}
      <circle cx="228" cy="232" r="4" fill={G}/>
      <circle cx="228" cy="232" r="9" fill="none" stroke={G} stroke-width="1" opacity=".6"/>
      <circle cx="228" cy="232" r="15" fill="none" stroke={G} stroke-width=".7" opacity=".35"/>
      {/* the astronaut, floating, praying by intention — faceless */}
      <g transform="translate(150,120) rotate(-18)">
        <rect x="-10" y="-8" width="34" height="20" rx="9" fill={S}/>
        <circle cx="24" cy="-4" r="9" fill={S}/>
        <rect x="-24" y="-4" width="16" height="8" rx="4" fill={S}/>
        <rect x="6" y="10" width="10" height="18" rx="5" fill={S}/>
        <rect x="-2" y="10" width="10" height="18" rx="5" fill={S} opacity=".85"/>
      </g>
      {/* tether */}
      <path d="M120 140 Q90 160 60 150" fill="none" stroke={S} stroke-width="1.2" opacity=".6"/>
      {/* intention line toward the qibla */}
      <path d="M176 130 Q210 180 224 226" fill="none" stroke={G} stroke-width="1.2" stroke-dasharray="2 5" opacity=".8"/>
      <g fill={S}><circle cx="70" cy="70" r="1.5"/><circle cx="110" cy="52" r="1.1"/><circle cx="300" cy="60" r="1.4"/><circle cx="340" cy="90" r="1.1"/><circle cx="260" cy="76" r="1.2"/><circle cx="330" cy="140" r="1.4"/><circle cx="80" cy="110" r="1.2"/><circle cx="56" cy="190" r="1.1"/></g>
    </svg>
  )}
  {name === "city" && (
    <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="400" height="260" fill={N1}/>
      {/* a 2077 skyline: towers, a dish, minarets among them */}
      <g fill={N2}>
        <rect x="20" y="120" width="34" height="140"/><rect x="66" y="90" width="28" height="170"/>
        <rect x="110" y="140" width="40" height="120"/><rect x="252" y="100" width="30" height="160"/>
        <rect x="300" y="130" width="38" height="130"/><rect x="352" y="150" width="30" height="110"/>
      </g>
      <g stroke={G} stroke-width="1" opacity=".5">
        <line x1="30" y1="120" x2="48" y2="120"/><line x1="72" y1="90" x2="88" y2="90"/><line x1="118" y1="140" x2="142" y2="140"/>
        <line x1="258" y1="100" x2="276" y2="100"/><line x1="308" y1="130" x2="330" y2="130"/>
      </g>
      {/* lit windows */}
      <g fill={G} opacity=".55">
        <rect x="28" y="132" width="5" height="7"/><rect x="40" y="148" width="5" height="7"/><rect x="72" y="102" width="5" height="7"/>
        <rect x="80" y="122" width="5" height="7"/><rect x="118" y="152" width="5" height="7"/><rect x="132" y="168" width="5" height="7"/>
        <rect x="258" y="112" width="5" height="7"/><rect x="268" y="140" width="5" height="7"/><rect x="308" y="144" width="5" height="7"/>
        <rect x="322" y="162" width="5" height="7"/><rect x="360" y="164" width="5" height="7"/>
      </g>
      {/* a minaret and a dome that survived the future */}
      <g fill={S}>
        <rect x="176" y="70" width="9" height="150"/>
        <rect x="170" y="86" width="21" height="6" rx="3"/>
        <path d="M180.5 46 L188 70 H173 Z"/>
      </g>
      <path d="M196 260 Q196 226 222 226 Q248 226 248 260 Z" fill={S}/>
      <line x1="222" y1="226" x2="222" y2="210" stroke={S} stroke-width="3"/><circle cx="222" cy="208" r="3" fill={G}/>
      {/* a satellite dish on a tower */}
      <path d="M267 100 Q284 84 292 62" fill="none" stroke={S} stroke-width="3"/>
      <path d="M284 62 Q298 66 302 80 Q288 78 284 62" fill={S}/>
      {/* drones and delivery bots */}
      <g fill={T}>
        <g transform="translate(120,60)"><rect x="-10" y="-4" width="20" height="8" rx="4"/><circle cx="-14" cy="0" r="3"/><circle cx="14" cy="0" r="3"/></g>
        <g transform="translate(320,50)"><rect x="-10" y="-4" width="20" height="8" rx="4"/><circle cx="-14" cy="0" r="3"/><circle cx="14" cy="0" r="3"/></g>
        <g transform="translate(90,240)"><rect x="-9" y="-12" width="18" height="14" rx="5"/><circle cx="0" cy="-16" r="4.5"/><circle cx="0" cy="-17" r="1.6" fill={S}/></g>
      </g>
      {/* people and robots sharing the street — faceless */}
      <g fill={S} opacity=".9">
        <g transform="translate(140,246)"><circle cx="0" cy="-10" r="4.5"/><rect x="-4.5" y="-6" width="9" height="10" rx="4"/></g>
        <g transform="translate(170,250)"><circle cx="0" cy="-10" r="4.5"/><rect x="-4.5" y="-6" width="9" height="10" rx="4"/></g>
        <g transform="translate(290,248)"><circle cx="0" cy="-10" r="4.5"/><rect x="-4.5" y="-6" width="9" height="10" rx="4"/></g>
      </g>
      <g transform="translate(330,246)" fill={T}><rect x="-7" y="-14" width="14" height="14" rx="5"/><circle cx="0" cy="-18" r="4"/><circle cx="0" cy="-19" r="1.5" fill={S}/></g>
      {/* the moon, high */}
      <circle cx="48" cy="44" r="14" fill={S} opacity=".9"/><circle cx="54" cy="40" r="12" fill={N1}/>
      <g fill={S} opacity=".6"><circle cx="200" cy="30" r="1.4"/><circle cx="240" cy="52" r="1.1"/><circle cx="150" cy="20" r="1.3"/><circle cx="360" cy="110" r="1.2"/><circle cx="20" cy="90" r="1.2"/></g>
    </svg>
  )}
</figure>
<style>
  .fut-scene { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); background: #071723; margin: 0; }
  .fut-scene svg { display: block; width: 100%; height: auto; }
</style>
