---
// "Where are you looking from?": the arcade of nine doors (landing page, under the Grand Tour button). A plain list of links; no
// script is needed to use it. The optional script /shell/viewpoint.js only leaves open the last door chosen on this device.
import { ui, type Lang } from "../lib/i18n";
import Door from "./Door.astro";
import { VIEWPOINTS, viewpointPath, accentStyle, quote } from "../lib/viewpoints";
const { lang } = Astro.props as { lang: Lang };
const P = ui(lang).viewpoints;
---
<section class="vps" id="viewpoints" aria-labelledby="vps-t" data-vp-cards data-vp-keys={VIEWPOINTS.join(",")}>
  <h2 id="vps-t" class="vps-title">{P.title}</h2>
  <p class="vps-lede ui">{P.lede}</p>
  <p class="vps-status ui" data-vp-status data-tpl={P.your} hidden><span data-vp-text></span> · <button type="button" data-vp-reset>{P.reset}</button></p>
  <nav aria-label={P.nav_label}>
    <ul class="vps-grid">
      {VIEWPOINTS.map((k) => (
        <li>
          <a class="vp" href={viewpointPath(lang, k)} style={accentStyle(k)} data-vp={k} data-name={P[k].name}>
            <Door v={k} />
            <span class="vp-nm">{P[k].name}</span>
            <span class="vp-ln ui">{quote(lang, P[k].line)}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <script is:inline src="/shell/viewpoint.js" defer></script>
</section>
<style>
  .vps { --wall: #efe6d3; --stone: #dccaa6; --door-line: #b9a37a; max-width: 76rem; margin: 2.4rem auto 0; text-align: center; }
  .vps-title { font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 0 0 .2rem; font-weight: 400; }
  .vps-lede { margin: 0 0 1.2rem; color: var(--muted); }
  .vps-status { margin: 0 0 .8rem; font-size: .9rem; }
  .vps-status button { background: none; border: 0; padding: 0; min-height: 24px; color: var(--link, inherit); text-decoration: underline; cursor: pointer; font: inherit; }
  .vps-grid { list-style: none; margin: 0; padding: 26px 14px 0; display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 8px; background: var(--wall); border-top: 10px solid var(--stone); border-bottom: 8px solid var(--stone); }
  .vp { display: flex; flex-direction: column; height: 100%; padding-bottom: 14px; color: var(--fg); text-decoration: none; border-radius: 4px; }
  .vp-nm { font-weight: 600; font-size: .98rem; line-height: 1.25; margin-top: 10px; }
  .vp-ln { font-size: .8rem; line-height: 1.4; color: var(--muted); margin-top: 4px; }
  .vp:hover .vp-nm, .vp.is-last .vp-nm { text-decoration: underline; text-decoration-color: #c5a059; text-decoration-thickness: 3px; text-underline-offset: 4px; }
  .vp:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  @media (max-width: 1000px) { .vps-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  @media (max-width: 680px) {
    .vps-grid { grid-template-columns: 1fr; gap: 0; padding: 6px 12px; }
    .vps-grid li + li { border-top: 1px solid var(--door-line); }
    .vp { display: grid; grid-template-columns: 46px 1fr; column-gap: 16px; text-align: start; padding: 10px 0; }
    .vp :global(.door) { grid-row: 1 / 3; }
    .vp-nm { margin: 0; align-self: end; font-size: 1.08rem; }
    .vp-ln { margin: 0; align-self: start; font-size: .9rem; }
  }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .vps { --wall: #113f4e; --stone: #1b5263; --door-line: #6b8f98; } }
  :global(:root[data-theme="dark"]) .vps { --wall: #113f4e; --stone: #1b5263; --door-line: #6b8f98; }
</style>
