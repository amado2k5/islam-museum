---
// An eight-fold star medallion for a heroes virtue hall — pure inline SVG, no text inside.
interface Props { accent: string; size?: number }
const { accent, size = 96 } = Astro.props;
---
<svg class="medallion" viewBox="0 0 100 100" width={size} height={size} aria-hidden="true" style={`--med:${accent}`}>
  <g fill="none" stroke="var(--med)" stroke-width="1.6">
    <circle cx="50" cy="50" r="46" opacity=".55" />
    <circle cx="50" cy="50" r="38" opacity=".8" />
    <path d="M50 12 L61 39 L88 50 L61 61 L50 88 L39 61 L12 50 L39 39 Z" />
    <path d="M50 24 L57 43 L76 50 L57 57 L50 76 L43 57 L24 50 L43 43 Z" opacity=".7" transform="rotate(45 50 50)" />
  </g>
  <circle cx="50" cy="50" r="6" fill="var(--med)" opacity=".85" />
</svg>
