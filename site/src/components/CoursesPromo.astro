---
// The homepage's section on the courses experience (docs/courses-mission/DESIGN.md, "The front door").
// It says what the surface is, what a student gets, and shows one real discovery card from a real lesson, with the
// counts read from the course records at build time. Its styles are written into the homepage only (see CoursesStyle.astro for why).
import css from "./courses-promo.css?raw";
import { ui, fmt, type Lang } from "../lib/i18n";
import { labelOf } from "../lib/graph";
import { num } from "../lib/nav";
import { courses, homePath, coursePath, lessonPath, connView, jurisdictions } from "../lib/courses";

interface Props { lang: Lang }
const { lang } = Astro.props;
const C = ui(lang).courses;
const min = css.replace(/\/\*[\s\S]*?\*\//g, "").replace(/\s*\n\s*/g, "").replace(/\s*([{};,>])\s*/g, "$1").replace(/;}/g, "}");
const nLessons = courses.reduce((a, c) => a + c.lessons.length, 0);
const nConns = courses.reduce((a, c) => a + c.lessons.reduce((b, l) => b + (l.data?.connections ?? []).length, 0), 0);
// one real card: the first connection, in catalogue order, that opens a written record
let sample: { course: (typeof courses)[number]; lesson: any; conn: ReturnType<typeof connView> } | undefined;
for (const c of courses) { for (const l of c.lessons) { const k = (l.data?.connections ?? []).map((x: any) => connView(x, lang)).find((x: any) => x.door && !x.door.stub && x.kind === "scholar"); if (k) { sample = { course: c, lesson: l, conn: k }; break; } } if (sample) break; }
---
{courses.length > 0 && (
<section class="band cxp" id="courses" aria-labelledby="courses-title">
  <style is:inline set:html={min}></style>
  <div class="wrap cxp-grid">
    <div>
      <p class="cxp-eyebrow ui">{C.promo_eyebrow}</p>
      <h2 id="courses-title">{C.promo_title}</h2>
      <p class="cxp-lede">{C.promo_lede}</p>
      <ul class="cxp-points">
        <li><b>{C.promo_p1_t}</b>{" "}{C.promo_p1}</li>
        <li><b>{C.promo_p2_t}</b>{" "}{C.promo_p2}</li>
        <li><b>{C.promo_p3_t}</b>{" "}{C.promo_p3}</li>
      </ul>
      <div class="row">
        <a class="btn btn-lapis" href={homePath(lang)}>{C.find_title} <span class="flip" aria-hidden="true">→</span></a>
        {sample && <a class="btn btn-outline" href={lessonPath(lang, sample.course, sample.lesson)}>{C.promo_sample}</a>}
      </div>
      <p class="cxp-stats ui">{fmt(C.promo_stats, { systems: num(jurisdictions.length, lang), courses: num(courses.length, lang), lessons: num(nLessons, lang), cards: num(nConns, lang) })}</p>
    </div>
    {sample && (
      <a class="cxp-card" href={lessonPath(lang, sample.course, sample.lesson)}>
        <span class="cxp-from ui">{labelOf(sample.course.subject, lang)} · {labelOf(sample.lesson, lang)}</span>
        <span class="cxp-kind ui">{sample.conn.kindLabel} · {C.within_label}</span>
        <b>{sample.conn.title}</b>
        <span class="cxp-text">{sample.conn.text}</span>
        <span class="cxp-door"><b>{sample.conn.door!.label}</b><span class="ui">{C.open_record} <span class="flip" aria-hidden="true">→</span></span></span>
      </a>
    )}
  </div>
</section>
)}
