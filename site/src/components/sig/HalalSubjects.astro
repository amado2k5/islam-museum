---
// "What are you asking about?" (Halal and Haram Browser): the twelve subjects as a board of tiles, each with its
// own line drawing, the number of its records, and a three-part bar of how many of its passages name the lawful,
// both, or the unlawful. Every tile is a link to the subject's own page. Every number comes from lib/halal.ts at
// build time; the view needs no script. The build throws when a subject has no label or drawing, so the lexicon
// (scripts/halal.ts) and this board cannot drift apart.
import { ui, fmt, type Lang } from "../../lib/i18n";
import { num } from "../../lib/nav";
import { halalSubjectGroups } from "../../lib/halal";
interface Props { lang: Lang; current?: string; compact?: boolean }
const { lang, current, compact } = Astro.props;
const G = (ui(lang) as any).halal;
const U = G.subjects_ui;
// 24×24 line drawings, one per subject.
const ICON: Record<string, string> = {
  principles: "M12 3v18M6 21h12M4 7h16M4 7l-2.5 6a3 3 0 0 0 5 0L4 7zm16 0-2.5 6a3 3 0 0 0 5 0L20 7z",
  food: "M3 11h18a9 9 0 0 1-18 0zM8 20h8M9 7c0-1.5 1.5-1.5 1.5-3M13.5 7c0-1.5 1.5-1.5 1.5-3",
  drink: "M7 3h10l-1.2 15.2A2 2 0 0 1 13.8 20h-3.6a2 2 0 0 1-2-1.8L7 3zM7.5 9h9",
  "hunting-slaughter": "M5 19C5 10 10 5 19 5M5 19 19 5M19 5v5M19 5h-5M5 19l-2 2M9 15l-3-1M9 15l1 3",
  earnings: "M9 14a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM15.5 10.2A5 5 0 1 1 12 19.6M9 7v4M7.5 9h3",
  "marriage-family": "M9 20a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zM15 20a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zM7.5 4l1.5 3 1.5-3z",
  dress: "M8 3 3 6l2 4 2-1v12h10V9l2 1 2-4-5-3a4 4 0 0 1-8 0z",
  "life-honour": "M12 3 4 6v6c0 4.5 3.2 7.8 8 9 4.8-1.2 8-4.5 8-9V6l-8-3zM12 8v8M8.5 12h7",
  conduct: "M4 5h16v11H10l-5 4v-4H4V5zM8 9h8M8 12.5h5",
  worship: "M16.5 3.5A9 9 0 1 0 20.5 15 7 7 0 0 1 16.5 3.5zM18 6.5l.7 1.6 1.8.2-1.3 1.2.4 1.8-1.6-.9-1.6.9.4-1.8-1.3-1.2 1.8-.2z",
  sanctuary: "M4 8l8-4 8 4v11H4V8zM4 12h16M10 19v-4h4v4",
  other: "M5 12h.01M12 12h.01M19 12h.01M5 12a.5.5 0 1 0 0 .01M12 12a.5.5 0 1 0 0 .01M19 12a.5.5 0 1 0 0 .01",
};
const tiles = halalSubjectGroups.filter((g) => g.items.length > 0).map((g) => {
  if (!G.subjects[g.id]) throw new Error(`HalalSubjects: no label for the subject ${g.id}`);
  if (!ICON[g.id]) throw new Error(`HalalSubjects: no drawing for the subject ${g.id}`);
  const k = (x: string) => g.items.filter((i) => i.kind === x).length;
  const h = k("halal"), b = k("both"), r = k("haram");
  return { id: g.id, n: g.items.length, h, b, r, t: Math.max(1, h + b + r) };
});
---
{tiles.length > 0 && (
  <section class={`halal-subjects${compact ? " is-compact" : ""}`} role="region" aria-label={U.region} data-pagefind-ignore>
    {!compact && <h2 id="subjects-title" style="font-size:1.25rem;margin:0 0 .3rem">{U.title}</h2>}
    {!compact && <p style="max-width:var(--measure);margin:0 0 .9rem">{U.note}</p>}
    {compact && <h2 style="font-size:1rem;margin:0 0 .5rem">{U.other_subjects}</h2>}
    <ul role="list" class="hsub-grid">
      {tiles.filter((t) => t.id !== current).map((t) => (
        <li>
          <a class="hsub-tile" href={`/${lang}/halal/subject/${t.id}/`}>
            <svg class="hsub-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON[t.id]} /></svg>
            <span class="hsub-name">{G.subjects[t.id].title}</span>
            <span class="ui muted hsub-count">{fmt(U.count, { n: num(t.n, lang) })}</span>
            {!compact && <span class="hsub-desc muted">{G.subjects[t.id].desc}</span>}
            {!compact && (
              <span class="hsub-bar" role="img" aria-label={fmt(U.bar, { h: num(t.h, lang), b: num(t.b, lang), r: num(t.r, lang) })}>
                {t.h > 0 && <span style={`flex:${t.h} 1 0;background:#2e7d52`}></span>}
                {t.b > 0 && <span style={`flex:${t.b} 1 0;background:#c5a059`}></span>}
                {t.r > 0 && <span style={`flex:${t.r} 1 0;background:#a8443a`}></span>}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
    {!compact && (
      <p class="ui muted hsub-legend">
        <span><i style="background:#2e7d52"></i>{G.kinds.halal}</span>
        <span><i style="background:#c5a059"></i>{G.kinds.both}</span>
        <span><i style="background:#a8443a"></i>{G.kinds.haram}</span>
      </p>
    )}
  </section>
)}
<style>
  .halal-subjects { margin: 1.4rem 0 0; }
  .hsub-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 12px; }
  .is-compact .hsub-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr)); gap: 8px; }
  .hsub-tile { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 2px 12px; height: 100%; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); color: var(--fg); text-decoration: none; }
  .is-compact .hsub-tile { padding: 8px 12px; }
  .hsub-tile:hover, .hsub-tile:focus-visible { border-color: var(--gold); }
  .hsub-icon { grid-row: span 2; color: #2e7d52; }
  .hsub-name { font-weight: 700; font-size: 1.05rem; }
  .hsub-count { font-size: .82rem; }
  .hsub-desc { grid-column: 1 / -1; font-size: .88rem; margin-top: .4rem; }
  .hsub-bar { grid-column: 1 / -1; display: flex; gap: 2px; height: 8px; margin-top: .6rem; border-radius: 4px; overflow: hidden; align-self: end; }
  .hsub-bar span { min-width: 4px; }
  .hsub-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: .7rem 0 0; font-size: .82rem; }
  .hsub-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-inline-end: 6px; }
</style>
