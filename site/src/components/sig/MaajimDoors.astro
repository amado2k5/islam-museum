---
// "Three doors to one root" (Dictionaries Browser home): the same Arabic root, ج ر ع, looked up in three different
// arrangements of the great dictionaries — Kitab al-Ayn (by place of articulation, permutations gathered), al-Sihah
// (chapter by last radical, section by first) and Asas al-Balagha (chapter by first radical). Each door links to its
// dictionary's record; the Sihah door also links to the scan page where the root actually stands (page 60 of volume 1).
// The works and the page are read from the graph at build time and the build throws when one is missing.
import { ui } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";
import { href, labelOf, realNodes } from "../../lib/graph";

interface Props { lang: Lang }
const { lang } = Astro.props;
const M = (ui(lang) as any).maajim;
const V = M.viz;
const DOORS = [
  { key: "ayn", work: "work/kitab-al-ayn", hue: "#2a7b88" },
  { key: "sihah", work: "work/al-sihah-jawhari", hue: "#c5a059", page: "passage/sihah-bulaq-v1-p0060" },
  { key: "asas", work: "work/asas-al-balagha", hue: "#9a4f68" },
];
const node = (id: string) => {
  const n = realNodes.find((x) => x.id === id);
  if (!n) throw new Error(`MaajimDoors: ${id} is not in the graph`);
  return n;
};
const doors = DOORS.map((d) => ({ ...d, n: node(d.work), p: d.page ? node(d.page) : null }));
---
<section aria-labelledby="sg-md-title" class="sg-md" style="margin-top:1.6rem">
  <div data-pagefind-body>
    <h2 id="sg-md-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure)">{V.note}</p>
  </div>
  <p class="sg-md-root ui" aria-label={V.root_label}><bdi dir="rtl" lang="ar">ج · ر · ع</bdi></p>
  <ol class="sg-md-doors" role="list" data-pagefind-ignore>
    {doors.map((d) => (
      <li class="sg-md-door" style={`--hue:${d.hue}`}>
        <svg viewBox="0 0 120 70" aria-hidden="true" class="sg-md-arch"><path d="M10 68 V34 Q10 8 60 8 Q110 8 110 34 V68" fill="none" stroke="var(--hue)" stroke-width="4"/><path d="M28 68 V38 Q28 22 60 22 Q92 22 92 38 V68" fill="none" stroke="var(--hue)" stroke-width="2" opacity=".6"/></svg>
        <h3><a href={href(lang, d.n.id)}>{labelOf(d.n, lang)}</a></h3>
        <p class="ui sg-md-rule">{V[d.key].rule}</p>
        <p class="sg-md-lands"><strong>{V.lands}</strong> {V[d.key].lands}</p>
        {d.p && <p class="ui"><a href={href(lang, d.p.id)}>{V.see_page}</a></p>}
      </li>
    ))}
  </ol>
  <p class="ui muted" style="max-width:var(--measure);font-size:.9rem">{V.caption}</p>
</section>
<style>
  .sg-md-root { font-size: 2.2rem; margin: .4rem 0 .8rem; letter-spacing: .2em; color: var(--gold); }
  .sg-md-doors { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .sg-md-door { border: 1px solid var(--line); border-top: 4px solid var(--hue); border-radius: 14px; padding: 12px 16px 16px; background: var(--card); }
  .sg-md-arch { width: 84px; height: auto; display: block; margin-bottom: 6px; }
  .sg-md-door h3 { font-size: 1.05rem; margin: 0 0 .4rem; }
  .sg-md-rule { margin: 0 0 .5rem; }
  .sg-md-lands { margin: 0 0 .5rem; }
</style>
