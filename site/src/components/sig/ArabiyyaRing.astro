---
// "The ring of the letters" (Arabic Language Browser home): the twenty-eight letters of Arabic set round a
// ring in the order al-Khalil ibn Ahmad filed the first Arabic dictionary by — from the throat outwards to
// the lips — one coloured arc per place of articulation. Inside the ring stand the counts the page computes
// from the graph: the verses in which the Qur'an names its own tongue, the other passages that speak of
// Arabic, and the curated records. The ring links to Kitab al-Ayn and to al-Khalil; both are read from the
// graph at build time and the build throws when one is missing. Plain SVG and text: no script is needed.
import { ui, fmt } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";
import { href, labelOf, byId } from "../../lib/graph";
import { num } from "../../lib/nav";
import { KHALIL_ORDER, arabiyyaPassages, arabiyyaRecords } from "../../lib/arabiyya";

interface Props { lang: Lang }
const { lang } = Astro.props;
const A = (ui(lang) as any).arabiyya;
const V = A.viz;
const node = (id: string) => {
  const n = byId.get(id);
  if (!n || n.stub) throw new Error(`ArabiyyaRing: ${id} is not in the graph`);
  return n;
};
const ayn = node("work/kitab-al-ayn");
const khalil = node("person/al-khalil-ibn-ahmad-al-farahidi");
const total = KHALIL_ORDER.reduce((s, g) => s + g.letters.length, 0);
if (total !== 29) throw new Error(`ArabiyyaRing: expected 28 letters and the hamza, found ${total}`);
// Place the letters clockwise from the top; Arabic reads right to left, so the ring runs to the right first.
const R = 150, C = 190;
let k = 0;
const marks = KHALIL_ORDER.flatMap((g) => g.letters.map((ch) => {
  const a = (k++ / total) * Math.PI * 2 - Math.PI / 2;
  return { ch, hue: g.hue, x: C + R * Math.cos(a), y: C + R * Math.sin(a) };
}));
let start = 0;
const arcs = KHALIL_ORDER.map((g) => {
  const a0 = ((start - 0.5) / total) * Math.PI * 2 - Math.PI / 2;
  start += g.letters.length;
  const a1 = ((start - 0.5) / total) * Math.PI * 2 - Math.PI / 2;
  const r = R + 24;
  const p = (a: number) => `${(C + r * Math.cos(a)).toFixed(1)} ${(C + r * Math.sin(a)).toFixed(1)}`;
  return { id: g.id, hue: g.hue, d: `M${p(a0 + 0.03)} A${r} ${r} 0 ${a1 - a0 > Math.PI ? 1 : 0} 1 ${p(a1 - 0.03)}` };
});
const verses = arabiyyaPassages.filter((p) => p.corpus === "quran").length;
const others = arabiyyaPassages.length - verses;
---
<section aria-labelledby="sg-ar-title" class="sg-ar" style="margin-top:1.6rem">
  <div data-pagefind-body>
    <h2 id="sg-ar-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure)">{V.note}</p>
  </div>
  <div class="sg-ar-grid" data-pagefind-ignore>
    <svg viewBox="0 0 380 380" role="img" aria-label={V.aria} class="sg-ar-ring">
      {arcs.map((a) => <path d={a.d} fill="none" stroke={a.hue} stroke-width="7" stroke-linecap="round" />)}
      <circle cx={C} cy={C} r={R - 30} fill="none" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 6" />
      {marks.map((m) => (
        <g>
          <circle cx={m.x} cy={m.y} r="17" fill="var(--card)" stroke={m.hue} stroke-width="2" />
          <text x={m.x} y={m.y} text-anchor="middle" dominant-baseline="central" font-size="19" fill="var(--fg)" lang="ar">{m.ch}</text>
        </g>
      ))}
      <text x={C} y={C - 34} text-anchor="middle" font-size="44" font-weight="700" fill="var(--gold)">{num(verses, lang)}</text>
      <text x={C} y={C - 10} text-anchor="middle" font-size="13" fill="var(--fg)">{V.verses}</text>
      <text x={C} y={C + 26} text-anchor="middle" font-size="24" font-weight="700" fill="var(--fg)">{num(others, lang)} · {num(arabiyyaRecords.length, lang)}</text>
      <text x={C} y={C + 46} text-anchor="middle" font-size="12" fill="var(--fg)">{V.others}</text>
    </svg>
    <div>
      <ol class="sg-ar-legend ui" role="list">
        {KHALIL_ORDER.map((g) => (
          <li style={`--hue:${g.hue}`}>
            <span class="sg-ar-dot" aria-hidden="true"></span>
            <span><strong>{V.groups[g.id]}</strong> <bdi dir="rtl" lang="ar">{g.letters.join(" ")}</bdi></span>
          </li>
        ))}
      </ol>
      <p class="ui muted" style="max-width:34rem">{fmt(V.source, { n: num(verses, lang) })} <a href={href(lang, ayn.id)}>{labelOf(ayn, lang)}</a> · <a href={href(lang, khalil.id)}>{labelOf(khalil, lang)}</a></p>
    </div>
  </div>
</section>
<style>
  .sg-ar-grid { display:grid; grid-template-columns:minmax(260px,380px) 1fr; gap:24px; align-items:center; }
  .sg-ar-ring { width:100%; height:auto; max-width:380px; }
  .sg-ar-legend { list-style:none; padding:0; margin:0 0 1rem; display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:6px 16px; }
  .sg-ar-legend li { display:flex; gap:8px; align-items:baseline; }
  .sg-ar-dot { width:12px; height:12px; border-radius:50%; background:var(--hue); flex:none; transform:translateY(1px); }
  @media (max-width:720px) { .sg-ar-grid { grid-template-columns:1fr; } }
</style>
