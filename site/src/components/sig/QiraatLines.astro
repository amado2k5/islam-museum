---
// "The ruled page" (Qira'at, Rasm, Scripts and Dotting Browser home): seven ruled lines, one per topic, and on each
// line a dot for every section that holds records of that topic, its area in proportion to their number — the way a
// dotted line of a mushaf carries its marks. Every dot is a real link to that section's list below, so the view reads
// and works without JavaScript; a topic with no record keeps its bare line and says so. A record with two topics is
// counted on both lines. Everything is computed at build time from lib/qiraat.ts, and the build fails when the data
// holds a topic or section the page cannot name (docs/site/signature-views.md, rules 1-6).
import { ui, fmt, type Lang } from "../../lib/i18n";
import { num } from "../../lib/nav";
import { qiraatItems, QIRAAT_TOPICS, QIRAAT_SECTIONS } from "../../lib/qiraat";

interface Props { lang: Lang }
const { lang } = Astro.props;
const G = (ui(lang) as any).qiraat;
const V = G.viz;

const topicName = (t: string) => { const s = G.topics?.[t]; if (!s) throw new Error(`QiraatLines: topic ${t} has no name under qiraat.topics`); return s as string; };
const secName = (s: string) => { const t = G.sections?.[s]?.title; if (!t) throw new Error(`QiraatLines: section ${s} has no title`); return t as string; };
for (const i of qiraatItems) {
  for (const t of i.topics) if (!(QIRAAT_TOPICS as readonly string[]).includes(t)) throw new Error(`QiraatLines: ${i.node.id} carries unknown topic ${t}`);
  if (!(QIRAAT_SECTIONS as readonly string[]).includes(i.section)) throw new Error(`QiraatLines: ${i.node.id} sits in unknown section ${i.section}`);
}

const cols = QIRAAT_SECTIONS.filter((s) => qiraatItems.some((i) => i.section === s));
const rows = QIRAAT_TOPICS.map((t) => {
  const items = qiraatItems.filter((i) => i.topics.includes(t));
  return { t, total: items.length, cells: cols.map((s) => ({ s, n: items.filter((i) => i.section === s).length })) };
});
const untopiced = qiraatItems.filter((i) => i.topics.length === 0).length;
const max = Math.max(1, ...rows.flatMap((r) => r.cells.map((c) => c.n)));
// dot diameter in px: area in proportion to the count, never smaller than a target a finger can hit
const MIN = 12, MAX = 44;
const size = (n: number) => Math.round(MIN + (MAX - MIN) * Math.sqrt(n / max));
const home = `/${lang}/qiraat/`;
---
<section class="ql" aria-labelledby="ql-title" style="margin-top:2rem">
  <div data-pagefind-body>
    <h2 id="ql-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{V.lede}</p>
  </div>
  <div class="ql-scroll">
    <table class="ql-page ui">
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">{V.topic_col}</span></th>
          {cols.map((s) => <th scope="col"><a href={`${home}#t-${s}`}>{secName(s)}</a></th>)}
          <th scope="col">{V.total_col}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{topicName(r.t)}</th>
            {r.cells.map((c) => (
              <td>
                {c.n > 0
                  ? <a class={`ql-dot s-${c.s}`} href={`${home}#t-${c.s}`} style={`--d:${size(c.n)}px`} title={`${topicName(r.t)} · ${secName(c.s)}: ${num(c.n, lang)}`}
                      aria-label={`${topicName(r.t)} · ${secName(c.s)}: ${num(c.n, lang)}`}><span aria-hidden="true">{num(c.n, lang)}</span></a>
                  : <span class="ql-none" aria-hidden="true"></span>}
              </td>
            ))}
            <td class="ql-n">{r.total > 0 ? fmt(V.records, { n: num(r.total, lang) }) : V.empty_topic}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {untopiced > 0 && <p class="ui muted" style="margin:.6rem 0 0;font-size:.85rem">{fmt(V.untopiced, { n: num(untopiced, lang) })}</p>}
</section>
<style>
  .ql-scroll { overflow-x: auto; }
  .ql-page { border-collapse: collapse; min-width: 640px; width: 100%; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  .ql-page th, .ql-page td { padding: 6px 8px; text-align: center; vertical-align: middle; }
  .ql-page thead th { font-size: .78rem; font-weight: 600; border-bottom: 2px solid var(--gold, #c5a059); }
  .ql-page thead th a { color: inherit; text-decoration: none; }
  .ql-page thead th a:hover, .ql-page thead th a:focus-visible { text-decoration: underline; }
  .ql-page tbody th { text-align: start; font-size: .92rem; font-weight: 600; white-space: nowrap; }
  /* the ruled line each topic's dots sit on */
  .ql-page tbody td { height: 56px; background: linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat; }
  .ql-page tbody td.ql-n { background: none; text-align: end; font-size: .82rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ql-dot { display: inline-flex; align-items: center; justify-content: center; inline-size: var(--d); block-size: var(--d); min-inline-size: 24px; min-block-size: 24px; border-radius: 50%; color: #fff; font-size: .68rem; text-decoration: none; font-variant-numeric: tabular-nums; }
  .ql-dot:focus-visible { outline: 3px solid var(--gold, #c5a059); outline-offset: 2px; }
  .ql-dot:hover { filter: brightness(1.15); }
  .ql-none { display: inline-block; inline-size: 6px; block-size: 6px; }
  .s-quran { background: #8a6a1f; }
  .s-sunnah { background: #1f6470; }
  .s-seerah { background: #7a4a94; }
  .s-books { background: #3f6090; }
  .s-sciences { background: #9a4f38; }
  .s-people { background: #4d6b2f; }
  .s-scripts { background: #6b4a2a; }
  .s-works { background: #8a3a5a; }
  .s-mushafs { background: #2f5d4d; }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) { .ql-dot { transition: filter .15s; } }
</style>
