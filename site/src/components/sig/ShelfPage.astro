---
// The shared page of the ten class-driven browsers (scripts/shelves.ts): badge, lede, method
// note, section nav, filter box, then one section per kind of record, paged by site/src/lib/paged.
// Each browser's strings live in i18n/<lang>.yaml under its slug (title, lede, method_note and a
// title+desc per section); the boilerplate (badge, status, filter labels) is the shared `shelf`
// block. Reads are the shelfItems of site/src/lib/shelves.ts — the same array the whole-list
// filter index and the /api/v1/<slug>.json export draw from.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PagedNav from "../PagedNav.astro";
import FullFilter from "../FullFilter.astro";
import DraftMark from "../DraftMark.astro";
import { pagedStaticPaths, pageView, type PagedProps } from "../../lib/paged";
import { ui, fmt, type Lang } from "../../lib/i18n";
import { href, labelOf, stripNeedsSource } from "../../lib/graph";
import { num } from "../../lib/nav";
import { shelfItems, SHELVES } from "../../lib/shelves";
import type { Node } from "../../../../scripts/build-graph";

interface Props { lang: Lang; slug: string; pagedProps: PagedProps }
const { lang, slug, pagedProps } = Astro.props;
const spec = SHELVES[slug];
const items = shelfItems(slug);
const T = ui(lang);
const G = (T as any)[slug];
const S = (T as any).shelf;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) =>
  stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "")
    .replace(/\s*\{cite:[^}]*\}/g, "")
    .replace(/\s+([.,؛،])/g, "$1");
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const clean = summaryText(n).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const sections = spec.sections
  .map((id) => ({ id, items: items.filter((i) => i.section === id) }))
  .filter((s) => s.items.length > 0);
const paged = pageView(sections, pagedProps, `/${lang}/${slug}/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing
  ? G.title
  : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const status = fmt(S.status, { n: num(items.length, lang), s: num(sections.length, lang) });
const kindLabel = (n: Node) => G.kinds?.[String(n.data.kind ?? "")] ?? n.data.kind;
const searchText = (n: Node) =>
  [n.label.ar, n.label.en, n.label.ur, summaryText(n)].filter(Boolean).join(" ");
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{G.badge ?? S.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <h1>{G.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{G.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{S.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{S.api} <a href={`/api/v1/${slug}.json`}><bdi dir="ltr">/api/v1/{slug}.json</bdi></a></p>
    </div>

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{S.sections_title}</h2>
      <nav aria-label={S.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{pagedLabel(s)} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="shelf-filter">{S.filter_label}</label>
        <input id="shelf-filter" type="search" data-shelf-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <FullFilter lang={lang} slug={slug} />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-shelf-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{pagedLabel(s)}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-shelf-row data-search={searchText(i.node)} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {i.node.data.kind && <span class="chip" style="font-size:.75rem;padding:1px 8px;margin-inline-start:4px">{kindLabel(i.node)}</span>}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-shelf-none hidden>{S.filter_none}</p>
      {items.length === 0 && <p class="panel ui">{S.empty}</p>}
    </section>
  </div>
  <script src="../../scripts/shelf-filter.ts"></script>
</BaseLayout>
