---
// "The lines of sonship" (Bunuwwa Browser home): six ruled lines, one per filial topic —
// sons and daughters, offspring, filial piety, orphans and suckling, the child's rights, the
// named children of the stories — and on each line a disc for every corpus section that holds
// records of that topic, its area in proportion to their number, the way a lineage table
// carries its names. Every disc is a real link to that section's list below, so the view reads
// and works without JavaScript; a topic with no record keeps its bare line and says so. A
// record with two topics is counted on both lines. Everything is computed at build time from
// lib/bunuwwa.ts, and the build fails when the data holds a topic or section the page cannot
// name (docs/site/signature-views.md, rules 1-6).
import { ui, fmt, type Lang } from "../../lib/i18n";
import { num } from "../../lib/nav";
import { bunuwwaItems, BUNUWWA_TOPICS, BUNUWWA_SECTIONS } from "../../lib/bunuwwa";

interface Props { lang: Lang }
const { lang } = Astro.props;
const G = (ui(lang) as any).bunuwwa;
const V = G.viz;

const topicName = (t: string) => { const s = G.topics?.[t]; if (!s) throw new Error(`BunuwwaLines: topic ${t} has no name under bunuwwa.topics`); return s as string; };
const secName = (s: string) => { const t = G.sections?.[s]?.title; if (!t) throw new Error(`BunuwwaLines: section ${s} has no title`); return t as string; };
for (const i of bunuwwaItems) {
  for (const t of i.topics) if (!(BUNUWWA_TOPICS as readonly string[]).includes(t)) throw new Error(`BunuwwaLines: ${i.node.id} carries unknown topic ${t}`);
  if (!(BUNUWWA_SECTIONS as readonly string[]).includes(i.section)) throw new Error(`BunuwwaLines: ${i.node.id} sits in unknown section ${i.section}`);
}

const cols = BUNUWWA_SECTIONS.filter((s) => bunuwwaItems.some((i) => i.section === s));
const rows = BUNUWWA_TOPICS.map((t) => {
  const items = bunuwwaItems.filter((i) => i.topics.includes(t));
  return { t, total: items.length, cells: cols.map((s) => ({ s, n: items.filter((i) => i.section === s).length })) };
});
const untopiced = bunuwwaItems.filter((i) => i.topics.length === 0).length;
const max = Math.max(1, ...rows.flatMap((r) => r.cells.map((c) => c.n)));
// dot diameter in px: area in proportion to the count, never smaller than a target a finger can hit
const MIN = 12, MAX = 44;
const size = (n: number) => Math.round(MIN + (MAX - MIN) * Math.sqrt(n / max));
const home = `/${lang}/bunuwwa/`;
---
<section class="wl" aria-labelledby="wl-title" style="margin-top:2rem">
  <div data-pagefind-body>
    <h2 id="wl-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{V.lede}</p>
  </div>
  <div class="wl-scroll">
    <table class="wl-page ui">
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">{V.topic_col}</span></th>
          {cols.map((s) => <th scope="col"><a href={`${home}#t-${s}`}>{secName(s)}</a></th>)}
          <th scope="col">{V.total_col}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{topicName(r.t)}</th>
            {r.cells.map((c) => (
              <td>
                {c.n > 0
                  ? <a class={`wl-dot s-${c.s}`} href={`${home}#t-${c.s}`} style={`--d:${size(c.n)}px`} title={`${topicName(r.t)} · ${secName(c.s)}: ${num(c.n, lang)}`}
                      aria-label={`${topicName(r.t)} · ${secName(c.s)}: ${num(c.n, lang)}`}><span aria-hidden="true">{num(c.n, lang)}</span></a>
                  : <span class="wl-none" aria-hidden="true"></span>}
              </td>
            ))}
            <td class="wl-n">{r.total > 0 ? fmt(V.records, { n: num(r.total, lang) }) : V.empty_topic}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {untopiced > 0 && <p class="ui muted" style="margin:.6rem 0 0;font-size:.85rem">{fmt(V.untopiced, { n: num(untopiced, lang) })}</p>}
</section>
<style>
  .wl-scroll { overflow-x: auto; }
  .wl-page { border-collapse: collapse; min-width: 860px; width: 100%; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  .wl-page th, .wl-page td { padding: 6px 8px; text-align: center; vertical-align: middle; }
  .wl-page thead th { font-size: .78rem; font-weight: 600; border-bottom: 2px solid var(--gold, #c5a059); }
  .wl-page thead th a { color: inherit; text-decoration: none; }
  .wl-page thead th a:hover, .wl-page thead th a:focus-visible { text-decoration: underline; }
  .wl-page tbody th { text-align: start; font-size: .92rem; font-weight: 600; white-space: nowrap; }
  /* the ruled line each topic's dots sit on */
  .wl-page tbody td { height: 56px; background: linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat; }
  .wl-page tbody td.wl-n { background: none; text-align: end; font-size: .82rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wl-dot { display: inline-flex; align-items: center; justify-content: center; inline-size: var(--d); block-size: var(--d); min-inline-size: 24px; min-block-size: 24px; border-radius: 50%; color: #fff; font-size: .68rem; text-decoration: none; font-variant-numeric: tabular-nums; }
  .wl-dot:focus-visible { outline: 3px solid var(--gold, #c5a059); outline-offset: 2px; }
  .wl-dot:hover { filter: brightness(1.15); }
  .wl-none { display: inline-block; inline-size: 6px; block-size: 6px; }
  .s-quran { background: #8a6a1f; }
  .s-sunnah { background: #1f6470; }
  .s-seerah { background: #7a4a94; }
  .s-books { background: #3f6090; }
  .s-curated { background: #2f6b4f; }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) { .wl-dot { transition: filter .15s; } }
</style>
