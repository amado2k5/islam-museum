---
// "The map of the makharij" (Tajwid and Tilawah Browser home): the seventeen points of articulation
// laid out as the breath travels them — from the empty space of the throat and mouth where the madd
// letters rise, through the three stations of the throat and the back, middle and tip of the tongue,
// to the lips and the nasal passage — as Ibn al-Jazari counts them in the Jazariyya. Each station is
// a stop on one line of breath; its letters sit on it in discs of the region's colour. Inside the
// band stand the counts the page computes from the graph. The view links to the Jazariyya and to Ibn
// al-Jazari; both are read from the graph at build time and the build throws when one is missing.
// Plain SVG and text: no script is needed.
import { ui, fmt } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";
import { href, labelOf, byId } from "../../lib/graph";
import { num } from "../../lib/nav";
import { MAKHRAJ_REGIONS, tajwidItems } from "../../lib/tajwid";

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (ui(lang) as any).tajwid;
const V = T.map;
const node = (id: string) => {
  const n = byId.get(id);
  if (!n || n.stub) throw new Error(`TajwidMap: ${id} is not in the graph`);
  return n;
};
const jazariyya = node("work/al-jazariyya");
const jazari = node("person/ibn-al-jazari");
const W = 1160, H = 300, Y = 128;
const x = (at: number) => 40 + (W - 80) * (1 - at); // breath travels right-to-left: deepest at the right
const stations = MAKHRAJ_REGIONS.map((r) => ({ ...r, x: x(r.at) }));
const wave = (at: number) => Y + Math.sin(at * Math.PI * 2.6) * 30;
const total = MAKHRAJ_REGIONS.length;
if (total !== 13) throw new Error(`TajwidMap: expected the 13 stations of the 17 makharij, found ${total}`);
const counts = {
  verses: tajwidItems.filter((i) => i.node.class === "passage" && i.section === "quran").length,
  passages: tajwidItems.filter((i) => i.node.class === "passage" && i.section !== "quran").length,
  records: tajwidItems.filter((i) => i.node.class !== "passage").length,
};
// the breath line: a smooth path through every station
const path = `M ${stations.map((s) => `${s.x.toFixed(1)} ${wave(s.at).toFixed(1)}`).join(" L ")}`;
const letters = MAKHRAJ_REGIONS.flatMap((r, ri) =>
  r.letters.split(" ").map((ch, ci) => ({ ch, hue: r.hue, x: x(r.at), y: wave(r.at) - 42 - (ci % 4) * 26 - Math.floor(ci / 4) * 0 })),
);
---
<section aria-labelledby="sg-tj-title" class="sg-tj" style="margin-top:1.6rem">
  <div data-pagefind-body>
    <h2 id="sg-tj-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure)">{V.note}</p>
    <p class="ui muted" style="max-width:var(--measure)">{fmt(V.counts, { v: num(counts.verses, lang), p: num(counts.passages, lang), r: num(counts.records, lang) })}</p>
  </div>
  <div class="sg-tj-scroll" data-pagefind-ignore>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={V.aria} class="sg-tj-map">
      <path d={path} fill="none" stroke="var(--line)" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />
      <path d={path} fill="none" stroke="#3d6b6b" stroke-width="3" stroke-dasharray="1 10" stroke-linecap="round" />
      {stations.map((s) => (
        <g>
          <circle cx={s.x} cy={wave(s.at)} r="9" fill={s.hue} stroke="var(--card)" stroke-width="2.5" />
          <text x={s.x} y={wave(s.at) + (s.at > 0.45 && s.at < 0.75 ? 46 : 38)} text-anchor="middle" font-size="13" fill="var(--fg)" lang="ar" dir="rtl">{s.makhraj}</text>
        </g>
      ))}
      {letters.map((m) => (
        <g>
          <circle cx={m.x} cy={m.y} r="11.5" fill="var(--card)" stroke={m.hue} stroke-width="1.8" />
          <text x={m.x} y={m.y + 1} text-anchor="middle" dominant-baseline="central" font-size="14" fill="var(--fg)" lang="ar">{m.ch}</text>
        </g>
      ))}
      <g>
        <rect x={W / 2 - 150} y={H - 56} width="300" height="40" rx="10" fill="var(--panel)" stroke="var(--line)" />
        <text x={W / 2} y={H - 32} text-anchor="middle" font-size="15" fill="var(--fg)">
          <a href={href(lang, jazariyya.id)}><tspan>{labelOf(jazariyya, lang)}</tspan></a>
          <tspan> · </tspan>
          <a href={href(lang, jazari.id)}><tspan>{labelOf(jazari, lang)}</tspan></a>
        </text>
      </g>
    </svg>
  </div>
  <ol role="list" class="sg-tj-stations" data-pagefind-ignore>
    {stations.map((s) => (
      <li style={`--m:${s.hue}`}>
        <span class="ui sg-tj-makhraj" lang="ar" dir="rtl">{s.makhraj}</span>
        <strong class="sg-tj-letters" lang="ar" dir="rtl">{s.letters}</strong>
        <span class="muted">{(s.desc as any)[lang] ?? s.desc.en}</span>
      </li>
    ))}
  </ol>
</section>
<style>
  .sg-tj-scroll { overflow-x: auto; margin: .6rem 0 1.2rem; }
  .sg-tj-map { min-width: 900px; width: 100%; height: auto; display: block; }
  .sg-tj-map a { fill: var(--link, #2a7b88); text-decoration: none; }
  .sg-tj-stations { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .sg-tj-stations li { display: grid; gap: 2px; align-content: start; padding: 12px 14px; border-radius: 10px; background: var(--panel); border: 1px solid var(--line); border-block-start: 3px solid var(--m); }
  .sg-tj-makhraj { font-size: .8rem; color: var(--m); font-weight: 700; }
  .sg-tj-letters { font-size: 1.35rem; font-family: "Reem Kufi", "Amiri", var(--ar-display), serif; font-weight: 500; line-height: 1.6; }
  .sg-tj-stations .muted { font-size: .85rem; line-height: 1.6; }
</style>
