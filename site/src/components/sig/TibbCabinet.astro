---
// "The apothecary's cabinet" — the signature view of the Medicine Browser (site/src/pages/[lang]/tibb).
// A cabinet of drawers drawn at build time from the browser's own list (`tibbCabinet` in site/src/lib/tibb.ts): a row for
// each of the six topics of the browser's title (prophetic medicine, medicine, anatomy, surgery, drugs, treatment), a
// drawer for each place the texts come from (the Qur'an, the Sunnah, the seerah, the other books, the museum's own
// records). A drawer's number is the count of records of that topic in that section, and its bar is that count against
// the largest drawer; every drawer is a real link to its section of the list below, so the view reads without scripts.
// The build throws when the drawers do not add up to the list. Abstract geometry only.
import { ui, type Lang } from "../../lib/i18n";
import { num } from "../../lib/nav";
import { tibbCabinet, tibbItems, TIBB_SECTIONS } from "../../lib/tibb";

interface Props { lang: Lang; home: string }
const { lang, home } = Astro.props;
const G = (ui(lang) as any).tibb;
const V = G.viz;

const drawn = tibbCabinet.reduce((a, r) => a + r.total, 0);
const expected = tibbItems.reduce((a, i) => a + i.topics.length, 0);
if (drawn !== expected) throw new Error(`Medicine cabinet: ${drawn} drawer entries drawn, the list holds ${expected}`);
const untopiced = tibbItems.filter((i) => i.topics.length === 0).length;
const max = Math.max(1, ...tibbCabinet.flatMap((r) => TIBB_SECTIONS.map((s) => r.cells[s])));
---
<figure class="tibb-cab" aria-labelledby="tibb-cab-title" data-pagefind-ignore>
  <figcaption id="tibb-cab-title" class="ui"><strong>{V.title}</strong> <span class="muted">{V.caption}</span></figcaption>
  <div class="tibb-cab-scroll">
    <table class="ui">
      <thead>
        <tr><td></td>{TIBB_SECTIONS.map((s) => <th scope="col">{G.sections[s].title}</th>)}</tr>
      </thead>
      <tbody>
        {tibbCabinet.map((r) => (
          <tr>
            <th scope="row">{G.topics[r.topic]} <span class="muted">· {num(r.total, lang)}</span></th>
            {TIBB_SECTIONS.map((s) => (
              <td>
                {r.cells[s] > 0
                  ? <a class="drawer" href={`${home}#t-${s}`} aria-label={`${G.topics[r.topic]} — ${G.sections[s].title}: ${num(r.cells[s], lang)}`}>
                      <span class="knob" aria-hidden="true"></span>
                      <span class="n">{num(r.cells[s], lang)}</span>
                      <span class="bar" aria-hidden="true" style={`inline-size:${Math.max(6, Math.round((r.cells[s] / max) * 100))}%`}></span>
                    </a>
                  : <span class="drawer empty" aria-label={`${G.topics[r.topic]} — ${G.sections[s].title}: ${num(0, lang)}`}><span class="n muted">—</span></span>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {untopiced > 0 && <p class="ui muted" style="margin:.4rem 0 0">{V.untopiced.replace("{n}", num(untopiced, lang))}</p>}
</figure>
<style>
  .tibb-cab { margin: 1.6rem 0 0; }
  .tibb-cab figcaption { margin: 0 0 .6rem; }
  .tibb-cab-scroll { overflow-x: auto; }
  .tibb-cab table { border-collapse: separate; border-spacing: 6px; min-inline-size: 620px; inline-size: 100%; }
  .tibb-cab th { font-weight: 600; text-align: start; font-size: .9rem; padding: 2px 4px; white-space: nowrap; }
  .tibb-cab thead th { text-align: center; font-size: .82rem; }
  .tibb-cab td { padding: 0; }
  .tibb-cab .drawer { position: relative; display: flex; align-items: center; justify-content: center; gap: 8px; min-block-size: 44px; padding: 6px 10px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--fg); text-decoration: none; overflow: hidden; }
  .tibb-cab a.drawer:hover, .tibb-cab a.drawer:focus-visible { border-color: var(--gold); outline: 2px solid var(--gold); outline-offset: 1px; }
  .tibb-cab .drawer.empty { background: transparent; border-style: dashed; }
  .tibb-cab .knob { inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--gold); flex: none; }
  .tibb-cab .n { font-variant-numeric: tabular-nums; font-weight: 600; }
  .tibb-cab .bar { position: absolute; inset-block-end: 0; inset-inline-start: 0; block-size: 4px; background: var(--gold); opacity: .7; }
</style>
