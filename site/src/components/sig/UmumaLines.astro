---
// "The six lines of motherhood" (Motherhood in Islam Browser home): six ruled lines, one per
// topic — the mother and her standing, pregnancy, childbirth, nursing, custody and raising,
// dutifulness to parents — and on each line a disc for every corpus section that holds records
// of that topic, its area in proportion to their number. Every disc is a real link to that
// section's list below, so the view reads and works without JavaScript; a topic with no record
// keeps its bare line and says so. A passage with two topics is counted on both lines.
// Everything is computed at build time from lib/umuma.ts, and the build fails when the data
// holds a topic or section the page cannot name (docs/site/signature-views.md, rules 1-6).
import { ui, fmt, type Lang } from "../../lib/i18n";
import { num } from "../../lib/nav";
import { umumaItems, UMUMA_SECTIONS, type UmumaTopic } from "../../lib/umuma";

interface Props { lang: Lang }
const { lang } = Astro.props;
const G = (ui(lang) as any).umuma;
const V = G.viz;

const UMUMA_TOPICS: UmumaTopic[] = ["umm", "haml", "wilada", "radaa", "tarbiya", "birr"];

const topicName = (t: string) => { const s = G.topics?.[t]; if (!s) throw new Error(`UmumaLines: topic ${t} has no name under umuma.topics`); return s as string; };
const secName = (s: string) => { const t = G.sections?.[s]?.title; if (!t) throw new Error(`UmumaLines: section ${s} has no title`); return t as string; };
for (const i of umumaItems) {
  for (const t of i.topics) if (!(UMUMA_TOPICS as readonly string[]).includes(t)) throw new Error(`UmumaLines: ${i.node.id} carries unknown topic ${t}`);
  if (!(UMUMA_SECTIONS as readonly string[]).includes(i.section)) throw new Error(`UmumaLines: ${i.node.id} sits in unknown section ${i.section}`);
}

const cols = UMUMA_SECTIONS.filter((s) => umumaItems.some((i) => i.section === s));
const rows = UMUMA_TOPICS.map((t) => {
  const items = umumaItems.filter((i) => i.topics.includes(t));
  return { t, total: items.length, cells: cols.map((s) => ({ s, n: items.filter((i) => i.section === s).length })) };
});
const untopiced = umumaItems.filter((i) => i.topics.length === 0).length;
const max = Math.max(1, ...rows.flatMap((r) => r.cells.map((c) => c.n)));
// disc diameter in px: area in proportion to the count, never smaller than a target a finger can hit
const MIN = 12, MAX = 44;
const size = (n: number) => Math.round(MIN + (MAX - MIN) * Math.sqrt(n / max));
const home = `/${lang}/umuma/`;
---
<section class="ul" aria-labelledby="ul-title" style="margin-top:2rem">
  <div data-pagefind-body>
    <h2 id="ul-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{V.lede}</p>
  </div>
  <div class="ul-scroll">
    <table class="ul-page ui">
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">{V.topic_col}</span></th>
          {cols.map((s) => <th scope="col"><a href={`${home}#t-${s}`}>{secName(s)}</a></th>)}
          <th scope="col">{V.total_col}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{topicName(r.t)}</th>
            {r.cells.map((c) => (
              <td>
                {c.n > 0
                  ? <a class={`ul-dot s-${c.s}`} href={`${home}#t-${c.s}`} style={`--d:${size(c.n)}px`} title={`${topicName(r.t)} · ${secName(c.s)}: ${num(c.n, lang)}`}
                      aria-label={`${topicName(r.t)} · ${secName(c.s)}: ${num(c.n, lang)}`}><span aria-hidden="true">{num(c.n, lang)}</span></a>
                  : <span class="ul-none" aria-hidden="true"></span>}
              </td>
            ))}
            <td class="ul-n">{r.total > 0 ? fmt(V.records, { n: num(r.total, lang) }) : V.empty_topic}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {untopiced > 0 && <p class="ui muted" style="margin:.6rem 0 0;font-size:.85rem">{fmt(V.untopiced, { n: num(untopiced, lang) })}</p>}
</section>
<style>
  .ul-scroll { overflow-x: auto; }
  .ul-page { border-collapse: collapse; min-width: 760px; width: 100%; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  .ul-page th, .ul-page td { padding: 6px 8px; text-align: center; vertical-align: middle; }
  .ul-page thead th { font-size: .78rem; font-weight: 600; border-bottom: 2px solid var(--gold, #c5a059); }
  .ul-page thead th a { color: inherit; text-decoration: none; }
  .ul-page thead th a:hover, .ul-page thead th a:focus-visible { text-decoration: underline; }
  .ul-page tbody th { text-align: start; font-size: .92rem; font-weight: 600; white-space: nowrap; }
  /* the ruled line each topic's discs sit on */
  .ul-page tbody td { height: 56px; background: linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat; }
  .ul-page tbody td.ul-n { background: none; text-align: end; font-size: .82rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ul-dot { display: inline-flex; align-items: center; justify-content: center; inline-size: var(--d); block-size: var(--d); min-inline-size: 24px; min-block-size: 24px; border-radius: 50%; color: #fff; font-size: .68rem; text-decoration: none; font-variant-numeric: tabular-nums; }
  .ul-dot:focus-visible { outline: 3px solid var(--gold, #c5a059); outline-offset: 2px; }
  .ul-dot:hover { filter: brightness(1.15); }
  .ul-none { display: inline-block; inline-size: 6px; block-size: 6px; }
  .s-quran { background: #8a6a1f; }
  .s-sunnah { background: #1f6470; }
  .s-seerah { background: #7a4a94; }
  .s-books { background: #3f6090; }
  .s-curated { background: #9a4f68; }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) { .ul-dot { transition: filter .15s; } }
</style>
