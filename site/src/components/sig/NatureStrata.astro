---
// "Six habitats" (Nature Explorer home): a cross-section of the world. Six horizontal strata, the sky at the top and the
// sea at the bottom; in each stratum every concept of that section is a hexagonal token, sized by the number of Qur'an
// ayahs and hadith passages that mention it (the `mentioned_in` links of lib/nature.ts passagesOf), square-root scaled
// on one scale for all six bands. Tokens are placed in order of size by ordinary wrapping, so the band's height follows
// its content. Everything is computed from the graph at build time; each token is a real link, so the drawing works
// without JavaScript. The script (site/src/scripts/sig-nature.ts) adds the read-out panel.
import { ui, fmt, type Lang } from "../../lib/i18n";
import { labelOf, summaryOf } from "../../lib/graph";
import { num } from "../../lib/nav";
import { natureItems, NATURE_SECTIONS, passagesOf } from "../../lib/nature";

interface Props { lang: Lang }
const { lang } = Astro.props;
const N = (ui(lang) as any).nature;
const V = N.viz;

/** The vertical order of the world, from the heavens down to the sea. The build fails when a section is missing or new. */
const NATURE_STRATA = ["cosmos", "bird", "land", "plant", "insect", "sea"];
const inData = [...new Set(natureItems.map((i) => i.section))];
if ([...NATURE_STRATA].sort().join() !== [...NATURE_SECTIONS].sort().join() || inData.some((s) => !NATURE_STRATA.includes(s)))
  throw new Error(`NatureStrata: the strata (${NATURE_STRATA}) do not match the sections (${NATURE_SECTIONS}; in data: ${inData})`);

const short = (n: any) => labelOf(n, lang).replace(/\s*⁦?\(.*$/, "").trim();
const first = (s: string) => {
  const t = s.replace(/\s+/g, " ").trim();
  const m = t.match(/^.*?[.!؟?۔](?=\s|$)/);
  let out = m ? m[0] : t;
  if (out.length > 120) out = out.slice(0, 120).replace(/\s+\S*$/, "") + "…";
  return out;
};
const f = (n: number) => Math.round(n * 10) / 10;

const rows = natureItems.map((i) => {
  const p = passagesOf(i.node.id);
  return { i, q: p.quran.length, h: p.hadith.length, n: p.quran.length + p.hadith.length };
});
const maxN = Math.max(1, ...rows.map((r) => r.n));
const D_MIN = 34, D_MAX = 82;
const diam = (n: number) => (n === 0 ? D_MIN - 6 : D_MIN + (D_MAX - D_MIN) * Math.sqrt(n / maxN));
const bands = NATURE_STRATA.map((id) => {
  const items = rows
    .filter((r) => r.i.section === id)
    .sort((a, b) => b.n - a.n || short(a.i.node).localeCompare(short(b.i.node), lang));
  return { id, items, total: items.reduce((t, r) => t + r.n, 0) };
});
const unlinked = rows.filter((r) => r.n === 0).length;
const sectionTitle = (id: string) => N.sections[id]?.title ?? id;
const slugOf = (id: string) => id.split("/")[1];
---
<section aria-labelledby="nature-strata-title" class="sg-n" data-sg-n style="margin-top:1.6rem"
  data-t-q={V.q} data-t-h={V.h} data-t-open={V.open}>
  <div data-pagefind-body>
    <h2 id="nature-strata-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{fmt(V.caption, { n: num(natureItems.length, lang), z: num(unlinked, lang) })}</p>
  </div>
  <div class="sg-n-world" role="group" aria-label={V.region}>
    {bands.map((b) => (
      <div class={`sg-n-band sg-n-b-${b.id}`} data-sec={b.id}>
        <p class="sg-n-hd ui">
          <a href={`#t-${b.id}`}>{sectionTitle(b.id)}</a>
          <span class="muted">{num(b.items.length, lang)}</span>
        </p>
        <ul class="sg-n-tokens" role="list">
          {b.items.map((r) => (
            <li>
              <a class={`sg-n-t${r.n === 0 ? " zero" : ""}`} href={`/${lang}/nature/${slugOf(r.i.node.id)}/`}
                style={`--d:${f(diam(r.n))}px`} data-q={String(r.q)} data-h={String(r.h)} data-s={first(summaryOf(r.i.node, lang))}>
                <i class="sg-n-hex" aria-hidden="true"><b>{r.n > 0 ? num(r.n, lang) : ""}</b></i>
                <span class="sg-n-nm">{short(r.i.node)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="sg-n-panel panel ui" data-sg-npanel aria-live="polite" hidden>
    <p class="muted sg-n-hint" data-sg-nhint>{V.hint}</p>
    <div data-sg-nbody></div>
  </div>
</section>
<style is:inline>
  .sg-n { --tex: color-mix(in srgb, var(--fg) 20%, transparent); }
  .sg-n-world { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--card); }
  .sg-n-band { position: relative; padding: 10px 14px 18px; border-block-end: 1px solid var(--line); }
  .sg-n-band:last-child { border-block-end: 0; }
  .sg-n-hd { position: relative; display: flex; align-items: baseline; gap: 10px; margin: 0 0 6px; font-size: .95rem; }
  .sg-n-hd a { font-weight: 700; color: var(--fg); min-block-size: 24px; display: inline-flex; align-items: center; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .sg-n-hd a:hover { color: var(--gold-text); }
  .sg-n-hd a:focus-visible, .sg-n-t:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 6px; }
  .sg-n-tokens { position: relative; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: 12px 8px; }
  /* the textures are plain gradients: stars, wind, strata, stems, grain, swell */
  .sg-n-b-cosmos { background-color: color-mix(in srgb, var(--link) 16%, var(--card));
    background-image: radial-gradient(circle, var(--tex) 1px, transparent 1.6px), radial-gradient(circle, var(--tex) .8px, transparent 1.3px);
    background-size: 46px 46px, 29px 29px; background-position: 0 0, 14px 20px; }
  .sg-n-b-bird { background-color: color-mix(in srgb, var(--link) 8%, var(--card));
    background-image: repeating-linear-gradient(168deg, transparent 0 21px, var(--tex) 21px 22px); }
  .sg-n-b-land { background-color: color-mix(in srgb, var(--gold) 14%, var(--card));
    background-image: repeating-linear-gradient(0deg, transparent 0 17px, var(--tex) 17px 18px), radial-gradient(circle, var(--tex) 1px, transparent 1.5px);
    background-size: auto, 23px 23px; }
  .sg-n-b-plant { background-color: color-mix(in srgb, var(--link) 12%, var(--card));
    background-image: repeating-linear-gradient(90deg, transparent 0 15px, var(--tex) 15px 16px), repeating-linear-gradient(90deg, transparent 0 41px, var(--tex) 41px 43px); }
  .sg-n-b-insect { background-color: color-mix(in srgb, var(--gold) 9%, var(--card));
    background-image: radial-gradient(circle, var(--tex) 1.4px, transparent 2px); background-size: 15px 15px; }
  .sg-n-b-sea { background-color: color-mix(in srgb, var(--link) 22%, var(--card));
    background-image: repeating-radial-gradient(ellipse 60px 22px at 50% 0, transparent 0 14px, var(--tex) 14px 15px); background-size: 120px 44px; }
  .sg-n-tokens li { display: block; }
  .sg-n-t { display: flex; flex-direction: column; align-items: center; inline-size: max(var(--d), 80px); text-decoration: none; color: var(--fg); text-align: center; }
  .sg-n-hex { display: grid; place-items: center; inline-size: var(--d); block-size: var(--d); background: var(--gold); color: #0a2533;
    clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0 50%); transition: transform .15s ease; }
  .sg-n-hex b { font-weight: 700; font-size: .78rem; line-height: 1; }
  .sg-n-t.zero .sg-n-hex { background: color-mix(in srgb, var(--gold) 38%, var(--card)); }
  .sg-n-nm { margin-block-start: 4px; font-size: .8rem; line-height: 1.25; max-inline-size: 100%; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; background: color-mix(in srgb, var(--card) 70%, transparent); border-radius: 4px; padding-inline: 2px; }
  .sg-n-t:hover .sg-n-hex, .sg-n-t:focus-visible .sg-n-hex, .sg-n-t[aria-current="true"] .sg-n-hex { transform: scale(1.14); }
  .sg-n-t:hover .sg-n-nm, .sg-n-t:focus-visible .sg-n-nm, .sg-n-t[aria-current="true"] .sg-n-nm { text-decoration: underline; color: var(--gold-text); }
  .sg-n-t[aria-current="true"] .sg-n-hex { box-shadow: none; filter: drop-shadow(0 0 0 var(--fg)); background: var(--fg); color: var(--card); }
  .sg-n-panel { position: sticky; inset-block-end: 8px; z-index: 3; margin-block: .8rem 0; border: 1px solid var(--gold); padding: 10px 16px; min-block-size: 4.2rem; box-shadow: 0 4px 18px color-mix(in srgb, var(--fg) 18%, transparent); }
  .sg-n-panel h3 { margin: 0; font-size: 1.05rem; }
  .sg-n-panel p { margin: .2rem 0 0; }
  .sg-n-panel .sg-n-sub { color: var(--muted); font-size: .86rem; }
  .sg-n-panel a { display: inline-block; min-block-size: 24px; }
  .sg-n-panel a:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  @media (max-width: 640px) {
    .sg-n-band { padding-inline: 8px; }
    .sg-n-tokens { gap: 10px 4px; }
    .sg-n-t { inline-size: max(var(--d), 72px); }
    .sg-n-panel { inset-block-end: 4px; }
  }
  @media (prefers-reduced-motion: reduce) { .sg-n-hex { transition: none !important; } }
</style>
<script src="../../scripts/sig-nature.ts"></script>
