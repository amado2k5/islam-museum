// "Where the occasions stand" (Nuzul Browser home): the sky line at top, and under it
// the 114 surahs in Mushaf order — every surah whose verses have an occasion report
// here receives a gold beam descending from the line, as wide as that surah's share
// of the records. The narrator counters (prophetic, companion, tabi'i, later) act as
// toggles that colour each beam by that generation only. Everything is computed here
// from `nuzulItems` (site/src/lib/nuzul.ts); each beam is a real link, and records
// with no surah number stay in the count below. The script
// (site/src/scripts/sig-nuzul.ts) adds the readout and the toggles.
import { ui, fmt, type Lang } from "../../lib/i18n";
import { href, labelOf } from "../../lib/graph";
import { num } from "../../lib/nav";
import { nuzulItems } from "../../lib/nuzul";
import { quranSurahs, surahName } from "../../lib/sig-quran";

interface Props { lang: Lang }
const { lang } = Astro.props;
const G = (ui(lang) as any).nuzul;
const V = G.viz;
const GENS = ["prophetic", "companion", "tabii", "later"] as const;

// ---- the build fails when the graph no longer matches what the descent assumes
if (quranSurahs.length !== 114 || quranSurahs.some((s, i) => s.data.sura !== i + 1)) throw new Error("NuzulDescent: the surah records are not suras 1..114");
for (const k of GENS) if (!G.narrators?.[k]) throw new Error(`NuzulDescent: nuzul.narrators has no ${k}`);

/** The surah an occasion record speaks of: its own `sura` field when 1..114. */
const suraOf = (n: any): number | null => {
  const s = Number(n.data.sura);
  return Number.isInteger(s) && s >= 1 && 114 >= s ? s : null;
};

const onSky = nuzulItems.filter((i) => suraOf(i.node) !== null);
const elsewhere = nuzulItems.length - onSky.length;

const short = (n: any) => labelOf(n, lang).replace(/\s*\u2066?\(.*$/, "").replace(/\s+[—–]\s+.*$/, "").trim();
const genCounts = (list: typeof nuzulItems) => GENS.map((k) => list.filter((i) => i.narrator === k).length);

interface Beam { key: string; name: string; label: string; items: typeof nuzulItems; k: number[]; href: string }
const bySura = new Map<number, typeof nuzulItems>();
for (const i of onSky) { const s = suraOf(i.node)!; bySura.set(s, [...(bySura.get(s) ?? []), i]); }
const surahs: Beam[] = quranSurahs.map((s) => {
  const n = s.data.sura as number;
  const items = (bySura.get(n) ?? []).sort((a, b) => Number(a.node.data.aya) - Number(b.node.data.aya) || a.node.id.localeCompare(b.node.id));
  return { key: String(n), name: surahName(s, lang), label: num(n, lang), items, k: genCounts(items), href: items.length ? href(lang, items[0].node.id) : "" };
});

const maxS = Math.max(1, ...surahs.map((s) => s.items.length));
const surahsNamed = surahs.filter((s) => s.items.length > 0).length;
const totals = GENS.map((_, j) => nuzulItems.reduce((t, i) => t + (i.narrator === GENS[j] ? 1 : 0), 0));

// the readout reads this: one entry per linked beam, [title, count text, [[label, href], ...up to three]]
const info: Record<string, [string, string, [string, string][]]> = {};
const beamId = (s: Beam) => `s${s.key.replace(/\W/g, "")}`;
for (const s of surahs) if (s.items.length)
  info[beamId(s)] = [`${s.label} · ${s.name}`, fmt(V.count_in, { n: num(s.items.length, lang) }),
    s.items.slice(0, 3).map((i) => [short(i.node), href(lang, i.node.id)] as [string, string])];

const beamAria = (s: Beam) => `${s.label} · ${s.name} · ${fmt(V.count_in, { n: num(s.items.length, lang) })}`;
---
<section aria-labelledby="sg-nz-title" class="sg-nz" data-sg-nz style="margin-top:1.8rem">
  <div data-pagefind-body>
    <h2 id="sg-nz-title">{V.title}</h2>
    <p class="muted" style="max-width:var(--measure);margin:0 0 1rem">{fmt(V.caption, { n: num(onSky.length, lang), e: num(elsewhere, lang) })}</p>
  </div>
  <p class="ui muted sg-nz-how" id="sg-nz-how">{V.how}</p>
  <div class="sg-nz-counters ui" role="group" aria-labelledby="sg-nz-how">
    {GENS.map((k, j) => (
      <button type="button" class="sg-nz-c" data-gen={j} aria-pressed="false" disabled>
        <strong>{num(totals[j], lang)}</strong><span>{G.narrators[k]}</span>
      </button>
    ))}
  </div>
  <div class="sg-nz-readout ui panel" data-sg-readout aria-live="polite" hidden>
    <p class="muted sg-nz-hint" data-sg-hint>{V.hint}</p>
    <div data-sg-detail hidden>
      <p class="sg-nz-rn"><strong data-f="name"></strong> <span class="muted" data-f="count"></span></p>
      <ul class="sg-nz-rl" data-f="list"></ul>
    </div>
  </div>
  <h3 class="sg-nz-shelf-t">{V.sky_title}</h3>
  <p class="muted ui sg-nz-shelf-n">{fmt(V.sky_note, { n: num(surahsNamed, lang), total: num(114, lang) })}</p>
  <div class="sg-nz-sky" aria-hidden="true"><span class="sg-nz-skyline"></span></div>
  <ol class="sg-nz-shelf" role="list" aria-label={V.sky_title} style={`--max:${maxS}`}>
    {surahs.map((s) => s.items.length ? (
      <li><a class="sg-nz-s" href={s.href} data-id={beamId(s)} data-k={s.k.join(",")} data-t={s.items.length} aria-label={beamAria(s)} style={`--f:${(s.items.length / maxS).toFixed(3)}`}><span class="z"><i></i></span><b aria-hidden="true">{s.label}</b></a></li>
    ) : (
      <li aria-hidden="true"><span class="sg-nz-s e"><span class="z"><i class="e"></i></span><b>{s.label}</b></span></li>
    ))}
  </ol>
  <script type="application/json" data-sg-json set:html={JSON.stringify(info).replace(/</g, "\\u003c")}></script>
</section>
<style is:inline>
  .sg-nz { --hz: 88px; }
  @media (max-width: 640px) { .sg-nz { --hz: 64px; } }
  .sg-nz-how { margin: 0 0 .5rem; font-size: .9rem; }
  .sg-nz-counters { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; margin: 0 0 1rem; }
  .sg-nz-c { text-align: start; font: inherit; color: var(--fg); background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 12px 16px; display: grid; gap: 2px; cursor: pointer; min-block-size: 44px; }
  .sg-nz-c:disabled { cursor: default; color: var(--fg); opacity: 1; }
  .sg-nz-c strong { font-size: 2.4rem; line-height: 1.05; color: var(--gold-text); }
  .sg-nz-c span { font-size: .92rem; line-height: 1.4; }
  .sg-nz-c[aria-pressed="true"] { background: var(--gold); border-color: var(--gold-text); color: #0a2533; }
  .sg-nz-c[aria-pressed="true"] strong { color: #0a2533; }
  .sg-nz-c:focus-visible, .sg-nz-s:focus-visible, .sg-nz-readout a:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .sg-nz-readout { border: 1px solid var(--gold); block-size: 12.5rem; overflow-y: auto; padding: 12px 16px; margin-block-end: 1.2rem; }
  .sg-nz-readout p { margin: .2rem 0; }
  .sg-nz-rn { font-size: 1.15rem; }
  .sg-nz-rl { list-style: none; margin: .4rem 0 0; padding: 0; display: grid; gap: 2px; }
  .sg-nz-rl a { display: inline-flex; align-items: center; min-block-size: 32px; }
  .sg-nz-shelf-t { margin: 1.4rem 0 .1rem; font-size: 1.1rem; }
  .sg-nz-shelf-n { margin: 0 0 .4rem; font-size: .88rem; }
  .sg-nz-sky { margin: 0; padding-block-start: .4rem; }
  .sg-nz-skyline { display: block; block-size: 10px; border-radius: 8px; background: linear-gradient(90deg, color-mix(in srgb, var(--lapis) 30%, transparent), color-mix(in srgb, var(--lapis) 70%, var(--gold)) 50%, color-mix(in srgb, var(--lapis) 30%, transparent)); box-shadow: 0 0 14px color-mix(in srgb, var(--gold) 45%, transparent); }
  .sg-nz-shelf { list-style: none; margin: 0; padding: 0; display: grid; row-gap: .6rem; grid-template-columns: repeat(auto-fill, minmax(26px, 1fr)); }
  .sg-nz-s { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--fg); min-inline-size: 0; border-radius: 4px; }
  /* the beam descends FROM the sky line: it hangs from the top edge, its width the surah's share */
  .sg-nz-s .z { display: flex; justify-content: center; align-items: flex-start; inline-size: 100%; block-size: var(--hz); }
  .sg-nz-s .z i { display: block; inline-size: max(calc(var(--f) * 82%), 6px); max-inline-size: 100%; block-size: calc(100% - 4px); background: linear-gradient(to bottom, var(--gold) var(--p, 100%), color-mix(in srgb, var(--gold) 16%, var(--card)) var(--p, 100%)); border: 1px solid var(--gold-text); border-block-start: 0; border-end-start-radius: 5px; border-end-end-radius: 5px; box-shadow: 0 0 10px color-mix(in srgb, var(--gold) 35%, transparent); }
  .sg-nz-s .z i.e { inline-size: 4px; block-size: 7px; background: var(--line); border-color: transparent; box-shadow: none; }
  .sg-nz-s b { font-size: .75rem; font-weight: 600; line-height: 1.8; }
  .sg-nz-s.e { color: var(--muted); opacity: .6; }
  .sg-nz-s:hover .z i, .sg-nz-s.is-sel .z i { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--fg); }
  .sg-nz-s.dim { opacity: .35; }
</style>
<script src="../../scripts/sig-nuzul.ts"></script>
