---
// The accessibility preferences menu (compact markup — it renders on every page, so whitespace costs weight).
interface Props { T: any }
const { T } = Astro.props;
---
<details class="a11y-prefs" id="a11y-prefs"><summary class="chip"><span class="a11y-full">{T.a11y.prefs}</span><span class="a11y-short" aria-hidden="true">A+</span></summary><div class="a11y-panel" role="group" aria-label={T.a11y.prefs}><div class="a11y-row"><span>{T.a11y.prefs_text}</span> <span class="a11y-ctl"><button type="button" data-ts="-" aria-label={T.a11y.prefs_smaller}>A−</button><output data-ts-out aria-live="polite">100%</output><button type="button" data-ts="+" aria-label={T.a11y.prefs_larger}>A+</button></span></div><label class="a11y-row"><span>{T.a11y.prefs_leading}</span><input type="checkbox" data-pref="leading" /></label><label class="a11y-row"><span>{T.a11y.prefs_contrast}</span><input type="checkbox" data-pref="contrast" /></label><label class="a11y-row"><span>{T.a11y.prefs_motion}</span><input type="checkbox" data-pref="motion" /></label><label class="a11y-row"><span>{T.a11y.prefs_links}</span><input type="checkbox" data-pref="links" /></label><p class="a11y-note muted">{T.a11y.prefs_note}</p></div></details>
