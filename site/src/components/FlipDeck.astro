---
// FlipDeck: flip-card deck for numbered list material. Front: number + title.
// Back: body + ref + verification note. Keyboard: arrows navigate, space/enter flips.
import type { DeckFile } from "../lib/cardlists";
import type { Lang } from "../lib/i18n";

interface Props { deck: DeckFile; lang: Lang; t: Record<string, string> }
const { deck, lang, t } = Astro.props;
const L = (x: { ar: string; en: string; ur?: string }) => (x[lang] ?? x.ar);
---
<div class="flipdeck" data-flipdeck>
  <div class="fd-progress"><div class="fd-bar" data-bar style="width:0%"></div></div>
  <div class="fd-stage">
    {deck.items.map((it, i) => (
      <article class="fd-card" data-card hidden={i !== 0} aria-label={`${i + 1} / ${deck.items.length}`}>
        <div class="fd-inner" data-inner tabindex="0" role="button" aria-label={t.flip}>
          <div class="fd-face fd-front">
            <span class="fd-num">{i + 1}</span>
            <h3>{L(it.title)}</h3>
            <span class="fd-hint">{t.tap_to_flip}</span>
          </div>
          <div class="fd-face fd-back">
            <h3>{L(it.title)}</h3>
            <p>{L(it.body)}</p>
            {it.ref && <p class="fd-ref ui">{it.ref}</p>}
            {it.verify && <p class="fd-verify ui">⚠ {it.verify}</p>}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="fd-nav">
    <button data-prev aria-label={t.prev}><span class="fd-arrow" aria-hidden="true">←</span></button>
    <span class="ui" data-count>1 / {deck.items.length}</span>
    <button data-next aria-label={t.next}><span class="fd-arrow" aria-hidden="true">→</span></button>
  </div>
  {deck.note && <p class="fd-note muted">{L(deck.note)}</p>}
  <div class="fd-fallback">
    <h3>{t.all_items}</h3>
    <ol>
      {deck.items.map((it) => (
        <li><b>{L(it.title)}</b> — {L(it.body)}{it.ref && <span class="ui"> ({it.ref})</span>}</li>
      ))}
    </ol>
  </div>
  <script type="application/json" data-payload set:html={JSON.stringify({ count: deck.items.length, lang })} />
</div>
<script src="../scripts/flipdeck.ts"></script>
<style>
.flipdeck { max-width: 640px; margin-inline: auto; }
.fd-progress { height: 6px; background: #1d3a6e33; border-radius: 3px; margin-bottom: 14px; }
.fd-bar { height: 100%; background: #c9a227; border-radius: 3px; transition: width .3s; }
.fd-stage { perspective: 1200px; min-height: 300px; }
.fd-card[hidden] { display: none; }
.fd-inner { position: relative; width: 100%; min-height: 280px; transform-style: preserve-3d;
  transition: transform .55s cubic-bezier(.2,.7,.3,1.15); cursor: pointer; }
.fd-inner.flipped { transform: rotateY(180deg); }
.fd-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
  border: 2px solid #c9a227; border-radius: 14px; padding: 28px; display: flex;
  flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 10px; }
.fd-front { background: #f8f1de; color: #1d3a6e; }
.fd-back { background: #152c55; color: #f8f1de; transform: rotateY(180deg); }
.fd-num { width: 56px; height: 56px; border-radius: 50%; background: #c9a227; color: #0a1428;
  display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; }
.fd-hint { font-size: .85rem; opacity: .65; }
.fd-ref { color: #c9a227; }
.fd-verify { color: #e8a13d; font-size: .85rem; }
.fd-arrow { display: inline-block; }
:root[dir="rtl"] .fd-arrow { transform: scaleX(-1); }
.fd-nav { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 14px; }
.fd-nav button { font-size: 22px; background: #152c55; color: #f8f1de; border: 1px solid #c9a227;
  border-radius: 50%; width: 48px; height: 48px; cursor: pointer; }
.fd-note { margin-top: 12px; border-inline-start: 3px solid #c9a227; padding-inline-start: 10px; }
.fd-fallback { margin-top: 22px; }
@media (prefers-reduced-motion: reduce) { .fd-inner { transition: none; } .fd-bar { transition: none; } }
@media print {
  .fd-progress, .fd-stage, .fd-nav, .fd-fallback, .fd-note { display: none !important; }
}
</style>
