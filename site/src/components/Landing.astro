---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "./Logo.astro";
import { ui, WINGS, wingHref, type Lang } from "../lib/i18n";
import { href } from "../lib/graph";
const { lang, path } = Astro.props as { lang: Lang; path: string };
const T = ui(lang);
// one medallion per wing, numbered in Arabic-Indic numerals: the museum is nine wings around one story
const NUM = ["١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"];
---
<BaseLayout lang={lang} title={T.tagline} path={path} jsonld={{ "@context": "https://schema.org", "@type": "WebSite", name: "islam.museum", url: "https://islam.museum/", inLanguage: ["en", "ar"], license: "https://creativecommons.org/licenses/by-sa/4.0/" }}>
  <section class="hero" aria-labelledby="hero-title">
    <Logo size={520} class="hero-watermark" />
    <div class="wrap" style="position:relative">
      <p class="eyebrow">{T.landing.eyebrow}</p>
      <h1 id="hero-title" class="display">{T.landing.title_pre} <strong>{T.landing.title_strong}</strong> {T.landing.title_post}</h1>
      <p class="hero-lede">{T.landing.lede}</p>
      <p class="ui pill"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{T.landing.soon}</p>
      <p class="ui" id="today-line" data-prefix={T.landing.today_is} aria-live="polite" style="margin:0"></p>
      <div class="hero-actions">
        <a class="btn btn-gold" href={href(lang, "event/hijra")}>{T.landing.start} <span class="flip" aria-hidden="true">→</span></a>
        <a class="btn btn-line" href={`/${lang}/learn/`}>{T.landing.learn_cta} <span class="flip" aria-hidden="true">→</span></a>
      </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 46 C240 6 480 84 720 44 S1200 6 1440 46 V90 H0 Z" style="fill:var(--bg)" /></svg>
  </section>

  <div class="wrap" style="padding-block:40px 20px">
    <a class="card" href={`/${lang}/learn/`} style="max-width:640px;margin:0 0 1rem;border:1px solid var(--gold)"><h2 class="card-title" style="font-size:1.15rem">{T.landing.learn_title}</h2><span>{T.landing.learn_text}</span> <span class="ui" style="display:block;margin-top:8px;color:var(--link)">{T.landing.learn_cta} <span class="flip" aria-hidden="true">→</span></span></a>
    <p class="ui" style="margin:0 0 1rem"><a href={`/${lang}/coverage/`}>{T.landing.coverage} <span class="flip" aria-hidden="true">→</span></a></p>

    <h2 id="wings" class="ui" style="font-size:1.1rem;font-weight:500;color:var(--muted);margin-top:3rem">{T.landing.wings}</h2>
    <ul class="grid-cards" style="margin-bottom:3.5rem">
      {WINGS.map((w, i) => (
        <li><a class="card wing-card" data-wing={w} href={wingHref(lang, w)} style={`--wing: var(--wing-${w})`}><span class="wing-medal" aria-hidden="true">{NUM[i]}</span><h3 class="card-title">{T.wings[w].title}</h3><span>{T.wings[w].blurb}</span></a></li>
      ))}
    </ul>

    <h2 class="ui" style="font-size:1.1rem;font-weight:500;color:var(--muted)">{T.entrances.title}</h2>
    <ul class="grid-cards" style="margin-bottom:3.5rem">
      {(["learn", "questions", "exhibits", "screen", "themes"] as const).map((k) => (
        <li><a class="card" href={`/${lang}/${k}/`}><h3 class="card-title">{T.entrances[k].title}{T.entrances[k].badge && <span class="chip ui" style="margin-inline-start:8px;font-size:.75rem;border:1px solid var(--gold)">{T.entrances[k].badge}</span>}</h3><span>{T.entrances[k].blurb}</span></a></li>
      ))}
    </ul>

    <h2 class="ui" style="font-size:1.1rem;font-weight:500;color:var(--muted)">{T.landing.how}</h2>
    <ul class="ui muted" style="display:flex;flex-wrap:wrap;gap:10px 26px;padding:0;list-style:none">
      {T.landing.pillars.map((p: string) => <li style="display:flex;gap:8px;align-items:center"><span aria-hidden="true" style="width:6px;height:6px;background:var(--gold-text);border-radius:50%"></span>{p}</li>)}
    </ul>
  </div>
  <script is:inline>
    (function () {
      var el = document.getElementById("today-line");
      if (!el) return;
      var l = document.documentElement.lang;
      try {
        var now = new Date(), loc = (l === "ar" ? "ar" : "en-GB");
        var h = new Intl.DateTimeFormat(loc + "-u-ca-islamic-umalqura-nu-latn", { day: "numeric", month: "long", year: "numeric" }).format(now);
        var g = new Intl.DateTimeFormat(loc + "-u-nu-latn", { day: "numeric", month: "long", year: "numeric" }).format(now);
        el.textContent = el.dataset.prefix + " " + h + " · " + g;
      } catch (e) {}
    })();
  </script>
</BaseLayout>
