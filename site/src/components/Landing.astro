---
// The landing page (Part 3, B): hero with "this day", the pathways, the nine wings, the four explorers, the Hijri-date widget, the stats.
// Layout, section order and copy follow docs/design/landing-mockup (islam-museum-landing-mockup.html); colours are the site tokens.
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "./Logo.astro";
import TodayCards from "./TodayCards.astro";
import ExplorerModule from "./ExplorerModule.astro";
import GiftShop from "./GiftShop.astro";
import ArtStrip from "./ArtStrip.astro";
import FutureStrip from "./FutureStrip.astro";
import WorldStrip from "./WorldStrip.astro";
import { ui, fmt, WINGS, wingHref, NUM_LOCALE, ARABIC_SCRIPT, type Lang } from "../lib/i18n";
import { href, graph, labelOf, summaryOf, realNodes } from "../lib/graph";
import { wingCountLabel, explorePages, num } from "../lib/nav";
import { featuredPool } from "../../../scripts/wings";
import { a11yLd } from "../lib/a11y";
const { lang, path } = Astro.props as { lang: Lang; path: string };
const T = ui(lang);
const L = T.learn;
const ORDER = ["path-islam-in-30-minutes", "path-meccan-period", "path-abyssinia-migrations", "path-women-around-the-prophet", "path-from-opposition-to-islam"];
const rank = (id: string) => { const k = ORDER.indexOf(id.replace("exhibit/", "")); return k === -1 ? 99 : k; };
const paths = realNodes.filter((n: any) => n.class === "exhibit" && String(n.id).startsWith("exhibit/path-")).sort((a: any, b: any) => rank(a.id) - rank(b.id) || String(a.id).localeCompare(String(b.id))).slice(0, 5);
const PATH_ACC = ["var(--gold)", "var(--wing-ideas)", "var(--wing-place)", "#8e5aa8", "var(--wing-people)"];
const EXPLORE = explorePages(lang);
const pages = 2 * realNodes.length;
// One random entry per wing card, picked in the browser from a small pool fixed at build time (scripts/wings.ts featuredPool).
const teaser = (s: string, n = 110) => (s.length > n ? s.slice(0, n).replace(/\s+\S*$/, "") + "…" : s);
// A wing with no entry written in the page's language yet borrows from the next language (Urdu: Arabic, then English); the link stays in the page's language.
const FALLBACK: Record<Lang, Lang[]> = { ar: ["ar", "en"], en: ["en", "ar"], ur: ["ur", "ar", "en"] };
const featured = Object.fromEntries(WINGS.map((w) => {
  let src = lang, pool: any[] = [];
  for (const l of FALLBACK[lang]) { pool = featuredPool(realNodes as any[], w, l); src = l; if (pool.length) break; }
  return [w, { g: src, x: pool.map((n: any) => ({ h: href(lang, n.id), l: labelOf(n, src), s: teaser(summaryOf(n, src)) })) }];
})) as Record<string, { g: Lang; x: { h: string; l: string; s: string }[] }>;
const featLang = (w: string) => featured[w].g === lang ? {} : { lang: featured[w].g, dir: ARABIC_SCRIPT.includes(featured[w].g) ? "rtl" : "ltr" };
const featJson = JSON.stringify(Object.fromEntries(Object.entries(featured).map(([w, f]) => [w, f.x]))).replace(/</g, "\\u003c");
const stats = fmt(T.landing.stats, { items: num(realNodes.length, lang), pages: num(Math.round(pages / 1000) * 1000, lang) });
---
<BaseLayout lang={lang} title={T.tagline} path={path} jsonld={{ "@context": "https://schema.org", "@type": "WebSite", name: "islam.museum", url: "https://islam.museum/", inLanguage: ["en", "ar"], license: "https://creativecommons.org/licenses/by-sa/4.0/", ...a11yLd(lang) }}>
  <section class="lhero" aria-labelledby="hero-title">
    <Logo size={300} class="lhero-star" variant="mono" alt={T.name} />
    <div class="wrap" style="position:relative">
      <p class="eyebrow">{T.landing.eyebrow}</p>
      <h1 id="hero-title" class="display">{T.landing.title_pre} <span class="hl">{T.landing.title_strong}</span> {T.landing.title_post}</h1>
      <TodayCards lang={lang} />
    </div>
  </section>

  <section class="block" aria-label={T.time_browser.x_name}>
    <div class="wrap"><ExplorerModule lang={lang} /></div>
  </section>

  <section class="block" id="tour" aria-labelledby="tour-title">
    <div class="wrap">
      <div class="sec-head"><h2 id="tour-title">{T.landing.tour_title}</h2><p class="muted">{T.landing.tour_lede}</p></div>
      <ul class="paths" role="list">
        {paths.map((n: any, i: number) => (
          <li><a class="path" href={href(lang, n.id)} style={`--acc:${PATH_ACC[i]}`}><h3>{labelOf(n, lang)}</h3><p>{summaryOf(n, lang)}</p><span class="meta ui">{(n.data.rooms ?? []).length} {L.steps} · {n.data.duration_minutes} {L.minutes}</span></a></li>
        ))}
      </ul>
      <p class="plan-note ui">{T.landing.plan_note} · <a href={`/${lang}/learn/`}>{T.landing.all_paths} <span class="flip" aria-hidden="true">→</span></a> · <a href={`/${lang}/learn/courses/`}>{T.syllabus.title} <span class="flip" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="block" id="wings" aria-labelledby="wings-title" style="padding-top:1rem">
    <div class="wrap">
      <div class="sec-head"><h2 id="wings-title">{T.landing.wings_title}</h2><p class="muted">{T.landing.wings_lede}</p></div>
      <ul class="wings" role="list">
        {WINGS.map((w) => (
          <li class="wing" data-wing={w} style={`--acc:var(--wing-${w})`}>
            <a class="wing-head" href={wingHref(lang, w)}><h3>{T.wings[w].title} <span class="flip" aria-hidden="true">→</span></h3><span class="count ui">{wingCountLabel(lang, w)}</span></a>
            <p>{T.wings[w].blurb}</p>
            {featured[w].x[0] && <a class="feat" data-feat={w} href={featured[w].x[0].h}><span class="feat-k ui">✦ {T.landing.featured}</span><h4 class="feat-l" {...featLang(w)}><bdi>{featured[w].x[0].l}</bdi></h4><span class="feat-s" {...featLang(w)}>{featured[w].x[0].s}</span></a>}
          </li>
        ))}
      </ul>
      <script type="application/json" data-feat-pool set:html={featJson} />
    </div>
  </section>

  <section class="block" id="explore" aria-labelledby="explore-title" style="padding-top:1rem">
    <div class="wrap">
      <div class="sec-head"><h2 id="explore-title">{T.landing.explore_title}</h2><p class="muted">{T.landing.explore_lede}</p></div>
      <ul class="xgrid" role="list">
        {EXPLORE.map((x) => (
          <li class="xcard">
            <div class="thumb" aria-hidden="true" data-thumb={x.key}>
              {x.key === "timeline" && <div class="axis"><div class="line"></div><span class="tick" style="inset-inline-start:8%">1هـ</span><span class="tick" style="inset-inline-start:38%">500هـ</span><span class="tick" style="inset-inline-start:66%">1000هـ</span><span class="tick" style="inset-inline-end:6%">1448هـ</span><div class="play"></div></div>}
              {x.key === "journeys" && <svg class="dunes" viewBox="0 0 150 150" preserveAspectRatio="xMidYMid slice"><rect width="150" height="150" fill="#e8d9b8"/><path d="M0 110 Q40 80 75 105 T150 95 V150 H0 Z" fill="#dfc99c"/><path class="route" d="M118 118 Q95 100 78 108 T40 92 T18 98"/><circle cx="118" cy="118" r="5" fill="var(--gold)"/><circle cx="40" cy="92" r="4" fill="var(--gold)"/><circle cx="18" cy="98" r="4" fill="var(--lapis)"/></svg>}
              {x.key === "graph" && <div class="stars"><i style="top:30%;right:25%"></i><i style="top:55%;right:45%"></i><i style="top:25%;right:60%"></i><i style="top:65%;right:70%"></i><i style="top:40%;right:80%"></i><svg style="position:absolute;inset:0" viewBox="0 0 150 150"><path d="M112 45 L82 82 L60 37 M82 82 L45 97 M82 82 L30 60" stroke="#e8c85a" stroke-width="1" opacity=".6" fill="none"/></svg></div>}
              {x.key === "revelation" && <div class="split"><div></div><div></div></div>}
              {x.key === "khutab" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M40 118 H110 M48 100 H102 M56 82 H94 M64 64 H86" stroke="#c5a059" stroke-width="5" fill="none"/><path d="M75 22 V52" stroke="#2a7b88" stroke-width="3"/></svg>}
              {x.key === "qudsi" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M30 44 Q75 30 75 44 V118 Q75 104 30 118 Z M120 44 Q75 30 75 44 V118 Q75 104 120 118 Z" fill="none" stroke="#c5a059" stroke-width="4"/><path d="M42 62 H64 M42 76 H64 M42 90 H60 M86 62 H108 M86 76 H108 M90 90 H108" stroke="#b27b42" stroke-width="2.5"/><circle cx="75" cy="24" r="7" fill="#2a7b88"/><path d="M75 8 V14 M75 34 V40 M59 24 H65 M85 24 H91" stroke="#2a7b88" stroke-width="2.5"/></svg>}
              {x.key === "jobs" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M75 26 V120 M54 120 H96" stroke="#c5a059" stroke-width="4" fill="none"/><path d="M36 50 H114" stroke="#b27b42" stroke-width="4" fill="none"/><path d="M36 50 L26 84 M36 50 L46 84 M114 50 L104 84 M114 50 L124 84" stroke="#2a7b88" stroke-width="2.5" fill="none"/><path d="M24 84 Q36 98 48 84 Z M102 84 Q114 98 126 84 Z" fill="#b27b42"/><circle cx="75" cy="26" r="6" fill="#c5a059"/></svg>}
              {x.key === "inventions" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M75 30 a28 28 0 0 1 16 51 v13 h-32 v-13 a28 28 0 0 1 16 -51 Z" fill="none" stroke="#c5a059" stroke-width="4"/><path d="M62 104 H88 M64 113 H86" stroke="#b27b42" stroke-width="4"/><path d="M75 94 V70 M66 62 L75 70 L84 62" stroke="#2a7b88" stroke-width="3" fill="none"/><path d="M30 58 H42 M108 58 H120 M44 26 L52 34 M106 26 L98 34" stroke="#2a7b88" stroke-width="2.5"/></svg>}
              {x.key === "modern" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M20 118 H130" stroke="#c5a059" stroke-width="4"/><rect x="28" y="88" width="14" height="30" fill="#2a7b88"/><rect x="50" y="70" width="14" height="48" fill="#c5a059"/><rect x="72" y="52" width="14" height="66" fill="#2a7b88"/><rect x="94" y="36" width="14" height="82" fill="#c5a059"/><rect x="116" y="60" width="10" height="58" fill="#b27b42"/><circle cx="121" cy="30" r="9" fill="none" stroke="#b27b42" stroke-width="3"/><path d="M121 24 V30 L125 33" stroke="#b27b42" stroke-width="2.5" fill="none"/></svg>}
              {x.key === "companions" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M75 40 L40 70 L58 112 L92 112 L110 70 Z M75 40 L58 112 M75 40 L92 112 M40 70 L110 70" fill="none" stroke="#c5a059" stroke-width="2.5"/><circle cx="75" cy="40" r="9" fill="#2a7b88"/><circle cx="40" cy="70" r="7" fill="#c5a059"/><circle cx="110" cy="70" r="7" fill="#c5a059"/><circle cx="58" cy="112" r="7" fill="#b27b42"/><circle cx="92" cy="112" r="7" fill="#b27b42"/><circle cx="75" cy="80" r="4" fill="#2a7b88"/></svg>}
              {x.key === "fatwa" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><rect x="38" y="28" width="74" height="96" rx="6" fill="none" stroke="#c5a059" stroke-width="4"/><path d="M52 52 H98 M52 70 H98 M52 88 H82" stroke="#2a7b88" stroke-width="4" fill="none"/><circle cx="104" cy="112" r="12" fill="#c5a059"/></svg>}
              {x.key === "map" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><circle cx="75" cy="75" r="52" fill="none" stroke="#c5a059" stroke-width="3"/><path d="M23 75 H127 M75 23 Q96 75 75 127 M75 23 Q54 75 75 127" stroke="#c5a059" stroke-width="2" fill="none"/><circle cx="90" cy="56" r="5" fill="#2a7b88"/><circle cx="57" cy="93" r="4" fill="#c5a059"/></svg>}
              {x.key === "seerah" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M15 118 Q45 108 62 118 T112 114 Q128 112 140 118" stroke="#2a7b88" stroke-width="3.5" fill="none"/><path d="M75 138 Q75 128 66 121 Q60 116 66 111" stroke="#2a7b88" stroke-width="3" fill="none" stroke-dasharray="5 5"/><circle cx="75" cy="88" r="20" fill="none" stroke="#c5a059" stroke-width="4"/><path d="M75 58 V66 M75 110 V118 M45 88 H53 M97 88 H105 M54 67 L60 73 M96 67 L90 73 M54 109 L60 103 M96 109 L90 103" stroke="#c5a059" stroke-width="3.5"/></svg>}
              {x.key === "ghayb" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M75 18 L92 58 L134 62 L102 90 L112 132 L75 110 L38 132 L48 90 L16 62 L58 58 Z" fill="none" stroke="#c5a059" stroke-width="4" stroke-linejoin="round"/><circle cx="75" cy="75" r="9" fill="#2a7b88"/><path d="M75 66 V84 M66 75 H84" stroke="#e8ecf8" stroke-width="2.5"/></svg>}
              {x.key === "surahmaps" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M75 12 L75 138" stroke="#c5a059" stroke-width="3" fill="none"/><circle cx="75" cy="30" r="9" fill="#c5a059"/><circle cx="75" cy="62" r="7" fill="#2a7b88"/><circle cx="75" cy="92" r="8" fill="#4d8a4f"/><circle cx="75" cy="120" r="6" fill="#c5a059"/><circle cx="100" cy="62" r="4" fill="#2a7b88"/><circle cx="50" cy="92" r="4" fill="#4d8a4f"/></svg>}
              {x.key === "dreams" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M96 30 A34 34 0 1 0 96 90 A27 27 0 1 1 96 30 Z" fill="#e8ecf8" opacity=".9"/><circle cx="38" cy="34" r="2.5" fill="#e8c85a"/><circle cx="118" cy="26" r="2" fill="#e8c85a"/><circle cx="124" cy="58" r="2.5" fill="#e8c85a"/><circle cx="30" cy="96" r="2" fill="#e8c85a"/><path d="M30 112 Q50 100 75 112 T120 108 V150 H30 Z" fill="#2a4a7a" opacity=".55"/><circle cx="52" cy="124" r="3" fill="#e8ecf8" opacity=".7"/><circle cx="98" cy="132" r="2.5" fill="#e8ecf8" opacity=".6"/></svg>}
              {x.key === "dua" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M75 22 C45 22 30 44 30 66 C30 92 52 108 75 126 C98 108 120 92 120 66 C120 44 105 22 75 22 Z" fill="none" stroke="#c5a059" stroke-width="4" stroke-linejoin="round"/><path d="M75 44 V84 M60 62 L75 78 L90 62" stroke="#2a7b88" stroke-width="4" fill="none" stroke-linecap="round"/><circle cx="75" cy="14" r="4" fill="#e8c85a"/><path d="M30 132 Q55 124 75 132 T122 128" stroke="#2a4a7a" stroke-width="3" fill="none" opacity=".6"/></svg>}
              {x.key === "sayyiat" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M28 40 Q50 30 75 40 Q100 30 122 40 V112 Q100 102 75 112 Q50 102 28 112 Z" fill="none" stroke="#c5a059" stroke-width="4"/><path d="M75 40 V112" stroke="#c5a059" stroke-width="3"/><path d="M40 56 H64 M40 72 H64 M40 88 H60 M86 56 H110 M86 72 H110 M90 88 H110" stroke="#2a7b88" stroke-width="2.5" fill="none"/><circle cx="75" cy="28" r="7" fill="#7a3a5e"/><path d="M75 18 V24 M75 32 V38 M63 28 H69 M81 28 H87" stroke="#7a3a5e" stroke-width="2.5"/><path d="M30 132 Q55 124 75 132 T122 128" stroke="#2a4a7a" stroke-width="3" fill="none" opacity=".6"/></svg>}
              {x.key === "madhahib" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M22 44 H128 M28 44 V104 M48 44 V96 M68 44 V110 M88 44 V92 M108 44 V104 M128 44 V96 M22 116 H128" stroke="#c5a059" stroke-width="4" fill="none"/><rect x="32" y="52" width="12" height="46" fill="#2a7b88"/><rect x="52" y="52" width="12" height="38" fill="#c5a059"/><rect x="72" y="52" width="12" height="52" fill="#2a7b88"/><rect x="92" y="52" width="12" height="34" fill="#c5a059"/><circle cx="75" cy="30" r="8" fill="none" stroke="#b27b42" stroke-width="3"/><path d="M75 18 V24 M75 36 V42 M63 30 H69 M81 30 H87" stroke="#b27b42" stroke-width="2.5"/></svg>}
              {x.key === "magic" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M75 18 L88 52 L124 58 L94 82 L102 118 L75 100 L48 118 L56 82 L26 58 L62 52 Z" fill="none" stroke="#c5a059" stroke-width="4" stroke-linejoin="round"/><circle cx="75" cy="66" r="10" fill="#2a7b88"/><path d="M75 50 V42 M75 90 V98 M59 66 H51 M91 66 H99" stroke="#e8c85a" stroke-width="3"/><circle cx="34" cy="120" r="3" fill="#e8ecf8" opacity=".7"/><circle cx="116" cy="124" r="2.5" fill="#e8ecf8" opacity=".6"/><path d="M30 132 Q55 124 75 132 T122 128" stroke="#2a4a7a" stroke-width="3" fill="none" opacity=".6"/></svg>}
              {x.key === "signs" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M52 26 H98 L88 62 H62 Z" fill="none" stroke="#c5a059" stroke-width="4" stroke-linejoin="round"/><path d="M62 124 H88 L98 88 H62 Z" fill="none" stroke="#c5a059" stroke-width="4" stroke-linejoin="round"/><path d="M66 70 H84" stroke="#e8c85a" stroke-width="3"/><circle cx="75" cy="18" r="6" fill="#2a7b88"/><path d="M75 8 V12 M75 24 V28 M65 18 H69 M81 18 H85" stroke="#e8c85a" stroke-width="2.5"/><circle cx="36" cy="118" r="3" fill="#e8ecf8" opacity=".7"/><circle cx="114" cy="122" r="2.5" fill="#e8ecf8" opacity=".6"/><path d="M30 134 Q55 126 75 134 T120 130" stroke="#2a4a7a" stroke-width="3" fill="none" opacity=".6"/></svg>}
              {x.key === "messengers" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M38 118 Q75 104 112 118 V132 H38 Z" fill="none" stroke="#c5a059" stroke-width="4"/><path d="M48 112 V78 Q48 58 75 58 Q102 58 102 78 V112" fill="none" stroke="#2a7b88" stroke-width="4"/><path d="M75 34 L81 48 L95 48 L84 57 L88 71 L75 62 L62 71 L66 57 L55 48 L69 48 Z" fill="#e8c85a"/><circle cx="38" cy="124" r="3" fill="#b27b42" opacity=".8"/><circle cx="112" cy="124" r="3" fill="#b27b42" opacity=".8"/></svg>}
              {x.key === "bayt" && <svg viewBox="0 0 150 150" style="position:absolute;inset:0" aria-hidden="true"><path d="M30 62 L75 30 L120 62 V118 H30 Z" fill="none" stroke="#c5a059" stroke-width="4" stroke-linejoin="round"/><path d="M60 118 V92 H90 V118" fill="none" stroke="#2a7b88" stroke-width="4"/><circle cx="75" cy="76" r="7" fill="#e8c85a"/><path d="M75 62 V69 M75 83 V90 M61 76 H68 M82 76 H89" stroke="#e8c85a" stroke-width="2.5"/><circle cx="42" cy="100" r="4" fill="#b27b42" opacity=".8"/><circle cx="108" cy="100" r="4" fill="#b27b42" opacity=".8"/><path d="M24 128 Q50 120 75 128 T128 124" stroke="#2a4a7a" stroke-width="3" fill="none" opacity=".6"/></svg>}
            </div>
            <div class="body" style={`--acc:${x.key === "qudsi" ? "var(--gold)" : x.key === "timeline" ? "var(--gold)" : x.key === "journeys" ? "var(--wing-living)" : x.key === "graph" ? "#8e5aa8" : x.key === "surahmaps" ? "var(--gold)" : x.key === "map" ? "var(--gold)" : x.key === "khutab" ? "var(--wing-ideas)" : x.key === "fatwa" ? "var(--wing-words)" : x.key === "jobs" ? "var(--wing-objects)" : x.key === "inventions" ? "var(--wing-ideas)" : x.key === "modern" ? "var(--wing-today)" : x.key === "companions" ? "var(--wing-people)" : x.key === "ghayb" ? "#8e5aa8" : x.key === "dreams" ? "#5a6bb8" : x.key === "dua" ? "#2a7b88" : x.key === "sayyiat" ? "#7a3a5e" : x.key === "madhahib" ? "var(--wing-ideas)" : x.key === "magic" ? "#4a3f7a" : x.key === "messengers" ? "var(--wing-people)" : x.key === "bayt" ? "#8a5a2b" : x.key === "signs" ? "#7a3a2e" : x.key === "seerah" ? "var(--wing-living)" : "var(--lapis)"}`}>
              <h3>{T.explore.pages[x.key].title}{!x.ready && <span class="chip soon ui">{T.landing.in_progress}</span>}</h3>
              <p>{T.explore.pages[x.key].desc}</p>
              <a class="go ui" href={x.href}>{T.landing.try} <span class="flip" aria-hidden="true">→</span></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="widget-title">
    <div class="wrap band-grid">
      <div>
        <h2 id="widget-title">{T.landing.widget_title}</h2>
        <p class="muted" style="margin:0">{T.landing.widget_lede}</p>
        <form class="row ui" id="hijri-form" data-hijri-widget data-corresponds={T.landing.corresponds} data-none={T.landing.widget_none} data-fail={T.landing.widget_fail}>
          <label class="sr-only" for="bdate">{T.landing.date_label}</label>
          <input type="date" id="bdate" name="d" lang={lang} required />
          <button class="btn btn-lapis" type="submit">{T.landing.calc}</button>
        </form>
        <p class="hresult ui" id="hresult" role="status" aria-live="polite" hidden></p>
      </div>
      <div style="text-align:center">
        <p style="font-size:1.15rem">{T.landing.widget_or}</p>
        <a class="btn btn-outline" href={href(lang, "event/hijra")} style="font-size:1.05rem;padding:.8rem 2rem">{T.landing.start} <span class="flip" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="stats ui" aria-label={T.landing.coverage}>
    <div class="wrap">
      <p class="nums">{stats}</p>
      <p class="honest muted">{T.landing.honest} — <a href={`/${lang}/coverage/`}>{T.landing.honest_link}</a></p>
    </div>
  </section>
  <WorldStrip lang={lang} />
  <FutureStrip lang={lang} />
  <ArtStrip lang={lang} />
  <GiftShop lang={lang} />
  <p class="last-upd ui muted" data-last-updated data-tpl={T.landing.last_updated} data-locale={NUM_LOCALE[lang]} hidden></p>
