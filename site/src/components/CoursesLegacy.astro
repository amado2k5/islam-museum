---
// The pilot's Syllabus Browser page, kept verbatim for the languages the new courses surface is not built in (Urdu).
// Do not edit: scripts/courses/o11_boundaries.py checks that the page it renders is byte-identical to the baseline's.
import BaseLayout from "../layouts/BaseLayout.astro";
import LearnPicker from "../islands/LearnPicker.svelte";
import { ui, LANGS, type Lang } from "../lib/i18n";
import { nodes, href, labelOf, summaryOf } from "../lib/graph";

interface Props { lang: Lang }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const S = T.syllabus;

const courses = nodes.filter((n) => n.class === "course");
const pickerNodes = courses.map((n) => ({
  id: n.id, kind: n.data?.kind, parent: n.data?.part_of,
  label: labelOf(n, lang), summary: summaryOf(n, lang), grade: n.data?.grade_number, order: n.data?.order,
}));
const subjects = courses.filter((n) => n.data?.kind === "subject");
---
<BaseLayout lang={lang} title={S.title} description={S.lede} path={`/${lang}/learn/courses/`} alternates={Object.fromEntries(LANGS.map((l) => [l, `/${l}/learn/courses/`]))}>
  <div class="wrap" style="padding-block:10px 20px">
    <nav class="ui muted no-print" aria-label={T.entity.breadcrumb} style="font-size:.88rem;margin-bottom:14px">
      <a href={`/${lang}/`} style="color:inherit">{T.entity.breadcrumb}</a>
      › <a href={`/${lang}/learn/`} style="color:inherit">{T.nav.learn}</a>
      › <span>{S.title}</span>
    </nav>
    <h1>{S.title}</h1>
    <p style="font-size:1.2rem;max-width:var(--measure)">{S.lede}</p>

    <section class="panel" style="margin-block:1.5rem;padding:18px 20px">
      <LearnPicker client:load nodes={pickerNodes} lang={lang} labels={{ country: S.country, grade: S.grade, subject: S.subject, open: S.open }} />
      <noscript><p class="ui">{S.noscript}</p></noscript>
    </section>

    <ul class="grid-cards" style="margin-top:1.5rem">
      {subjects.map((s) => (
        <li><a class="card" href={href(lang, s.id)}><b>{labelOf(s, lang)}</b><span>{summaryOf(s, lang)}</span></a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
