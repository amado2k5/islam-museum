---
// Story in 12 cards (E5): auto-play at 2.8 s per card (the Surah Map pattern),
// pause and step controls, and the full list without JS. Every illustration is
// an inline SVG motif — museum-drawn line art, no external media, no people.
import type { StoryCardFile, Motif } from "../lib/story-cards";
import type { Lang } from "../lib/i18n";

interface Props { story: StoryCardFile; lang: Lang; t: Record<string, string> }
const { story, lang, t } = Astro.props;
const L = (x: { ar: string; en: string; ur?: string }) => (x[lang] ?? x.ar);

const MOTIF_SVG: Record<Motif, string> = {
  moon: '<path d="M52 30a30 30 0 1 0 18 54 24 24 0 0 1-18-54z"/>',
  mountain: '<path d="M14 74L38 34l14 20 12-14 24 34z"/><path d="M46 40l6 8 6-6"/>',
  cave: '<path d="M18 70c0-26 14-42 32-42s32 16 32 42z"/><path d="M42 70c0-10 3-16 8-16s8 6 8 16"/>',
  camel: '<path d="M22 58c0-14 10-20 20-20 4-8 10-12 14-12 2 4-2 8-4 12 8 0 18 6 18 20v14h-6V58H56v14h-6v-6c-8 4-14 4-20 0v6h-8z"/><path d="M52 30l4-8 4 8"/>',
  caravan: '<path d="M12 66c0-10 8-16 16-16 3-6 8-9 11-9 1 3-1 6-3 9 6 0 14 5 14 16v8h-4v-8H40v8h-4v-4c-6 3-11 3-16 0v4h-8z"/><path d="M58 66c0-8 6-12 12-12 2-4 6-7 9-7 1 2-1 4-2 7 5 0 11 4 11 12v6h-3v-6H77v6h-3v-3c-5 2-9 2-13 0v3h-3z"/><path d="M30 30a8 8 0 0 1 16 0z"/>',
  sea: '<path d="M10 58c6-6 12-6 18 0s12 6 18 0 12-6 18 0 12 6 18 0"/><path d="M10 66c6-6 12-6 18 0s12 6 18 0 12-6 18 0 12 6 18 0"/><path d="M40 44V28l14 6-14 6"/><path d="M40 28v24"/>',
  star: '<path d="M50 18l7 18 19 1-14 12 5 19-17-11-17 11 5-19-14-12 19-1z"/>',
  mosque: '<path d="M50 24c-10 8-18 14-18 24h36c0-10-8-16-18-24z"/><path d="M28 48h44v24H28z"/><path d="M44 72v-10a6 6 0 0 1 12 0v10"/><path d="M22 36v36M78 36v36"/><path d="M20 36h4M76 36h4"/><circle cx="50" cy="18" r="2"/>',
  city: '<path d="M18 44h64v28H18z"/><path d="M18 44l6-8h6l6 8M46 44l6-8h6l6 8M74 44l4-8h4z"/><path d="M18 52h64"/><path d="M42 72v-10a8 8 0 0 1 16 0v10"/>',
  book: '<path d="M50 30c-8-6-18-8-28-6v44c10-2 20 0 28 6 8-6 18-8 28-6V24c-10-2-20 0-28 6z"/><path d="M50 30v44"/>',
  manuscript: '<rect x="26" y="18" width="48" height="64" rx="2"/><path d="M34 30h32M34 38h32M34 46h32M34 54h20"/><path d="M34 62h32" opacity=".5"/><path d="M26 18h48v64"/>',
  pen: '<path d="M30 70c10-2 14-8 16-16l20-24 8 8-24 20c-8 2-14 6-16 16z"/><path d="M30 70l6-6"/>',
  map: '<path d="M20 26l20-8 20 8 20-8v56l-20 8-20-8-20 8z"/><path d="M40 18v56M60 26v56"/><path d="M30 40c4-6 10-6 14-2" stroke-dasharray="3 3"/>',
  compass: '<circle cx="50" cy="50" r="30"/><path d="M50 26l8 24-8 24-8-24z"/><circle cx="50" cy="50" r="3"/>',
  coin: '<circle cx="50" cy="50" r="28"/><circle cx="50" cy="50" r="20"/><path d="M50 38l3 7 8 1-6 5 2 8-7-4-7 4 2-8-6-5 8-1z"/>',
  tree: '<path d="M50 30v44"/><path d="M50 30c-12 0-20-8-20-18 12 0 20 8 20 18zM50 30c12 0 20-8 20-18-12 0-20 8-20 18z"/><path d="M50 44c-8 0-14-6-14-14 8 0 14 6 14 14zM50 44c8 0 14-6 14-14-8 0-14 6-14 14z"/>',
};
---
<div class="sc" data-storycards>
  <div class="sc-player" data-sc-player>
    <div class="sc-stage">
      {story.cards.map((c, i) => (
        <article class="sc-panel" data-sc-panel hidden={i !== 0}>
          <svg class="sc-art" viewBox="0 0 100 100" role="img" aria-label={L(c.title)} set:html={MOTIF_SVG[c.motif]} />
          <h2 class="sc-card-title">{L(c.title)}</h2>
          <p class="sc-line">{L(c.narration)}</p>
        </article>
      ))}
    </div>
    <div class="sc-controls">
      <button type="button" class="sc-btn" data-sc-prev aria-label={t.prev}>→</button>
      <button type="button" class="sc-play" data-sc-play data-stop={t.stop}>{t.play}</button>
      <button type="button" class="sc-btn" data-sc-next aria-label={t.next}>←</button>
    </div>
    <div class="sc-rail" role="tablist" aria-label={t.all_cards}>
      {story.cards.map((c, i) => (
        <button type="button" class="sc-tick" data-sc-tick={i} role="tab" aria-selected={i === 0 ? "true" : "false"} aria-label={`${i + 1}. ${L(c.title)}`}>{i + 1}</button>
      ))}
    </div>
    <p class="sc-count ui" data-sc-count>1 / 12</p>
  </div>
  <ol class="sc-list">
    {story.cards.map((c) => (
      <li><b>{L(c.title)}</b><br />{L(c.narration)}</li>
    ))}
  </ol>
</div>
<script src="../scripts/story-cards.ts"></script>
<style>
.sc { max-width: 680px; margin-inline: auto; }
.sc-stage { position: relative; }
.sc-panel { border: 2px solid #c9a227; border-radius: 14px; padding: 22px; background: #f8f1de; color: #1d3a6e; text-align: center; }
.sc-panel[hidden] { display: none; }
.sc-art { width: 120px; height: 120px; margin-inline: auto; display: block; }
.sc-art :global(path), .sc-art :global(rect), .sc-art :global(circle) { fill: none; stroke: #8a6d1a; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
.sc-card-title { margin: 10px 0 6px; font-size: 1.25rem; }
.sc-line { font-size: 1.1rem; line-height: 1.9; }
.sc-controls { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 14px 0 10px; }
.sc-btn { font-size: 20px; background: #152c55; color: #f8f1de; border: 1px solid #c9a227; border-radius: 50%; width: 44px; height: 44px; cursor: pointer; }
.sc-play { background: #c9a227; color: #0a1428; border: 0; border-radius: 24px; padding: 10px 22px; font-weight: 700; cursor: pointer; font-size: 1rem; }
.sc-play.on { background: #152c55; color: #f8f1de; border: 1px solid #c9a227; }
.sc-rail { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
.sc-tick { width: 32px; height: 32px; border-radius: 50%; border: 2px solid #c9a227; background: transparent; color: inherit; cursor: pointer; font-weight: 700; font-size: .85rem; }
.sc-tick[aria-selected="true"] { background: #c9a227; color: #0a1428; }
.sc-count { text-align: center; margin-top: 8px; }
.sc-list { margin-top: 26px; }
.sc-list li { margin-bottom: 10px; }
</style>
