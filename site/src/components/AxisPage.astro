---
// One page of a browser's topic axis (site/src/lib/axis.ts): the heading, what the page lists and how a passage
// came to be on it, the rows, and plain previous / next / numbered links. No script.
import BaseLayout from "../layouts/BaseLayout.astro";
import DraftMark from "./DraftMark.astro";
import { ui, fmt, type Lang } from "../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../lib/graph";
import { num } from "../lib/nav";
import { pageWindow } from "../lib/paged";
import { AXIS_ROWS, type AxisHeading, type AxisItem } from "../lib/axis";
import type { Node } from "../../../scripts/build-graph";
interface Props { lang: Lang; base: string; anchor: string; browserTitle: string; A: any; name: string; group?: string; heading: AxisHeading<AxisItem>; pageNo: number; prev?: { id: string; name: string }; next?: { id: string; name: string } }
const { lang, base, anchor, browserTitle, A, name, group, heading, pageNo, prev, next } = Astro.props;
const T = ui(lang);
const P = (T as any).paged;
const home = `/${lang}/${base}/`;
const url = (id: string, n = 1) => (n <= 1 ? `${home}${anchor}/${id}/` : `${home}${anchor}/${id}/${n}/`);
const rows = heading.items.slice((pageNo - 1) * AXIS_ROWS, pageNo * AXIS_ROWS);
const from = (pageNo - 1) * AXIS_ROWS + 1, to = from + rows.length - 1;
const title = fmt(A.page_title, { topic: name }) + (pageNo > 1 ? ` · ${num(pageNo, lang)}` : "");
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1");
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > 220 ? `${clean.slice(0, 220)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => (n.data.sura && n.data.aya ? `${n.data.sura}:${n.data.aya}` : n.data.ref ? String(n.data.ref) : "");
---
<BaseLayout lang={lang} title={title} description={A.page_lede} path={url(heading.id, pageNo)}>
  <div class="wrap" style="padding-block:10px 24px">
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › <a href={home}>{browserTitle}</a> › {name}</nav>
    <section data-pagefind-body={pageNo === 1 || undefined}>
      <h1>{title} <span class="ui muted">· {num(heading.items.length, lang)}</span></h1>
      {group && <p class="ui muted" style="margin:0 0 .4rem">{group}</p>}
      <p style="max-width:var(--measure)">{A.page_lede}</p>
      <p class="panel ui" style="max-width:var(--measure)">{fmt(A.page_count, { own: num(heading.own, lang), passages: num(heading.items.length - heading.own, lang) })}</p>
      <DraftMark lang={lang} legend />
    </section>
    <section data-pagefind-ignore>
      <ol role="list" style="list-style:none;padding:0;margin:1rem 0 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
        {rows.map((i) => (
          <li class="panel" style="padding:14px 16px">
            <a href={href(lang, i.node.id)} style="font-weight:600">{labelOf(i.node, lang)}</a><DraftMark lang={lang} node={i.node} />
            {i.node.class === "passage" && <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">{workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}</p>}
            <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
          </li>
        ))}
      </ol>
    </section>
    {heading.pages > 1 && (
      <nav class="ui paged-nav" aria-label={P.nav_label} style="margin:1rem 0;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px">
        <span class="muted">{fmt(P.range, { from: num(from, lang), to: num(to, lang), total: num(heading.items.length, lang) })}</span>
        {pageNo > 1 ? <a class="chip" rel="prev" href={url(heading.id, pageNo - 1)}>{P.prev}</a> : null}
        <span style="display:inline-flex;flex-wrap:wrap;gap:4px">
          {pageWindow(pageNo, heading.pages).map((n) => n === pageNo
            ? <span class="chip" aria-current="page" style="border:1px solid var(--gold)">{num(n, lang)}</span>
            : <a class="chip" href={url(heading.id, n)} aria-label={fmt(P.page_n, { n: num(n, lang) })}>{num(n, lang)}</a>)}
        </span>
        {pageNo < heading.pages ? <a class="chip" rel="next" href={url(heading.id, pageNo + 1)}>{P.next}</a> : null}
      </nav>
    )}
    <nav class="ui" aria-label={A.title} style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;margin:1.4rem 0 0">
      <span>{prev && <a href={url(prev.id)}>‹ {prev.name}</a>}</span>
      <a href={`${home}#by-${anchor}`}>{A.back}</a>
      <span>{next && <a href={url(next.id)}>{next.name} ›</a>}</span>
    </nav>
  </div>
</BaseLayout>
