---
// Stepper: Q&A walkthrough for explainer cards.
import type { ExplainerFile } from "../lib/explainers";
import type { Lang } from "../lib/i18n";

interface Props { deck: ExplainerFile; lang: Lang; t: Record<string, string> }
const { deck, lang, t } = Astro.props;
const L = (x: { ar: string; en: string }) => (lang === "ar" ? x.ar : x.en);
const steps = deck.steps ?? [];
---
<div class="stepper" data-stepper>
  <div class="st-progress"><div class="st-bar" data-bar style="width:0%"></div></div>
  {deck.attribution && <p class="ui attribution">{L(deck.attribution)}</p>}
  {deck.nuance && <p class="nuance">{L(deck.nuance)}</p>}
  <div class="st-stage">
    {steps.map((s, i) => (
      <article class="st-card" data-card hidden={i !== 0}>
        <span class="st-q">{L(s.q)}</span>
        <p class="st-a">{L(s.a)}</p>
        {s.ref && <p class="st-ref ui">{s.ref}</p>}
        {s.evidence?.map((e) => (
          <p class="st-ev ui">📜 {e.source}{e.note && <span class="muted"> — {e.note}</span>}</p>
        ))}
      </article>
    ))}
  </div>
  <div class="st-nav">
    <button data-prev aria-label={t.prev}>→</button>
    <span class="ui" data-count>1 / {steps.length}</span>
    <button data-next aria-label={t.next}>←</button>
  </div>
  {deck.cautions?.map((c) => <p class="caution">⚠ {L(c)}</p>)}
  <div class="st-fallback">
    <h3>{t.all_items}</h3>
    <ol>{steps.map((s) => <li><b>{L(s.q)}</b><br />{L(s.a)}</li>)}</ol>
  </div>
</div>
<script src="../scripts/stepper.ts"></script>
<style>
.stepper { max-width: 640px; margin-inline: auto; }
.st-progress { height: 6px; background: #1d3a6e33; border-radius: 3px; margin-bottom: 14px; }
.st-bar { height: 100%; background: #c9a227; border-radius: 3px; transition: width .3s; }
.attribution { color: #c9a227; border: 1px solid #c9a227; border-radius: 8px; padding: 6px 12px; display: inline-block; }
.nuance { background: #152c5522; border-inline-start: 3px solid #c9a227; padding: 10px 14px; border-radius: 8px; }
.st-stage { min-height: 220px; }
.st-card[hidden] { display: none; }
.st-card { border: 2px solid #c9a227; border-radius: 14px; padding: 26px; background: #f8f1de; color: #1d3a6e; }
.st-q { font-size: 1.35rem; font-weight: 800; display: block; margin-bottom: 12px; }
.st-a { font-size: 1.1rem; line-height: 1.8; }
.st-ref { color: #8a6d1a; }
.st-ev { font-size: .9rem; }
.caution { background: #e8a13d22; border: 1px solid #e8a13d; border-radius: 8px; padding: 10px 14px; }
.st-nav { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 14px; }
.st-nav button { font-size: 22px; background: #152c55; color: #f8f1de; border: 1px solid #c9a227;
  border-radius: 50%; width: 48px; height: 48px; cursor: pointer; }
.st-fallback { margin-top: 22px; }
@media (prefers-reduced-motion: reduce) { .st-bar { transition: none; } }
</style>
