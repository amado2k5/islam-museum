---
// "This day" (Part 3, C.1): a dual-date pill and one card per calendar, rendered for the build day and refreshed in the browser
// to the viewer's day from the embedded index. `full` lists every event of the day (the /today/ page); otherwise one per calendar.
import { ui, type Lang } from "../lib/i18n";
import { HIJRI_MONTHS, GREG_MONTHS, formatAH, formatCE } from "../lib/dates";
import { buildDay, onThisDay, todayIndex } from "../lib/today";
const { lang, full = false, heading = "h2" } = Astro.props as { lang: Lang; full?: boolean; heading?: "h1" | "h2" };
const T = ui(lang);
const idx = todayIndex(lang);
const { g, h } = buildDay();
const pad = (n: number) => String(n).padStart(2, "0");
const pill = `${T.landing.today_is} ${formatAH(`${pad(h.y)}-${pad(h.m)}-${pad(h.d)}`, lang)} · ${formatCE(`${g.y}-${pad(g.m)}-${pad(g.d)}`, lang)}`;
const H = onThisDay(idx.h, "h", h.m, h.d), G = onThisDay(idx.g, "g", g.m, g.d);
const payload = { h: idx.h, g: idx.g, hm: HIJRI_MONTHS[lang], gm: GREG_MONTHS[lang], lang, t: { nearest: T.today.nearest, none: T.today.none, ah: lang === "ar" ? "هـ" : "AH", ce: lang === "ar" ? "م" : "", today: T.landing.today_is } };
const Heading = heading;
const cards = [
  { cal: "h", title: T.today.in_hijri, r: H, acc: "var(--gold)" },
  { cal: "g", title: T.today.in_gregorian, r: G, acc: "var(--lapis)" },
];
---
<div class="today-block" data-today>
  <p class="ui"><span class="datepill" data-today-pill>{pill}</span></p>
  <Heading class="today-title">{T.today.on_this_day}</Heading>
  <div class="duo">
    {cards.map((c) => (
      <section class="tcard" style={`--acc:${c.acc}`} data-cal={c.cal} data-full={full ? "1" : "0"} aria-labelledby={`today-${c.cal}`}>
        <h3 id={`today-${c.cal}`} class="ui">{c.title}</h3>
        <p class="ui muted" data-note style="min-height:1.2em;margin:0 0 4px;font-size:.9rem">{c.r.items.length ? (c.r.exact ? "" : T.today.nearest) : T.today.none}</p>
        <ul data-items class="today-list">
          {(full ? c.r.items : c.r.items.slice(0, 1)).map((x) => <li><a href={x.href}><strong>{x.label}</strong></a> <span class="muted">— {x.date}</span></li>)}
        </ul>
        {!full && c.r.items[0] && <a class="ui go" data-go href={c.r.items[0].href}>{T.today.read_story} <span class="flip" aria-hidden="true">→</span></a>}
      </section>
    ))}
  </div>
  <p class="ui" style="margin:1.1rem 0 0"><button type="button" class="pill-btn" data-shuffle>🎲 {full ? T.today.random_day : T.today.random}</button></p>
  {full && <p class="ui muted" style="margin-top:1rem;font-size:.9rem">{T.today.note}</p>}
  <script type="application/json" set:html={JSON.stringify(payload)} />
</div>
<script src="../scripts/today-client.ts"></script>
