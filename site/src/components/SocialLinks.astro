---
// Official accounts, shown in the footer. Icons are inline SVG (no script, no network call), decorative, and each link carries its platform and handle as its accessible name.
interface Account { name: string; handle: string; href?: string; }
const accounts: Account[] = [
  { name: "X", handle: "@islam_museum", href: "https://x.com/islam_museum" },
  { name: "WhatsApp", handle: "islam_museum", href: "https://wa.me/14168270144" },
  { name: "TikTok", handle: "@islam.museum", href: "https://www.tiktok.com/@islam.museum" },
  { name: "YouTube", handle: "@Islam_museum", href: "https://www.youtube.com/@Islam_museum" },
  { name: "Instagram", handle: "@islam_museum", href: "https://www.instagram.com/islam_museum/" },
];
const shown = accounts.filter((a) => a.href);
const { title } = Astro.props as { title: string };
---
<nav class="social" aria-label={title}>
  <span class="social-title">{title}</span>
  <ul>
    {shown.map((a) => (
      <li>
        <a href={a.href} rel="noopener" aria-label={`${a.name} ${a.handle}`} title={`${a.name} ${a.handle}`}>
          {a.name === "X" && <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>}
          {a.name === "TikTok" && <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.9 2.9 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43V8.97a8.16 8.16 0 0 0 4.77 1.52V7.05a4.79 4.79 0 0 1-1.04-.36z" /></svg>}
          {a.name === "YouTube" && <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12z" /></svg>}
          {a.name === "Instagram" && <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" /><circle cx="12" cy="12" r="4.3" /><circle cx="17.6" cy="6.4" r="0.6" fill="currentColor" /></svg>}
          {a.name === "WhatsApp" && <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3.5 20.5l1.3-4.2A9 9 0 1 1 8.7 19.2z" /><path d="M9 8.5c0 3 2.5 5.5 5.5 6.5l1.2-1.4-1.7-.9-.7.7c-1-.5-1.9-1.4-2.4-2.4l.7-.7-.9-1.7z" fill="currentColor" stroke="none" /></svg>}
          <span class="sr-only">{a.name} {a.handle}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .social { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .6rem 1rem; margin: 0 0 1rem; }
  .social-title { font-size: .95rem; color: var(--muted); }
  .social ul { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  .social a { display: inline-flex; align-items: center; justify-content: center; width: 2.6rem; height: 2.6rem; border: 1px solid var(--line); border-radius: 50%; color: var(--fg); text-decoration: none; }
  .social a:hover, .social a:focus-visible { border-color: var(--fg); }
  .social a:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .social svg { width: 1.2rem; height: 1.2rem; }
</style>
