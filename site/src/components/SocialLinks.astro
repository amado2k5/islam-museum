---
// Official accounts, the "Hudhud's Story Time" podcast and the museum's "Voices of the Museum" album, shown in the footer. Icons are inline SVG (no script, no network call), decorative, and each link carries its platform and handle as its accessible name. Podcast URLs come from the central links module (../lib/links) — add new platforms there, never here.
import { APPLE_PODCASTS, SPOTIFY, SOUNDCLOUD } from "../lib/links";
interface Account { name: string; handle: string; href?: string; }
const accounts: Account[] = [
  { name: "WhatsApp", handle: "islam_museum", href: "https://wa.me/14168270144" },
  { name: "TikTok", handle: "@islam.museum", href: "https://www.tiktok.com/@islam.museum" },
  { name: "YouTube", handle: "@Islam_museum", href: "https://www.youtube.com/@Islam_museum" },
  { name: "Instagram", handle: "@islam_museum", href: "https://www.instagram.com/islam_museum/" },
  { name: "Facebook", handle: "islam.museum", href: "https://www.facebook.com/profile.php?id=61595530199728" },
  { name: "Telegram", handle: "@islam_museum", href: "https://t.me/islam_museum" },
  { name: "Apple Podcasts", handle: "Hudhud's Story Time", href: APPLE_PODCASTS },
  { name: "Spotify", handle: "Hudhud's Story Time", href: SPOTIFY },
  { name: "SoundCloud", handle: "Voices of the Museum", href: SOUNDCLOUD },
];
const shown = accounts.filter((a) => a.href);
const { title } = Astro.props as { title: string };
