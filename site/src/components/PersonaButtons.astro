---
// Five doors into five views of the museum (landing page, under the Grand Tour button). Plain links, no script.
import { ui, type Lang } from "../lib/i18n";
import { PERSONAS, PERSONA_COLOR, personaPath } from "../lib/personas";
const { lang } = Astro.props as { lang: Lang };
const P = ui(lang).personas;
---
<nav class="pbtns" aria-label={P.eyebrow}>
  <p class="pbtns-eyebrow ui">{P.eyebrow}</p>
  <ul>
    {PERSONAS.map((k) => (
      <li><a class="pbtn" style={`--pa:${PERSONA_COLOR[k]}`} href={personaPath(lang, k)}><span>{P[k].btn}</span> <span class="flip" aria-hidden="true">→</span></a></li>
    ))}
  </ul>
</nav>
<style>
  .pbtns { margin: 1.4rem auto 0; max-width: 60rem; }
  .pbtns-eyebrow { margin: 0 0 .6rem; font-size: .85rem; color: var(--muted); letter-spacing: .02em; }
  .pbtns ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; justify-content: center; }
  .pbtn { display: inline-flex; align-items: center; gap: .5rem; padding: .7rem 1.2rem; min-height: 44px; border-radius: 999px; background: var(--pa); color: #fff; font-family: var(--sans); font-weight: 600; font-size: .98rem; text-decoration: none; border: 2px solid transparent; transition: transform .15s ease, box-shadow .15s ease; }
  .pbtn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px color-mix(in srgb, var(--pa) 35%, transparent); text-decoration: none; }
  .pbtn:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }
  :global(html:is([lang="ar"], [lang="ur"])) .pbtn { font-family: var(--ar-body); font-size: 1.06rem; }
  @media (prefers-reduced-motion: reduce) { .pbtn { transition: none; } .pbtn:hover { transform: none; } }
  @media (forced-colors: active) { .pbtn { border-color: CanvasText; } }
</style>
