---
import { byId, href, labelOf } from "../lib/graph";
import type { Lang } from "../lib/i18n";
const { span, ids = [], lang, self } = Astro.props as { span: { earliest: number; latest: number }; ids?: string[]; lang: Lang; self: string };
const rows = [{ id: self, span }, ...ids.map((i) => ({ id: i, span: byId.get(i)?.span! })).filter((r) => r.span)];
// The scale is cut from the entity's own dates (and its contemporaries), with room on both sides for the marker.
const lo = Math.min(...rows.map((r) => r.span.earliest)), hi = Math.max(...rows.map((r) => r.span.latest));
const width = Math.max(hi - lo, 30);
const margin = Math.max(width * 0.15, 8);
const total = width + 2 * margin;
const step = total <= 120 ? 10 : total <= 260 ? 25 : total <= 600 ? 50 : 100;
const MIN = Math.floor((lo - margin) / step) * step, MAX = Math.ceil((hi + margin) / step) * step;
// Build-time check: every marker lies on the scale (a marker outside it would be clipped, as the Hijra one was before).
if (!rows.every((r) => r.span.earliest >= MIN && r.span.latest <= MAX)) throw new Error(`timeline strip for ${self}: a marker falls outside ${MIN}–${MAX}`);
const x = (y: number) => ((y - MIN) / (MAX - MIN)) * 100;
const ticks: number[] = [];
for (let t = MIN; t <= MAX; t += step) ticks.push(t);
const dir = lang === "ar" ? "rtl" : "ltr";
---
<figure style="margin:0" class="no-print">
  <svg viewBox={`0 0 100 ${rows.length * 7 + 8}`} role="img" aria-label={rows.map((r) => `${labelOf(byId.get(r.id)!, lang)}: ${Math.floor(r.span.earliest)}–${Math.floor(r.span.latest)}`).join("; ")} style="width:100%;height:auto;display:block;direction:ltr">
    {ticks.map((t) => <g><line x1={x(t)} x2={x(t)} y1="0" y2={rows.length * 7 + 2} stroke="currentColor" opacity=".12" stroke-width=".25" /><text x={x(t)} y={rows.length * 7 + 7} font-size="2.6" text-anchor="middle" fill="currentColor" opacity=".6">{t}</text></g>)}
    {rows.map((r, i) => (
      <g>
        <rect x={x(r.span.earliest)} y={i * 7 + 1.5} width={Math.max(x(r.span.latest) - x(r.span.earliest), 0.6)} height="4" rx="1" fill={i === 0 ? "var(--gold)" : "var(--lapis)"} opacity={i === 0 ? 1 : 0.55} />
      </g>
    ))}
  </svg>
  {ids.length > 0 && (
    <figcaption class="ui muted" style="font-size:.85rem;margin-top:6px">
      {ids.slice(0, 6).map((i, k) => <><a href={href(lang, i)} style="color:inherit">{labelOf(byId.get(i)!, lang)}</a>{k < Math.min(ids.length, 6) - 1 ? " · " : ""}</>)}
    </figcaption>
  )}
</figure>
