---
// The Place wing: the map of the Islamic world and, under it, the index of every place.
//
// The map is plain SVG drawn at build time (land, the twelve regions, one dot per place at its real position), so the
// page reads without JavaScript: a reader then gets the picture and the index. With JavaScript the plain script
// site/public/shell/place-map.js takes the same SVG over: pan, zoom, search, the year bar, the panel and the orbit of
// people and events around a place. Its data is fetched on demand from /<lang>/place-map/*.json
// (site/src/pages/[lang]/place-map/[file].json.ts); nothing but the picture and the index is in the HTML.
// Styles are the plain file site/public/shell/place-map.css, linked from the wing page's head only, so that no other
// page's HTML changes when the map does (docs/site/README.md, "site-wide numbers").
// Requirements: docs/engineering/19-islam-map-requirements.md. Review and decisions: docs/site/place-map-review.md.
import { ui, NUM_LOCALE, type Lang } from "../lib/i18n";
import { labelOf, realNodes } from "../lib/graph";
import { allRelationTypes, dataVersion, dotPaths, ELSEWHERE, H, placeIndex, placeMapModel, REGION_IDS, relationLabels, SHARDS, W } from "../lib/place-map";
import { wholeYears } from "../lib/place-map-core";

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = ui(lang);
const V = T.map.viewer;
const m = placeMapModel();
const dots = dotPaths(m);
const index = placeIndex(lang);
const fmt = new Intl.NumberFormat(NUM_LOCALE[lang]);
const n = (tpl: string, count: number) => tpl.replace("{n}", fmt.format(count));
const regionName = (id: string) => (id === ELSEWHERE ? V.elsewhere : V.regions[id]) as string;
const pad = 14;
const viewBox = `${(m.home[0] - pad).toFixed(1)} ${(m.home[1] - pad).toFixed(1)} ${(m.home[2] - m.home[0] + pad * 2).toFixed(1)} ${(m.home[3] - m.home[1] + pad * 2).toFixed(1)}`;
// Eras that name a region for a span of years: shown under the region's own name at the chosen year, never instead of it.
const eras = realNodes
  .filter((x) => x.class === "period" && (x as any).span && labelOf(x, lang))
  .map((x) => ({ name: labelOf(x, lang), y: wholeYears((x as any).span), r: (x.regions ?? []).map((id: string) => REGION_IDS.indexOf(id)).filter((i: number) => i >= 0) }))
  .filter((e) => e.r.length);
const total = m.places.length;
// Region names for the picture as it stands without the script (the script places its own, measured, names). Widths
// are estimated from the letter count, and a name that would lie on an earlier one is moved a line up or down.
const nameSize = lang === "en" ? 7 : 8;
const nameBoxes: number[][] = [];
const staticNames = m.regions.map((r) => {
  const name = regionName(r.id), w = name.length * nameSize * (lang === "en" ? 0.5 : 0.46) + 6, line = nameSize * 1.35;
  for (const dy of [0, -line, line, -2 * line, 2 * line, -3 * line, 3 * line]) {
    const b = [r.ax - w / 2, r.ay + dy - line, r.ax + w / 2, r.ay + dy + 1];
    if (nameBoxes.some((o) => b[0] < o[2] && b[2] > o[0] && b[1] < o[3] && b[3] > o[1])) continue;
    nameBoxes.push(b);
    return { x: r.ax, y: Math.round((r.ay + dy) * 100) / 100, name };
  }
  return { x: r.ax, y: r.ay, name };
});
// The year bar's backdrop: how many dated records fall in each 25 years (square-root scale, so that thin centuries still show).
const peak = Math.sqrt(Math.max(...m.bins, 1));
const bars = m.bins.map((b, i) => { const h = Math.round(Math.max(0.6, (Math.sqrt(b) / peak) * 10) * 100) / 100; return { x: i + 0.1, y: Math.round((10 - h) * 100) / 100, h }; });
const config = {
  lang, dir: lang === "en" ? "ltr" : "rtl", base: `/${lang}/place-map/`, v: dataVersion(lang), page: `/${lang}/`, W, H, home: m.home, core: m.core, shards: SHARDS,
  ahMin: m.ahMin, ahMax: m.ahMax, startAh: m.startAh, ce: m.ce, bins: m.bins,
  regions: [...m.regions.map((r) => ({ id: r.id, name: regionName(r.id), bbox: r.bbox, ax: r.ax, ay: r.ay, count: r.count })), { id: ELSEWHERE, name: regionName(ELSEWHERE), bbox: null, ax: 0, ay: 0, count: m.byRegion[REGION_IDS.length].length }],
  eras, kinds: V.kind, cls: T.class, rel: relationLabels(lang, allRelationTypes()), numLocale: NUM_LOCALE[lang], total,
  t: V,
};
const ICON = {
  search: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm9 16-3.6-3.6",
  full: "M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5",
  plus: "M12 5v14M5 12h14",
  minus: "M5 12h14",
  world: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18",
  play: "M8 5.5v13l11-6.5z",
  panel: "M4 6h16M4 12h16M4 18h10",
};
---
<section class="pm" id="place-map" aria-labelledby="pm-h">
  <div class="pm-top">
    <div class="pm-title" data-pagefind-body>
      <h1 id="pm-h" class="display">{T.wings.place.title}</h1>
      <p class="pm-lede ui">{T.wings.place.blurb}</p>
    </div>
    <nav class="pm-crumbs ui pm-js" aria-label={V.crumbs}><ol></ol></nav>
    <div class="pm-search pm-js">
      <label class="sr-only" for="pm-q">{V.search}</label>
      <svg class="pm-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.search} /></svg>
      <input id="pm-q" class="ui" type="search" role="combobox" aria-expanded="false" aria-controls="pm-results" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder={V.search_ph} />
      <ul id="pm-results" class="ui" role="listbox" aria-label={V.search} hidden></ul>
    </div>
    <button type="button" class="pm-btn pm-fullbtn pm-js" aria-pressed="false" aria-label={V.fullscreen} title={V.fullscreen}><svg class="pm-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.full} /></svg></button>
  </div>
  <div class="pm-stage">
    <div class="pm-view" role="group" aria-label={n(V.view_label, total)} aria-describedby="pm-help">
      <svg class="pm-svg" viewBox={viewBox} preserveAspectRatio="xMidYMid meet" focusable="false">
        <g class="pm-cam">
          <path class="pm-land" d={m.land} />
          <path class="pm-borders" d={m.borders} />
          <g class="pm-regions">
            {m.regions.map((r, i) => (
              <a class="pm-region" href={`#pm-r-${r.id}`} data-r={i} aria-label={`${regionName(r.id)}: ${n(V.region_count, r.count)}`} style={`--tint:${r.tint}`}><path d={r.d} /></a>
            ))}
          </g>
          <g class="pm-dots" aria-hidden="true">
            {[0, 1, 2].map((t) => <path class={`pm-halo t${t}`} d={dots[t][3]} />)}
            {[0, 1, 2].map((t) => [0, 1, 2, 3].map((s) => <path class={`pm-dot t${t} s${s}`} d={dots[t][s]} />))}
          </g>
          <g class="pm-names" aria-hidden="true">
            {staticNames.map((t) => <text x={t.x} y={t.y}>{t.name}</text>)}
          </g>
        </g>
      </svg>
      <svg class="pm-links pm-js" aria-hidden="true" focusable="false"></svg>
      <div class="pm-over pm-js ui"></div>
    </div>
    <p id="pm-help" class="sr-only">{V.help}</p>
    <aside class="pm-panel pm-js ui" aria-label={V.panel}>
      <button type="button" class="pm-panel-toggle" aria-expanded="true" aria-controls="pm-panel-body"><svg class="pm-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.panel} /></svg><span class="pm-panel-title"></span></button>
      <div id="pm-panel-body" class="pm-panel-body" tabindex="-1"></div>
      <details class="pm-legend">
        <summary>{V.legend_h}</summary>
        <ul>
          <li><span class="pm-key k-size" aria-hidden="true"><i></i><i></i><i></i></span>{V.legend_size}</li>
          <li><span class="pm-key k-s3" aria-hidden="true"><i></i></span>{V.legend_active}</li>
          <li><span class="pm-key k-s2" aria-hidden="true"><i></i></span>{V.legend_earlier}</li>
          <li><span class="pm-key k-s1" aria-hidden="true"><i></i></span>{V.legend_notyet}</li>
          <li><span class="pm-key k-s0" aria-hidden="true"><i></i></span>{V.legend_undated}</li>
          <li class="pm-key-shapes">
            {(["person", "event", "building", "place", "work", "group"] as const).map((c) => <span><span class={`pm-shape c-${c}`} aria-hidden="true"></span>{T.class[c]}</span>)}
          </li>
          <li class="pm-key-help">{V.help}</li>
        </ul>
      </details>
    </aside>
    <div class="pm-zoom pm-js" role="group" aria-label={V.zoom}>
      <button type="button" class="pm-btn" data-act="in" aria-label={V.zoom_in} title={V.zoom_in}><svg class="pm-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.plus} /></svg></button>
      <button type="button" class="pm-btn" data-act="out" aria-label={V.zoom_out} title={V.zoom_out}><svg class="pm-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.minus} /></svg></button>
      <button type="button" class="pm-btn" data-act="home" aria-label={V.reset} title={V.reset}><svg class="pm-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.world} /></svg></button>
    </div>
    <div class="pm-time pm-js ui" role="group" aria-label={V.time}>
      <button type="button" class="pm-btn pm-play" aria-pressed="false" aria-label={V.play} title={V.play}><svg class="pm-ico fill" viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.play} /></svg></button>
      <button type="button" class="pm-btn pm-step" data-step="-10" aria-label={V.step_back} title={V.step_back}><span aria-hidden="true">−10</span></button>
      <div class="pm-slider">
        <svg class="pm-bins" viewBox={`0 0 ${m.bins.length} 10`} preserveAspectRatio="none" aria-hidden="true">
          {bars.map((b) => <rect x={b.x} y={b.y} width="0.8" height={b.h} />)}
        </svg>
        <input id="pm-year" type="range" min={m.ahMin} max={m.ahMax} step="1" value={m.startAh} aria-label={V.year} />
      </div>
      <button type="button" class="pm-btn pm-step" data-step="10" aria-label={V.step_fwd} title={V.step_fwd}><span aria-hidden="true">+10</span></button>
      <output class="pm-year" for="pm-year"></output>
    </div>
    <div class="pm-tip ui pm-js" hidden></div>
    <div class="pm-pop ui pm-js" role="dialog" aria-label={V.choose_place} hidden></div>
    <p class="pm-status ui pm-js" role="status" aria-live="polite"></p>
    <p class="pm-credit ui">{V.credit}</p>
  </div>
  <p class="pm-more ui"><a href="#pm-index">{n(V.to_index, total)} <span aria-hidden="true">↓</span></a></p>
  <noscript><p class="pm-nojs ui muted">{V.nojs}</p></noscript>
</section>
<section class="wrap pm-index" id="pm-index" aria-labelledby="pm-index-h" data-pagefind-ignore>
  <h2 id="pm-index-h" class="display">{V.index_h}</h2>
  <p class="ui muted">{n(V.index_lede, total)}</p>
  {index.groups.filter((g) => g.places.length).map((g) => (
    <details id={`pm-r-${g.id}`} class="pm-group">
      <summary class="ui"><span class="pm-group-name">{regionName(g.id)}</span> <span class="pm-group-n">{n(V.region_count, g.places.length)}</span></summary>
      <ul class="pm-list ui">{g.places.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
    </details>
  ))}
  {index.others.length > 0 && (
    <details id="pm-r-others" class="pm-group">
      <summary class="ui"><span class="pm-group-name">{V.index_others}</span> <span class="pm-group-n">{fmt.format(index.others.length)}</span></summary>
      <ul class="pm-list ui">{index.others.map((p) => <li><a href={p.href}>{p.label}</a> <span class="muted">{T.class[p.cls]}</span></li>)}</ul>
    </details>
  )}
</section>
<script type="application/json" id="pm-config" set:html={JSON.stringify(config).replace(/</g, "\\u003c")}></script>
<script is:inline src="/shell/place-map.js" defer></script>
