---
// The Timeline Explorer's front door on the homepage (correction prompt §6): a feature band right after the day-cards,
// with a timeline motif, the verbatim copy, four subject chips and a mini-search over the prepared subjects.
// No request and no model call: the search reads the index written into this page.
import { ui, type Lang } from "../lib/i18n";
import { subjects, subjectHref, pick } from "../lib/explorer";

const { lang } = Astro.props as { lang: Lang };
const B = ui(lang).time_browser;
const all = subjects();
const has = new Set(all.map((s) => s.id));
const chips = [
  { id: "person/salah-al-din-yusuf-ibn-ayyub", label: B.m_chip_1 },
  { id: "place/al-andalus", label: B.m_chip_2 },
  { id: "place/baghdad", label: B.m_chip_3 },
  { id: "period/abbasid-early", label: B.m_chip_4 },
].filter((c) => has.has(c.id));
const index = JSON.stringify(all.map((s) => ({ href: subjectHref(lang, s.id), label: pick(s.title, lang), keys: Object.values(s.title).join(" ").toLowerCase() }))).replace(/</g, "\\u003c");
const home = `/${lang}/time-browser/`;
---
<section class="xm" aria-labelledby="xm-title" data-xm>
  <a class="xm-cover" href={home} aria-hidden="true" tabindex="-1"></a>
  <div class="xm-line" aria-hidden="true">
    {[0, 1, 2, 3, 4, 5, 6].map((i) => <span class={`xm-node${i === 3 ? " xm-mid" : ""}`} style={`--i:${i}`}></span>)}
  </div>
  <p class="xm-eyebrow">{B.m_eyebrow}</p>
  <h2 id="xm-title" class="xm-title"><a href={home}>{B.m_headline}</a></h2>
  <p class="xm-promise">{B.m_promise}</p>
  <p><a class="xm-cta" href={home}>{B.m_cta}</a></p>
  <ul class="xm-chips" role="list">
    {chips.map((c) => <li><a class="xm-chip" href={subjectHref(lang, c.id)}>{c.label}</a></li>)}
  </ul>
  <form class="xm-search" role="search" onsubmit="return false">
    <label class="sr-only" for="xm-q">{B.m_search_hint}</label>
    <input id="xm-q" type="search" autocomplete="off" placeholder={B.m_search_hint} />
    <ul class="xm-results" data-xm-results role="list"></ul>
  </form>
  <script type="application/json" id="xm-index" set:html={index}></script>
</section>

<style>
  .xm { position: relative; margin-block: 18px 6px; padding: 22px 20px; border-radius: 16px; border: 1px solid color-mix(in srgb, var(--gold, #c9a227) 50%, transparent);
    background: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--gold, #c9a227) 18%, transparent), transparent 70%); text-align: center; }
  .xm-cover { position: absolute; inset: 0; z-index: 0; }
  .xm > :not(.xm-cover) { position: relative; z-index: 1; }
  .xm-line { display: flex; justify-content: space-between; align-items: center; margin: 4px auto 14px; max-width: 420px; height: 18px;
    background: linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat; color: color-mix(in srgb, var(--gold, #c9a227) 55%, transparent); }
  .xm-node { width: 10px; height: 10px; border-radius: 50%; background: var(--gold, #c9a227); opacity: .35; animation: xm-lit 3s ease-in-out calc(var(--i) * .35s) infinite; }
  .xm-mid { width: 16px; height: 16px; opacity: 1; box-shadow: 0 0 12px var(--gold, #c9a227); }
  @keyframes xm-lit { 0%, 100% { opacity: .35; } 40% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .xm-node { animation: none; opacity: 1; } }
  .xm-eyebrow { margin: 0; font-size: .85rem; letter-spacing: .04em; color: var(--gold, #c9a227); }
  .xm-title { margin: 6px 0; font-size: clamp(1.4rem, 3vw, 2rem); }
  .xm-title a { color: inherit; text-decoration: none; }
  .xm-promise { max-width: 60ch; margin: 0 auto 12px; }
  .xm-cta { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px; border-radius: 999px; background: var(--gold, #c9a227); color: #111; font-weight: 600; text-decoration: none; }
  .xm-chips { list-style: none; padding: 0; margin: 14px 0 10px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .xm-chip { display: inline-flex; align-items: center; min-height: 44px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--gold, #c9a227); text-decoration: none; color: inherit; }
  .xm-search { max-width: 420px; margin: 0 auto; }
  .xm-search input { width: 100%; min-height: 44px; padding: 8px 12px; }
  .xm-results { list-style: none; padding: 0; margin: 6px 0 0; text-align: start; }
  .xm-results a { display: block; min-height: 44px; padding: 10px 12px; }
</style>

<script>
  // Mini-search over the prepared subjects in this page. No request, no model call.
  const input = document.getElementById("xm-q") as HTMLInputElement | null;
  const list = document.querySelector<HTMLElement>("[data-xm-results]");
  const raw = document.getElementById("xm-index")?.textContent;
  if (input && list && raw) {
    const index = JSON.parse(raw) as { href: string; label: string; keys: string }[];
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      const hits = q ? index.filter((s) => s.keys.includes(q)).slice(0, 6) : [];
      list.replaceChildren(...hits.map((s) => {
        const li = document.createElement("li"); const a = document.createElement("a");
        a.href = s.href; a.textContent = s.label; li.append(a); return li;
      }));
    });
  }
</script>
