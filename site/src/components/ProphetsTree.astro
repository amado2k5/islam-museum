---
// The Prophets' Tree of the Messengers Browser (docs/plan/41-messengers-browser.md, "The tree"): one inline SVG drawn
// at build time from scripts/messengers-tree.ts and the graph. Every prophet is a real link, so the tree reads and
// navigates without JavaScript; the script (site/src/scripts/prophets-tree.ts) adds the growth, the lit path to the
// root and the detail panel, whose text is cloned from the outline list rendered below the drawing. The build fails
// if a drawn branch has no edge behind it (checkMessengersTree).
import { ui, fmt, type Lang } from "../lib/i18n";
import { byId, graph, href, labelOf, summaryOf, edgesFrom } from "../lib/graph";
import { num } from "../lib/nav";
import { messengerSubjectsById } from "../lib/messengers";
import { messengerTopicsOf } from "../../../scripts/messengers";
import {
  MESSENGERS_TREE, MESSENGERS_TREE_TIES, TREE_STEM, TREE_WIDTH, TREE_HEIGHT, TREE_STEM_X, TREE_STEM_FOOT,
  treeY, treePath, chainBetween, checkMessengersTree, pillWidth, pillHeight, type TreeSpec,
} from "../../../scripts/messengers-tree";
import type { Node } from "../../../scripts/build-graph";

interface Props { lang: Lang }
const { lang } = Astro.props;
const G = (ui(lang) as any).messengers;
const R = G.tree;

const written = new Set(graph.edges.filter((e) => !e.inverse).map((e) => `${e.from}|${e.type}|${e.to}`));
const problems = checkMessengersTree({
  has: (id) => !!byId.get(id) && !byId.get(id)!.stub,
  edge: (from, type, to) => written.has(`${from}|${type}|${to}`),
  names: (passage, person) => { const p = byId.get(passage); return !!p && (messengerTopicsOf(p) as string[]).includes(person); },
});
if (problems.length) throw new Error(`The Prophets' Tree disagrees with the graph:\n- ${problems.join("\n- ")}`);

// the short name: a label's parenthetical gloss ("Ibrahim (Abraham)") does not fit a leaf and is on the prophet's page
const nameOf = (id: string) => labelOf(byId.get(id) as Node, lang).replace(/\s*\u2066?\(.*$/, "").trim();
const linkOf = (id: string) => (messengerSubjectsById.has(id) ? `/${lang}/messengers/${id.split("/")[1]}/` : href(lang, id));
const f = (n: number) => Math.round(n * 10) / 10;

interface Drawn extends TreeSpec { y: number; w: number; h: number; label: string; top: number; bottom: number }
const drawn: Drawn[] = MESSENGERS_TREE.map((s) => {
  const label = nameOf(s.id);
  const y = treeY(s.r);
  const h = pillHeight(s.size);
  return { ...s, y, h, w: pillWidth(label, s.size), label, top: y - h / 2, bottom: y + h / 2 };
});
const D = new Map(drawn.map((n) => [n.id, n]));

// ---- the central stem above Ibrahim: one dashed line, cut where each twig leaves it, so a path can be lit up to its twig
const foot = D.get(TREE_STEM_FOOT)!;
const attachY = (n: Drawn) => (n.x === TREE_STEM_X ? n.bottom : n.y + 42);
const stemNodes = TREE_STEM.map((s) => D.get(s.id)!).sort((a, b) => attachY(b) - attachY(a));
const stemIndex = new Map(stemNodes.map((n, i) => [n.id, i]));
const stemSegs = stemNodes.map((n, i) => {
  const from = i === 0 ? foot.top : attachY(stemNodes[i - 1]);
  return { k: `stem:${i}`, d: `M${TREE_STEM_X} ${f(from)} V${f(attachY(n))}`, r: n.r };
}).filter((s, i) => i === 0 || attachY(stemNodes[i - 1]) !== attachY(stemNodes[i]));

// ---- one drawn link per node, keyed by the node it belongs to
interface Link { k: string; d: string; cls: string; r: number; width?: number }
const links: Link[] = [];
const chains: Record<string, { ids: string[]; disputed: number }> = {};
const vineLabels: { x: number; y: number; text: string; r: number; k: string }[] = [];
const VINE_X = 516;
for (const n of drawn) {
  if (n.kind === "root" || n.kind === "kin") continue;
  const p = D.get(n.parent!)!;
  if (n.stem) {
    if (n.x !== TREE_STEM_X) {
      const edge = n.x < TREE_STEM_X ? n.x + n.w / 2 : n.x - n.w / 2;
      links.push({ k: n.id, d: `M${TREE_STEM_X} ${f(attachY(n))} Q${TREE_STEM_X} ${f(n.y)} ${f(edge)} ${f(n.y)}`, cls: n.kind, r: n.r });
    }
    continue;
  }
  if (n.kind === "lineage") {
    const c = chainBetween(p.id, n.id);
    chains[n.id] = c;
    const mid = (p.r + n.r) / 2;
    const agreed = c.disputed === 0;
    const d = n.size === "crown"
      ? `M${p.x} ${f(p.top)} C${p.x} ${f(treeY(p.r + 0.6))} ${VINE_X} ${f(treeY(p.r + 0.5))} ${VINE_X} ${f(treeY(p.r + 1.2))} V${f(treeY(n.r - 1.1))} C${VINE_X} ${f(n.y)} ${f(n.x + n.w / 2 + 70)} ${f(n.y)} ${f(n.x + n.w / 2)} ${f(n.y)}`
      : `M${p.x} ${f(p.top)} C${p.x} ${f(treeY(p.r + 0.75))} ${VINE_X} ${f(treeY(p.r + 0.55))} ${VINE_X} ${f(treeY(p.r + 1.4))} V${f(treeY(n.r - 1.1))} C${VINE_X} ${f(treeY(n.r - 0.6))} ${n.x} ${f(treeY(n.r - 0.6))} ${n.x} ${f(n.bottom)}`;
    links.push({ k: n.id, d, cls: agreed ? "vine" : "vine disputed", r: mid });
    vineLabels.push({
      k: n.id, x: VINE_X + 21, y: treeY(n.size === "crown" ? (p.r + 1.2 + n.r - 1.1) / 2 : (p.r + 1.4 + n.r - 1.1) / 2), r: mid,
      text: fmt(agreed ? R.vine_agreed : R.vine_disputed, { n: num(c.ids.length, lang) }),
    });
    continue;
  }
  const straight = p.x === n.x;
  const mid = (p.top + n.bottom) / 2;
  links.push({
    k: n.id,
    d: straight ? `M${p.x} ${f(p.top)} V${f(n.bottom)}` : `M${p.x} ${f(p.top)} C${p.x} ${f(mid)} ${n.x} ${f(mid)} ${n.x} ${f(n.bottom)}`,
    cls: straight && n.kind === "order" ? "trunk" : n.kind,
    r: n.r,
    width: straight && n.kind === "order" ? 24 - n.r * 3 : undefined,
  });
}

// ---- kinship ties: a dotted line between the two pills, by their nearest edges
const ties = MESSENGERS_TREE_TIES.map((t, i) => {
  const a = D.get(t.a)!, b = D.get(t.b)!;
  const main = a.kind === "kin" ? a : b.kind === "kin" ? b : undefined;
  let d: string;
  if (Math.abs(a.y - b.y) < 60) {
    const [l, r] = a.x < b.x ? [a, b] : [b, a];
    const x1 = l.x + l.w / 2, x2 = r.x - r.w / 2;
    d = `M${f(x1)} ${f(l.y)} C${f((x1 + x2) / 2)} ${f(l.y)} ${f((x1 + x2) / 2)} ${f(r.y)} ${f(x2)} ${f(r.y)}`;
  } else {
    const [lo, hi] = a.y > b.y ? [a, b] : [b, a];
    d = `M${lo.x} ${f(lo.top)} C${lo.x} ${f((lo.top + hi.bottom) / 2)} ${hi.x} ${f((lo.top + hi.bottom) / 2)} ${hi.x} ${f(hi.bottom)}`;
  }
  return { ...t, k: main ? main.id : `tie:${i}`, d, r: Math.max(a.r, b.r) };
});

// ---- what lights up for a node: its own link, every link below it down to the root, and the stem up to its twig
const litOf = (id: string): string => {
  const keys = new Set<string>();
  for (const pid of treePath(id)) {
    keys.add(`n:${pid}`);
    keys.add(pid);
    const si = stemIndex.get(pid);
    if (si !== undefined) for (let i = 0; i <= si; i++) keys.add(`stem:${i}`);
  }
  for (const t of ties) if (t.a === id || t.b === id) keys.add(t.k);
  return [...keys].join(" ");
};

// ---- the outline: one card per prophet, in the tree's order; it is the text alternative and the panel's content
const tieOf = (id: string) => MESSENGERS_TREE_TIES.filter((t) => t.a === id || t.b === id).map((t) => ({ type: t.type, other: t.a === id ? t.b : t.a }));
const noteOf = (a: string, type: string, b: string): string =>
  lang === "ar" ? String(graph.edges.find((e) => !e.inverse && e.type === type && ((e.from === a && e.to === b) || (e.from === b && e.to === a)))?.note ?? "") : "";
const basisOf = (n: Drawn): string => {
  const p = n.parent ? nameOf(n.parent) : "";
  if (n.kind === "root") return R.basis.root;
  if (n.kind === "child") return fmt(R.basis.child, { p });
  if (n.kind === "progeny") return R.basis.progeny;
  if (n.kind === "kin") return R.basis.kin;
  if (n.kind === "lineage") {
    const c = chains[n.id];
    return fmt(c.disputed ? R.basis.lineage_disputed : R.basis.lineage_agreed, { p, n: num(c.ids.length, lang) });
  }
  return n.stem ? R.basis.order_stem : fmt(R.basis.order, { p });
};
const cards = drawn.map((n) => {
  const node = byId.get(n.id) as Node;
  const subject = messengerSubjectsById.get(n.id);
  const summary = summaryOf(node, lang).replace(/\s+([،؛])/g, "$1");
  const parents = edgesFrom(n.id).filter((e) => !e.inverse && e.type === "child_of").map((e) => byId.get(e.to)).filter((x): x is Node => !!x && !x.stub);
  const counts = subject
    ? (["quran", "sunnah", "seerah", "books"] as const).filter((c) => subject.counts[c] > 0).map((c) => `${G[`${c}_title`]} · ${num(subject.counts[c], lang)}`)
    : [];
  return {
    n, node, parents, counts,
    depth: treePath(n.id).length - 1,
    summary: summary.length > 240 ? `${summary.slice(0, 240).replace(/\s+\S*$/, "")}…` : summary,
    basis: basisOf(n),
    basisRef: n.basis ? byId.get(n.basis) : undefined,
    ties: tieOf(n.id).map((t) => ({ ...t, note: noteOf(n.id, t.type, t.other) })),
    chain: n.kind === "lineage",
  };
});
const delay = (r: number) => `--d:${Math.round(r * 95)}ms`;
const adam = D.get("person/adam")!;
const legend: [string, string][] = [["child", R.legend.child], ["vine", R.legend.vine], ["vine disputed", R.legend.vine_disputed], ["progeny", R.legend.progeny], ["order", R.legend.order], ["tie", R.legend.tie]];
---
<section aria-labelledby="prophets-tree-title" class="pt" data-pt style="margin-top:2rem">
  <div data-pagefind-body>
    <h2 id="prophets-tree-title">{R.title}</h2>
    <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{R.note}</p>
  </div>
  <ul class="pt-legend ui" aria-label={R.legend_title}>
    {legend.map(([cls, text]) => (
      <li><svg viewBox="0 0 44 12" width="44" height="12" aria-hidden="true" focusable="false"><path class={`pt-link ${cls}`} d="M2 6 H42" /></svg>{text}</li>
    ))}
  </ul>
  <div class="pt-wrap">
    <figure class="pt-figure">
      <svg class="pt-svg" viewBox={`0 0 ${TREE_WIDTH} ${f(TREE_HEIGHT)}`} role="group" aria-labelledby="prophets-tree-title" direction={lang === "en" ? "ltr" : "rtl"}>
        <g class="pt-deco" aria-hidden="true">
          <circle cx="110" cy={f(treeY(5.7))} r="118" /><circle cx="290" cy={f(treeY(8.2))} r="176" /><circle cx="470" cy={f(treeY(8.6))} r="96" />
          <circle cx="270" cy={f(treeY(11.4))} r="168" /><circle cx="280" cy={f(treeY(13.4))} r="112" /><circle cx="280" cy={f(treeY(2.9))} r="150" />
          <path class="pt-ground" d={`M60 ${f(adam.bottom + 26)} Q280 ${f(adam.bottom + 6)} 500 ${f(adam.bottom + 26)}`} />
          <path class="pt-roots" d={`M280 ${f(adam.bottom)} q-6 22 -62 34 M280 ${f(adam.bottom)} q2 24 -18 42 M280 ${f(adam.bottom)} q0 26 24 42 M280 ${f(adam.bottom)} q8 20 66 32`} />
        </g>
        <g class="pt-links" aria-hidden="true">
          {stemSegs.map((s) => <path class="pt-el pt-link stem" data-k={s.k} d={s.d} style={delay(s.r)} />)}
          {links.map((l) => <path class={`pt-el pt-link ${l.cls}`} data-k={l.k} d={l.d} style={`${delay(l.r)}${l.width ? `;stroke-width:${f(l.width)}px` : ""}`} />)}
          {links.filter((l) => l.cls === "trunk").map((l) => <path class="pt-el pt-link trunk-line" data-k={l.k} d={l.d} style={delay(l.r)} />)}
          {links.filter((l) => l.cls === "vine").map((l) => <path class="pt-el pt-link vine-beads" data-k={l.k} d={l.d} style={delay(l.r)} />)}
          {ties.map((t) => <path class="pt-el pt-link tie" data-k={t.k} d={t.d} style={delay(t.r)} />)}
          {vineLabels.map((v) => <text class="pt-el pt-vine-label" data-k={v.k} x={f(v.x)} y={f(v.y)} transform={`rotate(-90 ${f(v.x)} ${f(v.y)})`} text-anchor="middle" style={delay(v.r)}>{v.text}</text>)}
        </g>
        <g class="pt-nodes">
          {drawn.map((n) => (
            <a class={`pt-el pt-node ${n.size ?? ""}`} href={linkOf(n.id)} data-id={n.id} data-k={`n:${n.id}`} data-lit={litOf(n.id)} style={delay(n.r)}>
              <rect x={f(n.x - n.w / 2)} y={f(n.top)} width={n.w} height={n.h} rx={n.h / 2} />
              <text x={n.x} y={f(n.y)} text-anchor="middle" dominant-baseline="central">{n.label}</text>
            </a>
          ))}
        </g>
      </svg>
    </figure>
    <aside class="pt-panel panel" data-pt-panel aria-live="polite" hidden>
      <p class="ui muted pt-hint" data-pt-hint>{R.hint}</p>
      <div data-pt-body></div>
      <button type="button" class="ui pt-close" data-pt-close hidden>{R.close}</button>
    </aside>
  </div>
  <details class="pt-outline">
    <summary class="ui">{R.outline_title}</summary>
    <ul role="list">
      {cards.map((c) => (
        <li style={`margin-inline-start:${Math.min(c.depth, 6) * 0.9}rem`}>
          <div data-pt-card={c.n.id}>
            <h3><a href={linkOf(c.n.id)}>{c.n.label}</a></h3>
            <p class="pt-basis ui">{c.basis}{c.basisRef && <> <a href={href(lang, c.basisRef.id)}>{labelOf(c.basisRef, lang)}</a></>}</p>
            {c.ties.map((t) => (
              <p class="ui muted pt-tie">{fmt(t.type === "sibling_of" ? R.tie_sibling : R.tie_related, { p: nameOf(t.other) })}{t.note && <span dir="auto"> — {t.note}</span>}</p>
            ))}
            {c.parents.length > 0 && (
              <p class="ui muted pt-tie">{R.parents} {c.parents.map((p, i) => <>{i > 0 && " · "}<a href={href(lang, p.id)}>{labelOf(p, lang)}</a></>)}</p>
            )}
            {c.summary && <p class="pt-summary" dir="auto">{c.summary}</p>}
            {c.counts.length > 0 && <p class="ui muted pt-counts">{c.counts.join(" · ")}</p>}
            <p class="ui pt-actions">
              <a class="pt-open" href={linkOf(c.n.id)}>{R.open}</a>
              {c.chain && <a href={`/${lang}/ansab/#tree-title`}>{R.chain_link}</a>}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </details>
</section>
<style is:inline>
  .pt-wrap { display: grid; gap: 16px; align-items: start; }
  .pt-figure { margin: 0; min-width: 0; background: radial-gradient(120% 80% at 50% 100%, color-mix(in srgb, var(--gold) 9%, transparent), transparent 70%); border: 1px solid var(--line); border-radius: 18px; padding: 6px; }
  .pt-svg { display: block; width: 100%; height: auto; max-width: 620px; margin-inline: auto; font-family: inherit; overflow: visible; }
  .pt-deco circle { fill: var(--gold); opacity: .055; }
  .pt-ground { fill: none; stroke: var(--line); stroke-width: 2; stroke-linecap: round; }
  .pt-roots { fill: none; stroke: color-mix(in srgb, var(--gold) 55%, var(--panel)); stroke-width: 5; stroke-linecap: round; }
  .pt-link { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .pt-link.child { stroke: var(--gold); stroke-width: 5px; }
  .pt-link.vine { stroke: var(--gold); stroke-width: 3px; }
  .pt-link.vine.disputed { stroke-dasharray: 10 8; }
  .pt-link.vine-beads { stroke: var(--gold); stroke-width: 8px; stroke-dasharray: .1 22; }
  .pt-link.progeny { stroke: var(--gold-text); stroke-width: 2.4px; stroke-dasharray: 9 7; }
  .pt-link.order, .pt-link.stem, .pt-link.trunk-line { stroke: var(--muted); stroke-width: 2.4px; stroke-dasharray: .1 8; }
  .pt-link.trunk { stroke: color-mix(in srgb, var(--gold) 42%, var(--panel)); stroke-linecap: butt; }
  .pt-link.tie { stroke: var(--link); stroke-width: 2px; stroke-dasharray: 2 6; }
  .pt-vine-label { font-family: var(--sans); font-size: 15px; fill: var(--muted); }
  .pt-node { cursor: pointer; text-decoration: none; }
  .pt-node rect { fill: var(--card); stroke: color-mix(in srgb, var(--gold) 55%, var(--line)); stroke-width: 1.5px; transition: fill .2s, stroke-width .2s; }
  .pt-node text { fill: var(--fg); font-size: 20px; font-weight: 600; pointer-events: none; }
  .pt-node.major rect { stroke: var(--gold); stroke-width: 3px; }
  .pt-node.major text { font-size: 23px; }
  .pt-node.crown rect { fill: var(--gold); stroke: var(--gold); }
  .pt-node.crown text { fill: #0a2533; font-size: 25px; font-weight: 700; }
  .pt-node:hover rect, .pt-node.is-sel rect { stroke: var(--gold); stroke-width: 3.5px; fill: color-mix(in srgb, var(--gold) 20%, var(--card)); }
  .pt-node.crown:hover rect, .pt-node.crown.is-sel rect { fill: var(--gold); stroke: var(--fg); }
  .pt-node:focus-visible { outline: none; box-shadow: none; }
  .pt-node:focus-visible rect { stroke: var(--focus); stroke-width: 4px; }
  .pt-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; padding: 0; margin: 0 0 1rem; font-size: .84rem; color: var(--muted); max-width: var(--measure); }
  .pt-legend li { display: inline-flex; align-items: center; gap: 8px; }
  .pt-legend svg { flex: none; overflow: visible; }
  .pt-panel { position: sticky; bottom: 10px; border: 1px solid var(--gold); box-shadow: 0 8px 28px rgba(10, 37, 51, .18); padding: 14px 16px; max-height: 46vh; overflow: auto; }
  .pt-panel h3 { margin: 0 0 .25rem; font-size: 1.25rem; }
  .pt-panel p { margin: .35rem 0 0; }
  .pt-hint { margin: 0 !important; font-size: .88rem; }
  @media (max-width: 899px) {
    .pt-panel { max-height: 40vh; padding: 10px 14px; }
    .pt-panel .pt-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .pt-panel .pt-close { margin-top: .4rem; }
  }
  .pt-basis { font-size: .9rem; color: var(--gold-text); font-weight: 600; }
  .pt-tie, .pt-counts { font-size: .84rem; }
  .pt-summary { font-size: .95rem; }
  .pt-actions { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .pt-open { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.1rem; border-radius: 999px; background: var(--gold); color: #0a2533; font-weight: 700; text-decoration: none; }
  .pt-close { margin-top: .6rem; min-height: 44px; padding: 0 1rem; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--fg); font: inherit; font-size: .85rem; cursor: pointer; }
  .pt-outline { margin-top: 1rem; }
  .pt-outline summary { cursor: pointer; min-height: 44px; display: inline-flex; align-items: center; }
  .pt-outline ul { list-style: none; padding: 0; margin: .6rem 0 0; display: grid; gap: 10px; }
  .pt-outline li > div { border-inline-start: 3px solid var(--gold); padding: 4px 12px; }
  .pt-outline h3 { margin: 0; font-size: 1.05rem; }
  .pt-outline p { margin: .25rem 0 0; }
  @media (min-width: 900px) {
    .pt-wrap.has-panel { grid-template-columns: minmax(0, 640px) minmax(260px, 1fr); }
    .pt-panel { top: 132px; bottom: auto; max-height: calc(100vh - 150px); }
  }
  /* lit path: everything not on the way from the chosen prophet to the root steps back */
  .pt-el { transition: opacity .25s ease; }
  .pt-svg.has-lit .pt-el:not(.is-lit) { opacity: .2; }
  /* growth, from the root upward; only when the script has asked for it and motion is welcome */
  .pt-svg.pt-anim .pt-el { opacity: 0; }
  .pt-svg.pt-anim .pt-node { transform: translateY(12px); }
  .pt-svg.pt-anim.pt-grown .pt-el { opacity: 1; transition: opacity .55s ease var(--d, 0ms), transform .6s cubic-bezier(.2, .8, .2, 1) var(--d, 0ms); }
  .pt-svg.pt-anim.pt-grown .pt-node { transform: none; }
  @media (prefers-reduced-motion: reduce) { .pt-el, .pt-node rect { transition: none !important; } }
</style>
<script src="../scripts/prophets-tree.ts"></script>
