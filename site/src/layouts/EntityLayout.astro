---
import BaseLayout from "./BaseLayout.astro";
import DepthDial from "../components/DepthDial.svelte";
import TimeStrip from "../components/TimeStrip.astro";
import MiniMap from "../components/MiniMap.astro";
import Extras from "../components/Extras.astro";
import JourneyPlayer from "../components/JourneyPlayer.astro";
import Pathway from "../components/Pathway.astro";
import PageHeader from "../components/PageHeader.astro";
import ExploreBar from "../components/ExploreBar.astro";
import LevelSwitcher from "../components/LevelSwitcher.astro";
import { byId, href, labelOf, summaryOf, summaryRaw, related, updatedOn, REPO, SITE, SEGMENT } from "../lib/graph";
import { ui, fmt, LANGS, WINGS, wingHref, type Lang } from "../lib/i18n";
import { renderProse, newHonState } from "../lib/markdown";
import { recordingRef } from "../lib/recordings";
import { formatDate } from "../lib/dates";
import { connectionsOf, externalUrl, jsonLd, levelOf, placesOf, regionLabel, sectionRole, traditionLabel } from "../lib/entity";
import type { Node } from "../../../scripts/build-graph";

interface Props { node: Node; lang: Lang }
const { node: n, lang } = Astro.props;
const T = ui(lang);
const path = href(lang, n.id);
const title = labelOf(n, lang);
const second = lang === "ar" ? n.label.en : n.label.ar;
const d = n.data;
// a work's authors (its `authors` list and any `authored_by` relation), shown beside the title. An author whose faith entry is Shi'i, on a basis of documented or tradition, is marked in red with a text label.
const SHIA_BASES = ["self-identified", "documented", "tradition"];
const isShiaAuthor = (p: Node) => (p.data.faith ?? []).some((f: any) => String(f.value).startsWith("shia-") && SHIA_BASES.includes(f.basis));
const authorIds: string[] = n.class === "work" ? [...new Set([...(d.authors ?? []), ...(d.relations ?? []).filter((r: any) => r.type === "authored_by").map((r: any) => r.target)])] : [];
const workAuthors = authorIds.map((id) => byId.get(id)).filter(Boolean) as Node[];

// --- prose with fallback chain: requested language -> the other published language -> none
const proseLang = n.prose[lang] ? lang : n.prose.ar ? "ar" : n.prose.en ? "en" : null;
const prose = proseLang ? n.prose[proseLang] : null;
const untranslated = !!prose && proseLang !== lang;
const brief = prose?.sections.find((s) => sectionRole(s.heading) === "brief");

// --- dates for the header line
// Machine-readable form for <time datetime>: only a plain EDTF date/year qualifies;
// approximations (~), uncertainty (?) and intervals stay text-only (HTML datetime can't express them).
// datetime is proleptic Gregorian, so Julian-marked dates are also left as text
// (same rule as dates.ts: no calendar declared means Julian before 1583).
const machineDate = (d: any): string | undefined => {
  const e = d?.edtf;
  if (!e || !/^-?\d{1,4}(-\d{2}(-\d{2})?)?$/.test(e)) return undefined;
  const y = Number(e.match(/^-?\d{1,4}/)![0]);
  const cal = d.calendar ?? (y < 1583 ? "julian" : "gregorian");
  return cal === "gregorian" ? e : undefined;
};
const dateLine = (() => {
  const pair = (a: any, b: any) => {
    const s = formatDate(a, lang), e = formatDate(b, lang);
    const parts = [{ text: s.text, dt: machineDate(a) }, { text: e.text, dt: machineDate(b) }].filter((p) => p.text);
    return { parts, derived: s.derived || e.derived };
  };
  if (n.class === "person") return pair(d.born, d.died);
  if (n.class === "event") return pair(d.date?.start, d.date?.end);
  if (n.class === "period" || n.class === "polity") return pair(d.start, d.end);
  return { parts: [], derived: false };
})();

const places = placesOf(n.id);
const groups = connectionsOf(n.id, lang);

// --- sources: the entity's own + any cited in prose
const hon = newHonState(); // one honorific state per article, so the first mention is marked once across all sections
// the lede is read first on the page, so its summary renders before the sections: {cite:…} markers
// in summaries become footnotes and [[wiki-links]] become links, matching the prose pipeline
const ledeR = renderProse(summaryRaw(n, lang), lang, hon);
// leveled reading sections (edu/levels.yaml) leave the article flow and go to the switcher; the rest render as before
const levelSecs = (prose?.sections ?? []).filter((s) => proseLang && levelOf(s.heading, proseLang));
const sections = (prose?.sections ?? []).filter((s) => !levelSecs.includes(s)).map((s) => ({ ...s, role: sectionRole(s.heading), r: renderProse(s.markdown, lang, hon) }));
// citation numbers are per-section in renderProse; re-number globally for the footnote list
const citeList: { source: string; locator?: string }[] = [];
const citeIndex = (c: { source: string; locator?: string }) => {
  let i = citeList.findIndex((x) => x.source === c.source && x.locator === c.locator);
  if (i < 0) { citeList.push(c); i = citeList.length - 1; }
  return i + 1;
};
const renumberR = (r: { html: string; cites: { n: number; source: string; locator?: string }[] }) => {
  const map = new Map(r.cites.map((c) => [c.n, citeIndex(c)]));
  return (h: string) =>
    h.replace(/<sup class="cite"><a href="#note-(\d+)" id="cite-\d+-\d+">\d+<\/a><\/sup>/g, (_m, k) => {
      const g = map.get(Number(k))!;
      return `<sup class="cite"><a href="#note-${g}">${g}</a></sup>`;
    });
};
// the lede is one inline paragraph: unwrap the single <p> renderProse wraps it in
const ledeHtml = renumberR(ledeR)(ledeR.html).replace(/^<p>\s*([\s\S]*?)\s*<\/p>\s*$/, "$1");
const sectionHtml = sections.map((s) => {
  const renumber = renumberR(s.r);
  return { ...s, html: renumber(s.r.html), persp: s.r.perspectives.map((p) => ({ ...p, html: renumber(p.html) })) };
});
// each level is read on its own, so each gets its own honorific state; its citations join the page's footnote list
const levelHtml = levelSecs.map((s) => { const r = renderProse(s.markdown, lang, newHonState()); return { id: levelOf(s.heading, proseLang!)!.id, heading: s.heading, html: renumberR(r)(r.html) }; });
const kidsReadHref = d.education?.flagged_for_kids ? `/${lang}/sighar/read/${SEGMENT[n.class] ?? n.class}/${n.slug}/` : undefined;
const proseSources = [...new Set(citeList.map((c) => c.source))];
const ownSources = [...new Set([...(d.sources ?? []), ...proseSources])].map((id) => byId.get(id)).filter(Boolean) as Node[];
const refChip = (id: string) => { const n = byId.get(id); return n ? { id, label: labelOf(n, lang), url: href(lang, id), stub: !!n.stub } : null; };
// docs/plan/20-opinions.md: each opinion may carry a stance headline, its holders and its basis; prose blocks give only label and text
const perspectivesRaw = sectionHtml.flatMap((s) => s.persp).length
  ? sectionHtml.flatMap((s) => s.persp).map((p) => ({ label: p.tradition, id: "", standing: /^(sunni|أهل السنة|سني)/i.test(p.tradition) ? "main" : /academic|أكاديمي/i.test(p.tradition) ? "secondary" : "other", stance: "", html: p.html, sunni: /^(sunni|أهل السنة|سني)/i.test(p.tradition), holders: [] as any[], evidence: [] as any[], sources: [] as any[] }))
  : (d.perspectives ?? []).map((p: any) => ({
      label: traditionLabel(p.tradition, lang), stance: p.stance?.[lang] ?? p.stance?.en ?? "", html: p.summary[lang] ?? p.summary.en, sunni: String(p.tradition).startsWith("sunni"),
      id: p.id ?? "", standing: p.standing ?? (String(p.tradition).startsWith("sunni") ? "main" : p.tradition === "academic" ? "secondary" : "other"), holders: (p.holders ?? []).map(refChip).filter(Boolean),
      evidence: (p.evidence ?? []).map((e: any) => ({ chip: refChip(e.ref), note: e.note?.[lang] ?? e.note?.en ?? "" })).filter((e: any) => e.chip),
      sources: (p.sources ?? []).map(refChip).filter(Boolean),
    }));
// scope rule (docs/scope.md): the first opinion is Sunni and leads; every other view is labelled before its text and sits under "more opinions"
const leadOpinion = perspectivesRaw[0];
const moreOpinions = perspectivesRaw.slice(1);
const issueText: string = d.issue?.[lang] ?? d.issue?.en ?? "";
const perspectives = perspectivesRaw;

const bibliography = (s: Node) => {
  if (lang !== "ar") return labelOf(s, lang);
  const a = (s.data.author ?? []).map((x: any) => [x.family, x.given].filter(Boolean).join(", ")).join("; ");
  const y = s.data.issued?.["date-parts"]?.[0]?.[0];
  return `${a ? a.replace(/\.$/, "") + ". " : ""}${y ? `(${y}). ` : ""}${s.data.title ?? labelOf(s, lang)}${s.data.publisher ? `. ${s.data.publisher}` : ""}.`;
};

const alternates = Object.fromEntries(LANGS.map((l) => [l, href(l, n.id)]));
const altNames = [...new Set([...Object.values(n.label), ...(d.names ?? []).map((x: any) => x.value), ...n.aliases.map((a) => a.split("/")[1].replace(/-/g, " "))])].filter((x) => x !== title);
const wingChips = n.wings.filter((w) => (WINGS as readonly string[]).includes(w));
const wishUrl = `${REPO}/issues/new?template=request-translation.yml&title=${encodeURIComponent(`Translate ${n.id} to ${lang}`)}`;
const citeText = fmt(T.entity.cite_text, { title, url: `${SITE}${path}`, date: updatedOn(n, lang) });
const relatedIds = related(n.id).filter((r) => byId.has(r));
const crumbs = [
  { label: T.entity.breadcrumb, href: `/${lang}/` },
  ...(wingChips[0] ? [{ label: T.nav[wingChips[0]], href: wingHref(lang, wingChips[0] as any) }] : []),
  { label: T.class[n.class] },
];
const reviewStatus = d.status?.review ?? "draft";
// the constellation link only where export-api wrote a neighbourhood (a lone verse has none of its own)
const showGraph = n.degree > 0 && !(n.class === "passage" && d.unit === "ayah" && n.degree < 2);
---
<BaseLayout lang={lang} title={title} description={summaryOf(n, lang) || fmt(T.entity.stub_desc, { label: labelOf(n, lang) })} path={path} jsonld={jsonLd(n, lang, path)} alternates={alternates} ogType={n.class === "person" ? "profile" : "article"}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article id="entity-article" data-depth="standard" data-pagefind-body={n.class !== "passage" || undefined}>
    <PageHeader title={title} crumbs={crumbs} crumbsLabel={T.entity.breadcrumb} wing={wingChips[0]} titleAttrs={{ "data-pagefind-meta": "title" }}>
      {workAuthors.length > 0 && (
        <p class="ui" style="margin:0 0 10px">{T.entity.by} {workAuthors.map((a, k) => (
          <>{k > 0 && (lang === "en" ? ", " : "، ")}<a class={isShiaAuthor(a) ? "chip author-chip shia" : "chip"} href={href(lang, a.id)}>{labelOf(a, lang)}{isShiaAuthor(a) && <> <span class="sect">{T.entity.shia_label}</span></>}</a></>
        ))}</p>
      )}
      {second &&<p class="display" lang={lang === "ar" ? "en" : "ar"} dir={lang === "ar" ? "ltr" : "rtl"} style={`font-size:clamp(1.3rem,3vw,1.9rem);margin:0 0 6px;font-family:${lang === "ar" ? "var(--serif)" : "var(--ar-display)"};color:#e6d5b8`} data-pagefind-ignore>{second}</p>}
      {dateLine.parts.length > 0 && <p class="ui" style="margin:0 0 6px;color:#e6d5b8">{dateLine.parts.map((p, i) => <>{i > 0 && " – "}{p.dt ? <time datetime={p.dt}>{p.text}</time> : p.text}</>)}{dateLine.derived && <span title={T.entity.derived}> †</span>}</p>}
      {dateLine.derived && <p class="ui" style="margin:0 0 6px;font-size:.85rem;color:#c9d3d6">{T.entity.dagger}</p>}
      {places.length > 0 && <p class="ui" style="margin:0 0 10px">{places.map((p, i) => <><a class="chip" href={href(lang, p.id)}>{labelOf(p, lang)}</a>{i < places.length - 1 ? " → " : ""}</>)}</p>}
      {ledeHtml && <p class="page-lede" data-pagefind-meta="summary" set:html={ledeHtml} />}
    </PageHeader>

    <div class="wrap" style="padding-block:24px 20px">
      <div class="no-print" style="display:flex;justify-content:flex-end;gap:10px;max-width:920px;margin:0 auto 12px">
        <button type="button" class="chip" data-tour-add={n.id} data-save={T.mytour.save} data-saved={T.mytour.saved} aria-pressed="false">{T.mytour.save}</button>
        <DepthDial client:load labels={T.depth} />
      </div>
      <div class="reading">
    {n.stub ? (
      <section class="panel" style="margin-top:1.5rem">
        <h2 style="margin-top:0">{T.entity.stub_title}</h2>
        <p>{T.entity.stub_body}</p>
        <p class="ui"><a href={`${REPO}/issues/new?template=suggest-entity.yml&title=${encodeURIComponent(`Entity: ${n.id}`)}`}>{T.entity.stub_help} →</a></p>
      </section>
    ) : (
      <>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-block:1.5rem">
          <section class="panel ui" aria-labelledby="glance">
            <h2 id="glance" style="font-size:1rem;margin:0 0 10px">{T.entity.at_a_glance}</h2>
            <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:.92rem">
              {d.roles?.length > 0 && <><dt class="muted">{T.entity.roles}</dt><dd style="margin:0">{d.roles.map((r: string) => T.roles[r] ?? r).join(" · ")}</dd></>}
              {d.traditions?.length > 0 && <><dt class="muted">{T.entity.tradition}</dt><dd style="margin:0">{d.traditions.map((x: string) => (x.startsWith("shia") ? `${T.entity.venerated_by} ${T.entity.venerated_label?.[x] ?? traditionLabel(x, lang)}` : traditionLabel(x, lang))).join(" · ")}</dd></>}
              {n.periods.length > 0 && <><dt class="muted">{T.entity.era}</dt><dd style="margin:0">{n.periods.map((p) => <a href={href(lang, p)}>{labelOf(byId.get(p)!, lang)}</a>).reduce((a: any[], c, i) => (i ? [...a, " · ", c] : [c]), [])}</dd></>}
              {n.regions.length > 0 && <><dt class="muted">{T.entity.region}</dt><dd style="margin:0">{n.regions.map((r) => regionLabel(r, lang)).join(" · ")}</dd></>}
              {(Object.keys(d.external_ids ?? {}).length > 0 || d.iiif_manifest) && <><dt class="muted">{T.entity.identifiers}</dt><dd style="margin:0">{(Object.entries(d.external_ids) as [string, string][]).filter(([k, v]) => externalUrl(k, v)).map(([k, v]) => <a href={externalUrl(k, v)} rel="noopener" style="margin-inline-end:10px">{T.ids[k] ?? k}</a>)}{d.iiif_manifest && <a href={d.iiif_manifest} rel="noopener" style="margin-inline-end:10px">{T.ids.iiif}</a>}</dd></>}
              <dt class="muted">{T.entity.review}</dt>
              <dd style="margin:0"><span class="chip">{T.status[reviewStatus]}</span> {d.status?.completeness !== undefined && <span class="status-note">{T.entity.completeness} {d.status.completeness}/5 · <a href={`${REPO}/issues/new?template=suggest-entity.yml&title=${encodeURIComponent(`Complete: ${n.id}`)}`}>{T.entity.complete_help}</a></span>}</dd>
            </dl>
            {d.sensitivity === "figurative-prophet" && <p class="muted" style="font-size:.85rem;margin:10px 0 0">{T.entity.figurative}</p>}
            {d.sensitivity === "contested" && <p role="note" style="font-size:.9rem;margin:10px 0 0;padding-inline-start:10px;border-inline-start:4px solid #b45309"><strong>{T.entity.contested_label}:</strong> {T.entity.contested_notice}</p>}
          </section>

          {(n.span || places.some((p) => p.coordinates)) && (
            <section class="panel ui no-print" aria-label={T.entity.in_time}>
              {n.span && <>
                <h2 style="font-size:1rem;margin:0 0 8px">{n.class === "person" ? T.entity.life_in_time : T.entity.in_time}</h2>
                <TimeStrip span={n.span} ids={n.contemporaries} lang={lang} self={n.id} />
              </>}
              {places.some((p) => p.coordinates) && <>
                <h2 style="font-size:1rem;margin:14px 0 8px">{T.entity.in_space}</h2>
                <MiniMap places={places} lang={lang} />
                <p class="muted ui" style="font-size:.78rem;margin:6px 0 0">{T.entity.map_credit}</p>
              </>}
            </section>
          )}
        </div>

        {n.class === "journey" && d.waypoints && <JourneyPlayer node={n} lang={lang} />}
        {n.class === "exhibit" && (d.rooms?.length ?? 0) > 0 && <Pathway node={n} lang={lang} />}
        <script src="../scripts/mytour.ts"></script>
        <Extras node={n} lang={lang} />

        {untranslated && (
          <p class="panel ui" role="note" style="font-size:.92rem">{T.entity.not_translated} <a href={wishUrl}>{T.entity.help_translate}</a></p>
        )}

        <div class="prose" lang={proseLang ?? lang} dir={proseLang === "ar" ? "rtl" : "ltr"} data-pagefind-ignore={untranslated || undefined}>
          {!prose && n.class !== "passage" && <p class="panel ui" role="note">{T.entity.no_prose}</p>}
          <LevelSwitcher lang={lang} levels={levelHtml} kidsHref={kidsReadHref} shelfId={n.id}>
          {sectionHtml.map((s) =>
            s.role === "kids" || s.role === "scholars" ? (
              <details data-role={s.role} class="sec" style="margin-block:1rem">
                <summary style="cursor:pointer;font-weight:600"><span class="ui">{s.heading}</span></summary>
                <div set:html={s.html} />
              </details>
            ) : (
              <section data-role={s.role} class="sec">
                <h2>{s.heading}</h2>
                <div set:html={s.html} />
              </section>
            ),
          )}
          </LevelSwitcher>
        </div>

        {perspectives.length > 0 && (
          <section data-role="main" class="sec opinions" aria-labelledby="persp">
            <h2 id="persp">{T.entity.opinions_title}</h2>
            {issueText && <p class="ui" style="margin:0 0 12px"><b>{T.entity.issue}:</b> {issueText}</p>}
            {[leadOpinion].map((p) => (
              <div class="panel" id={p.id ? `op-${p.id}` : undefined} style="margin-bottom:14px;border-inline-start:4px solid var(--gold)">
                <h3 class="ui" style="margin:0 0 6px;font-size:1rem">{p.sunni ? `${T.entity.lead_opinion} · ${T.entity.sunni_frame}` : `${T.entity.lead_opinion} · ${fmt(T.entity.view, { label: p.label })}`}{p.sunni && p.label && !T.entity.sunni_frame.includes(p.label) ? ` · ${p.label}` : ""}<span class="chip ui" style="margin-inline-start:8px;font-size:.75rem;border:1px solid var(--gold)">{T.entity[`standing_${p.standing}`]}</span></h3>
                {p.stance && <p style="margin:0 0 6px"><b>{p.stance}</b></p>}
                <div set:html={p.html} />
                {p.holders.length > 0 && <p class="ui" style="margin:8px 0 0"><span class="muted">{T.entity.holders}:</span> {p.holders.map((h: any) => <a class={`chip${h.stub ? " stub-link" : ""}`} href={h.url}>{h.label}</a>)}</p>}
                {p.evidence.length > 0 && <p class="ui" style="margin:6px 0 0"><span class="muted">{T.entity.evidence}:</span> {p.evidence.map((e: any) => <><a class="chip" href={e.chip.url}>{e.chip.label}</a>{e.note ? ` ${e.note} ` : " "}</>)}</p>}
              </div>
            ))}
            {moreOpinions.length > 0 && (
              <details class="more-opinions" id="more-opinions" style="margin-top:6px">
                <summary class="ui" style="cursor:pointer;font-weight:600;padding:6px 0">{fmt(T.entity.more_opinions, { n: String(moreOpinions.length) })}</summary>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:10px">
                  {moreOpinions.map((p) => (
                    <div class="panel" id={p.id ? `op-${p.id}` : undefined}>
                      <h3 class="ui" style="margin:0 0 6px;font-size:1rem">{p.sunni ? `${T.entity.sunni_frame}${p.label && !T.entity.sunni_frame.includes(p.label) ? ` · ${p.label}` : ""}` : fmt(T.entity.view, { label: p.label })}<span class="chip ui" style="margin-inline-start:8px;font-size:.75rem;border:1px solid var(--gold)">{T.entity[`standing_${p.standing}`]}</span></h3>
                      {p.stance && <p style="margin:0 0 6px"><b>{p.stance}</b></p>}
                      <div set:html={p.html} />
                      {p.holders.length > 0 && <p class="ui" style="margin:8px 0 0"><span class="muted">{T.entity.holders}:</span> {p.holders.map((h: any) => <a class={`chip${h.stub ? " stub-link" : ""}`} href={h.url}>{h.label}</a>)}</p>}
                      {p.evidence.length > 0 && <p class="ui" style="margin:6px 0 0"><span class="muted">{T.entity.evidence}:</span> {p.evidence.map((e: any) => <><a class="chip" href={e.chip.url}>{e.chip.label}</a>{e.note ? ` ${e.note} ` : " "}</>)}</p>}
                    </div>
                  ))}
                </div>
              </details>
            )}
          </section>
        )}

        {groups.length > 0 && (
          <section data-role="main" class="sec ui" aria-labelledby="conn">
            <h2 id="conn">{T.entity.connections}</h2>
          {showGraph && <p class="ui no-print" style="margin:0 0 10px"><a class="chip" style="border:1px solid var(--gold)" rel="nofollow" href={`/${lang}/graph/?from=${n.id}`}>{T.graph.explore_link} <span class="flip" aria-hidden="true">→</span></a></p>}
            <dl style="display:grid;grid-template-columns:minmax(120px,max-content) 1fr;gap:8px 18px;margin:0">
              {groups.map((g) => (
                <>
                  <dt class="muted">{g.label}</dt>
                  <dd style="margin:0;display:flex;flex-wrap:wrap;gap:6px 8px">
                    {g.items.map(({ node: t }, k) => <>{k > 0 && <span class="sr-only">· </span>}<a class={`chip${t.stub ? " stub-link" : ""}`} href={href(lang, t.id)}>{labelOf(t, lang)}</a></>)}
                  </dd>
                </>
              ))}
            </dl>
          </section>
        )}

        {relatedIds.length > 0 && (
          <section data-role="main" class="sec ui no-print" aria-labelledby="rel">
            <h2 id="rel">{T.entity.related}</h2>
            <p style="display:flex;flex-wrap:wrap;gap:6px 8px">{relatedIds.map((r, k) => <>{k > 0 && <span class="sr-only">· </span>}<a class="chip" href={href(lang, r)}>{labelOf(byId.get(r)!, lang)}</a></>)}</p>
          </section>
        )}

        {(citeList.length > 0 || ownSources.length > 0) && (
          <section data-role="main" class="sec ui" aria-labelledby="src">
            <h2 id="src">{T.entity.sources}</h2>
            {citeList.length > 0 && (
              <ol style="padding-inline-start:1.4rem;font-size:.92rem">
                {citeList.map((c, i) => {
                  const s = byId.get(c.source);
                  const rec = recordingRef(c.source, c.locator);
                  return (
                    <li id={`note-${i + 1}`}>
                      {s ? bibliography(s) : c.source}
                      {rec
                        ? <>{`, ${fmt(T.entity.recording_line, { series: rec.seriesTitle, ep: rec.ep })}`}{rec.time && `, ${fmt(T.entity.recording_at, { time: rec.time })}`}</>
                        : (c.locator ? `, ${c.locator}` : "")}
                      {rec && (rec.media
                        ? <> · <a href={rec.media} rel="noopener">{T.entity.listen_at_archive}</a></>
                        : <> · <a href={rec.page} rel="noopener">{T.entity.open_at_archive}</a></>)}
                    </li>
                  );
                })}
              </ol>
            )}
            {ownSources.filter((s) => !proseSources.includes(s.id)).length > 0 && (
              <ul style="padding-inline-start:1.4rem;font-size:.92rem">
                {ownSources.filter((s) => !proseSources.includes(s.id)).map((s) => <li>{bibliography(s)}</li>)}
              </ul>
            )}
          </section>
        )}
      </>
    )}

    <section class="sec ui no-print" style="margin-top:2rem;font-size:.9rem" aria-label={T.entity.cite}>
      <details>
        <summary style="cursor:pointer">{T.entity.cite}</summary>
        <p class="panel" style="margin-top:8px;user-select:all">{citeText}</p>
      </details>
      <p class="muted">
        <a href={`${REPO}/edit/main/data/${n.class}/${n.slug}.yaml`} rel="noopener">{T.entity.edit}</a> ·
        <a href={`${REPO}/issues/new?template=report-error.yml&title=${encodeURIComponent(`Error: ${n.id}`)}`} rel="noopener">{T.entity.report}</a> ·
        <a href={`/api/v1/${n.class}/${n.slug}.json`} class="ltr">JSON</a>
      </p>
    </section>

      </div>

      {(wingChips[0] || relatedIds.length > 0) && (
        <section class="dual ui no-print" aria-label={T.explore.next}>
          {wingChips[0] && (
            <a class="card" href={wingHref(lang, wingChips[0] as any)}>
              <span class="eyebrow">{T.explore.wing_card}</span>
              <h2 class="card-title">{T.nav[wingChips[0]]}</h2>
              <span>{T.wings[wingChips[0] as keyof typeof T.wings]?.blurb}</span>
            </a>
          )}
          {relatedIds[0] && (
            <a class="card" href={href(lang, relatedIds[0])}>
              <span class="eyebrow">{T.explore.related_card}</span>
              <h2 class="card-title">{labelOf(byId.get(relatedIds[0])!, lang)}</h2>
              <span>{summaryOf(byId.get(relatedIds[0])!, lang)}</span>
            </a>
          )}
        </section>
      )}
    </div>
    <ExploreBar lang={lang} />

    {altNames.length > 0 && <div hidden aria-hidden="true">{altNames.join(" ")}</div>}
    <span hidden data-pagefind-filter={`${T.search.filter_class}:${T.class[n.class] ?? n.class}`}></span>
    {n.wings.map((w) => <span hidden data-pagefind-filter={`${T.search.filter_wing}:${T.nav[w] ?? w}`}></span>)}
  </article>
  <script is:inline>
    // Reading progress: a gold rule across the top, grown by scroll (inner-pages spec §4C). Nothing shows without scrolling room.
    (function () {
      var bar = document.querySelector(".reading-progress"); if (!bar) return;
      var fill = bar.firstElementChild, ticking = false;
      var set = function () {
        ticking = false;
        var h = document.documentElement, max = h.scrollHeight - h.clientHeight;
        var p = max > 0 ? Math.min(1, Math.max(0, h.scrollTop / max)) : 0;
        bar.style.setProperty("--p", p.toFixed(4));
      };
      addEventListener("scroll", function () { if (!ticking) { ticking = true; requestAnimationFrame(set); } }, { passive: true });
      set();
    })();
  </script>
  <script is:inline>
    // Deep depth opens the "more opinions" list; without JS the native disclosure still works.
    (function () {
      var art = document.getElementById("entity-article"), more = document.getElementById("more-opinions"); if (!art || !more) return;
      var sync = function () { if (art.dataset.depth === "deep") more.open = true; };
      sync();
      new MutationObserver(sync).observe(art, { attributes: true, attributeFilter: ["data-depth"] });
    })();
  </script>
</BaseLayout>

<style is:global>
  #entity-article[data-depth="brief"] .sec:not([data-role="brief"]) { display: none; }
  #entity-article .prose h2 { margin-top: 1.4em; }
  sup.cite a { text-decoration: none; padding-inline: 1px; }
  details[data-role] > summary { list-style: revert; }
</style>
