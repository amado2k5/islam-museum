---
import BaseLayout from "./BaseLayout.astro";
import DepthDial from "../components/DepthDial.svelte";
import TimeStrip from "../components/TimeStrip.astro";
import MiniMap from "../components/MiniMap.astro";
import Extras from "../components/Extras.astro";
import PageHeader from "../components/PageHeader.astro";
import ExploreBar from "../components/ExploreBar.astro";
import { byId, buildDate, href, labelOf, summaryOf, related, REPO, SITE } from "../lib/graph";
import { ui, other, fmt, LANGS, WINGS, wingHref, type Lang } from "../lib/i18n";
import { renderProse } from "../lib/markdown";
import { formatDate } from "../lib/dates";
import { connectionsOf, externalUrl, jsonLd, placesOf, regionLabel, sectionRole, traditionLabel } from "../lib/entity";
import type { Node } from "../../../scripts/build-graph";

interface Props { node: Node; lang: Lang }
const { node: n, lang } = Astro.props;
const T = ui(lang);
const path = href(lang, n.id);
const title = labelOf(n, lang);
const second = lang === "ar" ? n.label.en : n.label.ar;
const d = n.data;

// --- prose with fallback chain: requested language -> English -> none
const proseLang = n.prose[lang] ? lang : n.prose.en ? "en" : null;
const prose = proseLang ? n.prose[proseLang] : null;
const untranslated = !!prose && proseLang !== lang;
const brief = prose?.sections.find((s) => sectionRole(s.heading) === "brief");

// --- dates for the header line
const dateLine = (() => {
  if (n.class === "person") {
    const b = formatDate(d.born, lang), e = formatDate(d.died, lang);
    return { text: [b.text, e.text].filter(Boolean).join(" – "), derived: b.derived || e.derived };
  }
  if (n.class === "event") {
    const s = formatDate(d.date?.start, lang), e = formatDate(d.date?.end, lang);
    return { text: [s.text, e.text].filter(Boolean).join(" – "), derived: s.derived || e.derived };
  }
  if (n.class === "period" || n.class === "polity") {
    const s = formatDate(d.start, lang), e = formatDate(d.end, lang);
    return { text: [s.text, e.text].filter(Boolean).join(" – "), derived: s.derived || e.derived };
  }
  return { text: "", derived: false };
})();

const places = placesOf(n.id);
const groups = connectionsOf(n.id, lang);

// --- sources: the entity's own + any cited in prose
const sections = (prose?.sections ?? []).map((s) => ({ ...s, role: sectionRole(s.heading), r: renderProse(s.markdown, lang) }));
// citation numbers are per-section in renderProse; re-number globally for the footnote list
const citeList: { source: string; locator?: string }[] = [];
const citeIndex = (c: { source: string; locator?: string }) => {
  let i = citeList.findIndex((x) => x.source === c.source && x.locator === c.locator);
  if (i < 0) { citeList.push(c); i = citeList.length - 1; }
  return i + 1;
};
const sectionHtml = sections.map((s) => {
  const map = new Map(s.r.cites.map((c) => [c.n, citeIndex(c)]));
  const renumber = (h: string) =>
    h.replace(/<sup class="cite"><a href="#note-(\d+)" id="cite-\d+-\d+">\d+<\/a><\/sup>/g, (_m, k) => {
      const g = map.get(Number(k))!;
      return `<sup class="cite"><a href="#note-${g}">${g}</a></sup>`;
    });
  return { ...s, html: renumber(s.r.html), persp: s.r.perspectives.map((p) => ({ ...p, html: renumber(p.html) })) };
});
const proseSources = [...new Set(citeList.map((c) => c.source))];
const ownSources = [...new Set([...(d.sources ?? []), ...proseSources])].map((id) => byId.get(id)).filter(Boolean) as Node[];
const perspectivesRaw = sectionHtml.flatMap((s) => s.persp).length
  ? sectionHtml.flatMap((s) => s.persp).map((p) => ({ label: p.tradition, html: p.html, sunni: /^(sunni|أهل السنة|سني)/i.test(p.tradition) }))
  : (d.perspectives ?? []).map((p: any) => ({ label: traditionLabel(p.tradition, lang), html: p.summary[lang] ?? p.summary.en, sunni: String(p.tradition).startsWith("sunni") }));
// scope rule (docs/scope.md): the Sunni entry is the main view; every other view is labelled before its text
const sunniViews = perspectivesRaw.filter((p) => p.sunni);
const otherViews = perspectivesRaw.filter((p) => !p.sunni);
const perspectives = perspectivesRaw;

const bibliography = (s: Node) => {
  const a = (s.data.author ?? []).map((x: any) => [x.family, x.given].filter(Boolean).join(", ")).join("; ");
  const y = s.data.issued?.["date-parts"]?.[0]?.[0];
  return `${a ? a.replace(/\.$/, "") + ". " : ""}${y ? `(${y}). ` : ""}${s.data.title ?? labelOf(s, "en")}${s.data.publisher ? `. ${s.data.publisher}` : ""}.`;
};

const alternates = Object.fromEntries(LANGS.map((l) => [l, href(l, n.id)]));
const altNames = [...new Set([...Object.values(n.label), ...(d.names ?? []).map((x: any) => x.value), ...n.aliases.map((a) => a.split("/")[1].replace(/-/g, " "))])].filter((x) => x !== title);
const wingChips = n.wings.filter((w) => (WINGS as readonly string[]).includes(w));
const wishUrl = `${REPO}/issues/new?template=request-translation.yml&title=${encodeURIComponent(`Translate ${n.id} to ${lang}`)}`;
const citeText = fmt(T.entity.cite_text, { title, url: `${SITE}${path}`, date: buildDate });
const relatedIds = related(n.id).filter((r) => byId.has(r));
const crumbs = [
  { label: T.entity.breadcrumb, href: `/${lang}/` },
  ...(wingChips[0] ? [{ label: T.nav[wingChips[0]], href: wingHref(lang, wingChips[0] as any) }] : []),
  { label: T.class[n.class] },
];
const reviewStatus = d.status?.review ?? "draft";
---
<BaseLayout lang={lang} title={title} description={summaryOf(n, lang) || fmt(T.entity.stub_desc, { label: labelOf(n, lang) })} path={path} jsonld={jsonLd(n, lang, path)} alternates={alternates} ogType={n.class === "person" ? "profile" : "article"}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article id="entity-article" data-depth="standard" data-pagefind-body>
    <PageHeader title={title} crumbs={crumbs} crumbsLabel={T.entity.breadcrumb} wing={wingChips[0]} titleAttrs={{ "data-pagefind-meta": "title" }}>
      {second && <p class="display" lang={lang === "ar" ? "en" : "ar"} dir={lang === "ar" ? "ltr" : "rtl"} style={`font-size:clamp(1.3rem,3vw,1.9rem);margin:0 0 6px;font-family:${lang === "ar" ? "var(--serif)" : "var(--ar-display)"};color:#e6d5b8`} data-pagefind-meta="alt">{second}</p>}
      {dateLine.text && <p class="ui" style="margin:0 0 6px;color:#e6d5b8">{dateLine.text}{dateLine.derived && <span title={T.entity.derived}> †</span>}</p>}
      {dateLine.derived && <p class="ui" style="margin:0 0 6px;font-size:.85rem;color:#c9d3d6">{T.entity.dagger}</p>}
      {places.length > 0 && <p class="ui" style="margin:0 0 10px">{places.map((p, i) => <><a class="chip" href={href(lang, p.id)}>{labelOf(p, lang)}</a>{i < places.length - 1 ? " → " : ""}</>)}</p>}
      <p class="page-lede" data-pagefind-meta="summary">{summaryOf(n, lang) || ""}</p>
    </PageHeader>

    <div class="wrap" style="padding-block:24px 20px">
      <div class="no-print" style="display:flex;justify-content:flex-end;max-width:920px;margin:0 auto 12px"><DepthDial client:load labels={T.depth} /></div>
      <div class="reading">
    {n.stub ? (
      <section class="panel" style="margin-top:1.5rem">
        <h2 style="margin-top:0">{T.entity.stub_title}</h2>
        <p>{T.entity.stub_body}</p>
        <p class="ui"><a href={`${REPO}/issues/new?template=suggest-entity.yml&title=${encodeURIComponent(`Entity: ${n.id}`)}`}>{T.entity.stub_help} →</a></p>
      </section>
    ) : (
      <>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-block:1.5rem">
          <section class="panel ui" aria-labelledby="glance">
            <h2 id="glance" style="font-size:1rem;margin:0 0 10px">{T.entity.at_a_glance}</h2>
            <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:.92rem">
              {d.roles?.length > 0 && <><dt class="muted">{T.entity.roles}</dt><dd style="margin:0">{d.roles.map((r: string) => T.roles[r] ?? r).join(" · ")}</dd></>}
              {d.traditions?.length > 0 && <><dt class="muted">{T.entity.tradition}</dt><dd style="margin:0">{d.traditions.map((x: string) => traditionLabel(x, lang)).join(" · ")}</dd></>}
              {n.periods.length > 0 && <><dt class="muted">{T.entity.era}</dt><dd style="margin:0">{n.periods.map((p) => <a href={href(lang, p)}>{labelOf(byId.get(p)!, lang)}</a>).reduce((a: any[], c, i) => (i ? [...a, " · ", c] : [c]), [])}</dd></>}
              {n.regions.length > 0 && <><dt class="muted">{T.entity.region}</dt><dd style="margin:0">{n.regions.map((r) => regionLabel(r, lang)).join(" · ")}</dd></>}
              {Object.keys(d.external_ids ?? {}).length > 0 && <><dt class="muted">{T.entity.identifiers}</dt><dd style="margin:0">{(Object.entries(d.external_ids) as [string, string][]).filter(([k, v]) => externalUrl(k, v)).map(([k, v]) => <a href={externalUrl(k, v)} rel="noopener" style="margin-inline-end:10px">{T.ids[k] ?? k}</a>)}</dd></>}
              <dt class="muted">{T.entity.review}</dt>
              <dd style="margin:0"><span class="chip">{T.status[reviewStatus]}</span> {d.status?.completeness !== undefined && <span class="status-note">{T.entity.completeness} {d.status.completeness}/5 · <a href={`${REPO}/issues/new?template=suggest-entity.yml&title=${encodeURIComponent(`Complete: ${n.id}`)}`}>{T.entity.complete_help}</a></span>}</dd>
            </dl>
            {d.sensitivity === "figurative-prophet" && <p class="muted" style="font-size:.85rem;margin:10px 0 0">{T.entity.figurative}</p>}
          </section>

          {(n.span || places.some((p) => p.coordinates)) && (
            <section class="panel ui no-print" aria-label={T.entity.in_time}>
              {n.span && <>
                <h2 style="font-size:1rem;margin:0 0 8px">{T.entity.in_time}</h2>
                <TimeStrip span={n.span} ids={n.contemporaries} lang={lang} self={n.id} />
              </>}
              {places.some((p) => p.coordinates) && <>
                <h2 style="font-size:1rem;margin:14px 0 8px">{T.entity.in_space}</h2>
                <MiniMap places={places} lang={lang} />
                <p class="muted ui" style="font-size:.78rem;margin:6px 0 0">{T.entity.map_credit}</p>
              </>}
            </section>
          )}
        </div>

        <Extras node={n} lang={lang} />

        {untranslated && (
          <p class="panel ui" role="note" style="font-size:.92rem">{T.entity.not_translated} <a href={wishUrl}>{T.entity.help_translate}</a></p>
        )}

        <div class="prose" lang={proseLang ?? lang} dir={proseLang === "ar" ? "rtl" : "ltr"}>
          {!prose && n.class !== "passage" && <p class="panel ui" role="note">{T.entity.no_prose}</p>}
          {sectionHtml.map((s) =>
            s.role === "kids" || s.role === "scholars" ? (
              <details data-role={s.role} class="sec" style="margin-block:1rem">
                <summary style="cursor:pointer;font-weight:600"><span class="ui">{s.heading}</span></summary>
                <div set:html={s.html} />
              </details>
            ) : (
              <section data-role={s.role} class="sec">
                <h2>{s.heading}</h2>
                <div set:html={s.html} />
              </section>
            ),
          )}
        </div>

        {perspectives.length > 0 && (
          <section data-role="main" class="sec" aria-labelledby="persp">
            <h2 id="persp">{T.entity.perspectives}</h2>
            {sunniViews.map((p) => (
              <div class="panel" style="margin-bottom:14px;border-inline-start:4px solid var(--gold)"><h3 class="ui" style="margin:0 0 6px;font-size:1rem">{T.entity.sunni_frame}</h3><div set:html={p.html} /></div>
            ))}
            {otherViews.length > 0 && (
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px">
                {otherViews.map((p) => (
                  <div class="panel"><h3 class="ui" style="margin:0 0 6px;font-size:1rem">{fmt(T.entity.view, { label: p.label })}</h3><div set:html={p.html} /></div>
                ))}
              </div>
            )}
          </section>
        )}

        {groups.length > 0 && (
          <section data-role="main" class="sec ui" aria-labelledby="conn">
            <h2 id="conn">{T.entity.connections}</h2>
            <dl style="display:grid;grid-template-columns:minmax(120px,max-content) 1fr;gap:8px 18px;margin:0">
              {groups.map((g) => (
                <>
                  <dt class="muted">{g.label}</dt>
                  <dd style="margin:0;display:flex;flex-wrap:wrap;gap:6px 8px">
                    {g.items.map(({ node: t }) => <a class={`chip${t.stub ? " stub-link" : ""}`} href={href(lang, t.id)}>{labelOf(t, lang)}</a>)}
                  </dd>
                </>
              ))}
            </dl>
          </section>
        )}

        {relatedIds.length > 0 && (
          <section data-role="main" class="sec ui no-print" aria-labelledby="rel">
            <h2 id="rel">{T.entity.related}</h2>
            <p style="display:flex;flex-wrap:wrap;gap:6px 8px">{relatedIds.map((r) => <a class="chip" href={href(lang, r)}>{labelOf(byId.get(r)!, lang)}</a>)}</p>
          </section>
        )}

        {(citeList.length > 0 || ownSources.length > 0) && (
          <section data-role="main" class="sec ui" aria-labelledby="src">
            <h2 id="src">{T.entity.sources}</h2>
            {citeList.length > 0 && (
              <ol style="padding-inline-start:1.4rem;font-size:.92rem">
                {citeList.map((c, i) => {
                  const s = byId.get(c.source);
                  return <li id={`note-${i + 1}`}>{s ? bibliography(s) : c.source}{c.locator ? `, ${c.locator}` : ""}</li>;
                })}
              </ol>
            )}
            {ownSources.filter((s) => !proseSources.includes(s.id)).length > 0 && (
              <ul style="padding-inline-start:1.4rem;font-size:.92rem">
                {ownSources.filter((s) => !proseSources.includes(s.id)).map((s) => <li>{bibliography(s)}</li>)}
              </ul>
            )}
          </section>
        )}
      </>
    )}

    <section class="sec ui no-print" style="margin-top:2rem;font-size:.9rem" aria-label={T.entity.cite}>
      <details>
        <summary style="cursor:pointer">{T.entity.cite}</summary>
        <p class="panel" style="margin-top:8px;user-select:all">{citeText}</p>
      </details>
      <p class="muted">
        <a href={`${REPO}/edit/main/data/${n.class}/${n.slug}.yaml`} rel="noopener">{T.entity.edit}</a> ·
        <a href={`${REPO}/issues/new?template=report-error.yml&title=${encodeURIComponent(`Error: ${n.id}`)}`} rel="noopener">{T.entity.report}</a> ·
        <a href={`/api/v1/${n.class}/${n.slug}.json`} class="ltr">JSON</a>
      </p>
    </section>

      </div>

      {(wingChips[0] || relatedIds.length > 0) && (
        <section class="dual ui no-print" aria-label={T.explore.next}>
          {wingChips[0] && (
            <a class="card" href={wingHref(lang, wingChips[0] as any)}>
              <span class="eyebrow">{T.explore.wing_card}</span>
              <h2 class="card-title">{T.nav[wingChips[0]]}</h2>
              <span>{T.wings[wingChips[0] as keyof typeof T.wings]?.blurb}</span>
            </a>
          )}
          {relatedIds[0] && (
            <a class="card" href={href(lang, relatedIds[0])}>
              <span class="eyebrow">{T.explore.related_card}</span>
              <h2 class="card-title">{labelOf(byId.get(relatedIds[0])!, lang)}</h2>
              <span>{summaryOf(byId.get(relatedIds[0])!, lang)}</span>
            </a>
          )}
        </section>
      )}
    </div>
    <ExploreBar lang={lang} />

    {altNames.length > 0 && <div hidden aria-hidden="true">{altNames.join(" ")}</div>}
    <span hidden data-pagefind-filter={`${T.search.filter_class}:${T.class[n.class] ?? n.class}`}></span>
    {n.wings.map((w) => <span hidden data-pagefind-filter={`${T.search.filter_wing}:${T.nav[w] ?? w}`}></span>)}
  </article>
  <script is:inline>
    // Reading progress: a gold rule across the top, grown by scroll (inner-pages spec §4C). Nothing shows without scrolling room.
    (function () {
      var bar = document.querySelector(".reading-progress"); if (!bar) return;
      var fill = bar.firstElementChild, ticking = false;
      var set = function () {
        ticking = false;
        var h = document.documentElement, max = h.scrollHeight - h.clientHeight;
        var p = max > 0 ? Math.min(1, Math.max(0, h.scrollTop / max)) : 0;
        bar.style.setProperty("--p", p.toFixed(4));
      };
      addEventListener("scroll", function () { if (!ticking) { ticking = true; requestAnimationFrame(set); } }, { passive: true });
      set();
    })();
  </script>
</BaseLayout>

<style is:global>
  #entity-article[data-depth="brief"] .sec:not([data-role="brief"]) { display: none; }
  #entity-article .prose h2 { margin-top: 1.4em; }
  sup.cite a { text-decoration: none; padding-inline: 1px; }
  details[data-role] > summary { list-style: revert; }
</style>
