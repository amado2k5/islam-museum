---
import "../styles/global.css";
import { ui, other, LANGS, WINGS, wingHref, type Lang } from "../lib/i18n";
import { SITE } from "../lib/graph";
import { wingCountLabel, explorePages } from "../lib/nav";
import { SHOP } from "../lib/links";
import { BROWSE_CLASSES, browseSegment } from "../lib/browse";
import Logo from "../components/Logo.astro";
// Webfonts sit one hop behind the stylesheet, which delays first paint under throttled networks; the two faces above the fold
// are preloaded so they fetch in parallel with the CSS instead.
import naskh400 from "@fontsource/noto-naskh-arabic/files/noto-naskh-arabic-arabic-400-normal.woff2?url";
import amiri400 from "@fontsource/amiri/files/amiri-arabic-400-normal.woff2?url";
import serif400 from "@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

interface Props { lang: Lang; title: string; description?: string; path: string; jsonld?: object | object[]; alternates?: Partial<Record<Lang, string>>; ogType?: string; noindex?: boolean; kids?: boolean }
const { lang, title, description, path, jsonld, alternates, ogType = "website", noindex, kids = false } = Astro.props;
const T = ui(lang);
const fullTitle = path === `/${lang}/` ? `${T.name} · ${T.tagline}` : `${title} · ${T.name}`;
const desc = description ?? T.landing.meta_description ?? T.landing.lede;
const canonical = `${SITE}${path}`;
const alt = alternates ?? Object.fromEntries(LANGS.map((l) => [l, path.replace(`/${lang}/`, `/${l}/`)]));
const multilingual = LANGS.length > 1;
const switchHref = alt[other(lang)] ?? `/${other(lang)}/`;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const fonts = lang === "ar" ? [naskh400, amiri400] : [serif400, inter400];
const wingCount = (w: string) => wingCountLabel(lang, w);
const EXPLORE = explorePages(lang);
---
<!doctype html>
<html lang={lang} dir={T.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alt).map(([l, h]) => <link rel="alternate" hreflang={l} href={`${SITE}${h}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE}${alt.ar ?? path}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="islam.museum" />
    <meta property="og:locale" content={lang === "ar" ? "ar_AR" : "en_US"} />
    <meta property="og:image" content={`${SITE}/brand/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE}/brand/og-image.jpg`} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a2533" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>
      document.documentElement.classList.add("js");
      try { var t = localStorage.getItem("theme"); if (t) document.documentElement.setAttribute("data-theme", t); if (localStorage.getItem("font") === "sans") document.documentElement.setAttribute("data-font", "sans"); } catch (e) {}
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <svg class="pattern" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="girih" width="120" height="120" patternUnits="userSpaceOnUse">
          <g fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M60 10 L74 46 L110 60 L74 74 L60 110 L46 74 L10 60 L46 46 Z" />
            <path d="M60 25 L85 35 L95 60 L85 85 L60 95 L35 85 L25 60 L35 35 Z" />
            <path d="M0 0 L120 120 M120 0 L0 120 M60 0 V120 M0 60 H120" opacity=".35" />
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#girih)" />
    </svg>
    <a class="skip" href="#main">{T.a11y.skip}</a>
    <header class="site topbar">
      {kids ? (
        <div class="wrap kids-topbar">
          <a class="kids-brand" href={`/${lang}/sighar/`}>
            <span aria-hidden="true">🪶</span> {T.kids.hub_title}
          </a>
          <a class="kids-back" href={`/${lang}/`}>
            <span aria-hidden="true">🏛</span> {T.kids.back_to_museum}
          </a>
        </div>
        <script src="../scripts/classroom.ts"></script>
      ) : (
      <div class="wrap nav-row">
        <a class="ui brand" href={`/${lang}/`}>
          <Logo size={34} alt={T.name} />
          <span class="ltr" dir="ltr">islam.museum</span>
        </a>
        <button class="menu-btn ui" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">☰ {T.a11y.menu_open}</button>
        <nav aria-label={T.a11y.menu} class="ui nav-links" id="site-nav">
          <details class="dd" data-dd>
            <summary>{T.nav.wings_menu}</summary>
            <ul class="dd-menu" role="list">
              {WINGS.map((w) => <li><a href={wingHref(lang, w)}><span class="t">{T.wings[w].title}</span><span class="d">{wingCount(w)} — {T.wings[w].blurb}</span></a></li>)}
            </ul>
          </details>
          <a class="top-link" href={`/${lang}/learn/`}>{T.nav.learn}</a>
          <details class="dd" data-dd>
            <summary>{T.nav.explore_menu}</summary>
            <ul class="dd-menu" role="list">
              {EXPLORE.map((x) => <li><a href={x.href}><span class="t">{T.explore.pages[x.key].title}{!x.ready && <span class="chip soon">{T.landing.in_progress}</span>}</span><span class="d">{T.explore.pages[x.key].menu}</span></a></li>)}
              <li><a href={`/${lang}/wander/`}><span class="t">{T.explore.pages.wander.title}</span><span class="d">{T.explore.pages.wander.menu}</span></a></li>
            </ul>
          </details>
          <a class="top-link" href={`/${lang}/today/`}>{T.nav.today}</a>
          <a class="top-link" href={`/${lang}/art/`}>{T.nav.art}</a>
          <a class="top-link" href={`/${lang}/browse/`}>{T.nav.browse}</a>
          <details class="dd" data-dd>
            <summary>{T.nav.more}</summary>
            <ul class="dd-menu" role="list">
              {[["screen", "screen"], ["exhibits", "exhibits"], ["questions", "questions"], ["themes", "themes"], ["references", "references"], ["coverage", "coverage"], ["foundation", "foundation"]].map(([seg, key]) => <li><a href={`/${lang}/${seg}/`}><span class="t">{T.nav[key]}</span></a></li>)}
            </ul>
          </details>
          <a class="top-link" href={`/${lang}/support/`}>{T.support.title}</a>
          <a class="top-link" href={SHOP} rel="noopener">{T.nav.gift_shop}</a>
          <a class="top-link kids-link" href={`/${lang}/sighar/`}><span aria-hidden="true">🪶</span> {T.kids.hub_title}</a>
          <a class="top-link tour-link" href={`/${lang}/3d/`}><span aria-hidden="true">🧊</span> {T.tour.nav_label}</a>
        </nav>
        <div class="nav-tools ui">
          <a class="chip" href={`/${lang}/search/`}>{T.nav.search} ⌕</a>
          {multilingual && <a class="chip" href={switchHref} hreflang={other(lang)} lang={other(lang)} style="border:1px solid var(--line)"><span class="ltr" dir="ltr">AR | EN</span></a>}
          <button class="chip" id="font-toggle" type="button" aria-pressed="false" style="border:0;cursor:pointer">{T.explore.font}</button>
          <button class="chip" id="theme" type="button" aria-label={T.a11y.theme} data-to-dark={T.a11y.theme} data-to-light={T.a11y.theme_light} style="border:0;cursor:pointer">◐</button>
        </div>
      </div>
      )}
    </header>
    <main id="main" style="flex:1">
      <slot />
    </main>
    <footer class="site foot">
      <div class="wrap ui">
        <div class="fcols">
          <div><h2>{T.footer.browse_all}</h2>{BROWSE_CLASSES.map((c) => <a href={`/${lang}/browse/${browseSegment(c)}/`}>{T.class[c]}</a>)}</div>
          <div><h2>{T.footer.about}</h2><a href={`/${lang}/foundation/`}>{T.nav.foundation}</a><a href="https://github.com/amado2k5/islam-museum/blob/main/docs/plan/05-editorial.md" rel="noopener">{T.footer.editorial}</a><a href={`/${lang}/questions/`}>{T.footer.faq}</a><a href={`/${lang}/learn/`}>{T.nav.learn}</a></div>
          <div><h2>{T.footer.resources}</h2><a href="/api/v1/meta/index.json">{T.footer.open_data}</a><a href={`/${lang}/coverage/`}>{T.nav.coverage}</a><a href={`/${lang}/references/`}>{T.nav.references}</a><a href={`/${lang}/themes/`}>{T.nav.themes}</a><a href={`/${lang}/screen/`}>{T.nav.screen}</a><a href={`/${lang}/exhibits/`}>{T.nav.exhibits}</a><a href={`/${lang}/art/`}>{T.nav.art}</a><a href={`/${lang}/support/`}>{T.support.title}</a><a href={SHOP} rel="noopener">{T.nav.gift_shop}</a><a href="https://github.com/amado2k5/islam-museum" rel="noopener">{T.footer.contribute}</a></div>
          <div><h2>{T.footer.follow}</h2><a href="https://github.com/amado2k5/islam-museum/commits/main" rel="noopener">{T.footer.changelog}</a><a href="https://github.com/amado2k5/islam-museum/issues/new/choose" rel="noopener">{T.footer.report}</a><a href="https://github.com/amado2k5/islam-museum/discussions" rel="noopener">{T.footer.discuss}</a><span>{T.footer.privacy}</span></div>
        </div>
        <p class="fine">islam.museum · {T.footer.open} · <a href={`/${lang}/licenses/`}>{T.footer.licenses}</a> · {T.footer.privacy}</p>
        <p class="fine contact"><a href="mailto:discover@islam.museum">{T.footer.contact}</a></p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // Phone menu: a button opens the full list; Escape closes it and returns focus to the button.
        var mb = document.getElementById("menu-btn"), nav = document.getElementById("site-nav");
        if (mb && nav) {
          var setOpen = function (open, back) {
            nav.classList.toggle("open", open);
            mb.setAttribute("aria-expanded", String(open));
            if (open) { var first = nav.querySelector("a"); if (first) first.focus(); } else if (back) mb.focus();
          };
          mb.addEventListener("click", function () { setOpen(!nav.classList.contains("open"), false); });
          document.addEventListener("keydown", function (e) {
            if (e.key !== "Escape") return;
            if (nav.classList.contains("open")) setOpen(false, true);
            nav.querySelectorAll("details[open]").forEach(function (d) { d.removeAttribute("open"); var s = d.querySelector("summary"); if (s && d.contains(document.activeElement)) s.focus(); });
          });
          // one dropdown open at a time; a click elsewhere closes it
          nav.querySelectorAll("details[data-dd]").forEach(function (d) {
            d.addEventListener("toggle", function () { if (d.open) nav.querySelectorAll("details[data-dd]").forEach(function (o) { if (o !== d) o.removeAttribute("open"); }); });
          });
          document.addEventListener("click", function (e) { if (!nav.contains(e.target)) nav.querySelectorAll("details[data-dd][open]").forEach(function (d) { d.removeAttribute("open"); }); });
        }
      })();
      (function () {
        // Arabic body font: Amiri / Noto Naskh (default) or Cairo (sans). Remembered per viewer; nothing breaks without storage.
        var fb = document.getElementById("font-toggle"), root = document.documentElement;
        if (fb) {
          var sync = function () { fb.setAttribute("aria-pressed", String(root.getAttribute("data-font") === "sans")); };
          sync();
          fb.addEventListener("click", function () {
            var next = root.getAttribute("data-font") === "sans" ? null : "sans";
            if (next) root.setAttribute("data-font", next); else root.removeAttribute("data-font");
            try { if (next) localStorage.setItem("font", next); else localStorage.removeItem("font"); } catch (e) {}
            sync();
          });
        }
      })();
      (function () {
        var el = document.documentElement, b = document.getElementById("theme");
        if (!b) return;
        // The accessible name names the action: "switch to light" while the dark theme is showing.
        var isDark = function () { return el.getAttribute("data-theme") ? el.getAttribute("data-theme") === "dark" : matchMedia("(prefers-color-scheme: dark)").matches; };
        var sync = function () { b.setAttribute("aria-label", isDark() ? b.dataset.toLight : b.dataset.toDark); };
        sync();
        b.addEventListener("click", function () {
          var next = isDark() ? "light" : "dark";
          el.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
