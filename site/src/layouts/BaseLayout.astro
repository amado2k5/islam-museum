---
import "../styles/global.css";
import { ui, other, LANGS, WINGS, wingHref, type Lang } from "../lib/i18n";
import { SITE } from "../lib/graph";
import Logo from "../components/Logo.astro";

interface Props { lang: Lang; title: string; description?: string; path: string; jsonld?: object | object[]; alternates?: Partial<Record<Lang, string>>; ogType?: string; noindex?: boolean }
const { lang, title, description, path, jsonld, alternates, ogType = "website", noindex } = Astro.props;
const T = ui(lang);
const fullTitle = path === `/${lang}/` ? `${T.name} · ${T.tagline}` : `${title} · ${T.name}`;
const desc = description ?? T.landing.lede;
const canonical = `${SITE}${path}`;
const alt = alternates ?? Object.fromEntries(LANGS.map((l) => [l, path.replace(`/${lang}/`, `/${l}/`)]));
const multilingual = LANGS.length > 1;
const switchHref = alt[other(lang)] ?? `/${other(lang)}/`;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang={lang} dir={T.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alt).map(([l, h]) => <link rel="alternate" hreflang={l} href={`${SITE}${h}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE}${alt.ar ?? path}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="islam.museum" />
    <meta property="og:locale" content={lang === "ar" ? "ar_AR" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a2533" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add("js");
      try { var t = localStorage.getItem("theme"); if (t) document.documentElement.setAttribute("data-theme", t); } catch (e) {}
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <svg class="pattern" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="girih" width="120" height="120" patternUnits="userSpaceOnUse">
          <g fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M60 10 L74 46 L110 60 L74 74 L60 110 L46 74 L10 60 L46 46 Z" />
            <path d="M60 25 L85 35 L95 60 L85 85 L60 95 L35 85 L25 60 L35 35 Z" />
            <path d="M0 0 L120 120 M120 0 L0 120 M60 0 V120 M0 60 H120" opacity=".35" />
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#girih)" />
    </svg>
    <a class="skip" href="#main">{T.a11y.skip}</a>
    <header class="site wrap" style="padding-block:18px">
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 20px">
        <a class="ui" href={`/${lang}/`} style="display:flex;align-items:center;gap:10px;font-weight:600;letter-spacing:.02em;text-decoration:none;color:var(--fg)">
          <Logo size={36} />
          <span class="ltr" dir="ltr">islam.museum</span>
        </a>
        <div style="display:flex;align-items:center;gap:10px" class="ui">
          <a class="chip" href={`/${lang}/learn/`} style="border:1px solid var(--gold);font-weight:600">{T.nav.learn}</a>
          <a class="chip" href={`/${lang}/search/`}>{T.nav.search}</a>
          <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">{T.a11y.menu_open}</button>
          <button class="chip" id="theme" type="button" aria-label={T.a11y.theme} data-to-dark={T.a11y.theme} data-to-light={T.a11y.theme_light} style="border:0;cursor:pointer">◐</button>
          {multilingual && <a class="chip" href={switchHref} hreflang={other(lang)} lang={other(lang)} style="border:1px solid var(--line)">{T.switch_to}</a>}
        </div>
      </div>
      <nav aria-label={T.a11y.menu} class="ui" style="margin-top:14px" id="site-nav">
        <ul style="display:flex;flex-wrap:wrap;gap:6px 18px;list-style:none;margin:0;padding:0;font-size:.95rem">
          {WINGS.map((w) => <li><a href={wingHref(lang, w)} style="color:var(--fg);text-decoration:none">{T.nav[w]}</a></li>)}
          <li style="opacity:.5" aria-hidden="true">·</li>
          <li><a href={`/${lang}/learn/`} style="color:var(--fg);text-decoration:none">{T.nav.learn}</a></li>
          <li><a href={`/${lang}/questions/`} style="color:var(--fg);text-decoration:none">{T.nav.questions}</a></li>
          <li><a href={`/${lang}/exhibits/`} style="color:var(--fg);text-decoration:none">{T.nav.exhibits}</a></li>
          <li><a href={`/${lang}/screen/`} style="color:var(--fg);text-decoration:none">{T.nav.screen}</a></li>
          <li><a href={`/${lang}/themes/`} style="color:var(--fg);text-decoration:none">{T.nav.themes}</a></li>
          <li><a href={`/${lang}/wander/`} style="color:var(--fg);text-decoration:none">{T.nav.wander}</a></li>
        </ul>
      </nav>
    </header>
    <main id="main" style="flex:1">
      <slot />
    </main>
    <footer class="site" style="border-top:1px solid var(--line);margin-top:3rem">
      <div class="wrap ui" style="padding-block:22px;display:flex;flex-wrap:wrap;gap:10px 28px;justify-content:space-between;font-size:.9rem;color:var(--muted)">
        <span>islam.museum · {T.footer.open}</span>
        <span>{T.footer.licenses}</span>
        <span><a href="/api/v1/meta/index.json" style="color:inherit">{T.footer.api}</a> · <a href={`/${lang}/coverage/`} style="color:inherit">{T.nav.coverage}</a> · <a href="https://github.com/amado2k5/islam-museum" rel="noopener" style="color:inherit">{T.footer.github}</a></span>
        <span style="flex-basis:100%">{T.footer.privacy}</span>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // Phone menu: a button opens the full list; Escape closes it and returns focus to the button.
        var mb = document.getElementById("menu-btn"), nav = document.getElementById("site-nav");
        if (mb && nav) {
          var setOpen = function (open, back) {
            nav.classList.toggle("open", open);
            mb.setAttribute("aria-expanded", String(open));
            if (open) { var first = nav.querySelector("a"); if (first) first.focus(); } else if (back) mb.focus();
          };
          mb.addEventListener("click", function () { setOpen(!nav.classList.contains("open"), false); });
          document.addEventListener("keydown", function (e) { if (e.key === "Escape" && nav.classList.contains("open")) setOpen(false, true); });
        }
      })();
      (function () {
        var el = document.documentElement, b = document.getElementById("theme");
        if (!b) return;
        // The accessible name names the action: "switch to light" while the dark theme is showing.
        var isDark = function () { return el.getAttribute("data-theme") ? el.getAttribute("data-theme") === "dark" : matchMedia("(prefers-color-scheme: dark)").matches; };
        var sync = function () { b.setAttribute("aria-label", isDark() ? b.dataset.toLight : b.dataset.toDark); };
        sync();
        b.addEventListener("click", function () {
          var next = isDark() ? "light" : "dark";
          el.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
