---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ExploreBar from "../../../components/ExploreBar.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import items from "../../../data/architecture-art.json";

type Item = (typeof items)[number];
export function getStaticPaths() {
  return LANGS.flatMap((lang) => items.map((item) => ({ params: { lang, slug: item.slug }, props: { lang, item } })));
}
const { lang, item } = Astro.props as { lang: Lang; item: Item };
const T = ui(lang);
const label = item.label[lang as "ar" | "en"] ?? item.label.ar;
const groupTitle = { architecture: T.art.group_architecture, patterns: T.art.group_patterns, art: T.art.group_art }[item.group as "architecture" | "patterns" | "art"];
const extra = item as Item & { desc?: Record<string, string>; related?: { ref: string; label: Record<string, string> }[] };
const desc = extra.desc?.[lang] ?? extra.desc?.ar;
const related = extra.related ?? [];
---
<BaseLayout lang={lang} title={label} description={T.art.disclaimer} path={`/${lang}/art/${item.slug}/`}>
  <PageHeader title={label} lede={groupTitle} crumbs={[{ label: T.entity.breadcrumb, href: `/${lang}/` }, { label: T.art.title, href: `/${lang}/art/` }, { label }]} crumbsLabel={T.entity.breadcrumb} />
  <div class="wrap" style="padding-block:24px 20px;max-width:1280px">
    <figure style="margin:0">
      <a href={`/media/architecture-art/${item.slug}.webp`} target="_blank" rel="noopener" aria-label={T.art.open_full}>
        <img src={`/media/architecture-art/${item.slug}.webp`} alt={item.alt[lang] ?? item.alt.ar} width="1280" height="853" style="width:100%;height:auto;border-radius:8px" />
      </a>
      <figcaption class="ui muted" style="padding-top:8px">{item.source === "met" ? T.art.badge_met : T.art.badge} · <a href={`/media/architecture-art/${item.slug}.webp`} target="_blank" rel="noopener">{T.art.open_full}</a></figcaption>
    </figure>
    {desc && (
      <p class="ui" style="margin-top:20px">
        {desc}
        {related.length > 0 && (
          <>
            {" "}{T.art.related_title}:{" "}
            {related.map((r, k) => (
              <>
                {k > 0 && ", "}
                <a href={`/${lang}/${r.ref}/`}>{r.label[lang] ?? r.label.ar}</a>
              </>
            ))}
          </>
        )}
      </p>
    )}
    <p class="panel ui" style="margin-top:20px">{item.source === "met" ? T.art.credit_met : T.art.disclaimer}</p>
    <p class="ui" style="margin-top:16px"><a href={`/${lang}/art/`}>{T.art.back}</a></p>
  </div>
  <ExploreBar lang={lang} />
</BaseLayout>
