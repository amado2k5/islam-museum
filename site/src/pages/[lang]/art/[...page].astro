---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ExploreBar from "../../../components/ExploreBar.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import items from "../../../data/architecture-art.json";
import PagedNav from "../../../components/PagedNav.astro";
import { pagedStaticPaths, pageView, type PagedProps } from "../../../lib/paged";

// the landing shows the first images of each group; a group continues on linked sub-pages (site/src/lib/paged.ts; audit S18)
export function getStaticPaths() { return pagedStaticPaths(LANGS, ["architecture", "patterns", "art"].map((id) => ({ id, count: items.filter((i) => i.group === id).length }))); }
const { lang } = Astro.props as PagedProps;
const T = ui(lang);
const groups = [
  { key: "architecture", title: T.art.group_architecture },
  { key: "patterns", title: T.art.group_patterns },
  { key: "art", title: T.art.group_art },
];
const paged = pageView(groups.map((g) => ({ id: g.key, items: items.filter((i) => i.group === g.key) })).filter((x) => x.items.length > 0), Astro.props as PagedProps, `/${lang}/art/`);
const groupTitle = (id: string) => groups.find((g) => g.key === id)?.title ?? id;
const pagedTitle = paged.landing ? T.art.title : `${T.art.title} · ${groupTitle(paged.sections[0].id)}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const labelFor = (i: (typeof items)[number]) => i.label[lang as "ar" | "en"] ?? i.label.ar;
---
<BaseLayout lang={lang} title={pagedTitle} description={T.art.lede} path={paged.path}>
  <PageHeader title={T.art.title} lede={T.art.lede} crumbs={[{ label: T.entity.breadcrumb, href: `/${lang}/` }, { label: T.art.title }]} crumbsLabel={T.entity.breadcrumb} />
  <div class="wrap" style="padding-block:24px 20px">
    <p class="panel ui">{T.art.disclaimer}</p>
    {items.length === 0 ? <p class="panel ui">{T.art.empty}</p> : paged.sections.map((g) => (
      <section aria-labelledby={`t-${g.id}`} style="margin-top:32px">
        <h2 id={`t-${g.id}`}>{groupTitle(g.id)} <span class="ui muted">· {g.total}</span></h2>
        <ul class="grid-cards">
          {g.items.map((i) => (
            <li>
              <figure class="card" style="margin:0">
                <a href={`/${lang}/art/${i.slug}/`}><img src={`/media/architecture-art/${i.slug}.webp`} alt={i.alt[lang === "fr" ? "en" : lang] ?? i.alt.ar} width="1280" height="853" loading="lazy" style="width:100%;height:auto;border-radius:8px" /></a>
                <figcaption style="padding-top:8px">
                  <strong>{labelFor(i)}</strong>
                  <span class="ui muted" style="display:block;font-size:.85rem">{i.source === "met" ? T.art.badge_met : T.art.badge}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <PagedNav lang={lang} paged={paged} section={g} label={groupTitle(g.id)} />
      </section>
    ))}
  </div>
  <ExploreBar lang={lang} />
</BaseLayout>
