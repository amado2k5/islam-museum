---
// The completion room: the route drawn on the museum's graph, the counted truth of what hangs off it, and the doors on.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import GrandTourRibbon from "../../../components/GrandTourRibbon.astro";
import { ui, fmt, WINGS, wingHref, type Lang } from "../../../lib/i18n";
import { labelOf } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { TOUR_LANGS, stops, tourPath, stopHref, hangingOff, stopLinks } from "../../../lib/grand-tour";

export function getStaticPaths() { return TOUR_LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = T.grand_tour;
const rtl = T.dir === "rtl";
// the drawing: across by order on the tour (mirrored for right-to-left), down by the stop's first wing
const W = 1000, H = 400, GUTTER = 92, PAD = 22, LANE = (H - 2 * 28) / WINGS.length;
// a stop that sits in several wings is drawn in the one fewest stops share, so every wing the tour reaches shows on the drawing
const onTour = Object.fromEntries(WINGS.map((w) => [w, stops.filter((s) => s.node.wings.includes(w)).length]));
const laneOf = (i: number) => { const ws = stops[i].node.wings.filter((w) => (WINGS as readonly string[]).includes(w)); return ws.length ? ws.reduce((a, b) => (onTour[b] < onTour[a] ? b : a)) : "time"; };
const xy = (i: number) => {
  const x = GUTTER + PAD + (i * (W - GUTTER - 2 * PAD)) / (stops.length - 1);
  return [rtl ? W - x : x, 28 + WINGS.indexOf(laneOf(i) as any) * LANE + LANE / 2] as const;
};
const pts = stops.map((_, i) => xy(i));
const route = pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const arcs = stopLinks.map(([a, b]) => { const [x1, y1] = pts[a], [x2, y2] = pts[b]; const lift = Math.min(70, 14 + Math.abs(x2 - x1) * 0.12); return `M${x1.toFixed(1)} ${y1.toFixed(1)} Q${((x1 + x2) / 2).toFixed(1)} ${(Math.min(y1, y2) - lift).toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`; });
const last = Math.max(...stops.map((s) => s.walk));
---
<BaseLayout lang={lang} title={`${G.complete_title} · ${G.title}`} description={fmt(G.complete_count, { n: num(hangingOff, lang) })} path={tourPath(lang, "complete")} alternates={{ ar: tourPath("ar", "complete"), en: tourPath("en", "complete") }}>
  <div data-pagefind-ignore>
    <PageHeader title={G.complete_title} crumbs={[{ label: G.title, href: tourPath(lang) }, { label: G.finish }]} crumbsLabel={T.entity.breadcrumb} wing="time">
      <p class="gt-count" data-gt-hanging={hangingOff}>{fmt(G.complete_count, { n: num(hangingOff, lang) })}</p>
      <p class="page-lede">{fmt(G.complete_lede, { s: num(stops.length, lang) })}</p>
    </PageHeader>
    <div class="wrap gt-complete">
      <GrandTourRibbon lang={lang} walk={last} done />
      <p class="ui gt-visited" data-gt-visited data-tpl={G.visited} data-total={stops.length} hidden></p>
      <section aria-labelledby="gt-route">
        <h2 id="gt-route">{G.route_title}</h2>
        <p class="muted gt-route-desc">{G.route_desc} {fmt(G.complete_links, { n: num(stopLinks.length, lang) })}</p>
        <div class="gt-route-scroll" tabindex="0" role="group" aria-labelledby="gt-route">
          <svg class="gt-route" viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby="gt-route-t gt-route-d">
            <title id="gt-route-t">{G.route_title}</title>
            <desc id="gt-route-d">{G.route_desc}</desc>
            {WINGS.map((w, k) => (
              <g>
                <line x1="0" x2={W} y1={28 + k * LANE} y2={28 + k * LANE} class="gt-lane-line" />
                <text x={rtl ? W - 8 : 8} y={28 + k * LANE + LANE / 2 + 4} class="gt-lane-label" text-anchor="start" style={`fill:var(--wing-${w})`}>{T.wings[w].title}</text>
              </g>
            ))}
            {arcs.map((d) => <path d={d} class="gt-arc" />)}
            <polyline points={route} class="gt-path" />
            {stops.map((s, i) => (
              <a href={stopHref(lang, s)}>
                <title>{`${i + 1}. ${labelOf(s.node, lang)}`}</title>
                <circle cx={pts[i][0]} cy={pts[i][1]} r="10" class="gt-node" style={`stroke:var(--wing-${laneOf(i)})`} data-gt-node={s.slug} />
                <text x={pts[i][0]} y={pts[i][1] + 3.5} class="gt-node-n" text-anchor="middle">{i + 1}</text>
              </a>
            ))}
          </svg>
        </div>
        <details class="gt-key ui">
          <summary>{G.route_key}</summary>
          <ol>{stops.map((s) => <li><a href={stopHref(lang, s)}>{labelOf(s.node, lang)}</a></li>)}</ol>
        </details>
      </section>
      <section class="ui" aria-labelledby="gt-wings">
        <h2 id="gt-wings">{G.wings_doors}</h2>
        <ul class="grid-cards">
          {WINGS.map((w) => <li><a class="card" href={wingHref(lang, w)} style={`border-inline-start:5px solid var(--wing-${w})`}><b>{T.wings[w].title}</b><span>{T.wings[w].blurb}</span></a></li>)}
        </ul>
        <p class="gt-last"><a class="btn btn-lapis" href={`/${lang}/graph/`}>{G.graph_door} <span class="flip" aria-hidden="true">→</span></a> <a class="btn btn-outline" href={stopHref(lang, stops[0])}>{G.restart}</a> <a class="btn btn-outline" href={tourPath(lang)}>{G.back_to_river}</a></p>
      </section>
    </div>
  </div>
  <script is:inline src="/shell/grand-tour.js" defer></script>
  <style is:global>
    .gt-complete { padding-block: 22px 44px; }
    .gt-count { font-family: var(--sans); font-size: clamp(1.3rem, 3.4vw, 2rem); font-weight: 600; color: #f9f8f6; margin: 6px 0 10px; }
    .gt-complete h2 { font-size: 1.45rem; margin: 1.6rem 0 .5rem; }
    .gt-route-desc { max-width: var(--measure); margin: 0 0 12px; }
    .gt-route-scroll { overflow-x: auto; max-width: 100%; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); }
    .gt-route { display: block; width: 100%; min-width: 860px; height: auto; }
    .gt-lane-line { stroke: var(--line); stroke-width: 1; }
    .gt-lane-label { font-family: var(--sans); font-size: 11px; font-weight: 600; }
    .gt-arc { fill: none; stroke: var(--wing-living); stroke-width: 1; opacity: .38; }
    .gt-path { fill: none; stroke: var(--gold); stroke-width: 2.5; stroke-linejoin: round; }
    .gt-node { fill: var(--bg); stroke-width: 2.5; }
    .gt-node[data-visited] { fill: var(--gold); }
    .gt-node-n { font-family: var(--sans); font-size: 9.5px; font-weight: 700; fill: var(--fg); pointer-events: none; }
    .gt-route a:focus-visible .gt-node { stroke: var(--focus); stroke-width: 4; }
    .gt-key { margin: 12px 0 0; }
    .gt-key ol { columns: 3 220px; padding-inline-start: 1.8rem; margin: .6rem 0 0; font-size: .92rem; }
    .gt-visited { margin: 0 0 6px; font-weight: 600; }
    .gt-complete .card b { display: block; margin-bottom: 2px; }
    .gt-last { display: flex; flex-wrap: wrap; gap: 12px; margin: 1.4rem 0 0; }
  </style>
</BaseLayout>
