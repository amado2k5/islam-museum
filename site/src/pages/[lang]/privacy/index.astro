---
// Privacy and data statement (DPGA indicators 7 and 9a; docs/outreach/dpga-evidence-map.md). Plain prose from i18n, no scripts.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { REPO } from "../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const P = T.privacy;
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "summary", title: P.summary_title, body: [P.summary_1, P.summary_2] },
  { id: "collect", title: P.collect_title, body: [P.collect_body] },
  { id: "device", title: P.device_title, body: [P.device_body] },
  { id: "traffic", title: P.traffic_title, body: [P.traffic_body] },
  { id: "hosts", title: P.hosts_title, body: [P.hosts_body] },
  { id: "contact", title: P.contact_title, body: [P.contact_body] },
  { id: "people", title: P.people_title, body: [P.people_body] },
  { id: "kids", title: P.kids_title, body: [P.kids_body] },
  { id: "links", title: P.links_title, body: [P.links_body] },
  { id: "law", title: P.law_title, body: [P.law_body] },
  { id: "changes", title: P.changes_title, body: [P.changes_body] },
];
---
<BaseLayout lang={lang} title={P.title} description={P.lede} path={`/${lang}/privacy/`}>
  <PageHeader title={P.title} lede={P.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: P.title }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated">{P.updated}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
        </section>
      ))}

      <section aria-labelledby="more-h" class="p-sec">
        <h2 id="more-h">{P.more_title}</h2>
        <p>{P.more_body}</p>
        <p class="ui p-links">
          <a href={`${REPO}/blob/main/docs/plan/03-architecture.md`} rel="noopener">{P.arch_link}</a> ·
          <a href={`${REPO}/blob/main/docs/adr/0002-no-ai-or-compute-at-runtime.md`} rel="noopener">{P.adr_link}</a>
        </p>
        <p class="ui p-links">
          <a href="mailto:discover@islam.museum">{P.contact_cta}</a> ·
          <a href={`${REPO}/issues/new?template=report-error.yml`} rel="noopener">{P.report_cta}</a>
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
</style>
