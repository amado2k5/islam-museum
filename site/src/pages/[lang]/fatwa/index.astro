---
// The Fatwa Explorer (docs/plan/25-fatwa-explorer.md). Since the audit of 13 November 2026 (S23) a visitor can come
// from a question: a find box over every fatwa, and the subjects the fatwas are about (from each record's own `about`
// relations), beside the sources they were distilled from. Each list lives on its own page.
// The museum records fatwas as history and attributes them; it never issues a ruling.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FullFilter from "../../../components/FullFilter.astro";
import DraftMark from "../../../components/DraftMark.astro";
import QuestionField from "../../../components/sig/QuestionField.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { labelOf } from "../../../lib/graph";
import { fatwas, fatwaSources, fatwaSubjects, fatwasWithoutSubject } from "../../../lib/fatwa";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const F = T.fatwa;
const count = (n: number) => F.count.replace("{n}", String(n));
// the headline is the set the explorer lists: every fatwa stands under exactly one source
const listed = fatwaSources.reduce((k, s) => k + s.list.length, 0);
if (listed !== fatwas.length) throw new Error(`fatwa: the sources list ${listed} fatwas but the museum holds ${fatwas.length}`);
---
<BaseLayout lang={lang} title={F.title} description={F.lede} path={`/${lang}/fatwa/`}>
  <div class="wrap" style="padding-block:10px 24px">
    <section data-pagefind-body>
      <p class="ui" style="color:var(--gold);margin:0 0 .2rem">{T.explore.label}</p>
      <h1>{F.title} <span class="ui muted">{count(listed)}</span></h1>
      <p>{F.lede}</p>
      <p class="muted">{F.note}</p>
    </section>

    {fatwas.length === 0 ? <p class="muted">{F.empty}</p> : (
      <>
        {fatwaSubjects.length > 0 && <QuestionField lang={lang} />}
        <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:1rem 0">
          <label for="fatwa-filter">{F.filter_label}</label>
          <input id="fatwa-filter" type="search" autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
        </p>
        <FullFilter lang={lang} slug="fatwa" />
        {fatwas.some((n) => n.data.status?.review === "draft") && <DraftMark lang={lang} legend />}

        <nav aria-labelledby="fatwa-by-subject" data-pagefind-ignore>
          <h2 id="fatwa-by-subject">{F.by_subject} <span class="ui muted">{fatwaSubjects.length}</span></h2>
          <p class="muted" style="max-width:var(--measure)">{F.by_subject_note}</p>
          <ul role="list" class="ui" style="display:flex;flex-wrap:wrap;gap:6px 8px;padding:0;margin:0;list-style:none">
            {fatwaSubjects.map((s) => <li><a class="chip" href={`/${lang}/fatwa/subject/${s.slug}/`}>{labelOf(s.node, lang)} · {s.list.length}</a></li>)}
          </ul>
          {fatwasWithoutSubject.length > 0 && <p class="muted" style="margin-top:.8rem">{fmt(F.no_subject, { n: String(fatwasWithoutSubject.length) })}</p>}
        </nav>

        <nav aria-labelledby="fatwa-by-source" data-pagefind-ignore>
          <h2 id="fatwa-by-source">{F.by_source}</h2>
          <ul role="list">
            {fatwaSources.map((s) => (
              <li><a href={`/${lang}/fatwa/source/${s.slug}/`}>{s.node ? labelOf(s.node, lang) : s.sid}</a> <span class="ui muted">{count(s.list.length)}</span></li>
            ))}
          </ul>
        </nav>
      </>
    )}
  </div>
</BaseLayout>
