---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { href, labelOf, realNodes, summaryOf } from "../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const items = realNodes.filter((n) => n.class === "exhibit");
---
<BaseLayout lang={lang} title={T.exhibits.title} description={T.exhibits.lede} path={`/${lang}/exhibits/`}>
  <div class="wrap" style="padding-block:10px 20px" data-pagefind-ignore>
    <h1>{T.exhibits.title}</h1>
    <p style="font-size:1.2rem;max-width:var(--measure)">{T.exhibits.lede}</p>
    {items.length === 0 ? <p class="panel ui">{T.exhibits.empty}</p> : (
      <ul class="grid-cards">{items.map((n) => <li><a class="card" href={href(lang, n.id)}><h2 class="card-title">{labelOf(n, lang)}</h2><span>{summaryOf(n, lang)}</span></a></li>)}</ul>
    )}
  </div>
</BaseLayout>
