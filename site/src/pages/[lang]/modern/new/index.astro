---
// Records of the Modern Islam Browser added or changed in the 30 days before the build (git dates of their data files).
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ModernList from "../../../../components/ModernList.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { num } from "../../../../lib/nav";
import { buildDate, newEntries } from "../../../../lib/modern";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const M = T.modern;
const base = `/${lang}/modern`;
---
<BaseLayout lang={lang} title={`${M.new_title} · ${M.title}`} description={M.new_lede} path={`${base}/new/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › <a href={`${base}/`}>{M.title}</a> › {M.new_title}</nav>
    <div data-pagefind-body>
      <p class="ui" style="color:var(--gold);margin:0 0 .2rem">{M.title}</p>
      <h1>{M.new_title} <span class="ui muted">{num(newEntries.length, lang)}</span></h1>
      <p style="max-width:var(--measure)">{M.new_lede} <span class="muted">({buildDate})</span></p>
    </div>
    {newEntries.length === 0 ? <p class="panel ui">{M.new_none}</p> : <ModernList entries={newEntries} lang={lang} showSections id="new" />}
  </div>
  <script src="../../../../scripts/modern-filter.ts"></script>
</BaseLayout>
