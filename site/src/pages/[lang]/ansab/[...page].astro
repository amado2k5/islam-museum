---
// The Genealogies, Peoples, Butun and Prophets' Tree Browser's home
// (docs/plan/55-ansab-browser.md): every mention of lineages, tribes, peoples, the tribal
// the tribal subdivisions and the prophets' tree in the museum's sources — grouped into six domain sections over
// the one graph, with the prophets' lineage chain rendered as a tree. Subjects are graph
// records (persons, groups, works, concepts); their mention passages come from `mentions` edges
// and from the build-time lexicon in scripts/ansab.ts, so a mention in a book harvested later
// appears here automatically. Counts are read from the graph at build time.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { labelOf, stripNeedsSource, byId, href } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { ansabSubjects, ansabSlugById, ansabFeed, ANSAB_SECTIONS, ANSAB_CORPORA, ANSAB_PROPHET_CHAIN } from "../../../lib/ansab";

export function getStaticPaths() {
  // the landing, and a sub-page for every page of rows of each section longer than the landing shows (site/src/lib/paged.ts)
  // the subject sections, then the feed of mentions by corpus (ids "feed-<corpus>"): both are paginated the same way
  return pagedStaticPaths(LANGS, [
    ...ANSAB_SECTIONS.map((id) => ({ id: String(id), count: ansabSubjects.filter((s) => s.section === id).length })),
    ...ANSAB_CORPORA.map((c) => ({ id: `feed-${c}`, count: ansabFeed.filter((i) => i.corpus === c).length })),
  ]);
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const N = (T as any).ansab;
const label = (n: any) => labelOf(n, lang);
const summaryOf = (n: any) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1"); // citation markers belong to the entity page's footnotes
const sections = ANSAB_SECTIONS
  .map((id) => ({ id, items: ansabSubjects.filter((s) => s.section === id) }))
  .filter((s) => s.items.length > 0);
const feedSections = ANSAB_CORPORA.map((c) => ({ id: `feed-${c}`, items: ansabFeed.filter((i) => i.corpus === c) })).filter((s) => s.items.length > 0);
const paged = pageView<any>([...sections, ...feedSections], Astro.props as PagedProps, `/${lang}/ansab/`);
const isFeed = (s: { id: string }) => s.id.startsWith("feed-");
const pagedLabel = (s: { id: string }) => (isFeed(s) ? N.corpora[s.id.slice(5)].title : N.sections[s.id]?.title ?? s.id);
const pagedTitle = paged.landing ? N.title : `${N.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const status = fmt(N.status, { n: num(renderedHeadline("ansab", sections, [], ansabSubjects), lang), f: num(ansabFeed.length, lang), s: num(sections.length, lang) });
const searchText = (s: (typeof ansabSubjects)[number]) =>
  [s.node.label.ar, s.node.label.en, s.node.label.ur, summaryOf(s.node)].filter(Boolean).join(" ");
const slugOf = (s: (typeof ansabSubjects)[number]) => ansabSlugById.get(s.node.id)!;
// A browser subject links to its browser page; any other record links to its entity page.
const subjectHref = (id: string) => { const s = ansabSlugById.get(id); return s ? `/${lang}/ansab/${s}/` : href(lang, id); };
const countsLine = (s: (typeof ansabSubjects)[number]) =>
  ANSAB_CORPORA.filter((c) => s.counts[c] > 0).map((c) => `${N.corpora?.[c]?.name ?? c} · ${num(s.counts[c], lang)}`).join(" · ");
const chain = ANSAB_PROPHET_CHAIN.map((l) => ({ ...l, node: byId.get(l.id) })).filter((l) => l.node);
const firstDisputed = chain.findIndex((l) => !l.agreed);
const lastDisputed = chain.map((l, i) => (!l.agreed ? i : -1)).reduce((a, b) => Math.max(a, b), -1);
---
<BaseLayout lang={lang} title={pagedTitle} description={N.lede} path={paged.path}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{N.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {N.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <h1>{N.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{N.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{N.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{N.method_note}</p>
      <p class="ui muted">{N.api} <a href="/api/v1/ansab.json"><bdi dir="ltr">/api/v1/ansab.json</bdi></a></p>
    </div>

    <section aria-labelledby="tree-title" style="margin-top:2rem" data-pagefind-body={paged.landing || undefined}>
      <h2 id="tree-title">{N.tree_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{N.tree_note}</p>
      <ol role="list" class="ansab-chain" style="list-style:none;padding:0;margin:1rem 0;display:flex;flex-wrap:wrap;align-items:stretch;gap:8px">
        {chain.map((l, i) => (
          <li style={`display:flex;align-items:center;gap:8px;${!l.agreed ? "opacity:.92" : ""}`}>
            <a href={subjectHref(l.node.id)}
               class="chip"
               title={!l.agreed ? N.disputed_tooltip : ""}
               style={!l.agreed ? "border-style:dashed;border-color:var(--gold);text-decoration-style:dotted;text-decoration-line:underline;text-underline-offset:4px" : "font-weight:600"}>{label(l.node)}</a>
            {i < chain.length - 1 && <span class="ui" aria-hidden="true" style={`color:var(--gold);${!chain[i + 1].agreed ? "opacity:.6" : ""}`}>◂</span>}
          </li>
        ))}
      </ol>
      <p class="ui muted" style="font-size:.85rem;max-width:var(--measure)">
        <span aria-hidden="true" style="display:inline-block;width:2.2em;border-top:2px dashed var(--gold);vertical-align:middle;margin-inline-end:.4em"></span>{N.tree_legend}
        {firstDisputed >= 0 && <> — {N.disputed_from} {label(chain[firstDisputed].node)} {N.disputed_to} {label(chain[lastDisputed].node)}</>}
      </p>
    </section>

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{N.sections_title}</h2>
      <nav aria-label={N.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{N.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="ansab-filter">{N.filter_label}</label>
        <input id="ansab-filter" type="search" data-ansab-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <FullFilter lang={lang} slug="ansab" />
      <div data-pagefind-ignore>
        {paged.sections.filter((s) => !isFeed(s)).map((s) => (
          <section data-ansab-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{N.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{N.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-ansab-row data-search={searchText(i)} class="panel" style="padding:14px 16px">
                  <a href={`/${lang}/ansab/${slugOf(i)}/`} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {countsLine(i) && <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem">{countsLine(i)}</p>}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{summaryOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-ansab-none hidden>{N.filter_none}</p>
      {ansabSubjects.length === 0 && <p class="panel ui">{N.empty}</p>}
    </section>

    <section aria-labelledby="feed-title" style="margin-top:2rem">
      <h2 id="feed-title">{N.feed_title} · {num(ansabFeed.length, lang)}</h2>
      <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{N.feed_note}</p>
      {paged.sections.filter(isFeed).map((s) => {
        const c = s.id.slice(5);
        const items = s.items as typeof ansabFeed;
        return (
          <section aria-labelledby={`t-${s.id}`} style="margin:1.2rem 0" data-pagefind-ignore>
            <h3 id={`t-${s.id}`} style="font-size:1.05rem;margin:0 0 .5rem">{N.corpora[c].title} · {num(s.total, lang)}</h3>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:10px">
              {items.map((i) => (
                <li class="panel" style="padding:12px 14px">
                  <a href={`/${lang}/passage/${i.node.slug ?? i.node.id.split("/")[1]}/`} style="font-weight:600">{i.node.label?.[lang] ?? i.node.label?.en ?? i.node.id}</a>
                  <p class="ui muted" style="margin:.15rem 0 0;font-size:.8rem" dir="auto">{i.work ? label(i.work) : ""}{i.node.data.ref ? ` · ${i.node.data.ref}` : ""}</p>
                  {i.topics.length > 0 && (
                    <p class="ui" style="display:flex;flex-wrap:wrap;gap:4px;margin:.35rem 0 0">
                      {i.topics.slice(0, 6).map((t) => {
                        const tn = byId.get(t);
                        return tn
                          ? <a class="chip" style="font-size:.75rem" href={subjectHref(tn.id)}>{label(tn)}</a>
                          : <span class="chip" style="font-size:.75rem">{N.topics?.[t] ?? t}</span>;
                      })}
                    </p>
                  )}
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        );
      })}
    </section>
  </div>
  <script src="../../../scripts/ansab-filter.ts"></script>
</BaseLayout>
