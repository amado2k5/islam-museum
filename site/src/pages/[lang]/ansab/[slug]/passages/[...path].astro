---
// A subject of the Genealogy Browser: one section of the passages that name it, in full and paginated. The subject's
// own page shows the first of them (site/src/lib/axis.ts, SUBJECT_ROWS; audit S18).
import AxisPage from "../../../../../components/AxisPage.astro";
import { ui, LANGS, type Lang } from "../../../../../lib/i18n";
import { labelOf } from "../../../../../lib/graph";
import { ansabSubjects, ansabSlugById, passagesOfCorpus } from "../../../../../lib/ansab";
import { SUBJECT_ROWS, subjectHeading } from "../../../../../lib/axis";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => ansabSubjects.flatMap((s) => (["quran", "sunnah", "seerah", "books"] as const).flatMap((c) => {
    const h = subjectHeading(c, passagesOfCorpus(s.node.id, c));
    if (h.items.length <= SUBJECT_ROWS) return [];
    return Array.from({ length: h.pages }, (_x, k) => ({ params: { lang, slug: ansabSlugById.get(s.node.id)!, path: k === 0 ? c : `${c}/${k + 1}` }, props: { lang, subject: s.node, heading: h, pageNo: k + 1 } }));
  })));
}
const { lang, subject, heading, pageNo } = Astro.props as { lang: Lang; subject: any; heading: ReturnType<typeof subjectHeading>; pageNo: number };
const T = ui(lang) as any;
const N = T.ansab;
---
<AxisPage lang={lang} base={`ansab/${ansabSlugById.get(subject.id)}`} anchor="passages" browserTitle={labelOf(subject, lang)} A={T.paged.subject}
  name={`${labelOf(subject, lang)} · ${N.corpora[heading.id]?.title ?? heading.id}`} heading={heading} pageNo={pageNo} />
