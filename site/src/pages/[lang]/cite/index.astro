---
// Cite the museum: the canonical citation page for the islam.museum dataset.
// It carries the site's schema.org Dataset markup (Google Dataset Search and the
// other dataset indexes read JSON-LD), states the concept-DOI policy — always cite
// 10.5281/zenodo.23692511, never a single version DOI, so citations aggregate on one
// record — and gives copy-ready citation text plus BibTeX and RIS for the dataset.
// Prose from i18n (identical keys in ar/en/ur); the citation strings, BibTeX and RIS
// are language-neutral literals, shown LTR on every edition.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { SITE } from "../../../lib/graph";
import { a11yLd } from "../../../lib/a11y";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const C = T.cite;

const DOI = "10.5281/zenodo.23692511";
const DOI_URL = `https://doi.org/${DOI}`;

const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "islam.museum — an open digital museum of Islam",
  alternateName: "islam.museum dataset",
  description: "A knowledge graph of Islamic history — language-neutral records (people, places, events, buildings, works, concepts and more) with sourced relations and prose in Arabic, English and Urdu — published as a static site and a public API, and archived on Zenodo. Data CC0 1.0, prose CC BY-SA 4.0, code MIT.",
  url: `${SITE}/${lang}/cite/`,
  identifier: { "@type": "PropertyValue", propertyID: "DOI", value: DOI, url: DOI_URL },
  sameAs: [DOI_URL, "https://github.com/amado2k5/islam-museum"],
  creator: { "@type": "Person", name: "Ahmed Abdel Aal", identifier: "https://orcid.org/0009-0000-9215-2906", affiliation: { "@type": "Organization", name: "islam.museum", url: "https://islam.museum" } },
  publisher: { "@type": "Organization", name: "islam.museum", url: "https://islam.museum" },
  license: "https://creativecommons.org/publicdomain/zero/1.0/",
  isAccessibleForFree: true,
  inLanguage: ["ar", "en", "ur", "fr"],
  keywords: ["Islamic history", "Islamic civilization", "knowledge graph", "digital humanities", "open data", "digital museum"],
  distribution: [
    { "@type": "DataDownload", encodingFormat: "application/x-ndjson", contentUrl: "https://api.islam.museum/api/v1/graph/nodes.ndjson", name: "Graph nodes (records and stubs, one JSON object per line)" },
    { "@type": "DataDownload", encodingFormat: "application/x-ndjson", contentUrl: "https://api.islam.museum/api/v1/graph/edges.ndjson", name: "Graph edges (sourced connections, one JSON object per line)" },
    { "@type": "DataDownload", encodingFormat: "application/zip", contentUrl: DOI_URL, name: "Archived dataset snapshot on Zenodo (concept DOI; resolves to the newest version)" },
  ],
  ...a11yLd(lang),
};

const bibtex = `@dataset{abdel_aal_islam_museum_2026,
  author    = {Abdel Aal, Ahmed},
  title     = {islam.museum — an open digital museum of Islam},
  year      = {2026},
  publisher = {Zenodo},
  doi       = {${DOI}},
  url       = {${DOI_URL}},
  note      = {Data set. Data CC0 1.0. Concept DOI: cite this DOI, which always
               resolves to the newest archived version, rather than a version DOI.}
}`;

const ris = `TY  - DATA
AU  - Abdel Aal, Ahmed
TI  - islam.museum — an open digital museum of Islam
PY  - 2026
PB  - Zenodo
DO  - ${DOI}
UR  - ${DOI_URL}
N1  - Data set. Data CC0 1.0. Concept DOI: cite this DOI, which always resolves to the newest archived version, rather than a version DOI.
ER  -`;
---
<BaseLayout lang={lang} title={C.title} description={C.lede} path={`/${lang}/cite/`} jsonld={datasetLd}>
  <PageHeader
    title={C.title}
    lede={C.lede}
    crumbs={[
      { label: T.entity.breadcrumb, href: `/${lang}/` },
      { label: C.title },
    ]}
    crumbsLabel={T.entity.breadcrumb}
  />
  <div class="wrap" style="padding-block:24px">
    <article class="reading ui-body" style="max-width:52rem">
      <p>{C.intro}</p>

      <section aria-labelledby="cite-dataset">
        <h2 id="cite-dataset">{C.dataset_title}</h2>
        <p>{C.dataset_body}</p>
        <p dir="ltr"><a href={DOI_URL} rel="noopener">doi.org/{DOI}</a></p>
      </section>

      <section aria-labelledby="cite-preferred">
        <h2 id="cite-preferred">{C.citation_title}</h2>
        <h3>{C.citation_label}</h3>
        <pre class="cite-box" dir="ltr">{C.citation_text}</pre>
      </section>

      <section aria-labelledby="cite-version">
        <h2 id="cite-version">{C.version_title}</h2>
        <p>{C.version_body}</p>
      </section>

      <section aria-labelledby="cite-formats">
        <h2 id="cite-formats">{C.formats_title}</h2>
        <h3>{C.bibtex_label}</h3>
        <pre class="cite-box" dir="ltr">{bibtex}</pre>
        <h3>{C.ris_label}</h3>
        <pre class="cite-box" dir="ltr">{ris}</pre>
      </section>

      <section aria-labelledby="cite-paper">
        <h2 id="cite-paper">{C.paper_title}</h2>
        <p>{C.paper_body}</p>
      </section>

      <section aria-labelledby="cite-licence">
        <h2 id="cite-licence">{C.licence_title}</h2>
        <p>{C.licence_body}</p>
        <p>{C.contact_body}</p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .cite-box { white-space: pre-wrap; overflow-wrap: anywhere; border: 1px solid var(--rule); border-radius: 8px; padding: 12px 14px; font-size: .86rem; line-height: 1.55; background: var(--panel, transparent); }
</style>
