    ],
    hadith: [
      { t: "إن لنفسك عليك حقًا، ولأهلك عليك حقًا، ولضيفك عليك حقًا، فأعطِ كل ذي حق حقه.", r: "رواه البخاري" },
    ],
    steps: [
      "ابدأ بنقطة ثابتة واحدة: الفجر في وقته ثم أذكار الصباح، وأضف بقية المحطات تدريجيًا.",
