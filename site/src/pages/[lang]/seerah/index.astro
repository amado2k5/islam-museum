    steps: [
      { ar: "اكتب وصيتك وراجعها — الحقوق المالية والمعنوية لا تُرحَّل.", en: "Write your will and review it — financial and moral rights are not postponed.", ur: "اپنی وصیت لکھیں اور اس کا جائزہ لیں — مالی اور معنوی حقوق مؤخر نہیں کیے جاتے۔" },
      { ar: "ابدأ مشروع أثر: علّم ما تعرفه لواحد أصغر، أو أنشئ صدقة جارية موثقة.", en: "Begin a legacy project: teach what you know to someone younger, or establish a documented sadaqa jariyah.", ur: "اثر کا منصوبہ شروع کریں: اپنا علم کسی چھوٹے کو سکھائیں، یا لکھی ہوئی جاریہ صدقہ قائم کریں۔" },
      { ar: "خصص وردًا للمسجد — صلاة جماعة ثابتة تصبح عادة العمر الجديدة.", en: "Anchor yourself to the mosque — a fixed congregational prayer becomes the habit of this new age.", ur: "مسجد سے وابستہ ہوں — ایک مقررہ نمازِ جماعت اس نئی عمر کی عادت بن جاتی ہے۔" },
    ],
    why: { ar: "الصورة الكبيرة: آخر العمر أثمنه — أعمال الختام تُكتب على السجل كله، والأثر الجاري يجعل العمر يمتد بعد صاحبه.", en: "The big picture: the end of life is its most precious — closing deeds are written over the whole record, and a lasting legacy extends a lifetime beyond its owner.", ur: "بڑی تصویر: عمر کا آخری حصہ اس کا قیمتی ترین ہے — اختتامی اعمال پورے ریکارڈ پر لکھے جاتے ہیں، اور جاری اثر عمر کو اس کے مالک سے آگے بڑھاتا ہے۔" },
  },
];

const RES = [
  { url: "https://sunnah.com", b: "Sunnah.com", s: { ar: "كتب الحديث الستة — مصدر كل حديث مذكور هنا للتحقق.", en: "The six hadith collections — verify every hadith cited here.", ur: "حدیث کی چھ کتابیں — یہاں مذکور ہر حدیث کی تصدیق کے لیے۔" } },
  { url: "https://quran.com", b: "Quran.com", s: { ar: "نص القرآن وتلاوته وتفسيره — رفيق الورد اليومي.", en: "Quran text, recitation and tafsir — your daily portion companion.", ur: "قرآن کا متن، تلاوت اور تفسیر — روز کے ورد کا ساتھی۔" } },
  { url: "https://islamqa.info/ar", b: { ar: "الإسلام سؤال وجواب", en: "IslamQA", ur: "اسلام سوال و جواب" }, s: { ar: "إجابات موثقة على المسائل التفصيلية: زكاة، صيام، معاملات.", en: "Documented answers on detailed rulings: zakat, fasting, transactions.", ur: "تفصیلی مسائل پر مستند جوابات: زکوٰۃ، روزہ، معاملات۔" } },
];
const livingHref = `/${lang}/living/`;
---

<BaseLayout lang={lang} title={P.title} description={P.lede} path={`/${lang}/seerah/`}>
  <div class="wrap" style="padding-block:4vh 20px">
    <div data-pagefind-body>
      <p class="eyebrow">{lang === "ar" ? "Live Your Life the Islamic Way" : lang === "ur" ? "سیرت و زندگی" : "Seerah & Life"}</p>
      <h1 class="display" style="font-weight:400;font-size:clamp(2.2rem,6vw,4rem)">{P.title}</h1>
      <p style="font-size:clamp(1.05rem,2vw,1.3rem);max-width:64ch">{P.lede}</p>
      <p><a class="chip" href={href(lang, "passage/quran-33-21")}>{P.hero}</a></p>
    </div>

    <div class="controls ui" style="margin-block:1.6rem" data-pagefind-ignore>
      <input id="q" type="search" class="search" placeholder={P.search} aria-label={P.search} />
      <div class="chips-row" role="group" aria-label={P.hz}>
        <span class="row-label">{P.hz}</span>
        <button class="chip fchip hz active" data-hz="all" type="button">{P.all}</button>
        {HORIZONS.map((h) => <button class="chip fchip hz" data-hz={h.id} type="button">{S(h.name)}</button>)}
      </div>
      <div class="chips-row" role="group" aria-label={P.dm}>
        <span class="row-label">{P.dm}</span>
        <button class="chip fchip dm active" data-dm="all" type="button">{P.all}</button>
        {DOMAINS.map((d) => <button class="chip fchip dm" data-dm={d.id} type="button">{S(d.name)}</button>)}
      </div>
      <p class="muted" id="countline" style="font-size:.85rem;margin:8px 0 0" data-label={P.cards}></p>
    </div>

    <div data-pagefind-ignore>
    {DOMAINS.map((dom) => (
      <section class="domsec" data-domsec={dom.id} style="margin-block:2.4rem">
        <h2 class="ui" style="font-size:1.25rem;font-weight:600;border-inline-start:4px solid var(--gold);padding-inline-start:12px">{S(dom.name)}</h2>
        <p class="muted" style="max-width:60ch;margin-top:.2rem">{S(dom.desc)}</p>
        <ul class="plist">
          {ITEMS.filter((i) => i.domain === dom.id).map((it) => (
            <li>
              <details class="practice panel" data-hz={it.horizon} data-dom={it.domain}
                data-search={[S(it.title), S(it.teaser), S(it.body), ...(it.hadith ?? []).map((h) => S(h.t)), ...(it.steps ?? []).map((s) => S(s))].join(" ").toLowerCase()}>
                <summary>
                  <span class="sum-title">{S(it.title)}</span>
                  <span class="sum-teaser">{S(it.teaser)}</span>
                  <span class="sum-tags">
                    <span class="hz-badge">{S(HZ_NAME[it.horizon])}</span>
                    {it.stages.map((s) => <span class="stagetag">{S(STAGES[s])}</span>)}
                  </span>
                </summary>
                <div class="pbody">
                  <p>{S(it.body)}</p>
                  {it.routine && (
                    <table class="routine">
                      <tbody>
                        {it.routine.map((r) => <tr><th scope="row">{S(r.t)}</th><td>{S(r.a)}</td></tr>)}
                      </tbody>
                    </table>
                  )}
                  {it.ayat && it.ayat.length > 0 && (
                    <div>
                      <p class="blk">{P.from_quran}</p>
                      <p class="ayat-links">{it.ayat.map((a) => <a class="chip ayah-link" href={href(lang, `passage/quran-${a.sura}-${a.aya}`)}>{S(a.label)}</a>)}</p>
                    </div>
                  )}
                  {it.hadith && it.hadith.length > 0 && (
                    <div>
                      <p class="blk">{P.from_sunnah}</p>
                      {it.hadith.map((h) => <blockquote class="hadith">{S(h.t)} <span class="ref">{S(h.r)}</span></blockquote>)}
                    </div>
                  )}
                  {it.steps && (
                    <div>
                      <p class="blk">{P.steps}</p>
                      <ol class="steps">
                        {it.steps.map((s) => <li>{S(s)}</li>)}
                      </ol>
                    </div>
                  )}
                  {it.note && <p class="note"><b>{P.note}:</b> {S(it.note)}</p>}
                  {it.why && <p class="why">{S(it.why)}</p>}
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}
    </div>

    <section style="margin-block:3rem">
      <h2 class="ui" style="font-size:1.25rem;font-weight:600;border-inline-start:4px solid var(--gold);padding-inline-start:12px">{P.resources}</h2>
      <ul class="grid-cards" style="margin-top:1rem">
        {RES.map((r) => <li><a class="card" href={r.url} rel="noopener"><b>{typeof r.b === "string" ? r.b : S(r.b)}</b><span>{S(r.s)}</span></a></li>)}
        <li><a class="card" href={livingHref}><b>{P.living_wing}</b><span>{P.living_blurb}</span></a></li>
      </ul>
      <p class="muted" style="margin-top:1.5rem;font-size:.9rem">{P.verify}</p>
    </section>
  </div>

  <style>
    .search {
      width: 100%; padding: 12px 18px; font-size: 1.05rem; font-family: var(--ar-body);
      background: var(--bg); color: var(--fg);
      border: 1px solid var(--line); border-radius: 12px; outline: none;
    }
    .search:focus { border-color: var(--link); }
    .chips-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; }
    .row-label { font-size: .8rem; color: var(--muted); min-width: 82px; }
    .fchip { border: 1px solid var(--line); cursor: pointer; font-size: .9rem; }
    .fchip.active { background: var(--gold); color: #fff; border-color: var(--gold); }
    .plist { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; }
    .practice { padding: 0; overflow: hidden; }
    .practice summary {
      cursor: pointer; padding: 18px 20px; list-style: none; position: relative; padding-inline-end: 44px;
    }
    .practice summary::-webkit-details-marker { display: none; }
    .practice summary::after {
      content: "+"; position: absolute; inset-inline-end: 16px; top: 16px;
      color: var(--gold); font-size: 1.3rem; font-weight: 600; font-family: var(--sans);
    }
    .practice[open] summary::after { content: "−"; }
    .sum-title { display: block; font-family: var(--ar-display); font-size: 1.35rem; font-weight: 600; margin-bottom: 6px; }
    .sum-teaser { display: block; color: var(--muted); font-size: .95rem; }
    .sum-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .hz-badge {
      font-size: .72rem; padding: 2px 12px; border-radius: 999px;
      border: 1px solid var(--gold); color: var(--gold); font-weight: 700;
    }
    .stagetag { font-size: .72rem; padding: 2px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
    .pbody { padding: 0 20px 18px; border-top: 1px solid var(--line); padding-top: 14px; margin: 0 20px 18px; }
    .blk { font-size: .8rem; letter-spacing: 1px; color: var(--muted); margin: 1.2rem 0 .4rem; font-family: var(--sans); }
    .ayat-links { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
    .ayah-link { border: 1px solid var(--gold); color: var(--gold); font-family: var(--ar-quran); }
    .ref { display: block; font-family: var(--ar-body); font-size: .75rem; color: var(--muted); margin-top: 5px; }
    .hadith {
      font-size: .95rem; background: color-mix(in srgb, var(--link) 7%, transparent);
      border-inline-start: 3px solid var(--link); border-radius: 10px;
      padding: 10px 16px; margin: 10px 0;
    }
    .steps { margin: 8px 0; padding-inline-start: 22px; }
    .steps li { margin: 6px 0; }
    .note {
      margin-top: 12px; padding: 10px 16px; border-radius: 10px; font-size: .88rem;
      border: 1px dashed color-mix(in srgb, var(--link) 40%, transparent); color: var(--link);
    }
    .why {
      margin-top: 14px; padding: 12px 16px; border-radius: 12px; font-size: .92rem;
      border: 1px dashed color-mix(in srgb, var(--gold) 45%, transparent); color: var(--gold);
    }
    .routine { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: .95rem; }
    .routine th { color: var(--gold); font-family: var(--ar-display); font-weight: 600; white-space: nowrap; width: 1%; text-align: start; }
    .routine td, .routine th { padding: 8px 12px; border-bottom: 1px solid var(--line); }
    .hidden { display: none !important; }
  </style>

  <script src="../../../scripts/seerah.ts"></script>
</BaseLayout>
