---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, type Lang } from "../../../lib/i18n";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };

interface Step { ar: string }
interface Ref { t: string; r: string }
interface RoutineRow { t: string; a: string }
interface Practice {
  horizon: string; domain: string; stages: string[];
  title: string; teaser: string; body: string;
  routine?: RoutineRow[]; ayat?: Ref[]; hadith?: Ref[];
  steps?: string[]; note?: string; why?: string;
}

const HORIZONS = [
  { id: "daily",   name: "يومي" },
  { id: "weekly",  name: "أسبوعي" },
  { id: "monthly", name: "شهري" },
  { id: "yearly",  name: "سنوي" },
  { id: "life",    name: "مراحل العمر" },
] as const;
const HZ_NAME = Object.fromEntries(HORIZONS.map((h) => [h.id, h.name]));

const DOMAINS = [
  { id: "ibadah",  name: "العبادة والذكر",   desc: "صلاتك وذكرك وصيامك — عمود اليوم وقلب المنهج." },
  { id: "quran",   name: "القرآن والعلم",     desc: "وردك اليومي وحفظك وتعلّمك — نورٌ يقود بقية اليوم." },
  { id: "mal",     name: "المال والعمل",      desc: "الكسب الحلال، الإحسان في العمل، الزكاة، الادخار — المال أمانة." },
  { id: "usra",    name: "الأسرة والرحم",     desc: "بر الوالدين، صلة الرحم، تربية الأولاد — أقرب الناس أولى بالإحسان." },
  { id: "mujtama", name: "الجوار والمجتمع",   desc: "الجار، الرفق بالحيوان، خدمة الناس — المسلم جزء من كلّ." },
  { id: "nafs",    name: "النفس والوقت",      desc: "الهدف، الوقت، المحاسبة، التخطيط — عمرك رأس مالك." },
] as const;

const STAGES: Record<string, string> = {
  child: "طفولة", teen: "شباب", student: "طالب",
  adult: "عامل", parent: "والد/ة", elder: "كبير",
};

const ITEMS: Practice[] = [
  /* ---------- يومي ---------- */
  {
    horizon: "daily", domain: "ibadah", stages: ["teen", "student", "adult", "parent", "elder"],
    title: "يوم النبي",
    teaser: "من الفجر إلى النوم: خريطة يوم كامل على هديه — عبادة وعمل وأهل وراحة بلا إفراط ولا تفريط.",
    body: "لم يكن يوم النبي لحظات متفرقة بل نظامًا متكاملًا: يبدأ بالذكر والصلاة، ويمر بالعمل والأهل والناس، وينتهي بالنوم على ذكر. الوسطية هي السمة: «إن لنفسك عليك حقًا، ولأهلك عليك حقًا، ولضيفك عليك حقًا، فأعطِ كل ذي حق حقه». النوم المبكر والقيلولة والاستيقاظ قبل الفجر عادات ثابتة في يومه.",
    routine: [
      { t: "قبل الفجر", a: "قيام وتهجد واستغفار — وقت الأسحار وقت الدعاء المستجاب" },
      { t: "الفجر", a: "صلاة الفجر في وقتها، ثم أذكار الصباح وورد القرآن — لا يوم يبدأ بلا ذكر" },
      { t: "الصباح", a: "صلاة الضحى ركعتين، ثم العمل وكسب الرزق بإحسان" },
