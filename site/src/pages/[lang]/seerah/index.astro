---

<BaseLayout lang={lang} title="سيرة وحياة" description="السيرة منهج حياة: دليل عملي لتنظيم يومك وأسبوعك وشهرك وسنتك وعمرك على هدي النبي — عبادة وعلمًا ومالًا وأهلًا ومجتمعًا." path={`/${lang}/seerah/`}>
  <div class="wrap" style="padding-block:4vh 20px">
    <p class="eyebrow">Live Your Life the Islamic Way</p>
    <h1 class="display" style="font-weight:400;font-size:clamp(2.2rem,6vw,4rem)">سيرة وحياة</h1>
    <p style="font-size:clamp(1.05rem,2vw,1.3rem);max-width:64ch">السيرة ليست قصة تُروى فحسب — إنها منهج حياة. يوم النبي وسنته وعمره خريطة عملية: عبادة وعلمًا ومالًا وأهلًا ومجتمعًا. اختر أفقك الزمني ومجال حياتك، وابدأ.</p>
    <blockquote class="hero-ayah">﴿لَّقَدْ كَانَ لَكُمْ فِي رَسُولِ اللَّهِ أُسْوَةٌ حَسَنَةٌ لِّمَن كَانَ يَرْجُو اللَّهَ وَالْيَوْمَ الْآخِرَ﴾ <span class="ref">الأحزاب ٢١</span></blockquote>

    <div class="controls ui" style="margin-block:1.6rem">
      <input id="q" type="search" class="search" placeholder="ابحث في المنهج… (أذكار، زكاة، والدين، عمل، هدف…)" aria-label="بحث في البطاقات" />
      <div class="chips-row" role="group" aria-label="الأفق الزمني">
        <span class="row-label">الأفق الزمني</span>
        <button class="chip fchip hz active" data-hz="all" type="button">الكل</button>
        {HORIZONS.map((h) => <button class="chip fchip hz" data-hz={h.id} type="button">{h.name}</button>)}
      </div>
      <div class="chips-row" role="group" aria-label="مجال الحياة">
        <span class="row-label">مجال الحياة</span>
        <button class="chip fchip dm active" data-dm="all" type="button">الكل</button>
        {DOMAINS.map((d) => <button class="chip fchip dm" data-dm={d.id} type="button">{d.name}</button>)}
      </div>
      <p class="muted" id="countline" style="font-size:.85rem;margin:8px 0 0"></p>
    </div>

    {DOMAINS.map((dom) => (
      <section class="domsec" data-domsec={dom.id} style="margin-block:2.4rem">
        <h2 class="ui" style="font-size:1.25rem;font-weight:600;border-inline-start:4px solid var(--gold);padding-inline-start:12px">{dom.name}</h2>
        <p class="muted" style="max-width:60ch;margin-top:.2rem">{dom.desc}</p>
        <ul class="plist">
          {ITEMS.filter((i) => i.domain === dom.id).map((it) => (
            <li>
              <details class="practice panel" data-hz={it.horizon} data-dom={it.domain}
                data-search={[it.title, it.teaser, it.body, ...(it.ayat ?? []).map((a) => a.t), ...(it.hadith ?? []).map((h) => h.t), ...(it.steps ?? [])].join(" ").toLowerCase()}>
                <summary>
                  <span class="sum-title">{it.title}</span>
                  <span class="sum-teaser">{it.teaser}</span>
                  <span class="sum-tags">
                    <span class="hz-badge">{HZ_NAME[it.horizon]}</span>
                    {it.stages.map((s) => <span class="stagetag">{STAGES[s]}</span>)}
                  </span>
                </summary>
                <div class="pbody">
                  <p>{it.body}</p>
                  {it.routine && (
                    <table class="routine">
                      <tbody>
                        {it.routine.map((r) => <tr><th scope="row">{r.t}</th><td>{r.a}</td></tr>)}
                      </tbody>
                    </table>
                  )}
                  {it.ayat && it.ayat.length > 0 && (
                    <div>
                      <p class="blk">من القرآن</p>
                      {it.ayat.map((a) => <blockquote class="ayah">﴿{a.t}﴾ <span class="ref">{a.r}</span></blockquote>)}
                    </div>
                  )}
                  {it.hadith && it.hadith.length > 0 && (
                    <div>
                      <p class="blk">من السنة</p>
                      {it.hadith.map((h) => <blockquote class="hadith">{h.t} <span class="ref">{h.r}</span></blockquote>)}
                    </div>
                  )}
                  {it.steps && (
                    <div>
                      <p class="blk">خطوات عملية</p>
                      <ol class="steps">
                        {it.steps.map((s) => <li>{s}</li>)}
                      </ol>
                    </div>
                  )}
                  {it.note && <p class="note"><b>ملاحظة:</b> {it.note}</p>}
                  {it.why && <p class="why">{it.why}</p>}
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section style="margin-block:3rem">
      <h2 class="ui" style="font-size:1.25rem;font-weight:600;border-inline-start:4px solid var(--gold);padding-inline-start:12px">مصادر للتوسع</h2>
      <ul class="grid-cards" style="margin-top:1rem">
        <li><a class="card" href="https://sunnah.com" rel="noopener"><b>Sunnah.com</b><span>كتب الحديث الستة — مصدر كل حديث مذكور هنا للتحقق.</span></a></li>
        <li><a class="card" href="https://quran.com" rel="noopener"><b>Quran.com</b><span>نص القرآن وتلاوته وتفسيره — رفيق الورد اليومي.</span></a></li>
        <li><a class="card" href="https://islamqa.info/ar" rel="noopener"><b>الإسلام سؤال وجواب</b><span>إجابات موثقة على المسائل التفصيلية: زكاة، صيام، معاملات.</span></a></li>
        <li><a class="card" href={`/${lang}/living/`}><b>جناح الإسلام الحي</b><span>العبادات والعادات والسنة الهجرية في المتحف.</span></a></li>
      </ul>
      <p class="muted" style="margin-top:1.5rem;font-size:.9rem">المسائل الفقهية التفصيلية تُراجَع فيها مصادر الإفتاء الموثوقة في بلدك. والسيرة منهجٌ يُعاش، لا ذكرى تُروى.</p>
    </section>
  </div>

  <style>
    .hero-ayah {
      font-family: var(--ar-quran); font-size: 1.35rem; color: var(--gold);
      border: 1px solid var(--line); border-radius: 14px;
      padding: 18px 26px; max-width: 720px; margin: 1.6rem 0; background: var(--panel);
    }
    .hero-ayah .ref { display: block; font-family: var(--ar-body); font-size: .8rem; color: var(--muted); margin-top: 8px; }
    .search {
      width: 100%; padding: 12px 18px; font-size: 1.05rem; font-family: var(--ar-body);
      background: var(--bg); color: var(--fg);
      border: 1px solid var(--line); border-radius: 12px; outline: none;
    }
    .search:focus { border-color: var(--link); }
    .chips-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; }
    .row-label { font-size: .8rem; color: var(--muted); min-width: 82px; }
    .fchip { border: 1px solid var(--line); cursor: pointer; font-size: .9rem; }
    .fchip.active { background: var(--gold); color: #fff; border-color: var(--gold); }
    .plist { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; }
    .practice { padding: 0; overflow: hidden; }
    .practice summary {
      cursor: pointer; padding: 18px 20px; list-style: none;
    }
    .practice summary::-webkit-details-marker { display: none; }
    .practice summary::after {
      content: "+"; position: absolute; inset-inline-end: 16px; top: 16px;
      color: var(--gold); font-size: 1.3rem; font-weight: 600; font-family: var(--sans);
    }
    .practice[open] summary::after { content: "−"; }
    .practice summary { position: relative; padding-inline-end: 44px; }
    .sum-title { display: block; font-family: var(--ar-display); font-size: 1.35rem; font-weight: 600; margin-bottom: 6px; }
    .sum-teaser { display: block; color: var(--muted); font-size: .95rem; }
    .sum-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .hz-badge {
      font-size: .72rem; padding: 2px 12px; border-radius: 999px;
      border: 1px solid var(--gold); color: var(--gold); font-weight: 700;
    }
    .stagetag { font-size: .72rem; padding: 2px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
    .pbody { padding: 0 20px 18px; border-top: 1px solid var(--line); padding-top: 14px; margin: 0 20px 18px; }
    .blk { font-size: .8rem; letter-spacing: 1px; color: var(--muted); margin: 1.2rem 0 .4rem; font-family: var(--sans); }
    .ayah {
      font-family: var(--ar-quran); font-size: 1.2rem; color: var(--gold);
      background: color-mix(in srgb, var(--gold) 8%, transparent);
      border-inline-start: 3px solid var(--gold); border-radius: 10px;
      padding: 12px 16px; margin: 10px 0;
    }
    .ref { display: block; font-family: var(--ar-body); font-size: .75rem; color: var(--muted); margin-top: 5px; }
    .hadith {
      font-size: .95rem; background: color-mix(in srgb, var(--link) 7%, transparent);
      border-inline-start: 3px solid var(--link); border-radius: 10px;
      padding: 10px 16px; margin: 10px 0;
    }
    .steps { margin: 8px 0; padding-inline-start: 22px; }
    .steps li { margin: 6px 0; }
    .note {
      margin-top: 12px; padding: 10px 16px; border-radius: 10px; font-size: .88rem;
      border: 1px dashed color-mix(in srgb, var(--link) 40%, transparent); color: var(--link);
    }
    .why {
      margin-top: 14px; padding: 12px 16px; border-radius: 12px; font-size: .92rem;
      border: 1px dashed color-mix(in srgb, var(--gold) 45%, transparent); color: var(--gold);
    }
    .routine { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: .95rem; }
    .routine th { color: var(--gold); font-family: var(--ar-display); font-weight: 600; white-space: nowrap; width: 1%; text-align: start; }
    .routine td, .routine th { padding: 8px 12px; border-bottom: 1px solid var(--line); }
    .hidden { display: none !important; }
  </style>

  <script is:inline>
    (function () {
      var q = document.getElementById("q");
      var hzBtns = Array.prototype.slice.call(document.querySelectorAll(".fchip.hz"));
      var dmBtns = Array.prototype.slice.call(document.querySelectorAll(".fchip.dm"));
      var cards = Array.prototype.slice.call(document.querySelectorAll(".practice"));
      var secs = Array.prototype.slice.call(document.querySelectorAll(".domsec"));
      var countline = document.getElementById("countline");
      var hz = "all", dm = "all";
      function apply() {
        var query = (q && q.value || "").trim().toLowerCase();
        var words = query ? query.split(/\s+/) : [];
        var shown = 0;
        cards.forEach(function (c) {
          var ok = (hz === "all" || c.dataset.hz === hz) && (dm === "all" || c.dataset.dom === dm);
          if (ok && words.length) {
            var hay = c.dataset.search || "";
            ok = words.every(function (w) { return hay.indexOf(w) !== -1; });
          }
          c.closest("li").classList.toggle("hidden", !ok);
          if (ok) shown++;
        });
        secs.forEach(function (s) {
          var any = Array.prototype.some.call(s.querySelectorAll(".practice"), function (c) {
            return !c.closest("li").classList.contains("hidden");
          });
          s.classList.toggle("hidden", !any);
        });
        if (countline) countline.textContent = shown + " بطاقة";
      }
      hzBtns.forEach(function (b) { b.addEventListener("click", function () { hz = b.dataset.hz; hzBtns.forEach(function (x) { x.classList.toggle("active", x === b); }); apply(); }); });
      dmBtns.forEach(function (b) { b.addEventListener("click", function () { dm = b.dataset.dm; dmBtns.forEach(function (x) { x.classList.toggle("active", x === b); }); apply(); }); });
      if (q) q.addEventListener("input", apply);
      apply();
    })();
  </script>
</BaseLayout>
