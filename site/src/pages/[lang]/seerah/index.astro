      { t: "وَقُل رَّبِّ زِدْنِي عِلْمًا", r: "طه ١١٤" },
    ],
    hadith: [
      { t: "من سلك طريقًا يلتمس فيه علمًا سهل الله له به طريقًا إلى الجنة.", r: "رواه مسلم" },
      { t: "ما أكل أحد طعامًا قط خيرًا من أن يأكل من عمل يده.", r: "رواه البخاري" },
    ],
    steps: [
      "أتقن فرض العين أولًا: دورة أو كتاب ميسّر في العقيدة والفقه الأساسي — قبل أي تخصص.",
      "اختر مهارة سوق واحدة وخصص لها ساعة يوميًا لمدة سنة.",
      "ضع خطة تعلم مكتوبة: مصدر، وقت، وتطبيق — العلم بلا عمل نسيان مؤجل.",
    ],
    why: "الصورة الكبيرة: العالم العامل يخدم أمته بعلمه ويستغني بصنعته — الاستغناء بالكسب من كرم الأخلاق النبوية.",
  },
  {
    horizon: "life", domain: "mal", stages: ["student", "adult", "parent", "elder"],
    title: "العمل بإحسان والكسب الحلال",
    teaser: "إتقان العمل عبادة: لا غش، لا تقصير، لا رشوة — «إن الله يحب إذا عمل أحدكم عملًا أن يتقنه».",
    body: "العمل في الإسلام عبادة بالنية: موظف أمين، تاجر صادق، صانع متقن. الحرام في العمل: الغش («من غشنا فليس منا»)، الرشوة، تقصير ساعات الدوام، كذب البيع. الكسب الحلال يُسأل عنه يوم القيامة: «عن ماله من أين اكتسبه وفيما أنفقه». وإحسان العمل دعوة: كثير من الناس دخلوا الإسلام بصدق التجار.",
    hadith: [
      { t: "من غشنا فليس منا.", r: "رواه مسلم" },
      { t: "التاجر الصدوق الأمين مع النبيين والصديقين والشهداء.", r: "رواه الترمذي" },
      { t: "إن الله يحب إذا عمل أحدكم عملًا أن يتقنه.", r: "رواه البيهقي" },
    ],
    steps: [
      "دوّن نيتك صباحًا: هذا العمل عبادة وكسب حلال — النية تحوّل الساعات.",
      "راجع مالك: أي مصدر دخل فيه شبهة يُترك ولو قلّت البدائل.",
      "اسأل نفسك أسبوعيًا: هل أعطيت صاحب العمل / الزبون حقه كاملًا؟",
    ],
    why: "الصورة الكبيرة: ثلث عمرك في العمل — إن لم يكن عبادة ضاع ثلث دينك معه.",
  },
  {
    horizon: "life", domain: "usra", stages: ["adult", "parent"],
    title: "الزواج وبر الوالدين",
    teaser: "نصف الدين: اختيار بالدين والخلق، رحمة ومودة في البيت، وبرّ لا ينقطع بالوالدين.",
    body: "الزواج سكن ومودة ورحمة لا عقد مصالح: «ومن آياته أن خلق لكم من أنفسكم أزواجًا لتسكنوا إليها». المعيار النبوي للاختيار: الدين والخلق. بعد الزواج: الكلمة الطيبة صدقة بين الزوجين، والرفق بالنساء وصية النبي الأخيرة، وحقوق الوالدين لا تسقط بالزواج بل تتضاعف المسؤولية — الأم أولى بالصحبة ثلاث مرات قبل الأب.",
    ayat: [
      { t: "وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً", r: "الروم ٢١" },
    ],
    hadith: [
      { t: "إذا جاءكم من ترضون دينه وخلقه فزوجوه.", r: "رواه الترمذي" },
      { t: "أمك ثم أمك ثم أمك ثم أبوك.", r: "رواه البخاري في الأدب المفرد" },
      { t: "خيركم خيركم لأهله وأنا خيركم لأهلي.", r: "رواه الترمذي" },
    ],
    steps: [
      "للمقبل على الزواج: معيار الدين والخلق أولًا، والسؤال والاستخارة قبل القرار.",
      "للمتزوج: عدّ إلى عشر قبل الغضب، وخصص وقتًا أسبوعيًا للزوج أو الزوجة والأولاد بلا هاتف.",
      "للجميع: قائمة بحقوق الوالدين اليومية — اتصال، خدمة، دعاء — ولا يفوت يوم بلا بر.",
    ],
    why: "الصورة الكبيرة: البيت أول مجتمع تبنيه — صلاحه صلاح نصف المجتمع، وبر الوالدين أقرب طريق للرضا.",
  },
  {
    horizon: "life", domain: "nafs", stages: ["teen", "student", "adult", "parent", "elder"],
    title: "هدف في الحياة ورسالة",
    teaser: "«الدنيا مزرعة الآخرة» — مسلم بلا هدف كوكب بلا مدار؛ ما مشروعك الذي يبقى بعدك؟",
    body: "السيرة ليست عبادات متفرقة بل مشروع حياة: حمل النبي رسالة ولم تكن أيامه ردّة فعل. كل مسلم له رسالة ضمن رسالته: طبيب يشفي بإحسان، معلم يربي جيلًا، تاجر أمين يرفه الناس، أم تبني أسرة صالحة — كلها عبادة إذا صحت النية. اسأل: ما الذي أُتقنه ويحتاجه الناس ويرضي الله؟ تقاطع الثلاثة هو موقعك. واكتب مشروعك الذي يستمر بعدك: علم يُنتفع، صدقة جارية، ولد صالح.",
    ayat: [
      { t: "وَمَا خَلَقْتُ الْجِنَّ وَالْإِنسَ إِلَّا لِيَعْبُدُونِ", r: "الذاريات ٥٦" },
      { t: "وَابْتَغِ فِيمَا آتَاكَ اللَّهُ الدَّارَ الْآخِرَةَ ۖ وَلَا تَنسَ نَصِيبَكَ مِنَ الدُّنْيَا", r: "القصص ٧٧" },
    ],
    hadith: [
      { t: "إذا مات ابن آدم انقطع عمله إلا من ثلاث: صدقة جارية، أو علم ينتفع به، أو ولد صالح يدعو له.", r: "رواه مسلم" },
    ],
    steps: [
      "اكتب جملة واحدة: «رسالتي أن ...» — قد تتغير لكن الكتابة تبدأ الوضوح.",
      "حدد تقاطع الثلاثة: موهبتك + حاجة الناس + رضا الله.",
      "اربط مشروعًا دائمًا: علم تعلّمه، وقف تدعمه، أو ابن تربيه — شيء يجري بعدك.",
      "راجع رسالتك في المراجعة السنوية — الهدف يصقل ولا يترك.",
    ],
    why: "الصورة الكبيرة: هذه هي البطاقة المركزية في الصفحة كلها — العبادات تفاصيل، والرسالة هي الصورة التي تُجمع فيها.",
  },
  {
    horizon: "life", domain: "mujtama", stages: ["child", "teen", "student", "adult", "parent", "elder"],
    title: "الرفق بالحيوان ولا إسراف",
    teaser: "غُفر لرجل سقى كلبًا — الرحمة بالخلق كلهم منهج، والإسراف حرام ولو على النهر.",
    body: "الرحمة في السيرة تتجاوز البشر: حرم النبي قتل العصافير بلا حق، ونهى عن تحميل الدواب فوق طاقتها، وأثنى على من سقى كلبًا. والبيئة أمانة: «لا تسرفوا إن الله لا يحب المسرفين» — الماء والطعام والموارد. زرع الفسيلة صدقة: «ما من مسلم يغرس غرسًا فيأكل منه شيء إلا كانت له صدقة».",
    hadith: [
      { t: "غُفر لامرأة مومس سقت كلبًا، ودخلت النار امرأة حبست هرّة لا أطعمتها ولا تركتها تأكل من خشاش الأرض.", r: "متفق عليه" },
      { t: "ما من مسلم يغرس غرسًا أو يزرع زرعًا فيأكل منه طير أو إنسان أو بهيمة إلا كانت له صدقة.", r: "متفق عليه" },
    ],
    ayat: [
      { t: "وَلَا تُسْرِفُوا ۚ إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ", r: "الأنعام ١٤١" },
    ],
    steps: [
      "أطعم أو اسقِ حيوانًا هذا الأسبوع — وعاء ماء للقطط عند بابك مثلًا.",
      "راجع استهلاكك: ماء الوضوء والكهرباء والطعام المتبقي — الاعتدال عبادة.",
      "ازرع شيئًا ولو في شرفة — غرس يأكل منه مخلوق صدقة جارية.",
    ],
    why: "الصورة الكبيرة: الإسلام منظومة رحمة كونية لا خدمة ذات — «الراحمون يرحمهم الرحمن» بلا استثناء للنوع.",
  },
  {
    horizon: "life", domain: "mujtama", stages: ["student", "adult", "parent", "elder"],
    title: "خدمة المجتمع والتطوع",
    teaser: "«أحب الناس إلى الله أنفعهم للناس» — ساعة تطوع ثابتة تجعلك جزءًا من حل مشاكل الأمة.",
    body: "المسلم ليس معزولًا في محرابه: قضاء حوائج الناس عبادة — «لأن أمشي مع أخ لي في حاجة أحب إلي من اعتكاف شهر». تطوّع بما تجيد: طبيب يعالج فقيرًا، مبرمج يبني أداة نفع، معلم يدرّس مجانًا ساعة أسبوعيًا. والمجتمع يبدأ من الدائرة الصغرى: جارك، حارتك، مدرسة أولادك — قبل العالم.",
    hadith: [
      { t: "أحب الناس إلى الله أنفعهم للناس.", r: "رواه الطبراني — حسن" },
      { t: "من كان يؤمن بالله واليوم الآخر فليقل خيرًا أو ليصمت.", r: "متفق عليه" },
    ],
    steps: [
      "حدد مهارة تخدم بها: ما تجيده غالبًا هو ما يحتاجه غيرك.",
      "خصص ساعة تطوع ثابتة أسبوعيًا أو شهريًا — الثبات أهم من الحجم.",
      "ابدأ بدائرتك: جار محتاج، مدرسة، مسجد الحي — النفع القريب أولى.",
    ],
    why: "الصورة الكبيرة: الأمة جسد واحد — خدمتك للناس ليست خيارًا جانبيًا بل نصيبك في إصلاح الكل.",
  },
  {
    horizon: "life", domain: "mujtama", stages: ["parent", "elder"],
    title: "الكِبَر — خبرة تورَّث وأثر يبقى",
    teaser: "سنوات الكبار ليست انسحابًا بل ذروة: مسجد، تعليم، وصية، ومشروع خير يجري بعد الرحيل.",
    body: "السيرة تكرّم الشيخوخة: «إذا مات ابن آدم انقطع عمله إلا من ثلاث» — وهذه سنوات إعداد الثلاث. ملازمة المسجد — «لا يزال العبد في صلاة ما كان في المسجد ينتظر الصلاة» — نقل العلم والخبرة للأجيال، كتابة الوصية وتسوية الحقوق، وإنشاء صدقة جارية. والكبير له حقوق على الصغار: التوقير، الاستماع، خدمة الحاجة.",
    hadith: [
      { t: "لا يزال العبد في صلاة ما كان في المسجد ينتظر الصلاة.", r: "متفق عليه" },
      { t: "ليس منا من لم يرحم صغيرنا ويوقر كبيرنا.", r: "رواه الترمذي" },
    ],
    steps: [
      "اكتب وصيتك وراجعها — الحقوق المالية والمعنوية لا تُرحَّل.",
      "ابدأ مشروع أثر: علّم ما تعرفه لواحد أصغر، أو أنشئ صدقة جارية موثقة.",
      "خصص وردًا للمسجد — صلاة جماعة ثابتة تصبح عادة العمر الجديدة.",
    ],
    why: "الصورة الكبيرة: آخر العمر أثمنه — أعمال الختام تُكتب على السجل كله، والأثر الجاري يجعل العمر يمتد بعد صاحبه.",
  },
