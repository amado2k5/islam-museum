---
// Band hub: sprouts (docs/delegation/education-master-plan.md §4, E1).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BandHub from "../../../components/BandHub.astro";
import FactStrip from "../../../components/FactStrip.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { viewBands } from "../../../lib/edu";


export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const E = T.edu;
const band = viewBands(lang, T.kids).find((b) => b.id === "sprouts")!;

---
<BaseLayout lang={lang} title={band.name} description={`${fmt(E.band_hub_for, { ages: band.agesLabel })}: ${band.voice}`} path={band.hub} kids={true}>
  <BandHub lang={lang} band={band}>
    <FactStrip lang={lang} />
  </BandHub>
</BaseLayout>
