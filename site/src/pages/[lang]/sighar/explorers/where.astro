---
// Where am I? — the gentle version for the explorers band (docs/delegation/education-master-plan.md §5
// E3, step 6): twelve riddles spoken in the first person by a place or a building. Two choices, always
// warm — a <details> reveal under each option, so no JavaScript is needed and no answer is ever "wrong".
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { ui, fmt, LANGS, type Lang } from "../../../../lib/i18n";
import { viewBands } from "../../../../lib/edu";
import { loadWhere, viewWhere } from "../../../../lib/where";
import "../../../../styles/edu.css";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const E = T.edu;
const band = viewBands(lang, T.kids).find((b) => b.id === "explorers")!;
const path = `/${lang}/sighar/explorers/where/`;
const rounds = loadWhere().map((r) => viewWhere(r, lang));
---
<BaseLayout lang={lang} title={E.wh_title} description={E.wh_lede} path={path} kids={true}>
  <div class="wrap edu" style="padding-block:10px 24px">
    <nav class="ui muted no-print" aria-label="breadcrumb"><a href={band.hub}>{band.name}</a> › {E.wh_title}</nav>
    <h1>{E.wh_title}</h1>
    <p style="max-width:var(--measure)">{E.wh_lede}</p>

    <ol class="wh-list">
      {rounds.map((r) => (
        <li class="wh-round">
          <p class="wh-q">{r.question}</p>
          <div class="wh-opts">
            {r.options.map((o) => (
              <details class="wh-opt">
                <summary>{fmt(E.wh_guess, { name: o.label })}</summary>
                <div class="wh-reveal">
                  {o.right
                    ? <p>{fmt(E.wh_yes, { name: o.label })}</p>
                    : <p>{fmt(E.wh_notquite, { answer: r.answerLabel, name: o.label })}</p>}
                  <p class="ui"><a href={o.href}>{E.wh_visit}</a></p>
                </div>
              </details>
            ))}
          </div>
        </li>
      ))}
    </ol>
    <p class="muted" style="max-width:var(--measure)">{E.wh_note}</p>
  </div>
  <style>
    .wh-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; max-width: 46rem; }
    .wh-round { border: 1px solid var(--line); border-radius: 14px; padding: 12px 16px; background: var(--card); }
    .wh-q { font-size: 1.05rem; margin: 0 0 .5rem; }
    .wh-opts { display: grid; gap: 8px; }
    .wh-opt > summary { cursor: pointer; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }
    .wh-reveal { padding: .5rem 1rem 0; }
  </style>
</BaseLayout>
