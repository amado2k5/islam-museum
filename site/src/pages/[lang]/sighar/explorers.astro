---
// Band hub: explorers (docs/delegation/education-master-plan.md §4, E1).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BandHub from "../../../components/BandHub.astro";
import FactStrip from "../../../components/FactStrip.astro";
import ReadShelf from "../../../components/ReadShelf.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { viewBands } from "../../../lib/edu";


export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const E = T.edu;
const band = viewBands(lang, T.kids).find((b) => b.id === "explorers")!;

---
<BaseLayout lang={lang} title={band.name} description={`${fmt(E.band_hub_for, { ages: band.agesLabel })}: ${band.voice}`} path={band.hub} kids={true}>
  <BandHub lang={lang} band={band}>
    <FactStrip lang={lang} />
    <ul class="edu-adult">
      <li><a href={`/${lang}/sighar/explorers/where/`}><span class="ic" aria-hidden="true">🧭</span><span><h2>{E.wh_title}</h2><p>{E.wh_lede}</p></span></a></li>
    </ul>
    <ReadShelf lang={lang} band="explorers" />
  </BandHub>
</BaseLayout>
