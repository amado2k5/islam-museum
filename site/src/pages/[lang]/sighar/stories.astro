---
// Bedtime Stories (ages 4–6): five calm retellings, server-rendered, no JS needed.
// Story bodies come from kids/stories.yaml via lib/kids.ts viewStories() — the
// UI renders honorifics programmatically; authors never type them.
// Night theme lives in this page's scoped <style> (never touch styles/kids.css).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { loadStories, viewStories, storyAudioExists } from "../../../lib/kids";
import "../../../styles/kids.css";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const t = T.kids;
const crumbLabel = lang === "ar" ? "مسار التنقل" : "breadcrumb";
// Build-time gate: the narration player renders only when its MP3 exists.
const stories = viewStories(loadStories(), lang).map((s) => ({
  ...s,
  audio: storyAudioExists(s.slug, lang),
}));
---
<BaseLayout lang={lang} title={t.stories_title} description={t.stories_lede} path={`/${lang}/sighar/stories/`} kids={true}>
  <div class="kids night" id="top">
    <nav aria-label={crumbLabel} class="crumbs">
      <a href={`/${lang}/sighar/`}>{t.hub_title}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{t.stories_title}</span>
    </nav>

    <h1 class="stories-h1"><span aria-hidden="true">🌙</span> {t.stories_title}</h1>
    <p class="lede">{t.stories_lede}</p>

    <nav class="stories-index" aria-label={t.stories_all}>
      <ul>
        {stories.map((s) => (
          <li>
            <a href={`#story-${s.slug}`}>
              <span aria-hidden="true">{s.icon}</span> {s.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {stories.map((s, i) => {
      const next = stories[(i + 1) % stories.length];
      const nextHref = i === stories.length - 1 ? "#top" : `#story-${next.slug}`;
      return (
        <article class="story" id={`story-${s.slug}`} aria-labelledby={`story-title-${s.slug}`}>
          <h2 class="story-title" id={`story-title-${s.slug}`}>
            <span aria-hidden="true" class="story-icon">{s.icon}</span> {s.title}
          </h2>
          <div class="story-body">
            {s.bodyHtml.split(/\n{2,}/).map((para) => (
              <p set:html={para} />
            ))}
          </div>
          {s.audio && (
            <figure class="story-audio">
              <figcaption id={`story-audio-${s.slug}`}>{t.stories_listen} · {t.stories_transcript}</figcaption>
              <audio controls preload="none" src={`/audio/kids/${s.slug}-${lang}.mp3`} aria-describedby={`story-audio-${s.slug}`} />
            </figure>
          )}
          <aside class="talk-box" aria-label={t.stories_talk}>
            <p><b>💬 {t.stories_talk}:</b> {s.talk}</p>
          </aside>
          <p class="next-wrap">
            <a class="kids-btn next-story" href={nextHref}>
              {t.stories_next} <span aria-hidden="true">{next.icon}</span>
            </a>
          </p>
        </article>
      );
    })}

    <details class="grownups">
      <summary>{t.grownups_title}</summary>
      <p>{t.grownups_stories}</p>
    </details>
  </div>

  <style>
    /* Night-mode bedtime theme: deep lapis, warm paper, big serif. Scoped to this page. */
    .kids.night {
      background: #101d38;
      color: #faf6ea;
      border-radius: 1.5rem;
      padding: clamp(1.25rem, 4vw, 3rem);
    }
    .kids.night .crumbs a { color: #f2d77e; }
    .kids.night .crumbs [aria-current] { color: #faf6ea; }
    .kids.night .stories-h1 {
      font-family: Georgia, "Times New Roman", "Amiri", "Noto Naskh Arabic", serif;
      font-size: clamp(2.25rem, 7vw, 3.5rem);
      color: #faf6ea;
      margin-block: 0.75rem 0.5rem;
    }
    .kids.night .lede {
      font-size: clamp(1.25rem, 4vw, 1.6rem);
      color: #f2d77e;
      max-width: 40em;
    }
    .kids.night .stories-index ul {
      list-style: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-block: 1.5rem;
    }
    .kids.night .stories-index a {
      display: inline-block;
      padding: 0.75rem 1.25rem;
      min-height: 48px;
      border: 2px solid #c9a227;
      border-radius: 999px;
      color: #faf6ea;
      font-size: 1.15rem;
      text-decoration: none;
    }
    .kids.night .stories-index a:hover,
    .kids.night .stories-index a:focus-visible {
      background: #c9a227;
      color: #1b2a4a;
    }
    .kids.night .story {
      border-top: 2px solid #2c3f66;
      padding-block: 2.5rem;
      max-width: 46em;
    }
    .kids.night .story-title {
      font-family: Georgia, "Times New Roman", "Amiri", "Noto Naskh Arabic", serif;
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      color: #f2d77e;
      margin-block: 0 1rem;
      scroll-margin-top: 1rem;
    }
    .kids.night .story-icon { font-size: 1.2em; }
    .kids.night .story-body {
      font-size: clamp(1.35rem, 4vw, 1.7rem);
      line-height: 1.9;
    }
    .kids.night .story-body p { margin-block: 0 1.25rem; }
    .kids.night .story-audio { margin-block: 1.5rem; }
    .kids.night .story-audio figcaption {
      font-size: 1.2rem;
      color: #f2d77e;
      margin-block-end: 0.5rem;
    }
    .kids.night .story-audio audio { width: 100%; max-width: 28rem; }
    .kids.night .talk-box {
      background: #1b2a4a;
      border: 2px dashed #c9a227;
      border-radius: 1rem;
      padding: 1rem 1.25rem;
      font-size: 1.2rem;
      line-height: 1.7;
      margin-block: 1.5rem;
    }
    .kids.night .next-wrap { margin-block: 1.5rem 0; }
    .kids.night .next-story {
      min-height: 64px;
      font-size: 1.35rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    /* Grown-ups details readable on the night theme */
    .kids.night .grownups {
      background: #1b2a4a;
      border: 1px solid #2c3f66;
      color: #faf6ea;
    }
    .kids.night .grownups summary { color: #f2d77e; }
    @media (prefers-reduced-motion: reduce) {
      .kids.night * { animation: none !important; transition: none !important; }
    }
  </style>
</BaseLayout>
