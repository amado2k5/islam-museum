---
// Index of the entry roots marked on the pages of al-Sihah (Bulaq 1282/1865): every marked root, by first letter, with a
// link to the entry on its page. The marking is a model's reading of the machine text (docs/plan/72-dictionaries-browser.md);
// a root can be misread, so the link goes to the entry and the page text is the evidence.
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { ui, LANGS, fmt, type Lang } from "../../../../../lib/i18n";
import { href, realNodes } from "../../../../../lib/graph";
import { num } from "../../../../../lib/nav";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const M = (T as any).maajim;
const collator = new Intl.Collator("ar");
const base = (r: string) => r.replace(/[أإآٱ]/g, "ا");
type Row = { root: string; id: string; anchor: string; page: number; vol: number };
const rows: Row[] = [];
for (const n of realNodes) {
  if (!n.tags.includes("maajim-sihah-bulaq")) continue;
  const hw: { root: string | null; at: number }[] = n.data.headwords ?? [];
  if (!hw.length) continue;
  const m = /-v(\d)-p(\d+)$/.exec(n.id);
  const offset = hw[0].at > 0 ? 1 : 0;
  hw.forEach((h, k) => { if (h.root) rows.push({ root: h.root, id: n.id, anchor: `e${k + offset}`, page: m ? Number(m[2]) : 0, vol: m ? Number(m[1]) : 0 }); });
}
rows.sort((a, b) => collator.compare(base(a.root), base(b.root)) || a.vol - b.vol || a.page - b.page);
const groups = new Map<string, Row[]>();
for (const r of rows) { const g = [...base(r.root)][0]; if (!groups.has(g)) groups.set(g, []); groups.get(g)!.push(r); }
---
<BaseLayout lang={lang} title={M.roots_title} description={M.roots_lede} path={`/${lang}/maajim/sihah/roots/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › <a href={`/${lang}/maajim/`}>{M.title}</a> › <a href={`/${lang}/maajim/sihah/`}>{M.sihah_title}</a> › {M.roots_title}</nav>
    <div data-pagefind-body>
      <h1>{M.roots_title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{M.roots_lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{M.roots_note}</p>
      <p class="ui muted">{fmt(M.roots_count, { n: num(rows.length, lang) })}</p>
    </div>
    <div data-pagefind-ignore>
      {[...groups.entries()].map(([g, rs]) => (
        <details style="margin:.5rem 0">
          <summary class="ui"><bdi dir="rtl" lang="ar">{g}</bdi> · {num(rs.length, lang)}</summary>
          <ul role="list" style="display:flex;flex-wrap:wrap;gap:6px;padding:.5rem 0;margin:0;list-style:none">
            {rs.map((r) => <li><a class="chip" dir="rtl" lang="ar" href={`${href(lang, r.id)}#${r.anchor}`} title={fmt(M.roots_where, { v: num(r.vol, lang), p: num(r.page, lang) })}>{r.root}</a></li>)}
          </ul>
        </details>
      ))}
      {rows.length === 0 && <p class="panel ui">{M.empty}</p>}
    </div>
  </div>
</BaseLayout>
