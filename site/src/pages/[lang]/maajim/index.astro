---
// The Dictionaries Browser's home (docs/plan/72-dictionaries-browser.md): the museum's records of the great
// dictionaries of Arabic and of the Islamic sciences, in sections over the one graph. Counts are read from the
// graph at build time and appear on this page only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DraftMark from "../../../components/DraftMark.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { href, labelOf, realNodes } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { maajimItems, MAAJIM_SECTIONS, MAAJIM_PILOT_SOURCES } from "../../../lib/maajim";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const M = (T as any).maajim;
const label = (n: any) => labelOf(n, lang);
const summaryOf = (n: any) => n.data.summary?.[lang] ?? n.data.summary?.ar ?? "";
const sectionIds = [...MAAJIM_SECTIONS, ...new Set(maajimItems.map((i) => i.section).filter((s) => !MAAJIM_SECTIONS.includes(s)))];
const sections = sectionIds.map((id) => ({ id, items: maajimItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const status = fmt(M.status, { n: num(maajimItems.length, lang), s: num(sections.length, lang) });
const authorsOf = (n: any): any[] => (n.data.authors ?? []).map((id: string) => realNodes.find((x) => x.id === id)).filter(Boolean);
const pilotSources = MAAJIM_PILOT_SOURCES.map((id) => realNodes.find((n) => n.id === id)).filter(Boolean) as any[];
---
<BaseLayout lang={lang} title={M.title} description={M.lede} path={`/${lang}/maajim/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{M.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {M.title}</nav>
    <div data-pagefind-body>
      <h1>{M.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{M.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{M.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{M.method_note}</p>
      <p class="ui muted">{M.api} <a href="/api/v1/maajim.json"><bdi dir="ltr">/api/v1/maajim.json</bdi></a></p>
    </div>

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{M.sections_title}</h2>
      <nav aria-label={M.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`#t-${s.id}`}>{M.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <div data-pagefind-ignore>
        {sections.map((s) => (
          <section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{M.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{M.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {authorsOf(i.node).length > 0 && (
                    <p class="ui muted" style="margin:.2rem 0 0">{authorsOf(i.node).map((a, k) => <>{k > 0 ? "، " : ""}<a href={href(lang, a.id)}>{label(a)}</a></>)}</p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem">{summaryOf(i.node)}</p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
      {maajimItems.length === 0 && <p class="panel ui">{M.empty}</p>}
    </section>

    <section aria-labelledby="pilot-title" style="margin-top:2.2rem">
      <h2 id="pilot-title">{M.pilot_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{M.pilot_note}</p>
      <h3 style="font-size:1rem">{M.sources_title}</h3>
      <p class="muted" style="max-width:var(--measure)">{M.sources_note}</p>
      <ul>
        {pilotSources.map((s) => <li><a href={href(lang, s.id)}>{label(s)}</a></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
