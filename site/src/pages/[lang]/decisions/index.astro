---
// Decision ledger (POC): lists docs/decisions/records/*.yaml — the auditable output of
// scripts/decisions/decide.ts — plus the precedent count from precedents.yaml.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { decisionRecords, decisionStats } from "../../../lib/decisions";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const C = T.decisions;
const records = decisionRecords();
const stats = decisionStats(records);
const statusLabel = (s?: string) =>
  s === "decided" ? C.status_decided : s === "founder-docket" ? C.status_founder : s === "rejected" ? C.status_rejected : (s ?? "—");
---
<BaseLayout lang={lang} title={C.title} description={C.lede} path={`/${lang}/decisions/`}>
  <PageHeader title={C.title} lede={C.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: C.title }]} crumbsLabel={T.entity.breadcrumb} />
  <div class="wrap" style="padding-block:40px 20px">
    <p class="ui muted" style="max-width:var(--measure)">{C.note}</p>
    <p class="ui"><b>{stats.total}</b> {C.records_label} · <b>{stats.precedents}</b> {C.precedents_label}</p>
    {Object.keys(stats.byStatus).length > 0 && (
      <p class="ui">{C.by_status}: {Object.entries(stats.byStatus).map(([s, n]) => `${statusLabel(s)} (${n})`).join(" · ")}</p>
    )}
    {records.length === 0 ? (
      <p class="ui">{C.empty}</p>
    ) : (
      records.map((r) => (
        <section class="panel ui" style="margin:0 0 14px;padding:14px 16px">
          <p style="margin:0 0 6px"><b>{r.question}</b> <span class="muted" dir="ltr">{r.id}{r.date ? ` · ${r.date}` : ""}</span></p>
          <p style="margin:0 0 6px">{statusLabel(r.status)}{r.step ? ` · ${r.step}` : ""}{r.lane ? ` · ${C.lane}: ${r.lane}` : ""}{r.confidence !== undefined ? ` · ${C.confidence}: ${r.confidence}` : ""} · {r.reversible ? C.reversible_yes : C.reversible_no}</p>
          <p style="margin:0 0 6px"><b>{C.decision}:</b> {r.decision ?? r.rationale}</p>
          {r.rationale && r.decision && <p class="muted" style="margin:0 0 6px">{r.rationale}</p>}
          {r.precedent && <p class="muted" style="margin:0">{C.precedent}: <span dir="ltr">{r.precedent.id}</span> ({r.precedent.source_file})</p>}
          {r.needs_precedent && <p class="muted" style="margin:0">{C.needs_precedent}</p>}
        </section>
      ))
    )}
  </div>
</BaseLayout>
