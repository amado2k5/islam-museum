---
// The Du'a Browser's home (docs/plan/43-dua-browser.md): every supplication the museum's
// sources mention — Qur'an verses, hadith reports, seerah books and every harvested work —
// plus the curated records on supplication, over the one graph. Passages are found at build
// time by the shared detector in scripts/dua.ts, so a supplication in a book harvested later
// appears here the day its passage record lands; curated records join through the `dua-browser`
// tag. Counts are read from the graph at build time and appear on this page only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, curatedFirst, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import LampStrings from "../../../components/sig/LampStrings.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { duaItems, duaOccasions, duaOccasionTotal, DUA_SECTIONS, type DuaKind, type DuaSection } from "../../../lib/dua";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() {
  // the landing, and a sub-page for every page of rows of each section longer than the landing shows (site/src/lib/paged.ts)
  const ids = [...DUA_SECTIONS];
  return pagedStaticPaths(LANGS, ids.map((id) => ({ id: String(id), count: duaItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).dua;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1"); // citation markers belong to the entity page's footnotes
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : (n.data.unit ? String(n.data.unit) : "");
};
const kindLabel = (k: DuaKind | null) => (k ? G.kinds?.[k] : null);
const sectionIds: DuaSection[] = curatedFirst([...DUA_SECTIONS]);
const sections = sectionIds.map((id) => ({ id, items: duaItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/dua/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const status = fmt(G.status, { n: num(renderedHeadline("dua", sections, [], duaItems), lang), s: num(sections.length, lang) });
const searchText = (i: (typeof duaItems)[number]) =>
  [
    i.node.label.ar, i.node.label.en, i.node.label.ur,
    summaryText(i.node), excerptOf(i.node), workLabel(i.node),
    kindLabel(i.kind) ?? "",
  ].filter(Boolean).join(" ");
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{G.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <h1>{G.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{G.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/duas.json"><bdi dir="ltr">/api/v1/duas.json</bdi></a></p>
    </div>

    {paged.landing && <LampStrings lang={lang} />}
    <DraftMark lang={lang} legend />
    {paged.landing && duaOccasions.length > 0 && (
      <section aria-labelledby="dua-by-occasion" style="margin-top:2rem">
        <h2 id="dua-by-occasion">{G.occasions.title}</h2>
        <p class="muted" style="max-width:var(--measure)">{fmt(G.occasions.note, { n: num(duaOccasions.reduce((a, o) => a + o.items.length, 0), lang), d: num(duaOccasions.length, lang), t: num(duaOccasionTotal, lang) })}</p>
        <ul role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">
          {duaOccasions.map((o) => (
            <li class="panel" style="padding:14px 16px">
              <a href={`/${lang}/dua/occasion/${o.id}/`} style="font-weight:600">{G.occasions.names[o.id]}</a> <span class="ui muted">· {num(o.items.length, lang)}</span>
              <p class="ui muted" style="margin:.2rem 0 0;font-size:.85rem" lang="ar" dir="rtl">{o.title}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="dua-filter">{G.filter_label}</label>
        <input id="dua-filter" type="search" data-dua-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <FullFilter lang={lang} slug="dua" />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-dua-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-dua-row data-search={searchText(i)} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {i.node.class === "passage" && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                      {workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}
                      {kindLabel(i.kind) ? <> · <span class="chip" style="font-size:.75rem;padding:1px 8px">{kindLabel(i.kind)}</span></> : null}
                    </p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-dua-none hidden>{G.filter_none}</p>
      {duaItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/dua-filter.ts"></script>
</BaseLayout>
