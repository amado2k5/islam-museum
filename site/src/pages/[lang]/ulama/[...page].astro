---
// The Ulama Browser's home (docs/plan/70-ulama-browser.md): «متصفح المفكرون والعلماء والأدباء والمحدثون
// والكتاب» — every thinker, scholar, litterateur, muhaddith and writer the graph knows, and everything
// the Qur'an, the Sunnah, the seerah and every harvested book says about them. Persons qualify by
// role/job; mentions come from `mentions` edges, the reviewed Qur'an table and the guarded name lexicon
// in scripts/ulama.ts at build time, so a book harvested later appears the day its records land;
// curated records join through the `ulama-browser` tag. Counts are read from the graph and appear here only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, curatedFirst, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { ulamaItems, ulamaMentionsOf, worksOf, ULAMA_SECTIONS, ULAMA_TOPICS, type UlamaSection, type UlamaTopic } from "../../../lib/ulama";
import type { Node } from "../../../../scripts/build-graph";
import UlamaMajlis from "../../../components/sig/UlamaMajlis.astro";

export function getStaticPaths() {
  const ids = [...ULAMA_SECTIONS];
  return pagedStaticPaths(LANGS, ids.map((id) => ({ id: String(id), count: ulamaItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).ulama;
const AR = (ui("ar") as any).ulama;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1");
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : (n.data.unit ? String(n.data.unit) : "");
};
const topicLabel = (t: UlamaTopic) => G.topics?.[t] ?? t;
/** Person card dates: birth–death as the record states them, Hijri preferred where present. */
const datesOf = (n: Node) => {
  const b = n.data.born?.hijri ?? (n.data.born?.edtf ? String(n.data.born.edtf).replace(/-.*$/, "") : "");
  const d = n.data.died?.hijri ?? (n.data.died?.edtf ? String(n.data.died.edtf).replace(/-.*$/, "") : "");
  return [b, d].filter(Boolean).join(d && b ? " – " : "");
};
const sectionIds: UlamaSection[] = curatedFirst([...ULAMA_SECTIONS]);
const sections = sectionIds.map((id) => ({ id, items: ulamaItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/ulama/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const status = fmt(G.status, { n: num(renderedHeadline("ulama", sections, [], ulamaItems), lang), s: num(sections.length, lang) });
const searchText = (i: (typeof ulamaItems)[number]) =>
  [
    i.node.label.ar, i.node.label.en, i.node.label.ur,
    summaryText(i.node), excerptOf(i.node), workLabel(i.node),
    ...i.topics.map(topicLabel),
    ...i.mentioned.map((id) => { const m = byId.get(id); return m ? [m.label.ar, m.label.en, m.label.ur].join(" ") : ""; }),
  ].filter(Boolean).join(" ");
const PEOPLE_SECTIONS = new Set(["ulama", "muhaddithun", "mufakkirun", "udaba", "kuttab"]);
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap wr" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <header class="wr-hero">
        <div class="wr-frame">
          <p class="wr-kufi" lang="ar" dir="rtl" aria-hidden="true">{AR.hero_kufi}</p>
          <div class="wr-nuqat" aria-hidden="true"><i></i><i></i><i></i></div>
          <h1>{G.title}</h1>
          <p class="wr-naskh" lang="ar" dir="rtl" aria-hidden="true">{AR.hero_naskh}</p>
          <p class="wr-lede">{G.lede}</p>
          <p class="ui wr-status">{status}</p>
        </div>
      </header>
      <h2 id="topics-title" class="wr-h2">{G.topics_title}</h2>
      <ul class="wr-topics" role="list">
        {ULAMA_TOPICS.map((t) => (
          <li>
            {lang !== "ar" && <span class="wr-topic-ar" lang="ar" dir="rtl" aria-hidden="true">{AR.topics[t]}</span>}
            <strong>{topicLabel(t)}</strong>
            <span class="muted">{G.topics_desc?.[t]}</span>
          </li>
        ))}
      </ul>
      <h2 id="method-title" class="wr-h2">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/ulama.json"><bdi dir="ltr">/api/v1/ulama.json</bdi></a></p>
    </div>

    {paged.landing && <UlamaMajlis lang={lang} />}

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title" class="wr-h2">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="ulama-filter">{G.filter_label}</label>
        <input id="ulama-filter" type="search" data-ulama-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <FullFilter lang={lang} slug="ulama" />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-ulama-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-ulama-row data-search={searchText(i)} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {i.node.class === "passage" && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                      {workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}
                    </p>
                  )}
                  {i.node.class === "person" && (
                    <>
                      {datesOf(i.node) && <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">{datesOf(i.node)}</p>}
                      {worksOf(i.node.id).length > 0 && (
                        <p class="ui muted" style="margin:.15rem 0 0;font-size:.78rem" dir="auto">{fmt(G.works_count, { n: num(worksOf(i.node.id).length, lang) })}</p>
                      )}
                    </>
                  )}
                  {i.mentioned.length > 0 && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.8rem" dir="auto">
                      {G.mentions_label} {i.mentioned.slice(0, 4).map((id) => { const m = byId.get(id); return m ? <a href={href(lang, id)}>{labelOf(m, lang)}</a> : null; }).reduce((a, b, k) => a === null ? b : <>{a}{G.list_sep}{b}</>, null as any)}{i.mentioned.length > 4 ? <bdi> · +{num(i.mentioned.length - 4, lang)}</bdi> : null}
                    </p>
                  )}
                  {i.topics.length > 0 && (
                    <p class="ui muted" style="margin:.25rem 0 0;font-size:.78rem" dir="auto">
                      {i.topics.map((t) => topicLabel(t)).join(" · ")}
                    </p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-ulama-none hidden>{G.filter_none}</p>
      {ulamaItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/ulama-filter.ts"></script>
<style is:global>
  /* The browser's own dress (this page only): the scholar's inkwell — deep lapis night with gold and
     ink-blue pillars, headings marked by a pen-nib seal. Faces already shipped: Reem Kufi and Amiri. */
  .wr .wr-hero { margin: 0 0 1.8rem; padding: 10px; border-radius: 20px; background: #101a24; background-image: radial-gradient(ellipse at 50% 0%, #1f3040 0%, #101a24 72%); }
  .wr .wr-frame { position: relative; padding: clamp(22px, 5vw, 56px) clamp(16px, 5vw, 64px); border: 1px solid #c5a059; border-radius: 14px; outline: 1px solid #3a4a5a; outline-offset: -7px; text-align: center; color: #eef0e4; }
  .wr .wr-frame::before, .wr .wr-frame::after { content: ""; position: absolute; inset-block-end: 14px; inline-size: 20px; block-size: 20px; border: 2px solid #c5a059; border-radius: 50%; }
  .wr .wr-frame::before { inset-inline-start: 14px; } .wr .wr-frame::after { inset-inline-end: 14px; }
  .wr .wr-kufi { margin: 0; font-family: "Reem Kufi", "Amiri", serif; font-weight: 500; font-size: clamp(1.7rem, 5.6vw, 3.8rem); line-height: 1.4; color: #e8c85a; letter-spacing: 0; }
  .wr .wr-nuqat { display: flex; justify-content: center; gap: 14px; margin: 14px 0 12px; }
  .wr .wr-nuqat i { inline-size: 11px; block-size: 11px; border-radius: 50%; background: #c5a059; }
  .wr .wr-nuqat i:nth-child(2) { background: #8fb3c9; }
  .wr .wr-hero h1 { margin: 0; color: #f4f1dc; font-size: clamp(1.15rem, 2.4vw, 1.7rem); line-height: 1.6; }
  .wr .wr-naskh { margin: .5rem 0 0; font-family: "Amiri", "Noto Naskh Arabic", serif; font-size: clamp(1.2rem, 2.8vw, 1.9rem); line-height: 1.9; color: #cfd8e0; }
  .wr .wr-lede { margin: 1.2rem auto 0; max-width: 64ch; font-size: 1.08rem; line-height: 1.9; color: #e2e6d6; }
  .wr .wr-status { margin: 1.2rem auto 0; max-width: 64ch; font-size: .85rem; color: #c3cbb4; border-block-start: 1px solid #3a4a5a; padding-block-start: .9rem; }
  .wr .wr-h2, .wr section > div > h2, .wr section > h2 { position: relative; padding-inline-start: 26px; }
  .wr .wr-h2::before, .wr section > div > h2::before, .wr section > h2::before { content: ""; position: absolute; inset-inline-start: 4px; inset-block-start: .45em; inline-size: 12px; block-size: 12px; border-radius: 50%; border: 2px solid var(--gold, #c5a059); }
  html:is([lang="ar"], [lang="ur"]) .wr .wr-h2, html[lang="ar"] .wr section > div > h2, html[lang="ar"] .wr section > h2 { font-family: "Reem Kufi", var(--ar-display); font-weight: 500; }
  .wr .wr-topics { list-style: none; margin: 0 0 1.6rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .wr .wr-topics li { display: grid; gap: 4px; align-content: start; padding: 16px 16px 14px; border-radius: 12px; background: var(--panel); border: 1px solid var(--line); border-block-start: 3px solid #2f5d6e; }
  .wr .wr-topics strong { font-size: 1.05rem; }
  html[lang="ar"] .wr .wr-topics strong { font-family: "Reem Kufi", var(--ar-display); font-weight: 500; font-size: 1.3rem; color: var(--gold, #c5a059); }
  .wr .wr-topics .muted { font-size: .9rem; line-height: 1.7; }
  .wr .wr-topic-ar { font-family: "Reem Kufi", "Amiri", serif; font-weight: 500; font-size: 1.35rem; color: var(--gold, #c5a059); line-height: 1.5; }
  .wr [data-ulama-row] { border: 1px solid var(--line); border-inline-start: 3px solid #2f5d6e; border-radius: 4px 12px 12px 4px; }
  html:is([lang="ar"], [lang="ur"]) .wr [data-ulama-row] > a { font-family: var(--ar-display); font-size: 1.12rem; }
  .wr [data-ulama-section] > h3 { display: flex; align-items: center; gap: 10px; font-size: 1.25rem !important; }
  .wr [data-ulama-section] > h3::after { content: ""; flex: 1; block-size: 1px; background: linear-gradient(to left, transparent, var(--gold, #c5a059)); }
  html[dir="rtl"] .wr [data-ulama-section] > h3::after { background: linear-gradient(to right, transparent, var(--gold, #c5a059)); }
  html[lang="ar"] .wr [data-ulama-section] > h3 { font-family: "Reem Kufi", var(--ar-display); font-weight: 500; }
  .wr .chip { border: 1px solid color-mix(in srgb, var(--gold, #c5a059) 55%, transparent); }
</style>
</BaseLayout>
