---
// The Qur'an door: /{lang}/quran/ used to answer "page not found". It names the museum's Qur'an entry (the Mushaf,
// for continuous reading) and the instruments beside it, so a visitor who types the obvious address arrives somewhere.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const Q = (T as any).qurandoor;
const doors = [
  { href: `/${lang}/words/quran/`, title: T.reader.title, desc: Q.mushaf_desc },
  { href: `/${lang}/surah/`, title: T.surahmap.title, desc: Q.maps_desc },
  { href: `/${lang}/tafsir/`, title: (T as any).tafsir.title, desc: Q.tafsir_desc },
  { href: `/${lang}/words/revelation/`, title: T.revelation.title, desc: Q.revelation_desc },
];
---
<BaseLayout lang={lang} title={Q.title} description={Q.lede} path={`/${lang}/quran/`}>
  <PageHeader
    title={Q.title}
    lede={Q.lede}
    crumbs={[
      { label: T.entity.breadcrumb, href: `/${lang}/` },
      { label: T.wings.words.title, href: `/${lang}/words/` },
      { label: Q.title },
    ]}
    crumbsLabel={T.entity.breadcrumb}
    wing="words"
  />
  <div class="wrap" style="padding-block:20px">
    <ul class="grid-cards" style="list-style:none;margin:0;padding:0">
      {doors.map((d) => (
        <li>
          <a class="card" href={d.href}>
            <h2 class="card-title">{d.title}</h2>
            <span class="ui">{d.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
