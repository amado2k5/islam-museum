---
// Explainer deck page: routes to the right widget by deck.widget.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Stepper from "../../../../components/Stepper.astro";
import DecisionTree from "../../../../components/DecisionTree.astro";
import Timeline from "../../../../components/Timeline.astro";
import CompareCards from "../../../../components/CompareCards.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { listExplainers, loadExplainer } from "../../../../lib/explainers";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    listExplainers().map(({ slug }) => ({ params: { lang, slug }, props: { lang, slug } })));
}
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const T = ui(lang);
const C = T.cards;
const deck = loadExplainer(slug);
const L = (x: { ar: string; en: string }) => (lang === "ar" ? x.ar : x.en);
const t = { prev: C.prev, next: C.next, all_items: C.all_items, restart: C.restart, js_needed: C.js_needed };
---
<BaseLayout lang={lang} title={L(deck.title)} description={L(deck.lede)} path={`/${lang}/cards/explain/${slug}/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label="breadcrumb">
      <a href={`/${lang}/cards/`}>{C.title}</a> › <a href={`/${lang}/cards/explainers/`}>{C.explainers}</a> › {L(deck.title)}
    </nav>
    <h1>{L(deck.title)}</h1>
    <p style="font-size:1.15rem;max-width:var(--measure)">{L(deck.lede)}</p>
    {deck.widget === "stepper" && <Stepper deck={deck} lang={lang} t={t} />}
    {deck.widget === "decision-tree" && <DecisionTree deck={deck} lang={lang} t={t} />}
    {deck.widget === "timeline" && <Timeline deck={deck} lang={lang} t={t} />}
    {deck.widget === "compare" && <CompareCards deck={deck} lang={lang} />}
  </div>
</BaseLayout>
