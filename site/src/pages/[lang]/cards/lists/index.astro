---
// Lists index: all flip-card decks.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { listDecks } from "../../../../lib/cardlists";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const C = T.cards;
const L = (x: { ar: string; en: string }) => (lang === "ar" ? x.ar : x.en);
const decks = listDecks();
---
<BaseLayout lang={lang} title={C.lists} description={C.lists_lede} path={`/${lang}/cards/lists/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label="breadcrumb">
      <a href={`/${lang}/cards/`}>{C.title}</a> › {C.lists}
    </nav>
    <h1>{C.lists}</h1>
    <p style="font-size:1.2rem;max-width:var(--measure)">{C.lists_lede}</p>
    <ul class="grid-cards">
      {decks.map((d) => (
        <li>
          <a class="card" href={`/${lang}/cards/list/${d.slug}/`}>
            <h2 class="card-title">{L(d.title)}</h2>
            <span class="ui">{d.count} {C.items}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
