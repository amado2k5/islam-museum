---
import EntityLayout from "../../../layouts/EntityLayout.astro";
import { nodes, SEGMENT } from "../../../lib/graph";
import { LANGS, LEARN_LANGS, type Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    nodes.map((n) => ({ params: { lang, class: SEGMENT[n.class] ?? n.class, slug: n.slug }, props: { node: n, lang } })),
  ).concat(
    // course entities publish in English too (Education Browser ships bilingual early)
    nodes.filter((n) => n.class === "course").map((n) => ({ params: { lang: "en", class: "course", slug: n.slug }, props: { node: n, lang: "en" as Lang } })),
  );
}
const { node, lang } = Astro.props as { node: (typeof nodes)[number]; lang: Lang };
---
<EntityLayout node={node} lang={lang} />
