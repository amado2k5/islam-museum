---
import EntityLayout from "../../../layouts/EntityLayout.astro";
import { nodes, SEGMENT } from "../../../lib/graph";
import { LANGS, type Lang } from "../../../lib/i18n";
import { sample } from "../../../lib/sample";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    // A pull request's sample build keeps some of the records (site/src/lib/sample.ts); a full build keeps them all.
    sample(nodes, 100, (n) => `/${lang}/${SEGMENT[n.class] ?? n.class}/${n.slug}/`).map((n) => ({ params: { lang, class: SEGMENT[n.class] ?? n.class, slug: n.slug }, props: { node: n, lang } })),
  );
}
const { node, lang } = Astro.props as { node: (typeof nodes)[number]; lang: Lang };
---
<EntityLayout node={node} lang={lang} />
