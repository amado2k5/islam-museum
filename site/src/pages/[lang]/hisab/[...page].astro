---
// The Hasanat and Sayyi'at Ledger's home (docs/plan/50-hisab-browser.md): «قائمة وآلة حاسبة
// وعدّاد للحسنات والسيئات». The landing opens on one screen that needs no explanation: every
// act a text names a figure for is a large card with one "Add" button, what was added is listed
// like a basket, and the four sums follow at once in a bar at the foot of the screen. Everything
// else the page held before (the counter, the full table with its sources, the ladder, the list
// of every counting text, the caveat and the method) stays on the page, one press away under
// "More on this page". The cards read the `reckoning` block of the curated records, the list is
// every passage that counts, writes, erases, weighs or reckons a deed — found at build time by
// scripts/hisab.ts, so a book harvested later brings its counting texts here the day its passage
// records land. The cards, the table and the list are complete without JavaScript; the script
// only adds the adding-up, the tally and the filter.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, curatedFirst, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import HisabLadder from "../../../components/sig/HisabLadder.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { hisabItems, hisabRows, HISAB_SECTIONS, HISAB_KINDS, type HisabKind, type HisabSection, type Reckoning } from "../../../lib/hisab";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() {
  // the landing, and a sub-page for every page of rows of each section longer than the landing shows (site/src/lib/paged.ts)
  const ids = [...HISAB_SECTIONS];
  return pagedStaticPaths(LANGS, ids.map((id) => ({ id: String(id), count: hisabItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).hisab;
const label = (n: Node) => labelOf(n, lang);
const loc = (v: Record<string, string> | undefined) => v?.[lang] ?? v?.ar ?? v?.en ?? "";
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\[\[[^\]]+\]\]/g, "");
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : "";
};
const basisLabel = (n: Node) => (refOf(n) ? `${workLabel(n)} ${refOf(n)}` : label(n));
const sectionIds: HisabSection[] = curatedFirst([...HISAB_SECTIONS]);
const sections = sectionIds.map((id) => ({ id, items: hisabItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/hisab/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const kindCount = (k: HisabKind) => hisabItems.filter((i) => i.kinds.includes(k)).length;
const status = fmt(G.status, { n: num(renderedHeadline("hisab", sections, [], hisabItems), lang), r: num(hisabRows.length, lang), s: num(sections.length, lang) });
/** The stated figures of a row, as one readable line. */
const figures = (r: Reckoning) => {
  const parts: string[] = [];
  if (r.hasanat !== undefined) parts.push(r.hasanat_max ? fmt(G.fig.hasanat_range, { a: num(r.hasanat, lang), b: num(r.hasanat_max, lang) }) : fmt(G.fig.hasanat, { n: num(r.hasanat, lang) }));
  if (r.sayyiat !== undefined) parts.push(fmt(G.fig.sayyiat, { n: num(r.sayyiat, lang) }));
  if (r.erased !== undefined) parts.push(fmt(G.fig.erased, { n: num(r.erased, lang) }));
  if (r.degrees !== undefined) parts.push(fmt(G.fig.degrees, { n: num(r.degrees, lang) }));
  return parts.join(" · ");
};
const searchText = (i: (typeof hisabItems)[number]) =>
  [i.node.label.ar, i.node.label.en, i.node.label.ur, summaryText(i.node), excerptOf(i.node), workLabel(i.node), ...i.kinds.map((k) => G.kinds[k])].filter(Boolean).join(" ");
const tallyRows = hisabRows.filter((r) => r.reckoning.times);
const C = G.cart;
/** A card's short name: the act itself, without the figure the label repeats after a colon. */
const shortName = (n: Node) => { const l = label(n); const cut = l.split(/\s*[:：]\s+/)[0]; return cut.length >= 6 ? cut : l; };
const worded = (r: Reckoning) => r.unbounded || (!r.hasanat && !r.sayyiat && !r.erased && !r.degrees);
const tabs: HisabKind[] = HISAB_KINDS.filter((k) => hisabRows.some((r) => r.reckoning.effect === k));
const cell = "padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top;text-align:start";
const btn = "font:inherit;min-height:44px;padding:8px 16px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg);cursor:pointer";
const sum = "cursor:pointer;min-height:56px;padding:14px 18px;font-weight:700;font-size:1.1rem";
const more = "margin-top:12px;border:1px solid var(--line);border-radius:14px;background:var(--card)";
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap hc-page" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .4rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <h1 style="margin:0 0 .3rem">{G.title}</h1>
      {paged.landing && <p class="hc-how">{C.how}</p>}
      {paged.landing && <p class="muted" style="margin:0 0 1rem;max-width:var(--measure)">{C.note} <a href="#about">{G.caveat_title}</a></p>}
      {!paged.landing && <p class="ui" style="margin:.4rem 0 1rem"><a class="hc-back" href={`${paged.home}#calculator`}>{C.back}</a></p>}
    </div>

    {paged.landing && (
    <section id="calculator" class="hc" aria-labelledby="calc-title" data-hc data-pagefind-ignore
      data-t-hasanat={G.fig.hasanat} data-t-range={G.fig.hasanat_range} data-t-sayyiat={G.fig.sayyiat} data-t-erased={G.fig.erased} data-t-degrees={G.fig.degrees} data-t-remove={C.remove}>
      <h2 id="calc-title" class="sr-only">{G.calc_title}</h2>
      <p class="hc-tabs ui" role="group" aria-label={C.tabs_label} data-hc-tabs hidden>
        <button type="button" class="hc-tab" data-hc-tab="" aria-pressed="true">{G.kinds_all}</button>
        {tabs.map((k) => <button type="button" class="hc-tab" data-hc-tab={k} data-k={k} aria-pressed="false">{C.tab[k]}</button>)}
      </p>
      <noscript><p class="panel ui">{C.nojs}</p></noscript>
      <div class="hc-body">
        <ul role="list" class="hc-deeds">
          {hisabRows.map((r, i) => (
            <li class="hc-card" data-hc-deed data-id={r.node.id} data-k={r.reckoning.effect}
              data-h={r.reckoning.hasanat ?? 0} data-hmax={r.reckoning.hasanat_max ?? r.reckoning.hasanat ?? 0}
              data-s={r.reckoning.sayyiat ?? 0} data-e={r.reckoning.erased ?? 0} data-d={r.reckoning.degrees ?? 0}
              data-worded={worded(r.reckoning) ? "1" : "0"} data-name={shortName(r.node)} data-result={loc(r.reckoning.result)}>
              <div class="hc-what">
                <a class="hc-name" href={href(lang, r.node.id)}>{shortName(r.node)}</a>
                <span class="hc-fig" dir="auto">{figures(r.reckoning) || loc(r.reckoning.result)}</span>
                <span class="hc-unit muted">{loc(r.reckoning.unit)}</span>
                <span class="hc-src ui muted">{G.viz.basis} {r.basis.map((b, j) => <>{j > 0 ? " · " : ""}<a href={href(lang, b.id)}><bdi>{basisLabel(b)}</bdi></a></>)}</span>
              </div>
              <div class="hc-ctl" data-hc-ctl hidden>
                <button type="button" class="hc-minus" data-hc-minus aria-label={`${C.less}: ${shortName(r.node)}`} disabled>−</button>
                <label class="sr-only" for={`hc-n-${i}`}>{G.cols.count}: {shortName(r.node)}</label>
                <input id={`hc-n-${i}`} class="hc-qty" type="number" min="0" max="1000000" step="1" inputmode="numeric" value="0" data-hc-qty />
                <button type="button" class="hc-plus" data-hc-plus aria-label={`${C.add}: ${shortName(r.node)}`}><span aria-hidden="true">＋</span> {C.add}</button>
              </div>
            </li>
          ))}
        </ul>
        <aside id="my-count" class="hc-mine" aria-labelledby="mine-title" data-hc-mine hidden>
          <h3 id="mine-title" tabindex="-1" style="margin:0 0 .5rem;font-size:1.2rem">{C.mine}</h3>
          <p class="muted" data-hc-empty style="margin:0">{C.empty}</p>
          <ul role="list" class="hc-lines" data-hc-lines></ul>
          <p style="margin:.8rem 0 0"><button type="button" class="hc-clear" data-hc-clear hidden>{C.clear}</button></p>
          <p class="muted" style="margin:.8rem 0 0;font-size:.9rem">{G.total_note}</p>
          <p class="muted" style="margin:.4rem 0 0;font-size:.9rem">{C.saved}</p>
        </aside>
      </div>
      <div class="hc-bar" data-hc-bar hidden>
        <dl class="hc-sums" aria-live="polite">
          <div class="hc-sum" data-k="hasanat"><dt>{G.totals.hasanat}</dt><dd data-hc-out="hasanat">0</dd></div>
          <div class="hc-sum" data-k="sayyiat"><dt>{G.totals.sayyiat}</dt><dd data-hc-out="sayyiat">0</dd></div>
          <div class="hc-sum" data-k="erasure" data-hc-opt="erased" hidden><dt>{G.totals.erased}</dt><dd data-hc-out="erased">0</dd></div>
          <div class="hc-sum" data-k="scale" data-hc-opt="degrees" hidden><dt>{G.totals.degrees}</dt><dd data-hc-out="degrees">0</dd></div>
        </dl>
        <a class="hc-view ui" href="#my-count">{C.mine} · <span data-hc-n>0</span></a>
      </div>
    </section>
    )}

    {paged.landing && <p class="ui muted" style="margin:2.2rem 0 .2rem;font-weight:700">{C.more}</p>}

    {paged.landing && (
    <details id="counter" style={more} data-hisab-counter data-pagefind-ignore data-reached={G.counter_reached} data-free={G.counter_free}>
      <summary style={sum}><h2 id="counter-title" class="hc-h">{G.counter_title}</h2></summary>
      <div style="padding:0 18px 18px">
      <p style="max-width:var(--measure);margin-top:0">{G.counter_intro}</p>
      <noscript><p class="panel ui">{G.counter_nojs}</p></noscript>
      <div class="panel" style="max-width:560px" data-hisab-counter-ui hidden>
        <p class="ui" style="display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;margin:0 0 .8rem">
          <label for="hisab-what">{G.counter_what}</label>
          <select id="hisab-what" data-hisab-what style="font:inherit;min-height:44px;padding:6px 10px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg);max-width:100%">
            <option value="free" data-target="0">{G.counter_free}</option>
            {tallyRows.map((r) => <option value={r.node.id} data-target={r.reckoning.times} data-result={loc(r.reckoning.result)} data-href={href(lang, r.node.id)}>{label(r.node)}</option>)}
          </select>
        </p>
        <p aria-live="polite" style="margin:0;font-size:3.2rem;font-weight:700;line-height:1.1"><span data-hisab-tally>0</span><span class="muted" style="font-size:1.2rem" data-hisab-target></span></p>
        <p style="display:flex;flex-wrap:wrap;gap:8px;margin:.8rem 0 0">
          <button type="button" data-hisab-add style={`${btn};min-width:9em;min-height:64px;font-size:1.2rem;font-weight:700;border-color:var(--gold)`}>{G.counter_add}</button>
          <button type="button" data-hisab-undo style={btn}>{G.counter_undo}</button>
          <button type="button" data-hisab-zero style={btn}>{G.counter_reset}</button>
        </p>
        <p class="panel ui" style="margin:.8rem 0 0;border:1px solid var(--gold)" data-hisab-reached hidden></p>
        <p class="muted" style="margin:.8rem 0 0;font-size:.92rem">{G.counter_saved}</p>
      </div>
      </div>
    </details>
    )}

    {paged.landing && (
    <details id="table" style={more} data-pagefind-ignore>
      <summary style={sum}><h2 class="hc-h">{C.more_table}</h2></summary>
      <div style="padding:0 18px 18px">
      <p style="max-width:var(--measure);margin-top:0">{C.table_intro}</p>
      <div style="overflow-x:auto;position:relative">
        <table style="border-collapse:collapse;width:100%;min-width:620px">
          <caption class="sr-only">{G.calc_title}</caption>
          <thead>
            <tr class="ui">
              <th scope="col" style={cell}>{G.cols.deed}</th>
              <th scope="col" style={cell}>{G.cols.unit}</th>
              <th scope="col" style={cell}>{G.cols.states}</th>
              <th scope="col" style={cell}>{G.cols.texts}</th>
            </tr>
          </thead>
          <tbody>
            {hisabRows.map((r) => (
              <tr>
                <th scope="row" style={`${cell};font-weight:600`}>
                  <a href={href(lang, r.node.id)}>{label(r.node)}</a>
                  <span class="chip" style="font-size:.75rem;padding:1px 8px;margin-inline-start:6px">{G.kinds[r.reckoning.effect]}</span>
                </th>
                <td style={cell} class="muted">{loc(r.reckoning.unit)}</td>
                <td style={cell}>
                  {figures(r.reckoning) && <strong style="display:block">{figures(r.reckoning)}</strong>}
                  <span dir="auto">{loc(r.reckoning.result)}</span>
                </td>
                <td style={cell} class="ui">
                  <ul style="list-style:none;padding:0;margin:0">
                    {r.basis.map((b) => <li><a href={href(lang, b.id)}><bdi>{basisLabel(b)}</bdi></a></li>)}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      </div>
    </details>
    )}

    {paged.landing && (
    <details id="ladder" style={more}>
      <summary style={sum}><h2 class="hc-h">{G.viz.title}</h2></summary>
      <div style="padding:0 18px 18px"><HisabLadder lang={lang} /></div>
    </details>
    )}

    <details id="list" style={more} open={!paged.landing || undefined}>
      <summary style={sum}><h2 id="list-title" class="hc-h">{G.list_title} · {num(hisabItems.length, lang)}</h2></summary>
      <div style="padding:0 18px 18px">
      <p style="max-width:var(--measure);margin-top:0">{G.list_intro}</p>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 .6rem">
        <label for="hisab-filter">{G.filter_label}</label>
        <input id="hisab-filter" type="search" data-hisab-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <FullFilter lang={lang} slug="hisab" />
      <p class="ui" role="group" aria-label={G.kinds_label} style="display:flex;flex-wrap:wrap;gap:6px;margin:0 0 1rem" data-hisab-kinds hidden>
        <button type="button" class="chip" data-hisab-kind="" aria-pressed="true" style="cursor:pointer;min-height:44px">{G.kinds_all} · {num(hisabItems.length, lang)}</button>
        {HISAB_KINDS.map((k) => <button type="button" class="chip" data-hisab-kind={k} aria-pressed="false" style="cursor:pointer;min-height:44px">{G.kinds[k]} · {num(kindCount(k), lang)}</button>)}
      </p>
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-hisab-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-hisab-item data-kinds={i.kinds.join(" ")} data-search={searchText(i)} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                    {i.node.class === "passage" && <>{workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null} </>}
                    {i.kinds.map((k) => <span class="chip" style="font-size:.75rem;padding:1px 8px;margin-inline-end:4px">{G.kinds[k]}</span>)}
                  </p>
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-hisab-none hidden>{G.filter_none}</p>
      {hisabItems.length === 0 && <p class="panel ui">{G.empty}</p>}
      </div>
    </details>

    {paged.landing && (
    <details id="about" style={more} data-pagefind-body>
      <summary style={sum}><h2 class="hc-h">{C.more_about}</h2></summary>
      <div style="padding:0 18px 18px">
      <p style="font-size:1.1rem;max-width:var(--measure);margin-top:0">{G.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h3 id="caveat-title" style="font-size:1.1rem">{G.caveat_title}</h3>
      <p style="max-width:var(--measure)">{G.caveat}</p>
      <h3 id="method-title" style="font-size:1.1rem">{G.method_title}</h3>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/hisab.json"><bdi dir="ltr">/api/v1/hisab.json</bdi></a></p>
      <p class="ui"><a class="chip" href={href(lang, "concept/hisab-al-hasanat-wal-sayyiat")}>{G.read_more}</a></p>
      </div>
    </details>
    )}
  </div>
  <style is:inline>
    /* The count (docs/plan/50-hisab-browser.md section 5): large targets, one colour per ledger kind, nothing else. The four
       colours carry white text at 4.5:1 or better and are the same in the light and the dark theme. */
    .hc-page { --hc-hasanat: #1e7e34; --hc-sayyiat: #b8321f; --hc-erasure: #1f6f7a; --hc-scale: #654a15; }
    .hc-how { font-size: 1.35rem; font-weight: 700; margin: 0 0 .3rem; max-width: var(--measure); }
    .hc-h { display: inline; font-size: inherit; margin: 0; }
    .hc-back { display: inline-flex; align-items: center; min-height: 48px; padding: 8px 18px; border-radius: 12px; background: var(--hc-hasanat); color: #fff; font-weight: 700; text-decoration: none; }
    .hc { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }
    .hc-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
    .hc-tab { font: inherit; font-weight: 700; min-height: 52px; padding: 8px 20px; border-radius: 999px; border: 2px solid var(--line); background: var(--card); color: var(--fg); cursor: pointer; }
    .hc-tab[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    .hc-tab[data-k][aria-pressed="true"] { color: #fff; }
    .hc-tab[data-k="hasanat"][aria-pressed="true"] { background: var(--hc-hasanat); border-color: var(--hc-hasanat); }
    .hc-tab[data-k="sayyiat"][aria-pressed="true"] { background: var(--hc-sayyiat); border-color: var(--hc-sayyiat); }
    .hc-tab[data-k="erasure"][aria-pressed="true"] { background: var(--hc-erasure); border-color: var(--hc-erasure); }
    .hc-tab[data-k="scale"][aria-pressed="true"] { background: var(--hc-scale); border-color: var(--hc-scale); }
    .hc-body { display: grid; gap: 20px; flex: 1; align-content: start; }
    .hc-deeds { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; }
    .hc-card { --k: var(--hc-scale); display: flex; flex-direction: column; justify-content: space-between; gap: 12px; padding: 16px; border-radius: 16px; background: var(--card); border: 2px solid var(--line); border-inline-start: 10px solid var(--k); }
    .hc-card[data-k="hasanat"], .hc-sum[data-k="hasanat"] { --k: var(--hc-hasanat); }
    .hc-card[data-k="sayyiat"], .hc-sum[data-k="sayyiat"] { --k: var(--hc-sayyiat); }
    .hc-card[data-k="erasure"], .hc-sum[data-k="erasure"] { --k: var(--hc-erasure); }
    .hc-card[data-on] { border-color: var(--k); }
    .hc-card[hidden] { display: none; }
