---
// Journey Map (E4 step 6): the teen territories coloured from the passport.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import JourneyMap from "../../../components/JourneyMap.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { loadTopics } from "../../../lib/topics";
import { loadDilemmas } from "../../../lib/dilemmas";
import { loadDetective } from "../../../lib/detective";
import "../../../styles/edu.css";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const S = ui(lang).shabab;
const path = `/${lang}/shabab/journey/`;
---
<BaseLayout lang={lang} title={S.sb_journey} description={S.sb_journey_lede} path={path}>
  <div class="wrap edu" style="padding-block:10px 24px">
    <nav class="ui muted no-print" aria-label="breadcrumb"><a href={`/${lang}/shabab/`}>{S.sb_title}</a> › {S.sb_journey}</nav>
    <JourneyMap
      lang={lang}
      topics={loadTopics()}
      dilemmas={loadDilemmas()}
      detective={loadDetective()}
      titleLabel={S.sb_journey}
      legendLabel={S.sb_journey_legend}
      topicLabel={S.sb_topics}
      dilemmaLabel={S.sb_dilemmas}
      detectiveLabel={S.sb_detective}
      doneLabel={S.sb_journey_done}
      todoLabel={S.sb_journey_todo}
      printLabel={S.sb_journey_print}
    />
  </div>
</BaseLayout>
