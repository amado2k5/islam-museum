---
// The teen wing hub (docs/delegation/education-master-plan.md §5 E4): timeline-first, mascot-free.
// Two bands — Scholars (13–15) and Researchers (16–18) — plus the E3 engines mirrored here
// (daily challenge, Where am I?) and "in the making" chips for the sections still being built.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HijriTimeline from "../../../components/HijriTimeline.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { viewBands } from "../../../lib/edu";
import "../../../styles/edu.css";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const E = T.edu;
const S = T.shabab;
const path = `/${lang}/shabab/`;
const bands = viewBands(lang, T.kids).filter((b) => b.wing === "shabab");
const meta: Record<string, { lede: string; ages: string }> = {
  scholars: { lede: S.sb_scholars_lede, ages: S.sb_scholars_ages },
  researchers: { lede: S.sb_researchers_lede, ages: S.sb_researchers_ages },
};
const live = [
  { href: `/${lang}/shabab/topics/`, title: S.sb_topics, lede: S.sb_topics_lede },
  { href: `/${lang}/shabab/dilemmas/`, title: S.sb_dilemmas, lede: S.sb_dilemmas_lede },
  { href: `/${lang}/shabab/detective/`, title: S.sb_detective, lede: S.sb_detective_lede },
  { href: `/${lang}/shabab/daily/`, title: S.sb_daily, lede: S.sb_daily_lede },
  { href: `/${lang}/shabab/where/`, title: S.sb_where, lede: S.sb_where_lede },
  { href: `/${lang}/shabab/journey/`, title: S.sb_journey, lede: S.sb_journey_lede },
];
const coming: { title: string; lede: string }[] = [];
const crumbLabel = lang === "ar" ? "مسار التنقل" : "breadcrumb";
---
<BaseLayout lang={lang} title={S.sb_title} description={S.sb_lede} path={path}>
  <div class="wrap edu" style="padding-block:10px 24px" data-pagefind-ignore>
    <nav class="ui muted no-print" aria-label={crumbLabel}><a href={`/${lang}/learn/`}>{E.title}</a> › {S.sb_title}</nav>
    <section class="edu-hero">
      <p class="ui" style="color:var(--gold);margin:0 0 .2rem">{S.sb_bands}</p>
      <h1>{S.sb_title}</h1>
      <p>{S.sb_lede}</p>
    </section>

    <ul class="edu-doors" aria-label={S.sb_bands}>
      {bands.map((b) => (
        <li>
          <a class={`edu-door pal-${b.palette}`} href={b.hub}>
            <span class="g" aria-hidden="true">{b.glyph}</span>
            <h2>{b.name}</h2>
            <span class="ages">{meta[b.id]?.ages}</span>
            <p>{meta[b.id]?.lede}</p>
            <span class="go">{S.sb_enter}</span>
          </a>
        </li>
      ))}
    </ul>

    <HijriTimeline lang={lang} />

    <section aria-labelledby="sb-live">
      <h2 id="sb-live" class="ui" style="font-size:1.15rem">{S.sb_activities}</h2>
      <ul class="edu-adult">
        {live.map((a) => <li><a href={a.href}><span><h2>{a.title}</h2><p>{a.lede}</p></span></a></li>)}
      </ul>
    </section>

    <section aria-labelledby="sb-coming">
      <ul class="edu-adult">
        {coming.map((a) => <li><span><h2>{a.title} <span class="chip soon">{S.sb_soon}</span></h2><p>{a.lede}</p></span></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
