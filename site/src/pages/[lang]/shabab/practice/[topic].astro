---
// Self-marking practice set for one taught topic (E4 step 3): ten questions, four options each,
// an explanation under every option. Native radios keep it keyboard-first; scripts/practice.ts
// only adds the marking on the device — nothing leaves it.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PracticeSet from "../../../../components/PracticeSet.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { loadTopics } from "../../../../lib/topics";
import "../../../../styles/edu.css";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    loadTopics().map((t) => ({ params: { lang, topic: t.id }, props: { lang, topic: t } })),
  );
}
const { lang, topic } = Astro.props;
const T = ui(lang);
const S = T.shabab;
const title = `${topic.title[lang]} — ${S.sb_practice_title}`;
const path = `/${lang}/shabab/practice/${topic.id}/`;
---
<BaseLayout lang={lang} title={title} description={topic.title[lang]} path={path}>
  <div class="wrap edu" style="padding-block:10px 24px">
    <nav class="ui muted no-print" aria-label="breadcrumb">
      <a href={`/${lang}/shabab/`}>{S.sb_title}</a> › <a href={`/${lang}/shabab/topics/`}>{S.sb_topics}</a> › {topic.title[lang]}
    </nav>
    <h1>{S.sb_practice_title} — {topic.title[lang]}</h1>
    <p style="max-width:var(--measure)">{S.sb_practice_lede}</p>
    <PracticeSet
      lang={lang}
      topic={topic}
      markLabel={S.sb_practice_mark}
      againLabel={S.sb_practice_again}
      unansweredLabel={S.sb_practice_unanswered}
      correctLabel={S.sb_practice_correct}
      wrongLabel={S.sb_practice_wrong}
      resultLabel={S.sb_practice_result}
    />
    <p class="ui" style="display:flex;gap:1rem;flex-wrap:wrap">
      <a href={`/${lang}/shabab/60s/${topic.id}/`}>{S.sb_sixty_title}</a> ·
      <a href={`/${lang}/shabab/glossary/${topic.id}/`}>{S.sb_glossary_title}</a>
    </p>
  </div>
  <script src="../../../../scripts/practice.ts"></script>
</BaseLayout>
