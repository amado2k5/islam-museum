---
// The Hadith Qudsi Browser's home (docs/plan/29-hadith-qudsi-browser.md): every hadith qudsi of the six books and the
// Muwatta, one row per hadith with its narrations, in theme sections. Counts are read from the graph at build time and
// appear on this page only; no shared layout carries a number (docs/site/README.md, site-wide numbers).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { href, labelOf } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { qudsiHadiths, qudsiNodes, qudsiTitle, narrationName, QUDSI_THEMES } from "../../../lib/qudsi";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const Q = (T as any).qudsi;
const label = (n: any) => labelOf(n, lang);
const themeName = (id: string) => Q.themes[id] ?? id;
const themeIds = [...QUDSI_THEMES, ...new Set(qudsiHadiths.map((h) => h.theme).filter((t) => !QUDSI_THEMES.includes(t)))];
const sections = themeIds.map((id) => ({ id, hadiths: qudsiHadiths.filter((h) => h.theme === id) })).filter((s) => s.hadiths.length > 0);
const works = new Set(qudsiNodes.map((n) => n.data.work)).size;
const status = fmt(Q.status, { hadiths: num(qudsiHadiths.length, lang), narrations: num(qudsiNodes.length, lang), works: num(works, lang) });
const searchText = (h: (typeof qudsiHadiths)[number]) =>
  [h.lead.label.ar, h.lead.label.en, h.lead.label.ur, ...h.narrations.map((n) => narrationName(label(n)))].filter(Boolean).join(" ");
---
<BaseLayout lang={lang} title={Q.title} description={Q.lede} path={`/${lang}/qudsi/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{Q.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {Q.title}</nav>
    <div data-pagefind-body>
      <h1>{Q.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{Q.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{Q.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{Q.method_note}</p>
      <p class="ui muted">{Q.api} <a href="/api/v1/qudsi.json"><bdi dir="ltr">/api/v1/qudsi.json</bdi></a></p>
    </div>

    <section aria-labelledby="themes-title" style="margin-top:2rem">
      <h2 id="themes-title">{Q.themes_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{Q.themes_note}</p>
      <nav aria-label={Q.themes_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`#t-${s.id}`}>{themeName(s.id)} · {num(s.hadiths.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="qudsi-filter">{Q.filter_label}</label>
        <input id="qudsi-filter" type="search" data-qudsi-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <div data-pagefind-ignore>
        {sections.map((s) => (
          <section data-qudsi-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .4rem">{themeName(s.id)}</h3>
            <ol role="list" style="list-style:none;padding:0;margin:0">
              {s.hadiths.map((h) => (
                <li data-qudsi-row data-search={searchText(h)} style="padding:10px 0;border-bottom:1px solid var(--line)">
                  <a href={href(lang, h.lead.id)} style="font-weight:600">{qudsiTitle(h, label(h.lead))}</a>
                  <span class="ui muted"> · {fmt(Q.count, { n: num(h.narrations.length, lang) })}</span>
                  <ul class="ui" style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:6px 0 0;list-style:none">
                    {h.narrations.map((n) => <li><a class="chip" href={href(lang, n.id)}>{narrationName(label(n))}</a></li>)}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
      <p class="panel ui" data-qudsi-none hidden>{Q.filter_none}</p>
      {qudsiHadiths.length === 0 && <p class="panel ui">{Q.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/qudsi-filter.ts"></script>
</BaseLayout>
