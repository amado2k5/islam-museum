---
// A subject of the Messengers Browser: one section of the passages that name the prophet, in full and paginated. The
// subject's own page shows the first of them (site/src/lib/axis.ts, SUBJECT_ROWS; audit S18).
import AxisPage from "../../../../../components/AxisPage.astro";
import { ui, LANGS, type Lang } from "../../../../../lib/i18n";
import { labelOf } from "../../../../../lib/graph";
import { messengerSubjects } from "../../../../../lib/messengers";
import { SUBJECT_ROWS, subjectHeading } from "../../../../../lib/axis";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => messengerSubjects.flatMap((s) => (["quran", "sunnah", "seerah", "books"] as const).flatMap((c) => {
    const h = subjectHeading(c, s.passages.filter((p) => p.section === c).map((p) => p.node));
    if (h.items.length <= SUBJECT_ROWS) return [];
    return Array.from({ length: h.pages }, (_x, k) => ({ params: { lang, slug: s.node.id.split("/")[1], path: k === 0 ? c : `${c}/${k + 1}` }, props: { lang, subject: s.node, heading: h, pageNo: k + 1 } }));
  })));
}
const { lang, subject, heading, pageNo } = Astro.props as { lang: Lang; subject: any; heading: ReturnType<typeof subjectHeading>; pageNo: number };
const T = ui(lang) as any;
const G = T.messengers;
---
<AxisPage lang={lang} base={`messengers/${subject.id.split("/")[1]}`} anchor="passages" browserTitle={labelOf(subject, lang)} A={T.paged.subject}
  name={`${labelOf(subject, lang)} · ${G.sections[heading.id]?.title ?? G[`${heading.id}_title`] ?? heading.id}`} heading={heading} pageNo={pageNo} />
