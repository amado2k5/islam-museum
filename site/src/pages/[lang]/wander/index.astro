---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
// The pool of pages to wander through is a file of its own (./pool.json.ts), fetched on the first click. It used to be
// written into this page twice, as a script variable and as a no-script list of every record: 8 MB of HTML (audit S18).
import { wanderPool } from "../../../lib/wander";
const pool = wanderPool(lang);
const poolUrl = `/${lang}/wander/pool.json`;
const count = pool.length;
---
<BaseLayout lang={lang} title={T.wander.title} description={T.wander.lede} path={`/${lang}/wander/`}>
  <div class="wrap" style="padding-block:10px 20px" data-pagefind-ignore>
    <h1>{T.wander.title}</h1>
    <p style="font-size:1.2rem;max-width:var(--measure)">{T.wander.lede}</p>
    <p><a id="go" class="chip" style="border:1px solid var(--gold);font-size:1rem;padding:8px 18px" href={pool[0] ? `/${lang}/${pool[0]}` : undefined}>{T.wander.button}</a></p>
    <script is:inline define:vars={{ poolUrl, count, base: `/${lang}/` }}>
      var a = document.getElementById("go");
      var pool = null, loading = null;
      // the paths arrive on the first click; until then the link leads to one entry, so it is never dead
      function ready() { if (!loading) loading = fetch(poolUrl).then(function (r) { return r.json(); }).then(function (j) { pool = j.paths.map(function (p) { return { h: base + p }; }); }); return loading; }
      // Shuffled deck: every item is shown once before any repeats. The deck and position live in
      // sessionStorage so the position survives navigation (each click leaves this page).
      var KEY = "wander-deck-v1-" + count;
      function shuffle(n) {
        var d = []; for (var i = 0; i < n; i++) d.push(i);
        for (var k = n - 1; k > 0; k--) { var j = Math.floor(Math.random() * (k + 1)); var t = d[k]; d[k] = d[j]; d[j] = t; }
        return d;
      }
      function load() {
        try { var s = JSON.parse(sessionStorage.getItem(KEY)); if (s && s.deck && s.deck.length === pool.length && s.pos < pool.length) return s; } catch (e) {}
        return null;
      }
      function save(s) { try { sessionStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {} }
      function nextItem() {
        var s = load();
        if (!s) s = { deck: shuffle(pool.length), pos: 0 };
        var item = pool[s.deck[s.pos]];
        s.pos++;
        save(s);
        return item;
      }
      a.addEventListener("click", function (e) {
        if (!count) return;
        e.preventDefault();
        a.setAttribute("aria-busy", "true");
        ready().then(function () { location.href = nextItem().h; }, function () { location.href = a.getAttribute("href"); });
      });
    </script>
    <noscript><p class="panel ui"><a href={`/${lang}/browse/`}>{T.browse.title}</a></p></noscript>
  </div>
</BaseLayout>
