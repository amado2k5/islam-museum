---
// Poetry anthology (Phase 3, roadmap: "poetry anthology"): every work of kind: poem in the graph,
// grouped under its poet where an authored edge names one. Poems without an author edge fall under
// an "unattributed in the graph" group rather than a guessed one — the catalogue only shows what
// the data attests. Cards link to the poem's page; poet names link to the person's page.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { ui, LANGS, fmt, type Lang } from "../../../../lib/i18n";
import { byId, graph, href, labelOf, realNodes, summaryOf } from "../../../../lib/graph";
import { formatDate } from "../../../../lib/dates";
import { poetryModel } from "../../../../lib/poetry";
import { num } from "../../../../lib/nav";

// The anthology (poets and poems, with the finding lists of the verses) is the landing; the verses themselves are on
// /words/poetry/verses/ and /words/poetry/verses/<n>/ (site/src/lib/poetry.ts).
export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    { params: { lang, page: undefined }, props: { lang, versesPage: 0 } },
    ...poetryModel(lang).pages.map((_x, k) => ({ params: { lang, page: k === 0 ? "verses" : `verses/${k + 1}` }, props: { lang, versesPage: k + 1 } })),
  ]);
}
const { lang, versesPage } = Astro.props as { lang: Lang; versesPage: number };
const T = ui(lang);
const P = T.poetry;

const { poetOf, groups, unattributed, verses, versesOf, versePoems, pages, pageOf } = poetryModel(lang);
const versesUrl = (n: number) => (n <= 1 ? `/${lang}/words/poetry/verses/` : `/${lang}/words/poetry/verses/${n}/`);
const verseHref = (poem: any) => `${versesUrl(pageOf.get(poem.id) ?? 1)}#v-${poem.slug}`;
const PG = (T as any).paged;
// kept in sync with schema/enums/metres.yaml
const METRES: Record<string, { ar: string; en: string }> = {
  tawil: { ar: "الطويل", en: "Tawil" },
  basit: { ar: "البسيط", en: "Basit" },
  wafir: { ar: "الوافر", en: "Wafir" },
  kamil: { ar: "الكامل", en: "Kamil" },
  hazaj: { ar: "الهزج", en: "Hazaj" },
  rajaz: { ar: "الرجز", en: "Rajaz" },
  ramal: { ar: "الرمل", en: "Ramal" },
  sari: { ar: "السريع", en: "Sari" },
  munsarih: { ar: "المنسرح", en: "Munsarih" },
  khafif: { ar: "الخفيف", en: "Khafif" },
  mudari: { ar: "المضارع", en: "Mudari" },
  muqtadab: { ar: "المقتضب", en: "Muqtadab" },
  mujtath: { ar: "المجتث", en: "Mujtath" },
  mutaqarib: { ar: "المتقارب", en: "Mutaqarib" },
  mutadarik: { ar: "المتدارك", en: "Mutadarik" },
  madid: { ar: "المديد", en: "Madid" },
  other: { ar: "أخرى أو موضع خلاف", en: "Other or disputed" },
};
const dateOf = (n: any) => formatDate(n.data.died ?? n.data.born, lang).text;

const verseText = (v: any) => v.data.translations?.[lang]?.text ?? v.data.translations?.en?.text ?? "";
const metreLabel = (id: string) => METRES[id]?.[lang === "ar" ? "ar" : "en"] ?? id;
// Plain-link filters: for each poet, metre and rhyme letter, the poems (anchors in the list below) that
// have at least one verse with that value, with the number of such verses.
type Hit = { poem: any; n: number };
const tally = (keyOf: (poem: any, v: any) => string | undefined) => {
  const m = new Map<string, Map<string, Hit>>();
  for (const p of versePoems) for (const v of versesOf.get(p.id)!) {
    const k = keyOf(p, v);
    if (!k) continue;
    const poems = m.get(k) ?? m.set(k, new Map()).get(k)!;
    (poems.get(p.id) ?? poems.set(p.id, { poem: p, n: 0 }).get(p.id)!).n++;
  }
  return m;
};
const byPoetV = tally((p) => poetOf.get(p.id)?.id);
const byMetreV = tally((_, v) => v.data.metre);
const byRhymeV = tally((_, v) => v.data.rhyme);
const filters = [
  { id: "poet", title: P.verses_by_poet, entries: [...byPoetV.entries()].map(([k, poems]) => ({ key: k, label: labelOf(byId.get(k), lang), poems: [...poems.values()] })) },
  { id: "metre", title: P.verses_by_metre, entries: [...byMetreV.entries()].map(([k, poems]) => ({ key: k, label: metreLabel(k), poems: [...poems.values()] })) },
  { id: "rhyme", title: P.verses_by_rhyme, entries: [...byRhymeV.entries()].sort((a, b) => a[0].localeCompare(b[0], "ar")).map(([k, poems]) => ({ key: k, label: k, poems: [...poems.values()] })) },
].filter((f) => f.entries.length > 0);
---
<BaseLayout lang={lang} title={versesPage > 0 ? `${P.title} · ${P.verses_title}${versesPage > 1 ? ` · ${versesPage}` : ""}` : P.title} description={P.lede} path={versesPage > 0 ? versesUrl(versesPage) : `/${lang}/words/poetry/`}>
  <div data-pagefind-body={versesPage === 0 || undefined}>
  <PageHeader
    title={P.title}
    lede={P.lede}
    crumbs={[
      { label: T.entity.breadcrumb, href: `/${lang}/` },
      { label: T.wings.words.title, href: `/${lang}/words/` },
      { label: P.title },
    ]}
    crumbsLabel={T.entity.breadcrumb}
    wing="words"
  />
  </div>
  <div class="wrap" style="padding-block:20px" data-pagefind-ignore>
    {versesPage === 0 && <p class="ui muted" style="max-width:var(--measure);margin:0 0 16px">{P.index_note}</p>}
    {(versesPage === 0 ? groups : []).map((g) => (
      <section style="margin-bottom:28px" aria-labelledby={`p-${g.poet.slug}`}>
        <h2 id={`p-${g.poet.slug}`} style="font-size:1.3rem;margin:0 0 10px">
          <a href={href(lang, g.poet.id)}>{labelOf(g.poet, lang)}</a>
          {dateOf(g.poet) && <span class="ui muted" style="font-size:.85rem;font-weight:400"> · {P.died} {dateOf(g.poet)}</span>}
        </h2>
        <ul class="grid-cards">
          {g.poems.map((p) => (
            <li>
              <a class="card" href={href(lang, p.id)}>
                <h3 class="card-title" style="font-size:1.05rem">{labelOf(p, lang)}</h3>
                <span>{summaryOf(p, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {versesPage === 0 && unattributed.length > 0 && (
      <section style="margin-bottom:28px" aria-labelledby="p-none">
        <h2 id="p-none" style="font-size:1.3rem;margin:0 0 10px">{P.unattributed}</h2>
        <ul class="grid-cards">
          {unattributed.map((p) => (
            <li>
              <a class="card" href={href(lang, p.id)}>
                <h3 class="card-title" style="font-size:1.05rem">{labelOf(p, lang)}</h3>
                <span>{summaryOf(p, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
  {versePoems.length > 0 && (
    <div class="wrap" style="padding-block:20px" id="verses">
      <h2 style="font-size:1.5rem;margin:0 0 8px">{P.verses_title}</h2>
      <p class="ui muted" style="max-width:var(--measure);margin:0 0 12px">{fmt(P.verses_note, { n: String(verses.length), p: String(versePoems.length) })}</p>
      {(versesPage === 0 ? filters : []).map((f) => (
        <details style="margin-bottom:10px">
          <summary class="ui">{f.title} <span class="muted">({f.entries.length})</span></summary>
          <ul style="list-style:none;padding:0;margin:8px 0 0;display:grid;gap:6px">
            {f.entries.map((e) => (
              <li>
                <strong lang={f.id === "rhyme" ? "ar" : undefined}>{e.label}</strong>:
                {e.poems.map((h, i) => (
                  <span>{i > 0 ? " · " : " "}<a href={verseHref(h.poem)}>{labelOf(h.poem, lang)}</a> <span class="ui muted">({h.n})</span></span>
                ))}
              </li>
            ))}
          </ul>
        </details>
      ))}
      <nav aria-label={P.verses_jump} style="margin-bottom:20px" hidden={versesPage > 0 || undefined}>
        <ul style="display:flex;flex-wrap:wrap;gap:8px 16px;list-style:none;padding:0;margin:0">
          {(versesPage === 0 ? versePoems : []).map((p) => (
            <li><a href={verseHref(p)}>{labelOf(p, lang)}</a> <span class="ui muted">({versesOf.get(p.id)!.length})</span></li>
          ))}
        </ul>
      </nav>
      {versesPage === 0 && <p class="ui"><a class="chip" style="border:1px solid var(--gold)" href={versesUrl(1)}>{fmt(PG.all, { n: num(verses.length, lang), section: P.verses_title })} <span class="flip" aria-hidden="true">→</span></a></p>}
      {(versesPage > 0 ? pages[versesPage - 1] : []).map((p) => (
        <section style="margin-bottom:28px" id={`v-${p.slug}`} aria-labelledby={`vh-${p.slug}`}>
          <h3 id={`vh-${p.slug}`} style="font-size:1.2rem;margin:0 0 4px"><a href={href(lang, p.id)}>{labelOf(p, lang)}</a></h3>
          {poetOf.get(p.id) && <p class="ui muted" style="margin:0 0 10px"><a href={href(lang, poetOf.get(p.id).id)}>{labelOf(poetOf.get(p.id), lang)}</a></p>}
          <ol style="list-style:none;padding:0;margin:0;display:grid;gap:14px">
            {versesOf.get(p.id)!.map((v) => (
              <li id={v.slug} style="border-inline-start:3px solid var(--rule,#ccc);padding-inline-start:12px">
                <p lang="ar" dir="rtl" style="font-size:1.35rem;line-height:2;margin:0">{v.data.text}</p>
                {verseText(v) && <p style="margin:2px 0 0" lang={v.data.translations?.[lang] ? lang : "en"}>{verseText(v)}</p>}
                <p class="ui muted" style="margin:2px 0 0;font-size:.85rem">
                  {P.verse_ref} {v.data.ref}
                  {v.data.metre && <span> · {P.metre}: {metreLabel(v.data.metre)}</span>}
                  {v.data.rhyme && <span> · {P.rhyme}: <span lang="ar">{v.data.rhyme}</span></span>}
                  {" · "}<a href={href(lang, v.id)}>{P.verse_page}</a>
                </p>
              </li>
            ))}
          </ol>
        </section>
      ))}
      {versesPage > 0 && (
        <nav class="ui paged-nav" aria-label={PG.nav_label} style="margin:1rem 0;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px">
          {versesPage > 1 ? <a class="chip" rel="prev" href={versesUrl(versesPage - 1)}>{PG.prev}</a> : null}
          {pages.map((_x, k) => k + 1 === versesPage
            ? <span class="chip" aria-current="page" style="border:1px solid var(--gold)">{num(k + 1, lang)}</span>
            : <a class="chip" href={versesUrl(k + 1)} aria-label={fmt(PG.page_n, { n: num(k + 1, lang) })}>{num(k + 1, lang)}</a>)}
          {versesPage < pages.length ? <a class="chip" rel="next" href={versesUrl(versesPage + 1)}>{PG.next}</a> : null}
          <a href={`/${lang}/words/poetry/#verses`}>{PG.back}</a>
        </nav>
      )}
    </div>
  )}
</BaseLayout>
