---
// Poetry anthology (Phase 3, roadmap: "poetry anthology"): every work of kind: poem in the graph,
// grouped under its poet where an authored edge names one. Poems without an author edge fall under
// an "unattributed in the graph" group rather than a guessed one — the catalogue only shows what
// the data attests. Cards link to the poem's page; poet names link to the person's page.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { ui, LANGS, fmt, type Lang } from "../../../../lib/i18n";
import { byId, graph, href, labelOf, realNodes, summaryOf } from "../../../../lib/graph";
import { formatDate } from "../../../../lib/dates";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const P = T.poetry;

const poems = realNodes.filter((n) => n.class === "work" && n.data.kind === "poem");
// poet of a poem = person end of an authored edge (person --authored--> work).
const poetOf = new Map<string, any>();
for (const e of graph.edges) {
  if (e.type !== "authored" || e.inverse || !e.to.startsWith("work/")) continue;
  const person = byId.get(e.from);
  if (person?.class === "person" && !person.stub) poetOf.set(e.to, person);
}
const byPoet = new Map<string, { poet: any; poems: any[] }>();
const unattributed: any[] = [];
for (const p of poems) {
  const poet = poetOf.get(p.id);
  if (!poet) { unattributed.push(p); continue; }
  (byPoet.get(poet.id) ?? byPoet.set(poet.id, { poet, poems: [] }).get(poet.id)!).poems.push(p);
}
// groups ordered by the poet's death date where known, else alphabetically at the end.
const deathKey = (poet: any) => poet.data.died?.edtf ?? poet.data.died?.start?.edtf ?? "9999";
const groups = [...byPoet.values()].sort((a, b) => {
  const ka = deathKey(a.poet), kb = deathKey(b.poet);
  return ka === kb ? labelOf(a.poet, lang).localeCompare(labelOf(b.poet, lang), lang) : ka < kb ? -1 : 1;
});
for (const g of groups) g.poems.sort((a, b) => labelOf(a, lang).localeCompare(labelOf(b, lang), lang));
// kept in sync with schema/enums/metres.yaml
const METRES: Record<string, { ar: string; en: string }> = {
  tawil: { ar: "الطويل", en: "Tawil" },
  basit: { ar: "البسيط", en: "Basit" },
  wafir: { ar: "الوافر", en: "Wafir" },
  kamil: { ar: "الكامل", en: "Kamil" },
  hazaj: { ar: "الهزج", en: "Hazaj" },
  rajaz: { ar: "الرجز", en: "Rajaz" },
  ramal: { ar: "الرمل", en: "Ramal" },
  sari: { ar: "السريع", en: "Sari" },
  munsarih: { ar: "المنسرح", en: "Munsarih" },
  khafif: { ar: "الخفيف", en: "Khafif" },
  mudari: { ar: "المضارع", en: "Mudari" },
  muqtadab: { ar: "المقتضب", en: "Muqtadab" },
  mujtath: { ar: "المجتث", en: "Mujtath" },
  mutaqarib: { ar: "المتقارب", en: "Mutaqarib" },
  mutadarik: { ar: "المتدارك", en: "Mutadarik" },
  madid: { ar: "المديد", en: "Madid" },
  other: { ar: "أخرى أو موضع خلاف", en: "Other or disputed" },
};
const dateOf = (n: any) => formatDate(n.data.died ?? n.data.born, lang).text;

// Verses (passages of unit poem-line): grouped by poem, poems ordered like the anthology above.
const verses = realNodes.filter((n) => n.class === "passage" && n.data.unit === "poem-line");
const versesOf = new Map<string, any[]>();
for (const v of verses) (versesOf.get(v.data.work) ?? versesOf.set(v.data.work, []).get(v.data.work)!).push(v);
const refKey = (r: string) => r.split(/[^0-9]+/).filter(Boolean).map((x) => x.padStart(5, "0")).join("-") + "~" + r;
for (const list of versesOf.values()) list.sort((a, b) => refKey(String(a.data.ref ?? "")).localeCompare(refKey(String(b.data.ref ?? ""))) || a.id.localeCompare(b.id));
const versePoems = [...groups.flatMap((g) => g.poems), ...unattributed].filter((p) => versesOf.has(p.id));
const verseText = (v: any) => v.data.translations?.[lang]?.text ?? v.data.translations?.en?.text ?? "";
const metreLabel = (id: string) => METRES[id]?.[lang === "ar" ? "ar" : "en"] ?? id;
---
<BaseLayout lang={lang} title={P.title} description={P.lede} path={`/${lang}/words/poetry/`}>
  <PageHeader
    title={P.title}
    lede={P.lede}
    crumbs={[
      { label: T.entity.breadcrumb, href: `/${lang}/` },
      { label: T.wings.words.title, href: `/${lang}/words/` },
      { label: P.title },
    ]}
    crumbsLabel={T.entity.breadcrumb}
    wing="words"
  />
  <div class="wrap" style="padding-block:20px" data-pagefind-ignore>
    <p class="ui muted" style="max-width:var(--measure);margin:0 0 16px">{P.index_note}</p>
    {groups.map((g) => (
      <section style="margin-bottom:28px" aria-labelledby={`p-${g.poet.slug}`}>
        <h2 id={`p-${g.poet.slug}`} style="font-size:1.3rem;margin:0 0 10px">
          <a href={href(lang, g.poet.id)}>{labelOf(g.poet, lang)}</a>
          {dateOf(g.poet) && <span class="ui muted" style="font-size:.85rem;font-weight:400"> · {P.died} {dateOf(g.poet)}</span>}
        </h2>
        <ul class="grid-cards">
          {g.poems.map((p) => (
            <li>
              <a class="card" href={href(lang, p.id)}>
                <h3 class="card-title" style="font-size:1.05rem">{labelOf(p, lang)}</h3>
                <span>{summaryOf(p, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {unattributed.length > 0 && (
      <section style="margin-bottom:28px" aria-labelledby="p-none">
        <h2 id="p-none" style="font-size:1.3rem;margin:0 0 10px">{P.unattributed}</h2>
        <ul class="grid-cards">
          {unattributed.map((p) => (
            <li>
              <a class="card" href={href(lang, p.id)}>
                <h3 class="card-title" style="font-size:1.05rem">{labelOf(p, lang)}</h3>
                <span>{summaryOf(p, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
  {versePoems.length > 0 && (
    <div class="wrap" style="padding-block:20px" id="verses">
      <h2 style="font-size:1.5rem;margin:0 0 8px">{P.verses_title}</h2>
      <p class="ui muted" style="max-width:var(--measure);margin:0 0 12px">{fmt(P.verses_note, { n: String(verses.length), p: String(versePoems.length) })}</p>
      <nav aria-label={P.verses_jump} style="margin-bottom:20px">
        <ul style="display:flex;flex-wrap:wrap;gap:8px 16px;list-style:none;padding:0;margin:0">
          {versePoems.map((p) => (
            <li><a href={`#v-${p.slug}`}>{labelOf(p, lang)}</a> <span class="ui muted">({versesOf.get(p.id)!.length})</span></li>
          ))}
        </ul>
      </nav>
      {versePoems.map((p) => (
        <section style="margin-bottom:28px" id={`v-${p.slug}`} aria-labelledby={`vh-${p.slug}`}>
          <h3 id={`vh-${p.slug}`} style="font-size:1.2rem;margin:0 0 4px"><a href={href(lang, p.id)}>{labelOf(p, lang)}</a></h3>
          {poetOf.get(p.id) && <p class="ui muted" style="margin:0 0 10px"><a href={href(lang, poetOf.get(p.id).id)}>{labelOf(poetOf.get(p.id), lang)}</a></p>}
          <ol style="list-style:none;padding:0;margin:0;display:grid;gap:14px">
            {versesOf.get(p.id)!.map((v) => (
              <li id={v.slug} style="border-inline-start:3px solid var(--rule,#ccc);padding-inline-start:12px">
                <p lang="ar" dir="rtl" style="font-size:1.35rem;line-height:2;margin:0">{v.data.text}</p>
                {verseText(v) && <p style="margin:2px 0 0" lang={v.data.translations?.[lang] ? lang : "en"}>{verseText(v)}</p>}
                <p class="ui muted" style="margin:2px 0 0;font-size:.85rem">
                  {P.verse_ref} {v.data.ref}
                  {v.data.metre && <span> · {P.metre}: {metreLabel(v.data.metre)}</span>}
                  {v.data.rhyme && <span> · {P.rhyme}: <span lang="ar">{v.data.rhyme}</span></span>}
                  {" · "}<a href={href(lang, v.id)}>{P.verse_page}</a>
                </p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )}
</BaseLayout>
