---
// The Juha and Islamic Folklore Browser's home (docs/plan/72-juha-browser.md): Juha, the wits
// and fools, the anecdotes (نوادر), jests and laughter the museum's sources carry — in the
// Qur'an, the Sunnah, the seerah, Juha's own anecdote collections and every harvested book —
// over the one graph. Passages are found at build time by the shared detector in
// scripts/juha.ts, so a book harvested later appears here the day its passage records land;
// curated records join through the `juha-browser` tag. The landing opens as a storyteller's
// gathering: the "majlis" of the wits (medallion cards of the named figures), the "scale of
// laughter" (what kind of humour each corpus carries, drawn as stacked bars from the same rows
// the lists show) and a strip of Juha's anecdotes as speech bubbles. Counts are read from the
// graph at build time and appear on this page only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { juhaItems, JUHA_KINDS, JUHA_SECTIONS, type JuhaKind, type JuhaSection } from "../../../lib/juha";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() {
  // the landing, and a sub-page for every page of rows of each section longer than the landing shows (site/src/lib/paged.ts)
  return pagedStaticPaths(LANGS, [...JUHA_SECTIONS].map((id) => ({ id: String(id), count: juhaItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).juha;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1"); // citation markers belong to the entity page's footnotes
const EXCERPT = 240;
const clip = (s: string) => { const c = s.replace(/\s+/g, " ").trim(); return c.length > EXCERPT ? `${c.slice(0, EXCERPT)}…` : c; };
// A Juha anecdote is shown by its retelling in the reader's language; every other passage by its source excerpt.
const excerptOf = (i: (typeof juhaItems)[number]) =>
  clip(i.node.class === "passage" && i.section !== "juha" ? stripNeedsSource(String(i.node.data.text_search ?? i.node.data.text ?? "")) : summaryText(i.node));
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => (n.data.sura && n.data.aya ? `${n.data.sura}:${n.data.aya}` : n.data.ref ? String(n.data.ref) : "");
const kindLabel = (k: JuhaKind | null) => (k ? G.kinds?.[k] : null);
/** One colour per kind, shared by the chips, the bubbles' tails and the scale of laughter. */
const KIND_COLOR: Record<JuhaKind, string> = { juha: "#b5762a", wits: "#8e5aa8", anecdote: "#2a7b88", jest: "#c5a059", laughter: "#4a8a52", ethics: "#7a3a5e" };
const sectionIds: JuhaSection[] = [...JUHA_SECTIONS];
const sections = sectionIds.map((id) => ({ id, items: juhaItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/juha/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const kindCounts = new Map<JuhaKind, number>();
for (const i of juhaItems) if (i.kind) kindCounts.set(i.kind, (kindCounts.get(i.kind) ?? 0) + 1);
const kinds = JUHA_KINDS.filter((k) => (kindCounts.get(k) ?? 0) > 0);
const status = fmt(G.status, { n: num(renderedHeadline("juha", sections, [], juhaItems), lang), s: num(sections.length, lang) });
const searchText = (i: (typeof juhaItems)[number]) =>
  [i.node.label.ar, i.node.label.en, i.node.label.ur, i.node.label.fr, i.node.label.es, summaryText(i.node), excerptOf(i), workLabel(i.node), kindLabel(i.kind) ?? ""].filter(Boolean).join(" ");

// The majlis: the curated person records, Juha first, as medallion cards.
const majlis = juhaItems.filter((i) => i.node.class === "person")
  .sort((a, b) => Number(b.kind === "juha") - Number(a.kind === "juha") || (a.node.span?.earliest ?? Infinity) - (b.node.span?.earliest ?? Infinity));
const initial = (n: Node) => [...label(n).replace(/^(ال|al-|the )/i, "")][0] ?? "؟";
// The shelf: the curated works that collect the anecdotes.
const shelf = juhaItems.filter((i) => i.node.class === "work");
// The scale of laughter: per section, how many rows of each kind.
const scale = sections.map((s) => {
  const total = s.items.length;
  const parts = JUHA_KINDS.map((k) => ({ k, n: s.items.filter((i) => i.kind === k).length })).filter((p) => p.n > 0);
  return { id: s.id, total, parts };
});
const scaleMax = Math.max(1, ...scale.map((r) => r.total));
// The storyteller's strip: Juha anecdotes that carry a retelling, a fixed spread across the collection.
const tales = (() => {
  const all = juhaItems.filter((i) => i.section === "juha" && summaryText(i.node).length > 40);
  const step = Math.max(1, Math.floor(all.length / 9));
  return all.filter((_, ix) => ix % step === 0).slice(0, 9);
})();
const taleTitle = (n: Node) => { const l = label(n); const m = l.match(/[«'‘"]\s?(.+?)\s?[»'’"]\s*$/); return m ? m[1] : l; };
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:#b5762a"></span>{G.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <div class="jh-hero">
        <div>
          <h1>{paged.landing ? G.full_title : pagedTitle}</h1>
          <p style="font-size:1.2rem;max-width:var(--measure)">{G.lede}</p>
        </div>
        <svg class="jh-rider" viewBox="0 0 220 170" role="img" aria-label={G.rider_alt}>
          <path d="M8 150 Q60 140 110 150 T212 146" stroke="var(--line)" stroke-width="3" fill="none"/>
          <ellipse cx="112" cy="98" rx="52" ry="24" fill="none" stroke="#b5762a" stroke-width="5"/>
          <path d="M158 86 Q182 66 180 42 M180 42 L170 20 M180 42 L196 26" fill="none" stroke="#b5762a" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="176" cy="52" r="2.6" fill="#b5762a"/>
          <path d="M78 116 V148 M96 120 V148 M130 120 V148 M148 114 V148" stroke="#b5762a" stroke-width="5" stroke-linecap="round"/>
          <path d="M62 92 Q44 98 42 118" fill="none" stroke="#b5762a" stroke-width="4" stroke-linecap="round"/>
          <circle cx="96" cy="38" r="13" fill="none" stroke="#2a7b88" stroke-width="5"/>
          <path d="M82 30 Q96 6 110 30 Z" fill="#e8c85a" stroke="#c5a059" stroke-width="3" stroke-linejoin="round"/>
          <path d="M96 51 V78 M96 62 L74 72 M96 62 L116 70" stroke="#2a7b88" stroke-width="5" fill="none" stroke-linecap="round"/>
          <path d="M89 40 Q94 46 101 41" stroke="#2a7b88" stroke-width="3" fill="none" stroke-linecap="round"/>
          <path d="M22 44 q8 -12 16 0 M34 26 q6 -9 12 0 M196 84 q7 -10 14 0" stroke="#c5a059" stroke-width="3" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/juha.json"><bdi dir="ltr">/api/v1/juha.json</bdi></a></p>
    </div>

    {paged.landing && majlis.length > 0 && (
      <section aria-labelledby="majlis-title" style="margin-top:1.6rem">
        <h2 id="majlis-title">{G.majlis_title}</h2>
        <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{G.majlis_note}</p>
        <ul role="list" class="jh-majlis">
          {majlis.map((i) => (
            <li>
              <a href={href(lang, i.node.id)} class="jh-seat" style={`--k:${KIND_COLOR[i.kind ?? "wits"]}`}>
                <span class="jh-medal" aria-hidden="true">{initial(i.node)}</span>
                <span class="jh-seat-name">{label(i.node)}</span>
                <span class="ui muted jh-seat-sum">{clip(summaryText(i.node)).slice(0, 130)}…</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {paged.landing && tales.length > 0 && (
      <section aria-labelledby="tales-title" style="margin-top:1.8rem">
        <h2 id="tales-title">{G.tales_title}</h2>
        <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{G.tales_note}</p>
        <ol role="list" class="jh-tales">
          {tales.map((i) => (
            <li class="jh-bubble" style={`--k:${KIND_COLOR.juha}`}>
              <a href={href(lang, i.node.id)} class="jh-bubble-title">{taleTitle(i.node)}</a>
              <p dir="auto">{clip(summaryText(i.node))}</p>
              <span class="ui muted" style="font-size:.78rem">{workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {paged.landing && (
      <section aria-labelledby="scale-title" style="margin-top:1.8rem">
        <h2 id="scale-title">{G.scale_title}</h2>
        <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{G.scale_note}</p>
        <table class="jh-scale ui">
          <caption class="sr-only">{G.scale_caption}</caption>
          <thead class="sr-only"><tr><th scope="col">{G.sections_title}</th><th scope="col">{G.kinds_title}</th><th scope="col">{G.scale_total}</th></tr></thead>
          <tbody>
            {scale.map((r) => (
              <tr>
                <th scope="row"><a href={`#t-${r.id}`}>{G.sections[r.id]?.title ?? r.id}</a></th>
                <td>
                  <span class="jh-bar" style={`width:${Math.max(6, (r.total / scaleMax) * 100)}%`}>
                    {r.parts.map((p) => <span style={`flex:${p.n};background:${KIND_COLOR[p.k]}`} title={`${kindLabel(p.k)} · ${num(p.n, lang)}`}><span class="sr-only">{kindLabel(p.k)}: {num(p.n, lang)}. </span></span>)}
                  </span>
                </td>
                <td style="white-space:nowrap">{num(r.total, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <ul role="list" class="ui jh-legend">
          {kinds.map((k) => <li><i aria-hidden="true" style={`background:${KIND_COLOR[k]}`}></i>{kindLabel(k)} · {num(kindCounts.get(k) ?? 0, lang)}</li>)}
        </ul>
      </section>
    )}

    {paged.landing && shelf.length > 0 && (
      <section aria-labelledby="shelf-title" style="margin-top:1.8rem">
        <h2 id="shelf-title">{G.shelf_title}</h2>
        <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{G.shelf_note}</p>
        <ul role="list" class="jh-shelf">
          {shelf.map((i) => <li><a href={href(lang, i.node.id)}><span>{label(i.node)}</span></a></li>)}
        </ul>
      </section>
    )}

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <div class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <span id="kind-label" style="font-weight:600">{G.kinds_title}</span>
        <div role="group" aria-labelledby="kind-label" style="display:flex;flex-wrap:wrap;gap:6px">
          <button type="button" class="chip" data-juha-kind aria-pressed="true" data-kind="">{G.all_kinds} · {num(juhaItems.length, lang)}</button>
          {kinds.map((k) => (
            <button type="button" class="chip" data-juha-kind aria-pressed="false" data-kind={k}><i aria-hidden="true" class="jh-dot" style={`background:${KIND_COLOR[k]}`}></i>{kindLabel(k)} · {num(kindCounts.get(k) ?? 0, lang)}</button>
          ))}
        </div>
        <label for="juha-filter" style="margin-inline-start:auto">{G.filter_label}</label>
        <input id="juha-filter" type="search" data-juha-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </div>
      <FullFilter lang={lang} slug="juha" />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-juha-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px">
              {s.items.map((i) => (
                <li data-juha-row data-search={searchText(i)} data-kind={i.kind ?? ""} class="jh-bubble" style={`--k:${KIND_COLOR[i.kind ?? "anecdote"]}`}>
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                    {i.node.class === "passage" ? <>{workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}</> : null}
                    {kindLabel(i.kind) ? <>{i.node.class === "passage" ? " · " : ""}<span class="chip" style="font-size:.75rem;padding:1px 8px">{kindLabel(i.kind)}</span></> : null}
                  </p>
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-juha-none hidden>{G.filter_none}</p>
      {juhaItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/juha-filter.ts"></script>
</BaseLayout>
<style is:inline>
  /* the storyteller's gathering: a rider hero, medallion seats, speech-bubble cards with a kind-coloured tail, a stacked scale */
  .jh-hero { display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 28px; }
  .jh-hero > div { flex:1 1 420px;min-width:0; }
  .jh-rider { flex:0 0 auto;width:min(220px,46vw);height:auto; }
  .jh-majlis { list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px; }
  .jh-seat { display:grid;grid-template-columns:auto 1fr;gap:4px 12px;align-items:center;height:100%;text-decoration:none;border:1px solid var(--line);border-radius:16px;padding:12px 14px;background:var(--card); }
  .jh-seat:hover, .jh-seat:focus-visible { border-color:var(--k); }
  .jh-seat:focus-visible { outline:3px solid var(--focus);outline-offset:2px; }
  .jh-medal { grid-row:span 2;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font-size:1.5rem;font-weight:700;color:var(--k);border:3px double var(--k);background:color-mix(in srgb,var(--k) 10%,transparent); }
  .jh-seat-name { font-weight:600;color:var(--fg); }
  .jh-seat-sum { font-size:.8rem;grid-column:2; }
  .jh-tales { list-style:none;padding:0 0 12px;margin:0;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,320px);gap:16px;overflow-x:auto;scroll-snap-type:x proximity; }
  .jh-tales > li { scroll-snap-align:start; }
  .jh-bubble { position:relative;border:1px solid var(--line);border-inline-start:4px solid var(--k);border-radius:16px 16px 16px 4px;padding:14px 16px;background:var(--card);margin-block-end:10px; }
  .jh-bubble::after { content:"";position:absolute;inset-block-end:-10px;inset-inline-start:18px;width:16px;height:10px;background:var(--k);clip-path:polygon(0 0,100% 0,0 100%);opacity:.75; }
  [dir="rtl"] .jh-bubble::after { clip-path:polygon(0 0,100% 0,100% 100%); }
  .jh-bubble-title { font-weight:700;font-size:1.02rem; }
  .jh-bubble p { margin:.35rem 0 .4rem; }
  .jh-scale { width:100%;max-width:820px;border-collapse:separate;border-spacing:0 8px; }
  .jh-scale th { text-align:start;font-weight:600;padding-inline-end:12px;white-space:nowrap;width:1%; }
  .jh-scale td { padding:0 6px; }
  .jh-bar { display:flex;height:18px;border-radius:99px;overflow:hidden;min-width:24px; }
  .jh-legend { list-style:none;padding:0;margin:.4rem 0 0;display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.85rem; }
  .jh-legend i, .jh-dot { display:inline-block;width:10px;height:10px;border-radius:50%;margin-inline-end:6px; }
  .jh-shelf { list-style:none;padding:0 0 6px;margin:0;display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;border-block-end:6px solid color-mix(in srgb,#b5762a 55%,var(--line)); }
  .jh-shelf a { display:block;text-decoration:none;color:var(--fg);border:1px solid var(--line);border-block-end:0;border-radius:6px 6px 0 0;padding:14px 12px 10px;background:linear-gradient(180deg,color-mix(in srgb,#b5762a 14%,var(--card)),var(--card));max-width:220px;font-weight:600;font-size:.92rem; }
  .jh-shelf a:hover, .jh-shelf a:focus-visible { border-color:#b5762a; }
  .jh-shelf a:focus-visible { outline:3px solid var(--focus);outline-offset:2px; }
</style>
