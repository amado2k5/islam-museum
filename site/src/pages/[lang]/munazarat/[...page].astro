---
// The Munazarat Browser's home (docs/plan/63-munazarat-browser.md): every debate and
// exchange of arguments the museum's sources carry — between Islam and the other
// religions and, per the founder's clarification, inside the ummah too — over the one
// graph. Passages are found at build time by the shared detector in
// scripts/munazarat.ts, so a debate in a book harvested later appears here the day its
// passage record lands; curated records join through the `munazarat-browser` tag.
// The landing opens with the named debates — curated event records drawn as
// two-bench match cards with their parties, place and date — before the corpus
// sections. Counts are read from the graph at build time and appear on this page only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, curatedFirst, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import MunazaratFloor from "../../../components/sig/MunazaratFloor.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, edgesFrom, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { formatDate, startOf } from "../../../lib/dates";
import { munazaratItems, MUNAZARAT_SECTIONS, type MunazaratKind, type MunazaratSection, type MunazaratOpponent } from "../../../lib/munazarat";
import { placeOf } from "../../../lib/battles";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() {
  // the landing, and a sub-page for every page of rows of each section longer than the landing shows (site/src/lib/paged.ts)
  const ids = [...MUNAZARAT_SECTIONS];
  return pagedStaticPaths(LANGS, ids.map((id) => ({ id: String(id), count: munazaratItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).munazarat;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1"); // citation markers belong to the entity page's footnotes
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : (n.data.unit ? String(n.data.unit) : "");
};
const kindLabel = (k: MunazaratKind | null) => (k ? G.kinds?.[k] : null);
const opponentLabel = (s: MunazaratOpponent) => (s ? G.opponents?.[s] : G.opponents?.other);
const OPPONENT_ORDER: (MunazaratOpponent)[] = ["scriptuaries", "polytheists", "intra", "other"];
const sectionIds: MunazaratSection[] = curatedFirst([...MUNAZARAT_SECTIONS]);
const sections = sectionIds.map((id) => ({ id, items: munazaratItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/munazarat/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const opponentCounts = new Map<MunazaratOpponent, number>();
for (const i of munazaratItems) opponentCounts.set(i.opponent, (opponentCounts.get(i.opponent) ?? 0) + 1);
const opponents = OPPONENT_ORDER.filter((s) => (opponentCounts.get(s) ?? 0) > 0);
const status = fmt(G.status, { n: num(renderedHeadline("munazarat", sections, [], munazaratItems), lang), s: num(sections.length, lang) });
const searchText = (i: (typeof munazaratItems)[number]) =>
  [
    i.node.label.ar, i.node.label.en, i.node.label.ur,
    summaryText(i.node), excerptOf(i.node), workLabel(i.node),
    kindLabel(i.kind) ?? "", opponentLabel(i.opponent) ?? "",
  ].filter(Boolean).join(" ");

// The named debates: curated event records (non-passage munazarat items) sorted by
// their earliest date, drawn as two-bench match cards. The benches are the record's
// had_participant parties; a debate with no resolved parties shows its label alone.
const namedDebates = munazaratItems
  .filter((i) => i.node.class === "event")
  .map((i) => {
    const parties = edgesFrom(i.node.id)
      .filter((e) => e.type === "had_participant" && !e.inverse)
      .map((e) => byId.get(e.to))
      .filter((n): n is Node => Boolean(n) && !n!.stub)
      .slice(0, 4);
    const date = i.node.data ? formatDate(startOf(i.node.data), lang).text : "";
    const place = placeOf(i.node.id);
    const opponent = i.opponent ? opponentLabel(i.opponent) : null;
    return { n: i.node, parties, date, place, opponent };
  })
  .sort((a, b) => (a.n.span?.earliest ?? Infinity) - (b.n.span?.earliest ?? Infinity))
  .slice(0, 18);
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:#8e5aa8"></span>{G.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <h1>{G.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{G.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/munazarat.json"><bdi dir="ltr">/api/v1/munazarat.json</bdi></a></p>
    </div>

    {paged.landing && namedDebates.length > 0 && (
      <section aria-labelledby="named-title" class="mz-named" style="margin-top:1.6rem">
        <h2 id="named-title">{G.named_title}</h2>
        <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{G.named_note}</p>
        <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
          {namedDebates.map((d) => (
            <li class="mz-match">
              <a href={href(lang, d.n.id)} class="mz-match-link">
                <span class="mz-benches ui" aria-hidden="true"><i></i><b>{G.vs}</b><i></i></span>
                <span class="mz-match-title">{label(d.n)}</span>
                {d.parties.length > 0 && (
                  <span class="ui muted" style="font-size:.82rem">{d.parties.map((p) => label(p)).join(` ${G.vs} `)}</span>
                )}
                <span class="ui muted" style="font-size:.8rem">{[d.date, d.place && label(d.place), d.opponent].filter(Boolean).join(" · ")}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {paged.landing && <MunazaratFloor lang={lang} />}

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <div class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <span id="opponent-label" style="font-weight:600">{G.opponents_title}</span>
        <div role="group" aria-labelledby="opponent-label" style="display:flex;flex-wrap:wrap;gap:6px">
          <button type="button" class="chip" data-munazarat-opponent aria-pressed="true" data-opponent="">{G.all_opponents} · {num(munazaratItems.length, lang)}</button>
          {opponents.map((s) => (
            <button type="button" class="chip" data-munazarat-opponent aria-pressed="false" data-opponent={s ?? ""}>{opponentLabel(s)} · {num(opponentCounts.get(s) ?? 0, lang)}</button>
          ))}
        </div>
        <label for="munazarat-filter" style="margin-inline-start:auto">{G.filter_label}</label>
        <input id="munazarat-filter" type="search" data-munazarat-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </div>
      <FullFilter lang={lang} slug="munazarat" />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-munazarat-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-munazarat-row data-search={searchText(i)} data-opponent={i.opponent ?? ""} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {i.node.class === "passage" && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                      {workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}
                      {kindLabel(i.kind) ? <> · <span class="chip" style="font-size:.75rem;padding:1px 8px">{kindLabel(i.kind)}</span></> : null}
                      {opponentLabel(i.opponent) ? <> · <span class="chip" style="font-size:.75rem;padding:1px 8px">{opponentLabel(i.opponent)}</span></> : null}
                    </p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-munazarat-none hidden>{G.filter_none}</p>
      {munazaratItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/munazarat-filter.ts"></script>
</BaseLayout>
<style is:inline>
  /* the two benches of the debate floor: a named debate card reads as challenger · respondent */
  .mz-match-link { display:block;height:100%;text-decoration:none;border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--card);transition:border-color .15s ease; }
  .mz-match-link:hover, .mz-match-link:focus-visible { border-color:var(--gold); }
  .mz-match-link:focus-visible { outline:3px solid var(--focus);outline-offset:2px; }
  .mz-benches { display:flex;align-items:center;gap:8px;margin:0 0 .5rem; }
  .mz-benches i { flex:1;height:8px;border-radius:99px;background:linear-gradient(90deg,var(--gold),color-mix(in srgb,var(--gold) 35%,transparent)); }
  .mz-benches i:last-child { background:linear-gradient(90deg,color-mix(in srgb,#8e5aa8 35%,transparent),#8e5aa8); }
  .mz-benches b { font-size:.72rem;color:var(--gold-text);letter-spacing:.04em; }
  .mz-match-title { display:block;font-weight:600;font-size:1.02rem;margin:0 0 .15rem;color:var(--fg); }
</style>
