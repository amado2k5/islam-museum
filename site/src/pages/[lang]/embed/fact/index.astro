---
// Embeddable fact of the day «هل تعلم؟» (docs/delegation/education-master-plan.md §5 E5):
// a minimal self-contained page other sites may embed on their pages. Static, no JavaScript,
// no visitor storage, no tracking — one "from islam.museum" link back to the record. Kept ≤ 15 KB
// and readable at 300 px wide, per the E5 acceptance tests.
import { LANGS, ui, type Lang } from "../../../../lib/i18n";
import { factOfDay, viewFact } from "../../../../lib/facts";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const f = factOfDay();
const v = f ? viewFact(f, lang) : null;
const title = T.edu.embed_fact_title;
---
<!doctype html>
<html lang={lang} dir={T.dir}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{title} — islam.museum</title>
<style>
  body{margin:0;padding:14px;font-family:Georgia,'Times New Roman',serif;background:#faf6ea;color:#1c2733;min-width:0}
  .kicker{font-family:system-ui,sans-serif;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#a8862f;margin:0 0 .4rem}
  p{margin:0 0 .6rem;font-size:1rem;line-height:1.6}
  a{color:#1f4e79}
  .from{font-family:system-ui,sans-serif;font-size:.75rem;margin-top:.6rem}
  .from a{text-decoration:none;border-bottom:1px dotted #a8862f;color:#7a5a1e}
</style>
</head>
<body>
  <p class="kicker">{title}</p>
  {v && <p>{v.text} — <a href={v.href}>{v.label}</a></p>}
  <p class="from"><a href={`/${lang}/learn/facts/`}>{T.edu.embed_from}</a></p>
</body>
</html>
