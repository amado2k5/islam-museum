---
// /world/ — "The Muslim world today": a portrait of the present in numbers, flags and maps.
// Data: site/src/data/muslim-world.json (Pew / UN / World Bank estimates). Map: basemap-world.json
// (Natural Earth 110m, public domain) with population discs. Flags: WorldFlag.astro (hand-drawn SVG).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorldFlag from "../../../components/WorldFlag.astro";
import { ui, LANGS, NUM_LOCALE, type Lang } from "../../../lib/i18n";
import { href } from "../../../lib/graph";
import D from "../../../data/muslim-world.json";
import basemap from "../../../data/basemap-world.json";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const W = ui(lang).world;
const n = (x: number) => new Intl.NumberFormat(NUM_LOCALE[lang]).format(x);
const pct = (x: number) => `${n(x)}%`;
const money = (x: number) => `$${new Intl.NumberFormat(NUM_LOCALE[lang]).format(x)}`;

const COUNTRY_NAME: Record<string, { en: string; ar: string; ur: string }> = {
  in: { en: "India", ar: "الهند", ur: "بھارت" },
};
const cname = (c: any) => (COUNTRY_NAME[c.iso ?? c.c] ?? (c.name ? c.name[lang] : c.c))[lang] ?? c.name?.en ?? c.c;
const topMax = Math.max(...D.top10.map((t) => t.m));
const regionMax = Math.max(...D.regions.map((r) => r.share));
const muslimOf = (c: any) => Math.round((c.pop_m * c.muslim_pct) / 100);
// Donut geometry: circumference 2πr for r=54.
const R = 54, CIRC = 2 * Math.PI * R, frac = D.stats.share_of_humanity / 100;
---
<BaseLayout lang={lang} title={W.title} description={W.lede} path={`/${lang}/world/`}>
  <header class="wl-hero">
    <div class="wrap">
      <p class="eyebrow">{W.eyebrow}</p>
      <h1>{W.title}</h1>
      <p class="wl-lede">{W.lede}</p>
      <p class="wl-note ui">{W.note}</p>
    </div>
  </header>

  <div class="wrap" style="padding-block:2rem 3rem">
    <nav class="wl-views ui" aria-label={W.nums_title}>
      <a href="#wl-nums">{W.nums_title}</a>
      <a href="#wl-share">{W.donut_title}</a>
      <a href="#wl-regions">{W.regions_title}</a>
      <a href="#wl-top">{W.top10_title}</a>
      <a href="#wl-map">{W.map_title}</a>
      <a href="#wl-countries">{W.countries_title}</a>
      <a href="#wl-digital">{W.digital_title}</a>
    </nav>
    <section aria-label={W.nums_title} id="wl-nums">
      <h2 class="wl-sec">{W.nums_title}</h2>
      <ul class="wl-nums" role="list">
        <li><b data-count={D.stats.total_billion} data-dec="1">{n(D.stats.total_billion)}<span class="wl-suf">B</span></b><span>{W.num_people}</span></li>
        <li><b data-count={D.stats.share_of_humanity} data-pct="1">{pct(D.stats.share_of_humanity)}</b><span>{W.num_share}</span></li>
        <li><b data-count={D.stats.majority_countries} data-suf="+">{n(D.stats.majority_countries)}+</b><span>{W.num_countries}</span></li>
        <li><b data-count={D.stats.oic_members}>{n(D.stats.oic_members)}</b><span>{W.num_oic}</span></li>
        <li><b data-count={D.stats.median_age}>{n(D.stats.median_age)}</b><span>{W.num_age}</span></li>
        <li><b data-count={D.stats.un_founders}>{n(D.stats.un_founders)}</b><span>{W.num_un}</span></li>
      </ul>
    </section>

    <section aria-labelledby="wl-share">
      <h2 class="wl-sec" id="wl-share">{W.donut_title}</h2>
      <p class="muted">{W.donut_lede}</p>
      <div class="wl-donut-row">
        <svg class="wl-donut" viewBox="0 0 140 140" role="img" aria-label={`${W.donut_muslim} ${pct(D.stats.share_of_humanity)}`}>
          <circle cx="70" cy="70" r={R} fill="none" stroke="var(--panel)" stroke-width="20"/>
          <circle cx="70" cy="70" r={R} fill="none" stroke="var(--gold)" stroke-width="20"
            stroke-dasharray={`${(frac * CIRC).toFixed(1)} ${CIRC.toFixed(1)}`}
            transform="rotate(-90 70 70)" stroke-linecap="round"/>
          <text x="70" y="66" text-anchor="middle" class="dl-big">{pct(D.stats.share_of_humanity)}</text>
          <text x="70" y="86" text-anchor="middle" class="dl-small">{W.donut_muslim}</text>
        </svg>
        <ul class="wl-legend" role="list">
          <li><i class="sw" style="background:var(--gold)"></i>{W.donut_muslim} — {pct(D.stats.share_of_humanity)}</li>
          <li><i class="sw" style="background:var(--panel);border:1px solid var(--line)"></i>{W.donut_other} — {pct(100 - D.stats.share_of_humanity)}</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="wl-regions">
      <h2 class="wl-sec" id="wl-regions">{W.regions_title}</h2>
      <p class="muted">{W.regions_lede}</p>
      <ul class="wl-bars" role="list">
        {D.regions.map((r) => (
          <li>
            <span class="wl-bar-l">{W.regions[r.key]}</span>
            <span class="wl-bar"><i style={`width:${(r.share / regionMax) * 100}%`}></i></span>
            <span class="wl-bar-v ui">{pct(r.share)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="wl-top">
      <h2 class="wl-sec" id="wl-top">{W.top10_title}</h2>
      <p class="muted">{W.top10_lede}</p>
      <ul class="wl-bars" role="list">
        {D.top10.map((t) => {
          const c = D.countries.find((x: any) => x.iso === t.c);
          return (
            <li>
              <span class="wl-bar-l wl-flag-l"><WorldFlag iso={t.c} /><bdi>{c ? c.name[lang] : COUNTRY_NAME[t.c]?.[lang]}</bdi></span>
              <span class="wl-bar"><i class="gold" style={`width:${(t.m / topMax) * 100}%`}></i></span>
              <span class="wl-bar-v ui">{n(t.m)}{W.m_suffix}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <section aria-labelledby="wl-map">
      <h2 class="wl-sec" id="wl-map">{W.map_title}</h2>
      <p class="muted">{W.map_lede} <span class="ui">{W.map_hint}</span></p>
      <div class="wl-mapbox">
        <svg viewBox={basemap.viewBox} role="img" aria-label={W.map_lede} style="width:100%;height:auto;display:block">
          <rect width="1000" height="500" fill="#0a2533"/>
          <g fill="#113f4e">
            {basemap.paths.map((p: any) => <path d={p.d} />)}
          </g>
          {D.countries.map((c: any) => {
            const r = Math.sqrt(muslimOf(c)) * 2.6;
            return (
              <a href={`/${lang}/world/${c.iso}/`} class="wl-dot">
                <title>{c.name[lang]} — {n(muslimOf(c))}{W.m_suffix}</title>
                <circle cx={c.x} cy={c.y} r={r} fill="#c5a059" opacity=".3"/>
                <circle cx={c.x} cy={c.y} r={r} fill="none" stroke="#c5a059" stroke-width="1.2" opacity=".9"/>
                <circle cx={c.x} cy={c.y} r="2.4" fill="#e6d5b8"/>
              </a>
            );
          })}
        </svg>
      </div>
    </section>

    <section aria-labelledby="wl-countries">
      <h2 class="wl-sec" id="wl-countries">{W.countries_title}</h2>
      <p class="muted">{W.countries_lede}</p>
      <form class="wl-ctrl ui" id="wl-ctrl" onsubmit="return false">
        <input type="search" id="wl-q" placeholder={W.c_search} aria-label={W.c_search} />
        <label class="sr-only" for="wl-sort">{W.c_sort}</label>
        <select id="wl-sort" aria-label={W.c_sort}>
          <option value="pop">{W.c_sort_pop}</option>
          <option value="muslim">{W.c_sort_muslim}</option>
          <option value="gdp">{W.c_sort_gdp}</option>
          <option value="un">{W.c_sort_un}</option>
        </select>
        <span class="wl-chips" role="group" aria-label={W.c_all}>
          <button type="button" class="wl-chip on" data-region="all">{W.c_all}</button>
          <button type="button" class="wl-chip" data-region="apac">{W.regions.apac}</button>
          <button type="button" class="wl-chip" data-region="mena">{W.regions.mena}</button>
          <button type="button" class="wl-chip" data-region="ssa">{W.regions.ssa}</button>
        </span>
        <output class="wl-count" id="wl-count"></output>
      </form>
      <ul class="wl-cards" role="list" id="wl-cards">
        {D.countries.map((c: any) => (
          <li class="wl-card" id={`c-${c.iso}`} data-region={c.region}
            data-pop={c.pop_m} data-muslim={c.muslim_pct} data-gdp={c.gdp_pc} data-un={c.un}
            data-name={`${c.name.en} ${c.name.ar} ${c.name.ur}`.toLowerCase()}>
            <div class="wl-card-head" data-reg={c.region}>
              <span class="wl-flag"><WorldFlag iso={c.iso} /></span>
              <div>
                <h3>{c.name[lang]}</h3>
                <p class="wl-cap ui">{W.f_capital}: {c.capital[lang]}</p>
              </div>
            </div>
            <dl class="wl-dl">
              <div><dt>{W.f_pop}</dt><dd>{n(c.pop_m)}{W.m_suffix}</dd></div>
              <div><dt>{W.f_muslim}</dt><dd>{pct(c.muslim_pct)}</dd></div>
              <div><dt>{W.f_gdp}</dt><dd>{money(c.gdp_pc)}</dd></div>
              <div><dt>{W.f_currency}</dt><dd>{c.currency[lang]}</dd></div>
              <div><dt>{W.f_un}</dt><dd>{n(c.un)}</dd></div>
              <div><dt>{W.f_gov}</dt><dd>{c.gov[lang]}</dd></div>
              <div class="wl-wide"><dt>{W.f_leader}</dt><dd>{c.leader[lang]}</dd></div>
            </dl>
            <p class="wl-street"><span class="ui lab">{W.f_street}:</span> {c.street[lang]}</p>
            <p class="ui" style="margin:.6rem 0 0"><a href={`/${lang}/world/${c.iso}/`}>{W.c_visit} <span class="flip" aria-hidden="true">→</span></a></p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="wl-digital" style="margin-top:2.4rem">
      <h2 class="wl-sec" id="wl-digital">{W.digital_title}</h2>
      <p class="muted">{W.digital_lede}</p>
      <div class="wl-digital">
        <div class="wl-search">
          <b>{pct(D.digital.search_share)}+</b>
          <span>{W.digital_search}</span>
        </div>
        <ul role="list">
          {D.digital.apps.map((a: any) => <li>{a[lang]}</li>)}
        </ul>
      </div>
    </section>

    <section aria-labelledby="wl-life">
      <h2 class="wl-sec" id="wl-life">{W.life_title}</h2>
      <ul class="wl-themes" role="list">
        {D.life_themes.map((t: any) => <li>{t[lang]}</li>)}
      </ul>
    </section>

    <section aria-labelledby="wl-famous" style="margin-top:2.4rem">
      <h2 class="wl-sec" id="wl-famous">{W.famous_title}</h2>
      <p class="muted">{W.famous_lede}</p>
      <ul class="wl-fam" role="list">
        {D.global_famous.map((p: any) => (
          <li class="wl-famc">
            {p.id ? <a class="wl-famn" href={href(lang, p.id)}>{p.n[lang]}</a> : <b class="wl-famn">{p.n[lang]}</b>}
            <span>{p.t[lang]}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="wl-trivia" id="wl-trivia" data-lang={lang}>
      <span class="lab ui">{W.trivia_title}</span>
      <p id="wl-trivia-text">{D.global_trivia[0][lang]}</p>
      <button type="button" class="wl-chip" id="wl-trivia-next">{W.t_another} →</button>
    </div>
    <script type="application/json" id="wl-trivia-data" set:html={JSON.stringify(D.global_trivia.map((t: any) => t[lang])).replace(/</g, "\u003c")} />

    <section aria-labelledby="wl-src" style="margin-top:2.4rem">
      <h2 class="wl-sec" id="wl-src">{W.sources_title}</h2>
      <ul class="wl-voices">
        {W.sources.map((v: any) => <li><a href={v.u} rel="noopener noreferrer">{v.l}</a></li>)}
      </ul>
    </section>

    <section class="wl-epilogue" aria-labelledby="wl-epi">
      <h2 id="wl-epi">{W.epilogue_title}</h2>
      <p class="muted">{W.epilogue} <a href={`/${lang}/future/`}>{W.epilogue_link} <span class="flip" aria-hidden="true">→</span></a></p>
    </section>
  </div>
</BaseLayout>
<style>
  .wl-hero { position: relative; isolation: isolate; overflow: hidden; text-align: center;
    background: linear-gradient(160deg, #0a2533 0%, #113f4e 100%); color: #f9f8f6;
    padding: clamp(56px, 10vh, 110px) 0 clamp(48px, 8vh, 90px); }
  .wl-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .55;
    background-image: radial-gradient(1.4px 1.4px at 15% 25%, #e6d5b8 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 40% 60%, #c5a059 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 62% 18%, #f9f8f6 50%, transparent 51%),
      radial-gradient(1.1px 1.1px at 82% 48%, #e6d5b8 50%, transparent 51%),
      radial-gradient(1.3px 1.3px at 92% 75%, #c5a059 50%, transparent 51%); }
  .wl-hero::after { content: ""; position: absolute; inset: auto 0 -1px; height: 40%; z-index: -1;
    background: linear-gradient(to top, var(--bg) 2%, transparent); }
  .wl-hero .eyebrow { color: var(--gold); }
  .wl-hero h1 { color: #f9f8f6; font-weight: 500; max-width: 20ch; margin-inline: auto; font-size: clamp(2.2rem, 6vw, 4.2rem); }
  .wl-lede { color: #e6d5b8; font-size: clamp(1.05rem, 1.8vw, 1.25rem); max-width: 62ch; margin: 0 auto; }
  .wl-note { max-width: 62ch; margin: 1.2rem auto 0; font-size: .95rem; color: #c9d3d6;
    border: 1px solid rgba(197,160,89,.4); border-radius: 12px; padding: 10px 16px; background: rgba(10,37,51,.55); }
  .wl-sec { font-size: 1.6rem; margin: 2rem 0 .3rem; }
  .wl-nums { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  .wl-nums li { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 1.1rem 1.2rem; }
  .wl-nums b { display: block; font-size: clamp(1.7rem, 3.4vw, 2.4rem); color: var(--gold-text); line-height: 1.1; }
  .wl-suf { font-size: .55em; }
  .wl-nums span { color: var(--muted); font-size: .92rem; }
  .wl-donut-row { display: flex; gap: 2rem; align-items: center; flex-wrap: wrap; margin-top: 1rem; }
  .wl-donut { width: min(220px, 60vw); }
  .dl-big { font-size: 26px; font-weight: 600; fill: var(--fg); }
  .dl-small { font-size: 11px; fill: var(--muted); }
  .wl-legend { list-style: none; padding: 0; margin: 0; }
  .wl-legend li { display: flex; align-items: center; gap: .6rem; margin-block: .4rem; }
  .wl-legend .sw { width: 14px; height: 14px; border-radius: 4px; display: inline-block; }
  .wl-bars { list-style: none; padding: 0; margin: 1rem 0 0; }
  .wl-bars li { display: grid; grid-template-columns: minmax(120px, 180px) 1fr 64px; gap: .7rem; align-items: center; padding-block: .35rem; }
  .wl-bar-l { font-size: .95rem; display: flex; align-items: center; gap: .5rem; }
  .wl-bar { height: 14px; background: var(--panel); border-radius: 7px; overflow: hidden; display: block; }
  .wl-bar i { display: block; height: 100%; background: var(--teal); border-radius: 7px; }
  .wl-bar i.gold { background: var(--gold); }
  .wl-bar-v { text-align: end; font-size: .9rem; }
  .wl-flag-l .flag, .wl-flag .flag { width: 34px; height: auto; border-radius: 4px; box-shadow: 0 0 0 1px var(--line); flex: none; }
  .wl-mapbox { margin-top: 1rem; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); }
  .wl-cards { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
  .wl-card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 1.2rem 1.3rem; }
  .wl-card-head { display: flex; gap: .9rem; align-items: center; }
  .wl-card-head h3 { margin: 0; font-size: 1.3rem; }
  .wl-cap { margin: 0; font-size: .85rem; color: var(--muted); }
  .wl-dl { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem 1rem; margin: .9rem 0 0; }
  .wl-dl div { display: flex; justify-content: space-between; gap: .6rem; border-bottom: 1px dotted var(--rule); padding-bottom: 3px; font-size: .92rem; }
  .wl-dl dt { color: var(--muted); }
  .wl-dl dd { margin: 0; text-align: end; }
  .wl-wide { grid-column: 1 / -1; }
  .wl-street { margin: .8rem 0 0; font-size: .9rem; }
  .wl-street .lab { color: var(--gold-text); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; }
  .wl-digital { display: grid; gap: 1.2rem; grid-template-columns: 1fr; margin-top: 1rem; }
  @media (min-width: 800px) { .wl-digital { grid-template-columns: 260px 1fr; } }
  .wl-search { border-radius: 18px; padding: 1.4rem; color: #f0e9dc; text-align: center;
    background: linear-gradient(150deg, #0d2a3e, #071723); border: 1px solid rgba(197,160,89,.35); }
  .wl-search b { display: block; font-size: 2.4rem; color: var(--gold); }
  .wl-search span { font-size: .95rem; }
  .wl-digital ul { margin: 0; }
  .wl-digital li { margin-block: .45rem; }
  .wl-voices li { margin-block: .45rem; }
  .wl-epilogue { border-block: 1px solid var(--line); padding: 2rem 0; margin-top: 2.4rem; text-align: center; }
  .wl-epilogue p { max-width: var(--measure); margin-inline: auto; }
  .wl-views { position: sticky; top: 8px; z-index: 5; display: flex; flex-wrap: wrap; gap: .45rem;
    background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: .5rem .9rem; margin-bottom: .4rem; }
  .wl-views a { font-size: .85rem; text-decoration: none; border-radius: 999px; padding: .25rem .75rem; }
  .wl-views a:hover { background: color-mix(in srgb, var(--gold) 14%, transparent); color: var(--gold-text); }
  .wl-themes { list-style: none; padding: 0; margin: .8rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .wl-themes li { border: 1px solid var(--line); background: var(--card); border-radius: 999px; padding: .4rem 1rem; font-size: .95rem; }
  .wl-fam { list-style: none; padding: .2rem 0; margin: .8rem 0 0; display: flex; gap: .9rem; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
  .wl-famc { flex: 0 0 170px; scroll-snap-align: start; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: .9rem 1rem; }
  .wl-famc .wl-famn { display: block; font-weight: 600; text-decoration: none; }
  .wl-famc a.wl-famn:hover { text-decoration: underline; }
  .wl-famc span { font-size: .85rem; color: var(--muted); }
  .wl-trivia { margin-top: 2.4rem; border-radius: 18px; padding: 1.2rem 1.4rem; color: #f0e9dc; max-width: 720px;
    background: linear-gradient(150deg, #0d2a3e, #071723); border: 1px solid rgba(197,160,89,.35); }
  .wl-trivia .lab { color: var(--gold); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
  .wl-trivia p { margin: .5rem 0 .8rem; font-size: 1.05rem; }
  .wl-trivia .wl-chip { color: var(--gold); border-color: rgba(197,160,89,.5); background: transparent; }
  @media (max-width: 620px) {
    .wl-bars li { grid-template-columns: 1fr 70px; }
    .wl-bars .wl-bar-l { grid-column: 1 / -1; }
    .wl-ctrl input[type="search"] { flex: 1 1 100%; }
    .wl-views { overflow-x: auto; flex-wrap: nowrap; scrollbar-width: none; }
    .wl-views a { flex: none; }
    .wl-dl { grid-template-columns: 1fr; }
    .wl-card-head h3 { font-size: 1.15rem; }
    .wl-flag :global(.flag), .wl-flag-l .flag { width: 28px; }
  }
  .wl-dot { cursor: pointer; }
  .wl-dot:focus-visible { outline: none; }
  .wl-dot:hover circle:nth-child(2), .wl-dot:focus-visible circle:nth-child(2) { stroke-width: 2.6; stroke: #f9f8f6; }
  .wl-dot:hover circle:nth-child(3), .wl-dot:focus-visible circle:nth-child(3) { r: 4; }
  .wl-ctrl { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin: 1rem 0 .4rem; }
  .wl-ctrl input[type="search"] { font: inherit; padding: .5rem .9rem; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--fg); min-width: 180px; }
  .wl-ctrl select { font: inherit; padding: .5rem .7rem; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--fg); }
  .wl-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .wl-chip { font: inherit; font-size: .85rem; padding: .35rem .9rem; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--fg); cursor: pointer; }
  .wl-chip.on { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 14%, var(--card)); color: var(--gold-text); font-weight: 600; }
  .wl-count { font-size: .85rem; color: var(--muted); margin-inline-start: auto; }
  .wl-card { scroll-margin-top: 90px; border-inline-start: 4px solid var(--line); transition: transform .18s ease, box-shadow .18s ease; }
  .wl-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(10,37,51,.12); }
  .wl-card[data-region="apac"] { border-inline-start-color: var(--teal); }
  .wl-card[data-region="mena"] { border-inline-start-color: var(--gold); }
  .wl-card[data-region="ssa"] { border-inline-start-color: #4d8a4f; }
  .wl-card.hl { border-color: var(--gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 35%, transparent); }
  .wl-card[hidden] { display: none; }
  .wl-nums b[data-count] { font-variant-numeric: tabular-nums; }
  section { scroll-margin-top: 80px; }
  @media (prefers-reduced-motion: no-preference) {
    .rv { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
    .rv.in { opacity: 1; transform: none; }
  }
</style>
<script is:inline>
(function () {
  var cards = Array.prototype.slice.call(document.querySelectorAll(".wl-card"));
  var q = document.getElementById("wl-q"), sort = document.getElementById("wl-sort"),
      count = document.getElementById("wl-count"), region = "all";
  var total = cards.length;
  function apply() {
    var term = (q && q.value || "").trim().toLowerCase();
    var shown = 0;
    cards.forEach(function (c) {
      var ok = (region === "all" || c.dataset.region === region) && (!term || c.dataset.name.indexOf(term) !== -1);
      c.hidden = !ok; if (ok) shown++;
    });
    var key = sort.value;
    var vis = cards.filter(function (c) { return !c.hidden; });
    vis.sort(function (a, b) {
      if (key === "un") return (+a.dataset.un) - (+b.dataset.un);
      return (+b.dataset[key]) - (+a.dataset[key]);
    });
    var ul = document.getElementById("wl-cards");
    vis.forEach(function (c) { ul.appendChild(c); });
    if (count) count.textContent = shown + " / " + total;
  }
  if (q) q.addEventListener("input", apply);
  if (sort) sort.addEventListener("change", apply);
  document.querySelectorAll(".wl-chip").forEach(function (b) {
    b.addEventListener("click", function () {
      document.querySelectorAll(".wl-chip").forEach(function (x) { x.classList.remove("on"); });
      b.classList.add("on"); region = b.dataset.region; apply();
    });
  });
  apply();
  // count-up hero numbers
  var dur = 900;
  document.querySelectorAll("[data-count]").forEach(function (el) {
    var end = parseFloat(el.dataset.count), dec = +(el.dataset.dec || 0),
        pctM = el.dataset.pct, suf = el.dataset.suf || "", t0 = null;
    function fmt(v) { return (dec ? v.toFixed(dec) : Math.round(v).toLocaleString(document.documentElement.lang)) + (pctM ? "%" : "") + suf; }
    var suffix = el.querySelector(".wl-suf");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !window.requestAnimationFrame) return;
    function step(t) { if (!t0) t0 = t; var p = Math.min(1, (t - t0) / dur); var e = 1 - Math.pow(1 - p, 3);
      el.firstChild.nodeValue = fmt(end * e);
      if (p < 1) requestAnimationFrame(step); }
    el.firstChild.nodeValue = fmt(0);
    requestAnimationFrame(step);
  });
  // rotating trivia — different fact each visit (sessionStorage deck)
  var tdata = [];
  try { tdata = JSON.parse(document.getElementById("wl-trivia-data").textContent); } catch (e) {}
  var tEl = document.getElementById("wl-trivia-text"), tBtn = document.getElementById("wl-trivia-next");
  if (tEl && tdata.length) {
    var TKEY = "world-trivia-" + tdata.length;
    function deck() {
      try { var s = JSON.parse(sessionStorage.getItem(TKEY)); if (s && s.d && s.d.length === tdata.length && s.i < tdata.length) return s; } catch (e) {}
      var d = []; for (var i = 0; i < tdata.length; i++) d.push(i);
      for (var k = d.length - 1; k > 0; k--) { var j = Math.floor(Math.random() * (k + 1)); var t = d[k]; d[k] = d[j]; d[j] = t; }
      return { d: d, i: 0 };
    }
    var st = deck();
    tEl.textContent = tdata[st.d[st.i++ % tdata.length]];
    try { sessionStorage.setItem(TKEY, JSON.stringify(st)); } catch (e) {}
    if (tBtn) tBtn.addEventListener("click", function () {
      tEl.textContent = tdata[st.d[st.i++ % st.d.length]];
      try { sessionStorage.setItem(TKEY, JSON.stringify(st)); } catch (e) {}
    });
  }
  // scroll reveal
  if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("main section").forEach(function (s) { s.classList.add("rv"); });
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
    }, { rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll(".rv").forEach(function (s) { io.observe(s); });
  }
})();
</script>
