---
// The Ibadat and Adhkar Browser by act of worship: one page per act (site/src/lib/axis.ts).
import AxisPage from "../../../../components/AxisPage.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { ibadatHeadings } from "../../../../lib/ibadat";
import { axisStaticPaths, type AxisProps } from "../../../../lib/axis";

export function getStaticPaths() { return axisStaticPaths(LANGS, ibadatHeadings); }
const { lang, id, pageNo } = Astro.props as AxisProps;
const G = (ui(lang as Lang) as any).ibadat;
const at = ibadatHeadings.findIndex((h) => h.id === id);
const h = ibadatHeadings[at], prev = ibadatHeadings[at - 1], next = ibadatHeadings[at + 1];
const name = (x: string) => G.topics?.[x] ?? x;
---
<AxisPage lang={lang} base="ibadat" anchor="act" browserTitle={G.title} A={G.axis} name={name(id)} heading={h} pageNo={pageNo}
  prev={prev && { id: prev.id, name: name(prev.id) }} next={next && { id: next.id, name: name(next.id) }} />
