---
// Backstage: how the museum is made — the founder, the fleet of AI agents, the lanes and the
// gates, and everything else the project produces (the promo film, the cartoon trailer, the
// comic, the music suite, the social videos), ending with the agents' own guest book.
// Plain prose from i18n, no scripts. Guest-book append protocol: docs/agents/backstage.md.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, fmt, LANGS, NUM_LOCALE, type Lang } from "../../../lib/i18n";
import { REPO, graph, nodes, realNodes } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { pathways } from "../../../lib/pathways";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const B = T.backstage;
// Counts are graph-derived at build time and re-read client-side from /api/v1/meta/counts.json +
// meta/deploy.json (the single counts sources) so they can never drift from the homepage's numbers.
const entries = num(realNodes.length, lang);
// Entity pages are nodes × languages; the deploy stamp's exact HTML count replaces this at view time.
const pagesEstimate = num(nodes.length * LANGS.length, lang);
const pagesCount = pathways().length;
const buildDate = graph.generated ? new Intl.DateTimeFormat(NUM_LOCALE[lang], { dateStyle: "long", timeZone: "UTC" }).format(new Date(graph.generated)) : "";
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "intro", title: B.intro_title, body: [B.intro_1] },
  { id: "build", title: B.build_title, body: [B.build_1, B.build_2, B.build_3, B.build_4] },
  { id: "work", title: B.work_title, body: [B.work_1, B.work_2, B.work_3, B.work_4] },
  { id: "film", title: B.film_title, body: [B.film_1, B.film_2, B.film_3] },
  { id: "graph", title: B.graph_title, body: [B.graph_1, B.graph_2, B.graph_3] },
  { id: "music", title: B.music_title, body: [B.music_1, B.music_tracks, B.music_2] },
  { id: "social", title: B.social_title, body: [B.social_body] },
];
// The agents' guest book: one signed entry per fleet member, written only by its own author
// when the founder asks (docs/agents/backstage.md). Until then the entry renders as pending.
const guests: { id: string; name: string; body?: string; sign?: string }[] = [
  { id: "muse", name: "Muse", body: B.muse_body, sign: B.muse_sign },
  { id: "claude", name: "Claude", body: B.claude_body, sign: B.claude_sign },
  { id: "devin", name: "Devin", body: B.devin_body, sign: B.devin_sign },
  { id: "cursor", name: "Cursor", body: B.cursor_body, sign: B.cursor_sign },
  { id: "copilot", name: "Copilot", body: B.copilot_body, sign: B.copilot_sign },
  { id: "codex", name: "Codex", body: B.codex_body, sign: B.codex_sign },
  { id: "chatgpt", name: "ChatGPT", body: B.chatgpt_body, sign: B.chatgpt_sign },
  { id: "antigravity", name: "Antigravity", body: B.antigravity_body, sign: B.antigravity_sign },
  { id: "gemini", name: "Gemini", body: B.gemini_body, sign: B.gemini_sign },
  { id: "grok", name: "Grok", body: B.grok_body, sign: B.grok_sign },
];
---
<BaseLayout lang={lang} title={B.title} description={B.lede} path={`/${lang}/backstage/`}>
  <PageHeader title={B.title} lede={B.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: B.title }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated" data-last-updated data-tpl={B.updated_tpl} data-locale={NUM_LOCALE[lang]} hidden>{buildDate ? fmt(B.updated_tpl, { date: buildDate }) : ""}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
          {s.id === "intro" && (
            <p>
              {B.intro_2a}<span data-bs-entities>{entries}</span>{B.intro_2b}<span data-bs-pages>{pagesEstimate}</span>{B.intro_2c}<span>{num(pagesCount, lang)}</span>{B.intro_2d}
            </p>
          )}
          {s.id === "intro" && (
            <p class="ui p-links">
              <a href={REPO} rel="noopener">{B.repo_cta}</a> ·
              <a href={`${REPO}/blob/main/HOW_IT_WAS_BUILT.md`} rel="noopener">{B.how_cta}</a>
            </p>
          )}
          {s.id === "film" && (
            <p class="ui p-links">
              <a href="https://www.webtoons.com/en/canvas/chronicles-of-a-museum-keeper-islammuseum/the-night-shift-at-the-museum/viewer?title_no=1183808&episode_no=1" rel="noopener">{B.comic_cta}</a> ·
              <a href="https://chroniclesofamuseumkeeper.substack.com/p/the-night-shift-at-the-museum" rel="noopener">{B.substack_cta}</a>
            </p>
          )}
          {s.id === "music" && (
            <p class="ui p-links">
              <a href="https://soundcloud.com/islam-museum/sets/voices-of-the-museum" rel="noopener">{B.soundcloud_cta}</a> ·
              <a href="https://audiomack.com/islam_museum/album/voices-of-the-museum-1" rel="noopener">{B.audiomack_cta}</a>
            </p>
          )}
        </section>
      ))}

      <section aria-labelledby="guest-h" class="p-sec">
        <h2 id="guest-h">{B.guest_title}</h2>
        <p>{B.guest_intro}</p>
        {guests.map((g) => (
          <section aria-labelledby={`guest-${g.id}-h`} class="p-guest">
            <h3 id={`guest-${g.id}-h`}>{g.name}</h3>
            {g.body && <p>{g.body}</p>}
            {g.sign && <p class="p-sign">{g.sign}</p>}
            {!g.body && <p class="ui muted">{B.guest_pending}</p>}
          </section>
        ))}
      </section>
    </article>
  </div>
</BaseLayout>
<script src="../../../scripts/landing-random.ts"></script>
<script src="../../../scripts/backstage-stats.ts"></script>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
  .p-guest { margin-block: 1.5rem 0; }
  .p-guest h3 { margin-bottom: 0.4rem; }
  .p-sign { font-style: italic; }
</style>
