---
// Backstage: how the museum is made — the founder, the fleet of AI agents, the lanes and the
// gates, and everything else the project produces (the promo film, the cartoon trailer, the
// comic, the music suite, the social videos), ending with the agents' own guest book.
// Plain prose from i18n, no scripts. Guest-book append protocol: docs/agents/backstage.md.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { REPO } from "../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const B = T.backstage;
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "intro", title: B.intro_title, body: [B.intro_1, B.intro_2] },
  { id: "build", title: B.build_title, body: [B.build_1, B.build_2, B.build_3] },
  { id: "film", title: B.film_title, body: [B.film_1, B.film_2, B.film_3] },
  { id: "music", title: B.music_title, body: [B.music_1, B.music_tracks, B.music_2] },
  { id: "social", title: B.social_title, body: [B.social_body] },
];
// The agents' guest book: one signed entry per fleet member, written only by its own author
// when the founder asks (docs/agents/backstage.md). Until then the entry renders as pending.
const guests: { id: string; name: string; body?: string; sign?: string }[] = [
  { id: "muse", name: "Muse", body: B.muse_body, sign: B.muse_sign },
  { id: "claude", name: "Claude" },
  { id: "devin", name: "Devin" },
  { id: "cursor", name: "Cursor" },
  { id: "copilot", name: "Copilot" },
  { id: "codex", name: "Codex" },
  { id: "chatgpt", name: "ChatGPT" },
  { id: "antigravity", name: "Antigravity" },
  { id: "grok", name: "Grok" },
];
---
<BaseLayout lang={lang} title={B.title} description={B.lede} path={`/${lang}/backstage/`}>
  <PageHeader title={B.title} lede={B.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: B.title }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated">{B.updated}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
          {s.id === "intro" && (
            <p class="ui p-links">
              <a href={REPO} rel="noopener">{B.repo_cta}</a> ·
              <a href={`${REPO}/blob/main/HOW_IT_WAS_BUILT.md`} rel="noopener">{B.how_cta}</a>
            </p>
          )}
        </section>
      ))}

      <section aria-labelledby="guest-h" class="p-sec">
        <h2 id="guest-h">{B.guest_title}</h2>
        <p>{B.guest_intro}</p>
        {guests.map((g) => (
          <section aria-labelledby={`guest-${g.id}-h`} class="p-guest">
            <h3 id={`guest-${g.id}-h`}>{g.name}</h3>
            {g.body && <p>{g.body}</p>}
            {g.sign && <p class="p-sign">{g.sign}</p>}
            {!g.body && <p class="ui muted">{B.guest_pending}</p>}
          </section>
        ))}
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
  .p-guest { margin-block: 1.5rem 0; }
  .p-guest h3 { margin-bottom: 0.4rem; }
  .p-sign { font-style: italic; }
</style>
