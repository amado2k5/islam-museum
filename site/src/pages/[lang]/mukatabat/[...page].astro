---
// The Mukatabat Browser's home (docs/plan/46-mukatabat-browser.md): every mention of
// correspondence the museum's sources carry — letters sent by the Prophet, kings and
// caliphs and the letters, replies and reports that came back — over the one graph.
// Passages are found at build time by the shared detector in scripts/mukatabat.ts, so
// a letter in a book harvested later appears here the day its passage record lands;
// curated records join through the `mukatabat-browser` tag. Counts are read from the
// graph at build time and appear on this page only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, curatedFirst, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import MukatabatFlow from "../../../components/sig/MukatabatFlow.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { mukatabatItems, MUKATABAT_SECTIONS, type MukatabatKind, type MukatabatSection, type MukatabatSender } from "../../../lib/mukatabat";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() {
  // the landing, and a sub-page for every page of rows of each section longer than the landing shows (site/src/lib/paged.ts)
  const ids = [...MUKATABAT_SECTIONS];
  return pagedStaticPaths(LANGS, ids.map((id) => ({ id: String(id), count: mukatabatItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).mukatabat;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1"); // citation markers belong to the entity page's footnotes
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : (n.data.unit ? String(n.data.unit) : "");
};
const kindLabel = (k: MukatabatKind | null) => (k ? G.kinds?.[k] : null);
const senderLabel = (s: MukatabatSender) => (s ? G.senders?.[s] : G.senders?.other);
const SENDER_ORDER: (MukatabatSender)[] = ["prophetic", "caliphal", "royal", "other"];
const sectionIds: MukatabatSection[] = curatedFirst([...MUKATABAT_SECTIONS]);
const sections = sectionIds.map((id) => ({ id, items: mukatabatItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/mukatabat/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const senderCounts = new Map<MukatabatSender, number>();
for (const i of mukatabatItems) senderCounts.set(i.sender, (senderCounts.get(i.sender) ?? 0) + 1);
const senders = SENDER_ORDER.filter((s) => (senderCounts.get(s) ?? 0) > 0);
const status = fmt(G.status, { n: num(renderedHeadline("mukatabat", sections, [], mukatabatItems), lang), s: num(sections.length, lang) });
const searchText = (i: (typeof mukatabatItems)[number]) =>
  [
    i.node.label.ar, i.node.label.en, i.node.label.ur,
    summaryText(i.node), excerptOf(i.node), workLabel(i.node),
    kindLabel(i.kind) ?? "", senderLabel(i.sender) ?? "",
  ].filter(Boolean).join(" ");
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{G.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <h1>{G.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{G.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/mukatabat.json"><bdi dir="ltr">/api/v1/mukatabat.json</bdi></a></p>
    </div>

{paged.landing && <MukatabatFlow lang={lang} />}

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <div class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <span id="sender-label" style="font-weight:600">{G.senders_title}</span>
        <div role="group" aria-labelledby="sender-label" style="display:flex;flex-wrap:wrap;gap:6px">
          <button type="button" class="chip" data-mukatabat-sender aria-pressed="true" data-sender="">{G.all_senders} · {num(mukatabatItems.length, lang)}</button>
          {senders.map((s) => (
            <button type="button" class="chip" data-mukatabat-sender aria-pressed="false" data-sender={s ?? ""}>{senderLabel(s)} · {num(senderCounts.get(s) ?? 0, lang)}</button>
          ))}
        </div>
        <label for="mukatabat-filter" style="margin-inline-start:auto">{G.filter_label}</label>
        <input id="mukatabat-filter" type="search" data-mukatabat-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </div>
      <FullFilter lang={lang} slug="mukatabat" />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-mukatabat-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-mukatabat-row data-search={searchText(i)} data-sender={i.sender ?? ""} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {i.node.class === "passage" && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                      {workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}
                      {kindLabel(i.kind) ? <> · <span class="chip" style="font-size:.75rem;padding:1px 8px">{kindLabel(i.kind)}</span></> : null}
                      {senderLabel(i.sender) ? <> · <span class="chip" style="font-size:.75rem;padding:1px 8px">{senderLabel(i.sender)}</span></> : null}
                    </p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-mukatabat-none hidden>{G.filter_none}</p>
      {mukatabatItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/mukatabat-filter.ts"></script>
</BaseLayout>
