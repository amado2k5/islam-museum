---
// A Nature Explorer subject page (docs/plan/34-nature-browser.md): one creature or phenomenon —
// its summary, the Qur'an ayahs that mention it (text from the frozen Tanzil passage records,
// translations from the same records, never typed on the page), the hadith reports, and the
// other museum records it links to. Everything is composed from the compiled graph at build time.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { href, labelOf, summaryRaw } from "../../../../lib/graph";
import { renderProse, newHonState } from "../../../../lib/markdown";
import { natureItems, passagesOf, relatedOf } from "../../../../lib/nature";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    natureItems.map((i) => ({ params: { lang, slug: i.node.id.split("/")[1] }, props: { lang, item: i } })),
  );
}
const { lang, item } = Astro.props as { lang: Lang; item: (typeof natureItems)[number] };
const n = item.node;
const T = ui(lang);
const N = (T as any).nature;
const title = labelOf(n, lang);
const ledeR = renderProse(summaryRaw(n, lang), lang, newHonState());
const { quran, hadith } = passagesOf(n.id);
const related = relatedOf(n.id);
const section = item.section;
const sectionTitle = N.sections[section]?.title ?? section;
// Ayah card: verse text + ref + the page language's translation (Arabic shows none — the text is Arabic).
const ayah = (p: any) => ({
  href: href(lang, p.id),
  ref: p.data.ref,
  text: p.data.text,
  tr: lang === "ar" ? "" : p.data.translations?.[lang]?.text ?? p.data.translations?.en?.text ?? "",
});
const report = (p: any) => ({
  href: href(lang, p.id),
  label: p.label?.[lang] ?? p.label?.en ?? p.id,
  summary: p.data.summary?.[lang] ?? p.data.summary?.ar ?? "",
  summaryLang: (p.data.summary?.[lang] ?? p.data.summary?.ar) ? (p.data.summary?.[lang] ? lang : "ar") : lang,
});
const desc = summaryRaw(n, lang).replace(/\{cite:[^}]*\}/g, "").replace(/\[\[([a-z]+\/[a-z0-9-]+)(?:\|([^\]]*))?\]\]/g, (_m, _id, c) => c ?? "").slice(0, 240);
---
<BaseLayout lang={lang} title={title} description={desc} path={`/${lang}/nature/${n.id.split("/")[1]}/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem">
      <a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › <a href={`/${lang}/nature/`}>{N.title}</a> › {sectionTitle}
    </nav>
    <div data-pagefind-body>
      <h1>{title}</h1>
      <p class="lede" set:html={ledeR.html} />
      <p class="ui"><a class="chip" href={href(lang, n.id)}>{N.entity_page}</a> <a class="chip" href={`/${lang}/nature/#t-${section}`}>{sectionTitle}</a></p>
    </div>

    {quran.length > 0 && (
      <section aria-labelledby="nq" style="margin-top:1.6rem">
        <h2 id="nq">{N.quran_title} · {quran.length}</h2>
        <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;gap:12px">
          {quran.map((p) => { const a = ayah(p); return (
            <li class="panel" style="padding:14px 16px">
              <p lang="ar" dir="rtl" style="font-family:var(--ar-quran);font-size:1.35rem;line-height:2.1;margin:0">{a.text}</p>
              {a.tr && <p class="muted" style="margin:.5rem 0 0">{a.tr}</p>}
              <p class="ui" style="margin:.5rem 0 0;font-size:.9rem"><a href={a.href}>{T.entity.quran_ref ?? "Qur'an"} {a.ref}</a></p>
            </li>
          ); })}
        </ol>
      </section>
    )}

    {hadith.length > 0 && (
      <section aria-labelledby="nh" style="margin-top:1.6rem">
        <h2 id="nh">{N.hadith_title} · {hadith.length}</h2>
        <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;gap:12px">
          {hadith.map((p) => { const h = report(p); return (
            <li class="panel" style="padding:14px 16px">
              <p style="margin:0;font-weight:600"><a href={h.href}>{h.label}</a></p>
              {h.summary && <p class="muted" lang={h.summaryLang} style="margin:.4rem 0 0">{h.summary}</p>}
            </li>
          ); })}
        </ol>
      </section>
    )}

    {related.length > 0 && (
      <section aria-labelledby="nr" style="margin-top:1.6rem">
        <h2 id="nr">{N.related_title}</h2>
        <ul class="ui" style="display:flex;flex-wrap:wrap;gap:6px;padding:0;list-style:none">
          {related.map((r) => <li><a class="chip" href={href(lang, r.id)}>{labelOf(r, lang)}</a></li>)}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
