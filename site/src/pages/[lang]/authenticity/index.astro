---
// How the museum decides what to show: the public authenticity policy (docs/delegation/authenticity-policy-proposal.md).
// Plain prose from i18n, no scripts. Submission-impacting: see docs/delegation/authenticity-page-draft.md.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { REPO } from "../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const A = T.authenticity;
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "admit", title: A.admit_title, body: [A.admit_body] },
  { id: "check", title: A.check_title, body: [A.check_body] },
  { id: "not", title: A.not_title, body: [A.not_body] },
  { id: "decisions", title: A.decisions_title, body: [A.decisions_body] },
  { id: "sources", title: A.sources_title, body: [A.sources_body] },
  { id: "corrections", title: A.corrections_title, body: [A.corrections_body] },
  { id: "records", title: A.records_title, body: [A.records_body] },
  { id: "rules", title: A.rules_title, body: [A.rules_body] },
];
---
<BaseLayout lang={lang} title={A.title} description={A.lede} path={`/${lang}/authenticity/`}>
  <PageHeader title={A.title} lede={A.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: A.title }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated">{A.updated}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
        </section>
      ))}
      <section aria-labelledby="repo-h" class="p-sec">
        <h2 id="repo-h">{A.rules_title}</h2>
        <p class="ui p-links">
          <a href={`${REPO}/blob/main/docs/delegation/authenticity-policy-proposal.md`} rel="noopener">{A.title}</a> ·
          <a href={`${REPO}/blob/main/scripts/harvest/library/authenticity.yaml`} rel="noopener">authenticity.yaml</a> ·
          <a href={`${REPO}/blob/main/scripts/check-authenticity.ts`} rel="noopener">check-authenticity.ts</a> ·
          <a href={`${REPO}/blob/main/scripts/harvest/library/authenticity_gate.py`} rel="noopener">authenticity_gate.py</a>
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
</style>
