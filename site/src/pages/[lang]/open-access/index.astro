---
// Open Access Policy: who may read and reuse the museum — people, search engines, AI training
// and agent crawlers, scrapers, archives and API clients — and on what terms. The standing
// policy; the dated audit that verified it lives at /open-access/audit/. Plain prose from i18n,
// no scripts. Every new section ships in all seven languages in the same commit.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const O = T.open_access;
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "summary", title: O.summary_title, body: [O.summary_1, O.summary_2] },
  { id: "welcome", title: O.welcome_title, body: [O.welcome_1, O.welcome_2] },
  { id: "ai", title: O.ai_title, body: [O.ai_1, O.ai_2] },
  { id: "infra", title: O.infra_title, body: [O.infra_1, O.infra_2] },
];
---
<BaseLayout lang={lang} title={O.title} description={O.lede} path={`/${lang}/open-access/`}>
  <PageHeader title={O.title} lede={O.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: O.nav_label }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated">{O.updated}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
        </section>
      ))}

      <section aria-labelledby="more-h" class="p-sec">
        <h2 id="more-h">{O.more_title}</h2>
        <p>{O.more_body}</p>
        <p class="ui p-links">
          <a href={`/${lang}/open-access/audit/`}>{O.audit_link}</a> ·
          <a href="mailto:concerns@islam.museum">{O.contact_cta}</a>
        </p>
        <p><strong>{O.closing}</strong></p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
</style>
