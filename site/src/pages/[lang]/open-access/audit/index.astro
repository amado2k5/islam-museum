---
// Access audit, 24 November 2026: the dated transparency note recording what the museum checked
// in its hosting and content-delivery configuration against the Open Access Policy, what it
// found, and what it corrected. The robots.txt correction (PR #8189) is recorded as pending
// merge and deploy, not live. Plain prose from i18n, no scripts.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { REPO } from "../../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const A = T.open_access_audit;
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "scope", title: A.scope_title, body: [A.scope_body] },
  { id: "found", title: A.found_title, body: [A.found_1, A.found_2] },
  { id: "fixes", title: A.fixes_title, body: [A.fix_1, A.fix_2] },
  { id: "exceptions", title: A.exceptions_title, body: [A.exceptions_body] },
  { id: "result", title: A.result_title, body: [A.result_body] },
];
---
<BaseLayout lang={lang} title={A.title} description={A.lede} path={`/${lang}/open-access/audit/`}>
  <PageHeader title={A.title} lede={A.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: T.open_access.nav_label, href: `/${lang}/open-access/` }, { label: A.updated }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated">{A.updated}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
        </section>
      ))}

      <section aria-labelledby="more-h" class="p-sec">
        <p>{A.eng_body}</p>
        <p class="ui p-links">
          <a href={`/${lang}/open-access/`}>{A.policy_link}</a> ·
          <a href={`${REPO}/tree/main/docs/engineering`} rel="noopener">{A.eng_link}</a>
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
</style>
