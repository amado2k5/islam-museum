---
// The Akhlaq and Mu'amalat Browser by heading: one page per virtue, vice and dealing (site/src/lib/axis.ts).
import AxisPage from "../../../../components/AxisPage.astro";
import { ui, LANGS, type Lang } from "../../../../lib/i18n";
import { akhlaqHeadings, akhlaqGroupOf } from "../../../../lib/akhlaq";
import { axisStaticPaths, type AxisProps } from "../../../../lib/axis";

export function getStaticPaths() { return axisStaticPaths(LANGS, akhlaqHeadings); }
const { lang, id, pageNo } = Astro.props as AxisProps;
const G = (ui(lang as Lang) as any).akhlaq;
const at = akhlaqHeadings.findIndex((h) => h.id === id);
const h = akhlaqHeadings[at], prev = akhlaqHeadings[at - 1], next = akhlaqHeadings[at + 1];
const name = (x: string) => G.topics?.[x] ?? x;
---
<AxisPage lang={lang} base="akhlaq" anchor="trait" browserTitle={G.title} A={G.axis} name={name(id)} group={G.axis.groups[akhlaqGroupOf(id)]} heading={h} pageNo={pageNo}
  prev={prev && { id: prev.id, name: name(prev.id) }} next={next && { id: next.id, name: name(next.id) }} />
