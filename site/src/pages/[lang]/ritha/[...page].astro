---
// The Elegy and Death-Announcement Browser's home (docs/plan/72-ritha-browser.md,
// «متصفح أشهر ما قيل في الرثاء والنعي»): every elegy, death announcement, word of condolence
// and report of weeping and wailing the museum's sources carry — in the Qur'an, the Sunnah, the
// seerah, the reports of the Companions and the Successors and every harvested book — over the one
// graph. Passages are found at build time by the shared detector in scripts/ritha.ts, so a book
// harvested later appears here the day its passage records land; curated records join through the
// `ritha-browser` tag. The page opens with a black-edged notice frame, the four mourning banners
// and the famous formulas, before the corpus sections. Counts are read from the graph at build time.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, curatedFirst, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import RithaDoors from "../../../components/sig/RithaDoors.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { rithaItems, RITHA_SECTIONS, RITHA_KINDS, type RithaKind, type RithaSection } from "../../../lib/ritha";
import { rithaSignalsOf } from "../../../../../scripts/ritha";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() {
  const ids = [...RITHA_SECTIONS];
  return pagedStaticPaths(LANGS, ids.map((id) => ({ id: String(id), count: rithaItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).ritha;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1");
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : (n.data.unit ? String(n.data.unit) : "");
};
const kindLabel = (k: RithaKind | null) => (k ? G.kinds?.[k]?.title : null);
const sectionIds: RithaSection[] = curatedFirst([...RITHA_SECTIONS]);
const sections = sectionIds.map((id) => ({ id, items: rithaItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/ritha/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const kindCounts = new Map<RithaKind | null, number>();
for (const i of rithaItems) kindCounts.set(i.kind, (kindCounts.get(i.kind) ?? 0) + 1);
const kinds = RITHA_KINDS.filter((k) => (kindCounts.get(k) ?? 0) > 0);
const status = fmt(G.status, { n: num(renderedHeadline("ritha", sections, [], rithaItems), lang), s: num(sections.length, lang) });
const searchText = (i: (typeof rithaItems)[number]) =>
  [i.node.label.ar, i.node.label.en, i.node.label.ur, i.node.label.fr, i.node.label.es, summaryText(i.node), excerptOf(i.node), workLabel(i.node), kindLabel(i.kind) ?? ""].filter(Boolean).join(" ");

// The famous formulas: one card per fixed wording the detector knows, with how many records carry it
// and the first record to open (a curated record or a verse first, then the shortest report).
const FORMULAS = ["istirja", "lillah_ma_akhadh", "sadma_ula", "ajirni", "ayn_tadma", "ya_abatah", "man_kana_yabudu", "al_jafar", "nay_najashi", "adhkuru_mahasin"] as const;
const signalsByItem = new Map(rithaItems.filter((i) => i.node.class === "passage").map((i) => [i.node.id, rithaSignalsOf(i.node)]));
const formulas = FORMULAS.map((f) => {
  const hits = rithaItems.filter((i) => signalsByItem.get(i.node.id)?.includes(f));
  const first = [...hits].sort((a, b) => String(a.node.data.text ?? "").length - String(b.node.data.text ?? "").length)[0];
  return { f, n: hits.length, first };
}).filter((x) => x.n > 0);
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:#2b2b33"></span>{G.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <div class="rt-frame">
        <h1>{G.title}</h1>
        <p class="rt-lede">{G.lede}</p>
      </div>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/ritha.json"><bdi dir="ltr">/api/v1/ritha.json</bdi></a></p>
    </div>

    {paged.landing && <RithaDoors lang={lang} />}

    {paged.landing && formulas.length > 0 && (
      <section aria-labelledby="formulas-title" style="margin-top:1.6rem">
        <h2 id="formulas-title" style="font-size:1.1rem">{G.formulas_title}</h2>
        <p class="muted" style="max-width:var(--measure);margin:0 0 .8rem">{G.formulas_note}</p>
        <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">
          {formulas.map((x) => (
            <li class="rt-formula">
              <a href={href(lang, x.first.node.id)}>
                <span class="rt-formula-t">{G.formulas[x.f].title}</span>
                <span class="ui muted" style="font-size:.82rem">{G.formulas[x.f].note}</span>
                <span class="ui rt-formula-n">{fmt(G.formula_count, { n: num(x.n, lang) })}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <div class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <span id="kind-label" style="font-weight:600">{G.kinds_title}</span>
        <div role="group" aria-labelledby="kind-label" style="display:flex;flex-wrap:wrap;gap:6px">
          <button type="button" class="chip" data-ritha-kind data-kind="" aria-pressed="true">{G.all_kinds} · {num(rithaItems.length, lang)}</button>
          {kinds.map((k) => (
            <button type="button" class="chip" data-ritha-kind data-kind={k} aria-pressed="false">{G.kinds[k].title} · {num(kindCounts.get(k) ?? 0, lang)}</button>
          ))}
        </div>
        <label for="ritha-filter" style="margin-inline-start:auto">{G.filter_label}</label>
        <input id="ritha-filter" type="search" data-ritha-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </div>
      <FullFilter lang={lang} slug="ritha" />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-ritha-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-ritha-row data-search={searchText(i)} data-kind={i.kind ?? ""} class={`panel rt-card rt-k-${i.kind ?? "none"}`} style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {i.node.class === "passage" && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                      {workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}
                      {kindLabel(i.kind) ? <> · <span class="chip" style="font-size:.75rem;padding:1px 8px">{kindLabel(i.kind)}</span></> : null}
                    </p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-ritha-none hidden>{G.filter_none}</p>
      {rithaItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/ritha-filter.ts"></script>
</BaseLayout>
<style is:inline>
  /* a death notice: a black selvedge and a double rule around the title, as in a printed obituary */
  .rt-frame { border:1px solid var(--line);border-block-start:10px solid #2b2b33;outline:3px double color-mix(in srgb,#2b2b33 40%,transparent);outline-offset:-9px;padding:1.2rem 1.4rem 1rem;margin:0 0 1rem;background:var(--card);max-width:calc(var(--measure) + 4rem); }
  .rt-frame h1 { margin-block-start:.4rem; }
  .rt-lede { font-size:1.15rem;margin:0; }
  .rt-formula a { display:flex;flex-direction:column;gap:2px;height:100%;text-decoration:none;color:var(--fg);border:1px solid var(--line);border-inline-start:6px solid #2b2b33;border-radius:8px;padding:12px 14px;background:var(--card); }
  .rt-formula a:hover, .rt-formula a:focus-visible { border-color:var(--gold); }
  .rt-formula a:focus-visible { outline:3px solid var(--focus);outline-offset:2px; }
  .rt-formula-t { font-weight:600; }
  .rt-formula-n { font-size:.8rem;color:var(--gold-text); }
  .rt-card { border-inline-start:5px solid var(--line); }
  .rt-k-ritha { border-inline-start-color:#6b4a8c; } .rt-k-nay { border-inline-start-color:#2b2b33; } .rt-k-taziya { border-inline-start-color:#2a7b88; } .rt-k-bukaa { border-inline-start-color:#7a3a2e; }
</style>
