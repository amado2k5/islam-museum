---
// The Arabic Language Browser's home (docs/plan/74-arabic-language-browser.md, requirements in
// docs/engineering/66-arabic-language-browser-requirements.md): Arabic, the language of the Qur'an — the
// verses in which the Qur'an names its own tongue, what the hadith, the Companions, the Successors, the
// seerah, the tafsir and the harvested books say about it, and the curated records on its inimitability,
// history, script, sciences, dialects, world, scholars and books. Passages are found at build time by the
// shared detector in scripts/arabiyya.ts, so a mention in a book harvested later appears here the day its
// passage record lands; curated records join through the `arabiyya-browser` tag. Counts are read from the
// graph at build time and appear on this page only. Readable without JavaScript.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DraftMark from "../../../components/DraftMark.astro";
import ArabiyyaRing from "../../../components/sig/ArabiyyaRing.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { arabiyyaPassages, arabiyyaRecords, ARABIYYA_CORPORA, ARABIYYA_SECTIONS } from "../../../lib/arabiyya";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const A = (T as any).arabiyya;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1");
const EXCERPT = 240;
const excerptOf = (n: Node) => {
  const clean = stripNeedsSource(String(n.data.text ?? n.data.text_search ?? "")).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work && byId.get(n.data.work as string) ? labelOf(byId.get(n.data.work as string)!, lang) : "");
const refOf = (n: Node) => (n.data.sura && n.data.aya ? `${n.data.sura}:${n.data.aya}` : n.data.ref ? String(n.data.ref) : "");
const suraLabel = (n: Node) => { const s = byId.get(`passage/quran-${n.data.sura}`); return s ? labelOf(s, lang) : ""; };
const translationOf = (n: Node) => (lang === "ar" ? "" : String(n.data.translations?.[lang]?.text ?? n.data.translations?.en?.text ?? ""));

const verses = arabiyyaPassages.filter((p) => p.corpus === "quran");
const corpora = ARABIYYA_CORPORA.filter((c) => c !== "quran")
  .map((id) => ({ id, items: arabiyyaPassages.filter((p) => p.corpus === id) }))
  .filter((c) => c.items.length > 0);
const sections = ARABIYYA_SECTIONS.map((id) => ({ id, items: arabiyyaRecords.filter((r) => r.section === id) })).filter((s) => s.items.length > 0);
const status = fmt(A.status, {
  v: num(verses.length, lang),
  p: num(arabiyyaPassages.length - verses.length, lang),
  r: num(arabiyyaRecords.length, lang),
});
const classLabel = (n: Node) => (T as any).class?.[n.class] ?? n.class;
---
<BaseLayout lang={lang} title={A.title} description={A.lede} path={`/${lang}/arabiyya/`}>
  <div class="wrap ar-b" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{A.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {A.title}</nav>
    <div data-pagefind-body>
      <h1>{A.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{A.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{A.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{A.method_note}</p>
      <p class="ui muted">{A.api} <a href="/api/v1/arabiyya.json"><bdi dir="ltr">/api/v1/arabiyya.json</bdi></a></p>
    </div>

    <nav aria-label={A.contents_title} class="ui" style="margin:1rem 0 0">
      <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
        <li><a class="chip" href="#c-quran">{A.corpora.quran.title} · {num(verses.length, lang)}</a></li>
        {sections.map((s) => <li><a class="chip" href={`#s-${s.id}`}>{A.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        {corpora.map((c) => <li><a class="chip" href={`#c-${c.id}`}>{A.corpora[c.id]?.title ?? c.id} · {num(c.items.length, lang)}</a></li>)}
      </ul>
    </nav>

    <ArabiyyaRing lang={lang} />
    <DraftMark lang={lang} legend />

    <section aria-labelledby="c-quran" style="margin-top:2.2rem">
      <div data-pagefind-body>
        <h2 id="c-quran">{A.corpora.quran.title}</h2>
        <p class="muted" style="max-width:var(--measure)">{A.corpora.quran.desc}</p>
      </div>
      <ol role="list" class="ar-verses" data-pagefind-ignore>
        {verses.map((v) => (
          <li class="ar-verse">
            <p class="ui ar-ref"><a href={href(lang, v.node.id)}>{suraLabel(v.node)} <bdi dir="ltr">{refOf(v.node)}</bdi></a></p>
            <p class="ar-text" dir="rtl" lang="ar">{String(v.node.data.text ?? "")}</p>
            {translationOf(v.node) && <p class="muted ar-tr">{translationOf(v.node)}</p>}
          </li>
        ))}
      </ol>
      {verses.length === 0 && <p class="panel ui">{A.empty}</p>}
    </section>

    {sections.map((s, k) => (
      <section aria-labelledby={`s-${s.id}`} class="ar-chapter" style="margin-top:2.2rem">
        <div data-pagefind-body>
          <p class="ui ar-no" aria-hidden="true">{num(k + 1, lang)}</p>
          <h2 id={`s-${s.id}`}>{A.sections[s.id]?.title ?? s.id}</h2>
          <p class="muted" style="max-width:var(--measure)">{A.sections[s.id]?.desc}</p>
        </div>
        <ol role="list" class="ar-cards" data-pagefind-ignore>
          {s.items.map((r) => (
            <li class="panel" style="padding:14px 16px">
              <a href={href(lang, r.node.id)} style="font-weight:600">{label(r.node)}</a><DraftMark lang={lang} node={r.node} />
              <p class="ui muted" style="margin:.15rem 0 0;font-size:.8rem">{classLabel(r.node)}</p>
              <p class="muted" style="margin:.3rem 0 0;font-size:.92rem">{summaryText(r.node)}</p>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section aria-labelledby="passages-title" style="margin-top:2.4rem">
      <div data-pagefind-body>
        <h2 id="passages-title">{A.passages_title}</h2>
        <p class="muted" style="max-width:var(--measure)">{A.passages_note}</p>
      </div>
      <div data-pagefind-ignore>
        {corpora.map((c) => (
          <section aria-labelledby={`c-${c.id}`} style="margin:1.4rem 0">
            <h3 id={`c-${c.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{A.corpora[c.id]?.title ?? c.id} · {num(c.items.length, lang)}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{A.corpora[c.id]?.desc}</p>
            <ol role="list" class="ar-cards">
              {c.items.map((p) => (
                <li class="panel" style="padding:14px 16px">
                  <a href={href(lang, p.node.id)} style="font-weight:600">{label(p.node)}</a><DraftMark lang={lang} node={p.node} />
                  <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">{workLabel(p.node)}{refOf(p.node) ? <bdi> · {refOf(p.node)}</bdi> : null}</p>
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="rtl" lang="ar">{excerptOf(p.node)}</p>
                </li>
              ))}
            </ol>
          </section>
        ))}
        {corpora.length === 0 && <p class="panel ui">{A.empty}</p>}
      </div>
    </section>

    <section aria-labelledby="kin-title" style="margin-top:2.2rem;max-width:var(--measure)">
      <h2 id="kin-title" style="font-size:1.1rem">{A.kin_title}</h2>
      <p class="ui"><a href={`/${lang}/maajim/`}>{(T as any).explore.maajim.title}</a> · <a href={`/${lang}/words/quran/`}>{(T as any).explore.quran.title}</a> · <a href={`/${lang}/words/poetry/`}>{(T as any).explore.poetry.title}</a> · <a href={`/${lang}/qiraat/`}>{(T as any).explore.qiraat.title}</a></p>
    </section>
  </div>
</BaseLayout>
<style>
  .ar-verses { list-style:none; padding:0; margin:1rem 0 0; display:grid; gap:14px; max-width:60rem; }
  .ar-verse { border-inline-start:4px solid var(--gold); background:var(--panel); border-radius:10px; padding:14px 18px; }
  .ar-ref { margin:0 0 .3rem; font-size:.85rem; }
  .ar-text { margin:0; font-size:1.45rem; line-height:2.1; }
  .ar-tr { margin:.4rem 0 0; font-size:.95rem; }
  .ar-cards { list-style:none; padding:0; margin:1rem 0 0; display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:12px; }
  .ar-chapter { border-top:1px solid var(--line); padding-top:1.2rem; }
  .ar-no { margin:0; font-size:2rem; font-weight:700; color:var(--gold); line-height:1; }
</style>
