---
// The Tajwid and Tilawah Browser's home (docs/plan/76-tajwid-tilawah-browser.md): everything the
// museum's sources say of tajwid — the letters' makharij and sifat, the mudud and the ghunna, the
// qalqala, the rules of nun sakinah, mim sakinah and the tanwin, the waqf and the ibtida' — and of
// tilawah: the measured recitation (tartil) the Qur'an commands, its etiquette and its hearing, the
// melodies debated under their holders' names, and the qurra' and the teaching texts that carry the
// craft — plus the curated records about them, over the one graph. Qur'an verses come from the
// reviewed table in scripts/tajwid.ts and every other passage from its guarded lexicon at build
// time, so a mention in a book harvested later appears the day its passage record lands; curated
// records join through the `tajwid-browser` tag. Counts are read from the graph at build time and
// appear on this page only. The Qira'at Browser (/qiraat/) covers the readings, the rasm and the
// scripts; this one covers how the letters are pronounced and how the recitation is performed.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PagedNav from "../../../components/PagedNav.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { pagedStaticPaths, pageView, renderedHeadline, curatedFirst, type PagedProps } from "../../../lib/paged";
import DraftMark from "../../../components/DraftMark.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { tajwidItems, TAJWID_SECTIONS, TAJWID_TOPICS, type TajwidSection, type TajwidTopic } from "../../../lib/tajwid";
import type { Node } from "../../../../scripts/build-graph";
import TajwidMap from "../../../components/sig/TajwidMap.astro";

export function getStaticPaths() {
  // the landing, and a sub-page for every page of rows of each section longer than the landing shows (site/src/lib/paged.ts)
  const ids = [...TAJWID_SECTIONS];
  return pagedStaticPaths(LANGS, ids.map((id) => ({ id: String(id), count: tajwidItems.filter((i) => i.section === id).length })));
}
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).tajwid;
const AR = (ui("ar") as any).tajwid; // the Arabic names, set in the display faces on every language's page
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "").replace(/\s*\{cite:[^}]*\}/g, "").replace(/\s+([.,؛،])/g, "$1"); // citation markers belong to the entity page's footnotes
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : (n.data.unit ? String(n.data.unit) : "");
};
const topicLabel = (t: TajwidTopic) => G.topics?.[t] ?? t;
const sectionIds: TajwidSection[] = curatedFirst([...TAJWID_SECTIONS]);
const sections = sectionIds.map((id) => ({ id, items: tajwidItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const paged = pageView(sections, Astro.props as PagedProps, `/${lang}/tajwid/`);
const pagedLabel = (s: { id: string }) => G.sections[s.id]?.title ?? s.id;
const pagedTitle = paged.landing ? G.title : `${G.title} · ${pagedLabel(paged.sections[0])}${paged.pager && paged.pager.pageNo > 1 ? ` · ${paged.pager.pageNo}` : ""}`;
const status = fmt(G.status, { n: num(renderedHeadline("tajwid", sections, [], tajwidItems), lang), s: num(sections.length, lang) });
const searchText = (i: (typeof tajwidItems)[number]) =>
  [
    i.node.label.ar, i.node.label.en, i.node.label.ur,
    summaryText(i.node), excerptOf(i.node), workLabel(i.node),
    ...i.topics.map(topicLabel),
  ].filter(Boolean).join(" ");
---
<BaseLayout lang={lang} title={pagedTitle} description={G.lede} path={paged.path}>
  <div class="wrap tj" style="padding-block:10px 20px">
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body={paged.landing || undefined}>
      <header class="tj-hero">
        <div class="tj-frame">
          <p class="tj-ayah" lang="ar" dir="rtl">{AR.hero_ayah}</p>
          <div class="tj-breath" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          <h1>{G.title}</h1>
          <p class="tj-naskh" lang="ar" dir="rtl" aria-hidden="true">{AR.hero_naskh}</p>
          <p class="tj-lede">{G.lede}</p>
          <p class="ui tj-status">{status}</p>
        </div>
      </header>
      <h2 id="topics-title" class="tj-h2">{G.topics_title}</h2>
      <ul class="tj-topics" role="list">
        {TAJWID_TOPICS.map((t) => (
          <li>
            {lang !== "ar" && <span class="tj-topic-ar" lang="ar" dir="rtl" aria-hidden="true">{AR.topics[t]}</span>}
            <strong>{topicLabel(t)}</strong>
            <span class="muted">{G.topics_desc?.[t]}</span>
          </li>
        ))}
      </ul>
      <h2 id="method-title" class="tj-h2">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/tajwid.json"><bdi dir="ltr">/api/v1/tajwid.json</bdi></a></p>
    </div>

    {paged.landing && <TajwidMap lang={lang} />}

    <DraftMark lang={lang} legend />
    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title" class="tj-h2">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`${paged.home}#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="tajwid-filter">{G.filter_label}</label>
        <input id="tajwid-filter" type="search" data-tajwid-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <FullFilter lang={lang} slug="tajwid" />
      <div data-pagefind-ignore>
        {paged.sections.map((s) => (
          <section data-tajwid-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-tajwid-row data-search={searchText(i)} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a><DraftMark lang={lang} node={i.node} />
                  {i.node.class === "passage" && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                      {workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}
                    </p>
                  )}
                  {i.topics.length > 0 && (
                    <p class="ui muted" style="margin:.25rem 0 0;font-size:.78rem" dir="auto">
                      {i.topics.map((t) => topicLabel(t)).join(" · ")}
                    </p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
            <PagedNav lang={lang} paged={paged} section={s} label={pagedLabel(s)} />
          </section>
        ))}
      </div>
      <p class="panel ui" data-tajwid-none hidden>{G.filter_none}</p>
      {tajwidItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>

    <section aria-labelledby="kin-title" style="margin-top:2.2rem;max-width:var(--measure)">
      <h2 id="kin-title" class="tj-h2">{G.kin_title}</h2>
      <p class="ui"><a href={`/${lang}/qiraat/`}>{(T as any).explore.pages.qiraat.title}</a> · <a href={`/${lang}/words/quran/`}>{(T as any).explore.pages.quran.title}</a> · <a href={`/${lang}/words/hadith/`}>{(T as any).explore.pages.hadith.title}</a> · <a href={`/${lang}/tafsir/`}>{(T as any).explore.pages.tafsir.title}</a></p>
    </section>
  </div>
  <script src="../../../scripts/tajwid-filter.ts"></script>
<style is:global>
  /* The browser's own dress (this page only): a hero on the colours of breath — deep teal like the
     chest the sound rises from and rose-gold like the letters at the lips — with the command
     «ورتل» set large and a breath of five dots descending to the title. Faces already shipped:
     Reem Kufi (Kufic) and Amiri (naskh). */
  .tj .tj-hero { margin: 0 0 1.8rem; padding: 10px; border-radius: 20px; background: #0d1517; background-image: radial-gradient(ellipse at 50% 100%, #17343a 0%, #0d1517 68%); }
  .tj .tj-frame { position: relative; padding: clamp(22px, 5vw, 56px) clamp(16px, 5vw, 64px); border: 1px solid #3d6b6b; border-radius: 14px; outline: 1px solid #1e3a3e; outline-offset: -7px; text-align: center; color: #e3ede9; }
  .tj .tj-ayah { margin: 0; font-family: "Amiri", "Noto Naskh Arabic", serif; font-size: clamp(1.5rem, 4.6vw, 3rem); line-height: 2; color: #d8b878; }
  .tj .tj-breath { display: flex; justify-content: center; gap: 12px; margin: 14px 0 10px; }
  .tj .tj-breath i { inline-size: 8px; block-size: 8px; border-radius: 50%; background: #3d6b6b; }
  .tj .tj-breath i:nth-child(2) { background: #2e7d52; }
  .tj .tj-breath i:nth-child(3) { background: #4d8a4f; }
  .tj .tj-breath i:nth-child(4) { background: #b27b42; }
  .tj .tj-breath i:nth-child(5) { background: #c5a059; }
  .tj .tj-hero h1 { margin: 0; color: #f0e7d0; font-size: clamp(1.25rem, 2.6vw, 1.9rem); line-height: 1.5; }
  .tj .tj-naskh { margin: .5rem 0 0; font-family: "Amiri", "Noto Naskh Arabic", serif; font-size: clamp(1.2rem, 3vw, 1.9rem); line-height: 1.9; color: #a9c4bd; }
  .tj .tj-lede { margin: 1.2rem auto 0; max-width: 62ch; font-size: 1.08rem; line-height: 1.9; color: #d8e2dc; }
  .tj .tj-status { margin: 1.2rem auto 0; max-width: 62ch; font-size: .85rem; color: #9fb8ae; border-block-start: 1px solid #1e3a3e; padding-block-start: .9rem; }
  .tj .tj-h2, .tj section > div > h2, .tj section > h2 { position: relative; padding-inline-start: 26px; }
  .tj .tj-h2::before, .tj section > div > h2::before, .tj section > h2::before { content: ""; position: absolute; inset-inline-start: 4px; inset-block-start: .55em; inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--gold, #c5a059); }
  .tj .tj-topics { list-style: none; margin: 0 0 1.6rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .tj .tj-topics li { display: grid; gap: 4px; align-content: start; padding: 16px 16px 14px; border-radius: 12px; background: var(--panel); border: 1px solid var(--line); border-block-start: 3px solid #3d6b6b; }
  .tj .tj-topics strong { font-size: 1.05rem; }
  html[lang="ar"] .tj .tj-topics strong { font-family: "Amiri", var(--ar-display); font-weight: 700; font-size: 1.3rem; color: #2e7d52; }
  .tj .tj-topics .muted { font-size: .9rem; line-height: 1.7; }
  .tj .tj-topic-ar { font-family: "Amiri", "Noto Naskh Arabic", serif; font-weight: 700; font-size: 1.3rem; color: #2e7d52; line-height: 1.5; }
  /* cards: a breathing edge — the letters' own colour line */
  .tj [data-tajwid-row] { border: 1px solid var(--line); border-inline-start: 3px solid #3d6b6b; border-radius: 4px 12px 12px 4px; }
  html:is([lang="ar"], [lang="ur"]) .tj [data-tajwid-row] > a { font-family: var(--ar-display); font-size: 1.12rem; }
  .tj [data-tajwid-section] > h3 { display: flex; align-items: center; gap: 10px; font-size: 1.25rem !important; }
  .tj [data-tajwid-section] > h3::after { content: ""; flex: 1; block-size: 2px; border-radius: 2px; background: linear-gradient(to left, transparent, #3d6b6b); }
  html[dir="rtl"] .tj [data-tajwid-section] > h3::after { background: linear-gradient(to right, transparent, #3d6b6b); }
  .tj .chip { border: 1px solid color-mix(in srgb, #3d6b6b 55%, transparent); }
</style>
</BaseLayout>
