---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MiniMap from "../../../components/MiniMap.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ExploreBar from "../../../components/ExploreBar.astro";
import TodayCards from "../../../components/TodayCards.astro";
import HijriTimeline from "../../../components/HijriTimeline.astro";
import { ui, LANGS, WINGS, WING_PATH, fmt, type Lang, type Wing } from "../../../lib/i18n";
import { href, labelOf, realNodes, summaryOf } from "../../../lib/graph";
import { formatDate, timelineKey } from "../../../lib/dates";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => WINGS.map((w) => ({ params: { lang, hall: WING_PATH[w] }, props: { lang, wing: w } })));
}
const { lang, wing } = Astro.props as { lang: Lang; wing: Wing };
const T = ui(lang);
const items = realNodes.filter((n) => n.wings.includes(wing));
if (wing === "time") {
  // Chronological by start date (see timelineKey); the build fails if the rendered sequence is not non-decreasing.
  const keyed = items.map((n) => ({ n, ...timelineKey(n) })).sort((a, b) => (a.key === b.key ? a.ord - b.ord : a.key < b.key ? -1 : 1));
  for (let i = 1; i < keyed.length; i++) {
    if (keyed[i].key < keyed[i - 1].key) throw new Error(`time wing out of order: ${keyed[i - 1].n.id} before ${keyed[i].n.id}`);
  }
  // Undated entries (datasets, buildings) sort last: Infinity keys are non-decreasing.
  items.splice(0, items.length, ...keyed.map((k) => k.n));
}
const dateOf = (n: any) => {
  const d = n.data;
  return formatDate(d.born ?? d.date?.start ?? d.start, lang).text;
};
// Hub cards show a 110-char teaser (cut at a word boundary) instead of the
// full summary: /ar/people/ and /ar/time/ are multi-MB pages otherwise.
// summaryOf already resolves [[wiki-links]] to label text, so no cut can
// land inside a link. Rendered at build time, so no-JS readers still get text.
const short = (s: string, n = 110) => (s.length > n ? s.slice(0, n).replace(/\s+\S*$/, "") + "…" : s);
const placesWithCoords = wing === "place" ? realNodes.filter((n) => n.coordinates) : [];
// Objects hall: depict→media thumbnail index and collections grouping.
const thumbByObject = new Map<string, { thumb: string; alt: string }>();
if (wing === "objects") {
  for (const m of realNodes.filter((n) => n.class === "media" && n.data.kind === "image")) {
    for (const t of m.data.depicts ?? []) {
      if (!thumbByObject.has(t) && m.data.thumbnail) {
        thumbByObject.set(t, { thumb: m.data.thumbnail, alt: m.data.alt?.[lang] ?? m.data.alt?.en ?? labelOf(m, lang) });
      }
    }
  }
}
const objectItems = wing === "objects" ? items.filter((n) => n.class === "object") : [];
const pictured = objectItems.filter((n) => thumbByObject.has(n.id));
const collections = wing === "objects"
  ? [...objectItems.reduce((m, n) => {
      const k = n.data.holding_institution as string | undefined;
      if (k) m.set(k, (m.get(k) ?? 0) + 1);
      return m;
    }, new Map<string, number>()).entries()].sort((a, b) => b[1] - a[1])
  : [];
---
<BaseLayout lang={lang} title={T.wings[wing].title} description={T.wings[wing].blurb} path={`/${lang}/${WING_PATH[wing]}/`}>
  <PageHeader
    title={T.wings[wing].title}
    lede={T.wings[wing].blurb}
    crumbs={[{ label: T.entity.breadcrumb, href: `/${lang}/` }, { label: T.wings[wing].title }]}
    crumbsLabel={T.entity.breadcrumb}
    wing={wing}
  >
    <p class="ui" style="color:#c9d3d6;margin:14px 0 0">{items.length ? (wing === "time" ? T.hall.coming_time : T.hall.coming) : T.hall.empty}{" "}{wing !== "objects" && <span>{fmt(T.hall.phase, { wing: T.wings[wing].title })}</span>}</p>
    {wing === "time" && <p class="ui tl-legend" style="color:#c9d3d6;font-size:.9rem;margin:6px 0 0">{T.timeline.legend}</p>}
  </PageHeader>
  <div class="wrap" style="padding-block:24px 20px" data-pagefind-ignore>
    {wing === "time" && <HijriTimeline lang={lang} />}
    {wing === "today" && (
      <section class="today-page" aria-labelledby="today-h">
        <TodayCards lang={lang} full={true} />
        <p class="muted ui" style="margin-top:1.5rem">{T.today.wing_note}</p>
      </section>
    )}

    {wing === "place" && placesWithCoords.length > 0 && (
      <figure style="margin:1.5rem 0;max-width:720px"><MiniMap places={placesWithCoords} lang={lang} /><figcaption class="muted ui" style="font-size:.85rem">{T.hall.map_note}</figcaption></figure>
    )}

    {wing === "words" && (
      <ul class="grid-cards" style="list-style:none;margin:0 0 8px;padding:0">
        <li><a class="card" href={`/${lang}/words/quran/`}><h2 class="card-title">{T.reader.title}</h2><span>{T.reader.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/words/hadith/`}><h2 class="card-title">{T.hadith.title}</h2><span>{T.hadith.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/words/poetry/`}><h2 class="card-title">{T.poetry.title}</h2><span>{T.poetry.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/words/revelation/`}><h2 class="card-title">{T.revelation.title}</h2><span>{T.revelation.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/surah/`}><h2 class="card-title">{T.surahmap.title}</h2><span>{T.surahmap.lede}</span></a></li>
      </ul>
    )}

    {wing === "objects" && pictured.length > 0 && (
      <section aria-labelledby="obj-gallery-h">
        <h2 id="obj-gallery-h" class="ui" style="font-size:1.15rem;margin:1.5rem 0 .6rem">{T.hall.gallery}</h2>
        <ul class="obj-grid">
          {pictured.map((n) => {
            const m = thumbByObject.get(n.id)!;
            return (
              <li>
                <a class="obj-card" href={href(lang, n.id)}>
                  <img src={m.thumb} alt={m.alt} loading="lazy" decoding="async" />
                  <span class="obj-cap">
                    <span class="card-title" style="font-size:.95rem">{labelOf(n, lang)}</span>
                    <span class="ui" style="font-size:.8rem;color:var(--muted)">
                      {[n.data.holding_institution, dateOf(n)].filter(Boolean).join(" · ")}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
    {wing === "objects" && collections.length > 0 && (
      <section aria-labelledby="obj-colls-h">
        <h2 id="obj-colls-h" class="ui" style="font-size:1.15rem;margin:1.8rem 0 .6rem">{T.hall.collections}</h2>
        <ul class="coll-list">
          {collections.map(([inst, n]) => (
            <li><span>{inst}</span><span class="ui" style="color:var(--muted)">{n}</span></li>
          ))}
        </ul>
      </section>
    )}
    {wing === "objects" && <h2 class="ui" style="font-size:1.15rem;margin:1.8rem 0 0">{T.hall.index}</h2>}
    {items.some((n) => formatDate(n.data.born ?? n.data.date?.start ?? n.data.start, lang).derived) && <p class="ui muted" style="font-size:.85rem;margin:1.2rem 0 0">{T.entity.dagger}</p>}
    <ul class="grid-cards" style="margin-top:1.5rem">
      {items.filter((n) => labelOf(n, lang)).map((n) => (
        <li><a class="card" href={href(lang, n.id)}><span class="ui kicker">{T.class[n.class]}</span><h2 class="card-title">{labelOf(n, lang)}</h2>{n.wings.filter((w) => WINGS.includes(w as Wing)).length > 1 && <span class="ui" style="display:block;font-size:.8rem;opacity:.75">{WINGS.filter((w) => n.wings.includes(w)).map((w) => T.nav[w]).join(" · ")}</span>}{dateOf(n) && <span class="ui" style="display:block;font-size:.85rem">{dateOf(n)}</span>}<span>{short(summaryOf(n, lang))}</span></a></li>
      ))}
    </ul>

  </div>
  <ExploreBar lang={lang} />
</BaseLayout>
