---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PlaceMap from "../../../components/PlaceMap.astro";
import { assetVersion, dataVersion } from "../../../lib/place-map";
import PageHeader from "../../../components/PageHeader.astro";
import ExploreBar from "../../../components/ExploreBar.astro";
import TodayCards from "../../../components/TodayCards.astro";
import DraftMark from "../../../components/DraftMark.astro";
import HallCard from "../../../components/HallCard.astro";
import FullFilter from "../../../components/FullFilter.astro";
import { hallItems, hallGroups, hallCornerstones, hallPromised, hallIndexHref } from "../../../lib/halls";
import { num } from "../../../lib/nav";
import HijriTimeline from "../../../components/HijriTimeline.astro";
import { ui, fmt, LANGS, WINGS, WING_PATH, type Lang, type Wing } from "../../../lib/i18n";
import { WING_CLASSES } from "../../../../../scripts/wings";
import { href, labelOf, realNodes, summaryOf } from "../../../lib/graph";
import { formatDate, timelineKey } from "../../../lib/dates";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => WINGS.map((w) => ({ params: { lang, hall: WING_PATH[w] }, props: { lang, wing: w } })));
}
const { lang, wing } = Astro.props as { lang: Lang; wing: Wing };
const T = ui(lang);
// the wing's records in the hall's order (time order in Time, the wing's own class first elsewhere), and its index groups
const items = wing === "place" ? realNodes.filter((n) => n.wings.includes(wing)) : hallItems(wing, lang);
const groups = wing === "place" ? [] : hallGroups(wing, lang);
const cornerstones = wing === "place" ? [] : hallCornerstones(wing, lang);
const promised = wing === "place" ? [] : hallPromised(wing, lang);
// the headline of the index is the set the index pages render: every record is on exactly one of them
const indexed = groups.reduce((k, g) => k + g.items.length, 0);
if (wing !== "place" && indexed !== new Set(items.map((n) => n.id)).size) throw new Error(`${wing} hall: the index pages hold ${indexed} records but the wing lists ${items.length}`);
const groupLabel = (g: { id: string; label: string }) => (g.id === "other" ? T.hall.other : g.id === "undated" ? T.hall.undated : g.id === "bce" ? T.hall.bce : g.label);
const dateOf = (n: any) => {
  const d = n.data;
  return formatDate(d.born ?? d.date?.start ?? d.start, lang).text;
};
// Hub cards show a 110-char teaser (cut at a word boundary) instead of the
// full summary: /ar/people/ and /ar/time/ are multi-MB pages otherwise.
// summaryOf already resolves [[wiki-links]] to label text, so no cut can
// land inside a link. Rendered at build time, so no-JS readers still get text.
const short = (s: string, n = 110) => (s.length > n ? s.slice(0, n).replace(/\s+\S*$/, "") + "…" : s);
// The Place wing is the map and the index under it (components/PlaceMap.astro, docs/site/place-map-review.md).
// Objects hall: depict→media thumbnail index and collections grouping.
const thumbByObject = new Map<string, { thumb: string; alt: string }>();
if (wing === "objects") {
  for (const m of realNodes.filter((n) => n.class === "media" && n.data.kind === "image")) {
    for (const t of m.data.depicts ?? []) {
      if (!thumbByObject.has(t) && m.data.thumbnail) {
        thumbByObject.set(t, { thumb: m.data.thumbnail, alt: m.data.alt?.[lang] ?? m.data.alt?.en ?? labelOf(m, lang) });
      }
    }
  }
}
const objectItems = wing === "objects" ? items.filter((n) => n.class === "object") : [];
const pictured = objectItems.filter((n) => thumbByObject.has(n.id));
const collections = wing === "objects"
  ? [...objectItems.reduce((m, n) => {
      const k = n.data.holding_institution as string | undefined;
      if (k) m.set(k, (m.get(k) ?? 0) + 1);
      return m;
    }, new Map<string, number>()).entries()].sort((a, b) => b[1] - a[1])
  : [];
---
<BaseLayout lang={lang} title={T.wings[wing].title} description={T.wings[wing].blurb} path={`/${lang}/${WING_PATH[wing]}/`}><Fragment slot="head">{wing === "place" && (<><link rel="stylesheet" href={`/shell/place-map.css?v=${assetVersion("place-map.css")}`} /><link rel="preload" as="fetch" crossorigin="anonymous" href={`/${lang}/place-map/places.json?v=${dataVersion(lang)}`} /></>)}</Fragment>{wing !== "place" ? <PageHeader
    title={T.wings[wing].title}
    lede={T.wings[wing].blurb}
    crumbs={[{ label: T.entity.breadcrumb, href: `/${lang}/` }, { label: T.wings[wing].title }]}
    crumbsLabel={T.entity.breadcrumb}
    wing={wing}
  >
    <p class="ui" style="color:#c9d3d6;margin:14px 0 0">{items.length ? (wing === "time" ? T.hall.coming_time : T.hall.coming) : T.hall.empty}</p>
    {wing === "time" && <p class="ui tl-legend" style="color:#c9d3d6;font-size:.9rem;margin:6px 0 0">{T.timeline.legend}</p>}
  </PageHeader> : <PlaceMap lang={lang} />}
  <div class="wrap" style={wing === "place" ? "padding-block:0" : "padding-block:24px 20px"} data-pagefind-ignore>
    {wing === "time" && <HijriTimeline lang={lang} />}
    {wing === "time" && <p class="ui muted" style="max-width:var(--measure);margin:.8rem 0 0">{T.hall.other_timeline} <a href={`/${lang}/time-browser/`}>{T.explore.pages.timeexplorer.title}</a>.</p>}
    {wing === "today" && (
      <section class="today-page" aria-labelledby="today-h">
        <TodayCards lang={lang} full={true} />
        <p class="muted ui" style="margin-top:1.5rem">{T.today.wing_note}</p>
      </section>
    )}

    {/* The Place wing's map is drawn above the banner's place by PlaceMap; this empty expression keeps the other wings' HTML byte for byte as it was. */}

    {wing === "words" && (
      <ul class="grid-cards" style="list-style:none;margin:0 0 8px;padding:0">
        <li><a class="card" href={`/${lang}/words/quran/`}><h2 class="card-title">{T.reader.title}</h2><span>{T.reader.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/words/hadith/`}><h2 class="card-title">{T.hadith.title}</h2><span>{T.hadith.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/words/poetry/`}><h2 class="card-title">{T.poetry.title}</h2><span>{T.poetry.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/words/revelation/`}><h2 class="card-title">{T.revelation.title}</h2><span>{T.revelation.lede}</span></a></li>
        <li><a class="card" href={`/${lang}/surah/`}><h2 class="card-title">{T.surahmap.title}</h2><span>{T.surahmap.lede}</span></a></li>
      </ul>
    )}

    {wing === "objects" && pictured.length > 0 && (
      <section aria-labelledby="obj-gallery-h">
        <h2 id="obj-gallery-h" class="ui" style="font-size:1.15rem;margin:1.5rem 0 .6rem">{T.hall.gallery}</h2>
        <ul class="obj-grid">
          {pictured.map((n) => {
            const m = thumbByObject.get(n.id)!;
            return (
              <li>
                <a class="obj-card" href={href(lang, n.id)}>
                  <img src={m.thumb} alt={m.alt} loading="lazy" decoding="async" />
                  <span class="obj-cap">
                    <span class="card-title" style="font-size:.95rem">{labelOf(n, lang)}</span>
                    <span class="ui" style="font-size:.8rem;color:var(--muted)">
                      {[n.data.holding_institution, dateOf(n)].filter(Boolean).join(" · ")}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
    {wing === "objects" && collections.length > 0 && (
      <section aria-labelledby="obj-colls-h">
        <h2 id="obj-colls-h" class="ui" style="font-size:1.15rem;margin:1.8rem 0 .6rem">{T.hall.collections}</h2>
        <ul class="coll-list">
          {collections.map(([inst, n]) => (
            <li><span>{inst}</span><span class="ui" style="color:var(--muted)">{n}</span></li>
          ))}
        </ul>
      </section>
    )}
    {wing === "objects" && <h2 class="ui" style="font-size:1.15rem;margin:1.8rem 0 0">{T.hall.index}</h2>}
    {wing !== "place" && items.some((n) => formatDate(n.data.born ?? n.data.date?.start ?? n.data.start, lang).derived) && <p class="ui muted" style="font-size:.85rem;margin:1.2rem 0 0">{T.entity.dagger}</p>}
    {/* One pattern for every hall (site/src/lib/halls.ts): what the wing promises first, then the full index by pages. */}
    {wing !== "place" && promised.length > 0 && (
      <section aria-labelledby="hall-promise">
        <h2 id="hall-promise" class="ui" style="font-size:1.15rem;margin:1.8rem 0 .6rem">{T.hall.promise[wing]}</h2>
        <ul class="grid-cards">{promised.map((n) => <li><HallCard lang={lang} node={n} wing={wing} heading="h3" /></li>)}</ul>
      </section>
    )}
    {wing !== "place" && cornerstones.length > 0 && (
      <section aria-labelledby="hall-lead">
        <h2 id="hall-lead" class="ui" style="font-size:1.15rem;margin:1.8rem 0 .6rem">{T.hall.lead_title}</h2>
        <ul class="grid-cards">{cornerstones.map((n) => <li><HallCard lang={lang} node={n} wing={wing} heading="h3" /></li>)}</ul>
      </section>
    )}
    {wing !== "place" && items.length > 0 && (
      <section aria-labelledby="hall-index">
        <h2 id="hall-index" class="ui" style="font-size:1.15rem;margin:1.8rem 0 .3rem">{T.hall.index_title} <span class="muted" style="font-weight:400">· {fmt(T.hall.index_count, { n: num(indexed, lang) })}</span></h2>
        <p class="muted ui" style="max-width:var(--measure);margin:0 0 .8rem">{wing === "time" ? T.hall.index_note_time : T.hall.index_note}</p>
        {items.some((n) => n.data.status?.review === "draft" && n.class !== "passage") && <DraftMark lang={lang} legend />}
        <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
          <label for="hall-filter">{T.hall.filter_label}</label>
          <input id="hall-filter" type="search" autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
        </p>
        <FullFilter lang={lang} slug={`hall-${wing}`} />
        {wing === "time" && (
          <form class="ui" data-year-jump data-base={`/${lang}/time/all/`} data-groups={groups.map((g) => g.id).join(" ")} data-t-invalid={T.hall.year_invalid} data-t-none={T.hall.year_none}
            style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem" action={`/${lang}/time/`}>
            <label for="year-jump">{T.hall.year_label}</label>
            <input id="year-jump" name="year" type="number" min="1" max="2100" inputmode="numeric" required style="font:inherit;min-height:44px;width:7em;padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
            <select name="era" aria-label={T.hall.year_era} style="font:inherit;min-height:44px;padding:6px 8px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)">
              <option value="ah">{T.hall.year_ah}</option>
              <option value="ce">{T.hall.year_ce}</option>
            </select>
            <button type="submit" class="chip" style="min-height:44px;border:1px solid var(--gold)">{T.hall.year_go}</button>
            <span role="alert" data-year-msg hidden style="flex-basis:100%;color:var(--gold)"></span>
          </form>
        )}
        <nav aria-label={T.hall.index_title} class="ui">
          <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
            {groups.map((g) => <li><a class="chip" href={hallIndexHref(lang, WING_PATH[wing], g.id)}>{groupLabel(g)} · {num(g.items.length, lang)}</a></li>)}
          </ul>
        </nav>
      </section>
    )}

  </div>
  {wing === "time" && <script is:inline src="/shell/year-jump.js" defer></script>}
  {wing !== "place" && <ExploreBar lang={lang} />}
</BaseLayout>
