---
// Hijri calendar app (docs/plan/06 Phase 2): a browsable Hijri month with the
// Gregorian twin of every day, the year's observances linked to their museum
// pages, a two-way converter and an .ics download. Conversion runs in the
// browser through the same tested functions as scripts/hijri/convert.ts
// (Umm al-Qura 1318–1500 AH, tabular otherwise). The HTML is a function of the
// commit, not the clock (docs/site/README.md): it shows the month of the built
// commit's day, and hijri-calendar.ts moves the "today" line, the highlight and
// the displayed month to the viewer's own day on load. Without JavaScript that
// month, its date line and the observance list stay readable.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { href } from "../../../lib/graph";
import { hijriToCivil, fmt } from "../../../../../scripts/hijri/convert";
import { OBS, obsFor, hijriJDN, monthLen, gregDay, wdOf, buildDay, buildHijri, staticYears, monthHref, yearHref, prevMonth, nextMonth } from "../../../lib/hijri-cal";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const C = T.calendar;

// month arithmetic, the observances and the built commit's day are shared with the static month pages (site/src/lib/hijri-cal.ts)
const today = buildDay;
const todayH = buildHijri;

// static grid for the current Hijri month (the no-JS view)
const cur = { y: todayH.date.y, m: todayH.date.m };
const curLen = monthLen(cur.y, cur.m);
const curStart = wdOf(hijriJDN(cur.y, cur.m, 1));
const curObs = OBS.filter((o) => o.m === cur.m);

const payload = {
  months: C.months, weekdays: C.weekday_names,
  obs: OBS.map((o) => ({ ...o, label: C.obs[o.key], href: o.link ? href(lang, o.link) : undefined })),
  t: { prev: C.prev_month, next: C.next_month, today: C.today, is_today: C.is_today, approx: C.approx, umalqura: C.umalqura, observances: C.observances, obs_none: C.obs_none, jump: C.jump },
};
---
<BaseLayout lang={lang} title={C.title} description={C.lede} path={`/${lang}/calendar/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <div data-pagefind-body>
      <h1>{C.title}</h1>
      <p style="font-size:1.15rem;max-width:var(--measure)">{C.lede}</p>
    </div>

    <section class="cal panel" data-cal aria-label={C.title} style="max-width:var(--measure)">
      <div class="cal-head no-print">
        <button type="button" class="cal-nav" data-prev aria-label={C.prev_month}>‹</button>
        <h2 class="cal-title" data-title>{C.months[cur.m - 1]} {cur.y}</h2>
        <button type="button" class="cal-nav" data-next aria-label={C.next_month}>›</button>
      </div>
      <p class="ui muted cal-range" data-range>{gregDay(cur.y, cur.m, 1)} — {gregDay(cur.y, cur.m, curLen)}{todayH.method === "umalqura" ? ` · ${C.umalqura}` : ` · ${C.approx}`}</p>
      <div class="cal-grid" data-grid>
        {C.weekday_names.map((w: string) => <span class="cal-wd ui">{w}</span>)}
        {Array.from({ length: curStart }, () => <span class="cal-blank" aria-hidden="true" />)}
        {Array.from({ length: curLen }, (_, k) => {
          const d = k + 1;
          const obs = obsFor(cur.m, d);
          const isToday = d === todayH.date.d && cur.y === todayH.date.y && cur.m === todayH.date.m;
          return (
            <button type="button" class:list={["cal-day", { "cal-today": isToday, "cal-marked": obs.length > 0 }]} data-day={d} title={obs.map((o) => C.obs[o.key]).join(" · ")}>
              <span class="cal-h">{d}</span>
              <span class="cal-g">{(() => { const c = hijriToCivil({ y: cur.y, m: cur.m, d }); return c.calendar === "gregorian" ? `${c.date.d}/${c.date.m}` : ""; })()}</span>
            </button>
          );
        })}
      </div>
      <p class="ui cal-detail" data-detail>{C.is_today} {todayH.date.d} {C.months[todayH.date.m - 1]} {todayH.date.y} = {fmt(today)}</p>
      <div class="cal-obs" data-obslist>
        {curObs.length > 0 ? curObs.map((o) => (
          o.link ? <a class="chip" href={href(lang, o.link)}>{C.obs[o.key]} · {o.days.length > 1 ? `${o.days[0]}–${o.days[o.days.length - 1]}` : o.days[0]}</a>
                 : <span class="chip">{C.obs[o.key]} · {o.days.length > 1 ? `${o.days[0]}–${o.days[o.days.length - 1]}` : o.days[0]}</span>
        )) : <p class="ui muted">{C.obs_none}</p>}
      </div>
      <div class="cal-tools no-print">
        <button type="button" class="chip" data-today>{C.today}</button>
        <button type="button" class="chip" data-ics>{C.download_ics}</button>
        <span class="cal-jump ui">
          <input type="number" data-jy min="1" max="2000" value={cur.y} style="width:5.5em" aria-label="Hijri year" />
          <select data-jm aria-label="Hijri month">{C.months.map((mn: string, i: number) => <option value={i + 1} selected={i + 1 === cur.m}>{mn}</option>)}</select>
          <button type="button" class="chip" data-jump>{C.jump}</button>
        </span>
        <span class="cal-conv ui">
          <label>{C.convert_to_hijri} <input type="date" data-conv /></label>
          <span data-convout class="cal-convout"></span>
        </span>
      </div>
      <script type="application/json" set:html={JSON.stringify(payload)} />
    </section>
    {/* audit S28: every month has an address. These are plain links, so the months are reachable without JavaScript. */}
    <nav class="ui" aria-label={C.months_index} style="max-width:var(--measure);margin:1rem 0">
      <p style="display:flex;flex-wrap:wrap;gap:8px 12px;margin:0 0 .6rem">
        <a class="chip" rel="prev" href={monthHref(lang, ...prevMonth(cur.y, cur.m))}>‹ {C.prev_month}</a>
        <a class="chip" href={monthHref(lang, cur.y, cur.m)}>{C.months[cur.m - 1]} {cur.y}</a>
        <a class="chip" rel="next" href={monthHref(lang, ...nextMonth(cur.y, cur.m))}>{C.next_month} ›</a>
        <a class="chip" href={yearHref(lang, cur.y)}>{C.months_of.replace("{year}", String(cur.y))}</a>
      </p>
      <h2 style="font-size:1rem;margin:.8rem 0 .4rem">{C.months_index}</h2>
      <p class="muted" style="font-size:.9rem;margin:0 0 .5rem">{C.static_note.replace("{from}", String(staticYears[0])).replace("{to}", String(staticYears[staticYears.length - 1]))}</p>
      <p style="display:flex;flex-wrap:wrap;gap:6px;margin:0">{staticYears.map((y) => <a class="chip" href={yearHref(lang, y)} aria-current={y === cur.y ? "true" : undefined}>{y}</a>)}</p>
    </nav>
    <script src="../../../scripts/hijri-calendar.ts"></script>
  </div>
  <style>
    /* The month grid is redrawn in the browser (hijri-calendar.ts), so the day-cell rules use :global:
       a scoped rule never matches the new buttons. */
    .cal { padding: 18px; max-width: 100%; box-sizing: border-box; }
    .cal-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .cal-title { margin: 0; font-size: 1.2rem; }
    .cal-nav { font-size: 1.4rem; background: var(--bg); color: var(--fg); border: 1px solid var(--gold); border-radius: 50%; width: 40px; height: 40px; cursor: pointer; line-height: 1; }
    .cal-range { font-size: .85rem; margin: 4px 0 10px; }
    .cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
    .cal-grid :global(.cal-wd) { text-align: center; font-size: .75rem; color: var(--muted); padding: 4px 0; min-width: 0; }
    .cal-grid :global(.cal-blank) { min-height: 2.8em; min-width: 0; }
    .cal-grid :global(.cal-day) { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; min-height: 2.8em; overflow: hidden; border: 1px solid color-mix(in srgb, var(--gold) 20%, transparent); border-radius: 8px; background: var(--bg); color: var(--fg); cursor: pointer; padding: 2px; line-height: 1.15; }
    .cal-grid :global(.cal-day:hover) { border-color: var(--gold); }
    .cal-grid :global(.cal-h) { font-weight: 700; font-size: 1rem; }
    .cal-grid :global(.cal-g) { font-size: .65rem; color: var(--muted); font-family: var(--sans); white-space: nowrap; }
    .cal-grid :global(.cal-today) { border-color: var(--gold); border-width: 2px; background: color-mix(in srgb, var(--gold) 12%, var(--bg)); }
    .cal-grid :global(.cal-marked) { border-bottom: 3px solid var(--gold); }
    .cal-detail { margin: 12px 0 6px; font-size: .95rem; }
    .cal-obs { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 12px; }
    .cal-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; border-top: 1px solid color-mix(in srgb, var(--gold) 30%, transparent); padding-top: 12px; font-size: .9rem; }
    .cal-jump, .cal-conv { display: inline-flex; align-items: center; gap: 6px; }
    .cal-convout { font-weight: 700; }
    .cal-grid :global(button.cal-day[hidden]) { display: none; }
    @media (max-width: 480px) {
      /* The phone rule gives every button a 44px minimum; seven such cells are wider than a 375px screen. */
      .cal { padding: 10px; }
      .cal-grid { gap: 2px; }
      .cal-grid :global(.cal-day) { min-width: 0; min-height: 2.6em; padding: 1px; }
      .cal-grid :global(.cal-h) { font-size: .9rem; }
      .cal-grid :global(.cal-g) { font-size: .6rem; }
    }
  </style>
</BaseLayout>
