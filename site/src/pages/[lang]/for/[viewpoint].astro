---
// One of nine viewpoints (founder request, 23 and 24 November 2026; docs/site/viewpoints.md), or a small redirect page for one of
// the five earlier persona URLs (/for/convert/ and so on). Same records, a different door. No script is needed to read it;
// /shell/viewpoint.js only remembers the choice on this device.
import Door from "../../../components/Door.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { SITE } from "../../../lib/graph";
import { VIEWPOINTS, OLD_ALIASES, ICON, STEPS, BLOCK, CARD_LINK, viewpointPath, linkPath, accentStyle, quote, type Viewpoint } from "../../../lib/viewpoints";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    ...VIEWPOINTS.map((v) => ({ params: { lang, viewpoint: v }, props: { lang, viewpoint: v as string, alias: false } })),
    ...Object.entries(OLD_ALIASES).map(([old, v]) => ({ params: { lang, viewpoint: old }, props: { lang, viewpoint: v as string, alias: true } })),
  ]);
}
const { lang, viewpoint, alias } = Astro.props as { lang: Lang; viewpoint: Viewpoint; alias: boolean };
const T = ui(lang);
const P = T.viewpoints;
const V = P[viewpoint];
const target = viewpointPath(lang, viewpoint);
const steps = STEPS[viewpoint];
if (V.steps.length !== steps.length) throw new Error(`viewpoints.${viewpoint}.steps has ${V.steps.length} entries in ${lang}, expected ${steps.length}`);
const kind = BLOCK[viewpoint];
const cardLinks = CARD_LINK[viewpoint] ?? {};
const dir = lang === "ar" || lang === "ur" ? "rtl" : "ltr";
---
{alias ? (
  <html lang={lang} dir={dir}>
    <head>
      <meta charset="utf-8" />
      <title>{V.name} · islam.museum</title>
      <meta name="viewport" content="width=device-width,initial-scale=1" />
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={`${SITE}${target}`} />
      <meta http-equiv="refresh" content={`0; url=${target}`} />
    </head>
    <body><p><a href={target}>{V.name}</a></p></body>
  </html>
) : (
<BaseLayout lang={lang} title={V.name} description={V.line} path={target}>
  <div class="vpage" style={accentStyle(viewpoint)} data-viewpoint={viewpoint} data-vp-keys={VIEWPOINTS.join(",")}>
    <div class="vcrumb"><div class="wrap">
      <nav aria-label={T.entity.breadcrumb}><p class="crumbs ui"><a href={`/${lang}/`}>{P.home}</a> <span aria-hidden="true">›</span> <a href={`/${lang}/#viewpoints`}>{P.nav_label}</a> <span aria-hidden="true">›</span> <span aria-current="page">{V.name}</span></p></nav>
      <p class="vsw ui"><span hidden data-vp={viewpoint} data-name={V.name}></span><a href={`/${lang}/#viewpoints`}>{P.switch_title}</a> · <span data-vp-status data-tpl={P.your} hidden><span data-vp-text></span> · <button type="button" data-vp-reset>{P.reset}</button></span></p>
    </div></div>
    <header class="v-hero">
      <div class="wrap v-entry">
        <div class="v-door"><Door v={viewpoint} open /></div>
        <div>
          <p class="v-eyebrow ui">{P.eyebrow}: {V.name}</p>
          <h1 class="v-title">{V.h}</h1>
          <p class="v-lede">{quote(lang, V.line)}</p>
          <p><a class="v-cta ui" href="#path">{P.start} <span class="flip" aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </header>

    <main class="wrap v-main" data-pagefind-body>
      <section class="v-blk" aria-labelledby="th-t">
        <h2 id="th-t">{P.thoughts_title}</h2>
        <p class="v-sub ui">{P.thoughts_sub}</p>
        <ul class="v-thoughts">{V.thoughts.map((t: string) => <li><q>{t}</q></li>)}</ul>
      </section>

      <section class="v-blk" id="path" aria-labelledby="path-t">
        <h2 id="path-t">{P.path_title}</h2>
        <p class="v-sub ui">{P.path_sub}</p>
        <ol class="v-steps">
          {steps.map(([key, min], i) => (
            <li>
              <a href={linkPath(lang, key)}>{P.links[key]}</a>
              <small class="ui">{V.steps[i]}</small>
              <span class="v-min ui">{min} {P.minutes}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="v-blk" aria-labelledby="sig-t">
        <h2 id="sig-t">{V.block_title}</h2>
        <p class="v-sub ui">{V.block_sub}</p>
        {kind === "timeline" && (
          <ul class="v-tl">{V.items.map((it: any) => <li><b class="ui">{it.t}</b>{it.x}</li>)}</ul>
        )}
        {kind === "cards" && (
          <div class="v-grid">{V.items.map((it: any, i: number) => (
            <div class="v-card"><h3>{it.t}</h3><p>{it.x}</p>{cardLinks[i] && <p class="ui"><a href={linkPath(lang, cardLinks[i])}>{P.links[cardLinks[i]]} <span class="flip" aria-hidden="true">→</span></a></p>}</div>
          ))}</div>
        )}
        {kind === "voices" && V.items.map((it: any) => (
          <div class="v-card v-q"><p class="v-qt">{it.q}</p>
            <div class="v-voices"><div class="v-voice"><small class="ui">{it.al}</small>{it.a}</div><div class="v-voice"><small class="ui">{it.bl}</small>{it.b}</div></div>
          </div>
        ))}
      </section>

      <aside class="v-about" aria-labelledby="ab-t">
        <h2 id="ab-t">{P.about_title}</h2>
        <p>{P.about}</p>
      </aside>
    </main>

    <nav class="v-switch wrap" aria-labelledby="sw-t" data-pagefind-ignore>
      <h2 id="sw-t">{P.switch_title}</h2>
      <ul>
        {VIEWPOINTS.map((k) => (
          <li><a class="v-pill" style={accentStyle(k)} href={viewpointPath(lang, k)} aria-current={k === viewpoint ? "page" : undefined}>{P[k].name}</a></li>
        ))}
      </ul>
      <p class="ui"><a href={`/${lang}/`}>{P.home}</a></p>
    </nav>
    <script is:inline src="/shell/viewpoint.js" defer></script>
  </div>
</BaseLayout>
)}
<style>
  .vpage { --vp: var(--a); --vt: var(--t); --on: #fff; --wall: #efe6d3; --door-line: #b9a37a; background: var(--bg); color: var(--fg); }
  .vcrumb .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-block: 6px; }
  .vcrumb p { margin: 0; font-size: .88rem; }
  .vcrumb .crumbs span[aria-hidden] { margin-inline: .45em; }
  .vsw button { background: none; border: 0; padding: 0; min-height: 24px; font: inherit; color: var(--link, inherit); text-decoration: underline; cursor: pointer; }
  .v-hero { border-bottom: 6px solid var(--vp); padding: clamp(20px, 4vh, 40px) 0 clamp(24px, 5vh, 44px); }
  .v-entry { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); gap: clamp(20px, 5vw, 56px); align-items: center; }
  @media (max-width: 620px) { .v-entry { grid-template-columns: 1fr; } .v-door { max-width: 7rem; } }
  .v-eyebrow { margin: 0 0 .5rem; font-size: .95rem; color: var(--muted); }
  .v-title { font-size: clamp(1.9rem, 4.4vw, 2.9rem); font-weight: 400; line-height: 1.2; max-width: 22ch; margin: 0 0 .8rem; }
  .v-lede { font-size: 1.15rem; max-width: 46ch; margin: 0 0 1.1rem; }
  .v-cta { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: 0 20px; border-radius: 999px; background: var(--vp); color: var(--on); font-weight: 600; text-decoration: none; }
  .v-cta:hover { filter: brightness(1.08); }
  .v-main { padding-block: 1rem 2rem; }
  .v-blk { margin-block: 2rem; }
  .v-blk h2, .v-about h2, .v-switch h2 { font-size: 1.45rem; margin: 0 0 .3rem; }
  .v-sub { margin: 0 0 1rem; font-size: .92rem; color: var(--muted); }
  .v-thoughts { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .v-thoughts li { border-inline-start: 3px solid var(--vp); padding-inline-start: 16px; font-size: 1.15rem; }
  .v-thoughts q { quotes: none; }
  .v-steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; gap: 4px; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); }
  .v-steps li { counter-increment: s; display: flex; flex-direction: column; gap: 4px; background: var(--wall); border-bottom: 5px solid var(--vp); padding: 14px 16px; min-width: 0; }
  .v-steps li::before { content: counter(s); font-size: 1.6rem; font-weight: 600; line-height: 1.2; }
  .v-steps a { font-weight: 700; color: var(--fg); text-decoration: none; min-height: 24px; }
  .v-steps a:hover { text-decoration: underline; }
  .v-steps small { color: var(--muted); font-size: .88rem; line-height: 1.45; }
  .v-min { margin-top: auto; padding-top: 6px; font-size: .82rem; color: var(--muted); }
  .v-tl { list-style: none; margin: 0; padding: 0; border-inline-start: 3px solid var(--vp); display: grid; gap: 14px; }
  .v-tl li { position: relative; padding-inline-start: 18px; }
  .v-tl li::before { content: ""; position: absolute; inset-inline-start: -9px; top: .5em; width: 15px; height: 15px; border-radius: 50%; background: var(--bg); border: 3px solid var(--vp); box-sizing: border-box; }
  .v-tl b { display: block; font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; color: var(--vp); }
  .v-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .v-card { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 16px 18px; min-width: 0; }
  .v-card h3 { font-size: 1.05rem; margin: 0 0 4px; }
  .v-card p { margin: 0 0 .4rem; color: var(--muted); }
  .v-q { margin-bottom: 12px; }
  .v-qt { font-weight: 600; color: var(--fg) !important; }
  .v-voices { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .v-voice { border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; font-size: .95rem; }
  .v-voice small { display: block; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--vp); margin-bottom: 4px; font-weight: 600; }
  .v-about { background: var(--vt); border-radius: 8px; padding: 1.1rem 1.3rem; margin-block: 2rem 1rem; line-height: 1.65; }
  .v-switch { padding-block: 1rem 3rem; }
  .v-switch ul { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .v-pill { display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box; padding: .5rem 1.1rem; border-radius: 999px; background: var(--a); color: #fff; font-family: var(--sans); font-weight: 600; text-decoration: none; }
  .v-pill[aria-current="page"] { outline: 3px solid var(--fg); outline-offset: 2px; }
  .v-pill:focus-visible, .v-cta:focus-visible, .v-steps a:focus-visible { outline: 3px solid #c5a059; outline-offset: 3px; }
  @media (max-width: 620px) { .v-voices { grid-template-columns: 1fr; } }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .vpage { --vp: var(--ad); --vt: var(--td); --on: #0a2533; --wall: #113f4e; --door-line: #6b8f98; }
    :global(:root:not([data-theme="light"])) .v-pill { background: var(--ad); color: #0a2533; }
  }
  :global(:root[data-theme="dark"]) .vpage { --vp: var(--ad); --vt: var(--td); --on: #0a2533; --wall: #113f4e; --door-line: #6b8f98; }
  :global(:root[data-theme="dark"]) .v-pill { background: var(--ad); color: #0a2533; }
  @media (forced-colors: active) { .v-card, .v-steps li, .v-thoughts li, .v-pill, .v-voice { border: 1px solid CanvasText; } }
</style>
