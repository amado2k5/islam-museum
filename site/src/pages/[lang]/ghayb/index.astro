---
// The Ghayb Browser's home (docs/plan/33-ghayb-browser.md): the museum's records on the unseen —
// jinn and angels, the soul, the measures of time, the Night Journey, the greatest creations, the
// barzakh and the signs of the Hour — grouped in seven sections over the one graph. Counts are read
// from the graph at build time and appear on this page only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { href, labelOf } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { ghaybItems, GHAYB_SECTIONS, ghaybSignItems, GHAYB_SIGNS_ORDER } from "../../../lib/ghayb";
import { realNodes } from "../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).ghayb;
const label = (n: any) => labelOf(n, lang);
const summaryOf = (n: any) => n.data.summary?.[lang] ?? n.data.summary?.ar ?? "";
const sectionIds = [...GHAYB_SECTIONS, ...new Set(ghaybItems.map((i) => i.section).filter((s) => !GHAYB_SECTIONS.includes(s)))];
const sections = sectionIds.map((id) => ({ id, items: ghaybItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const status = fmt(G.status, { n: num(ghaybItems.length, lang), s: num(sections.length, lang) });
const mirajJourney = realNodes.find((n) => n.id === "journey/isra-and-miraj-route");
const mirajWaypoints = (mirajJourney?.data.waypoints ?? []) as { title?: { ar?: string; en?: string; ur?: string }; place?: string }[];
const mirajHeavens = ["concept/al-samawat-al-sab","concept/sidrat-al-muntaha","concept/bayt-al-mamur"].map((id) => realNodes.find((n) => n.id === id)).filter(Boolean);
const searchText = (i: (typeof ghaybItems)[number]) =>
  [i.node.label.ar, i.node.label.en, i.node.label.ur, summaryOf(i.node)].filter(Boolean).join(" ");
---
<BaseLayout lang={lang} title={G.title} description={G.lede} path={`/${lang}/ghayb/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{G.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body>
      <h1>{G.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{G.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/ghayb.json"><bdi dir="ltr">/api/v1/ghayb.json</bdi></a></p>
    </div>

    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="ghayb-filter">{G.filter_label}</label>
        <input id="ghayb-filter" type="search" data-ghayb-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <div data-pagefind-ignore>
        {sections.map((s) => (
          <section data-ghayb-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-ghayb-row data-search={searchText(i)} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a>
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem">{summaryOf(i.node)}</p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
      <p class="panel ui" data-ghayb-none hidden>{G.filter_none}</p>
      {ghaybItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>

    {G.miraj_title && (
      <section aria-labelledby="miraj-title" data-pagefind-ignore style="margin-top:2.2rem">
        <h2 id="miraj-title">{G.miraj_title}</h2>
        <p class="muted" style="max-width:var(--measure)">{G.miraj_desc}</p>
        <ol role="list" style="list-style:none;padding:0;margin:1rem 0;border-inline-start:3px solid #8e5aa8;padding-inline-start:1rem;display:grid;gap:10px;max-width:var(--measure)">
          {mirajWaypoints.map((w: any) => <li class="panel" style="padding:10px 14px">{w.title?.[lang] ?? w.title?.ar ?? w.place}</li>)}
          {mirajHeavens.map((n: any) => n && <li class="panel" style="padding:10px 14px"><a href={href(lang, n.id)}>{labelOf(n, lang)}</a></li>)}
        </ol>
      </section>
    )}

    {G.signs_title && ghaybSignItems.length > 0 && (
      <section aria-labelledby="signs-title" data-pagefind-ignore style="margin-top:2.2rem">
        <h2 id="signs-title">{G.signs_title}</h2>
        <p class="muted" style="max-width:var(--measure)">{G.signs_desc}</p>
        <ol style="max-width:var(--measure);display:grid;gap:8px">
          {GHAYB_SIGNS_ORDER.map((slug) => {
            const n = realNodes.find((x) => x.id === `concept/${slug}`);
            return n ? <li class="panel" style="padding:10px 14px"><a href={href(lang, n.id)}>{labelOf(n, lang)}</a></li> : null;
          })}
        </ol>
      </section>
    )}
  </div>
  <script src="../../../scripts/ghayb-filter.ts"></script>
</BaseLayout>
