---
// The Islamic Economy Browser's home (docs/plan/47-islamic-economy-browser.md): every
// mention of money and Islamic economics, deeds/instruments/covenants, and endowments —
// the «متصفح العملات والصكوك والوقف الإسلامي» — in the Qur'an, the Sunnah, the seerah,
// every harvested book and every book harvested later, plus the curated records, over
// the one graph. Passages are found at build time by the shared detector in
// scripts/islamic-economy.ts; curated records join through the `islamic-economy-browser`
// tag. Counts are read from the graph at build time and appear on this page only.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, LANGS, fmt, type Lang } from "../../../lib/i18n";
import { byId, href, labelOf, stripNeedsSource } from "../../../lib/graph";
import { num } from "../../../lib/nav";
import { ieItems, IE_SECTIONS, IE_TOPICS, type IeSection, type IeTopic } from "../../../lib/islamic-economy";
import type { Node } from "../../../../scripts/build-graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const G = (T as any).islamic_economy;
const label = (n: Node) => labelOf(n, lang);
const summaryText = (n: Node) => stripNeedsSource(n.summary?.[lang] ?? n.summary?.ar ?? n.summary?.en ?? "");
const EXCERPT = 220;
const excerptOf = (n: Node) => {
  const raw = n.class === "passage" ? String(n.data.text_search ?? n.data.text ?? "") : summaryText(n);
  const clean = stripNeedsSource(raw).replace(/\s+/g, " ").trim();
  return clean.length > EXCERPT ? `${clean.slice(0, EXCERPT)}…` : clean;
};
const workLabel = (n: Node) => (n.data.work ? labelOf(byId.get(n.data.work as string) ?? n, lang) : "");
const refOf = (n: Node) => {
  if (n.data.sura && n.data.aya) return `${n.data.sura}:${n.data.aya}`;
  return n.data.ref ? String(n.data.ref) : (n.data.unit ? String(n.data.unit) : "");
};
const topicLabel = (t: IeTopic) => G.topics?.[t];
const sectionIds: IeSection[] = [...IE_SECTIONS];
const topicIds: IeTopic[] = [...IE_TOPICS];
const sections = sectionIds.map((id) => ({ id, items: ieItems.filter((i) => i.section === id) })).filter((s) => s.items.length > 0);
const topicCounts = topicIds.map((t) => ({ id: t, n: ieItems.filter((i) => i.topics.includes(t)).length })).filter((t) => t.n > 0);
const status = fmt(G.status, { n: num(ieItems.length, lang), s: num(sections.length, lang) });
const searchText = (i: (typeof ieItems)[number]) =>
  [
    i.node.label.ar, i.node.label.en, i.node.label.ur,
    summaryText(i.node), excerptOf(i.node), workLabel(i.node),
    ...i.topics.map((t) => topicLabel(t) ?? t),
  ].filter(Boolean).join(" ");
---
<BaseLayout lang={lang} title={G.title} description={G.lede} path={`/${lang}/islamic-economy/`}>
  <div class="wrap" style="padding-block:10px 20px">
    <p class="ui" style="display:inline-flex;align-items:center;gap:10px;background:var(--panel);border-radius:999px;padding:8px 16px;margin:0 0 1rem"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--gold)"></span>{G.badge}</p>
    <nav class="ui muted" aria-label={T.entity.breadcrumb} style="margin:0 0 .6rem"><a href={`/${lang}/`}>{T.entity.breadcrumb}</a> › {G.title}</nav>
    <div data-pagefind-body>
      <h1>{G.title}</h1>
      <p style="font-size:1.2rem;max-width:var(--measure)">{G.lede}</p>
      <p class="panel ui" style="max-width:var(--measure);border:1px solid var(--gold)">{status}</p>
      <h2 id="method-title" style="font-size:1.1rem">{G.method_title}</h2>
      <p class="muted" style="max-width:var(--measure)">{G.method_note}</p>
      <p class="ui muted">{G.api} <a href="/api/v1/islamic-economy.json"><bdi dir="ltr">/api/v1/islamic-economy.json</bdi></a></p>
    </div>

    <section aria-labelledby="sections-title" style="margin-top:2rem">
      <h2 id="sections-title">{G.sections_title}</h2>
      <nav aria-label={G.sections_title} class="ui" style="margin:0 0 1rem">
        <ul style="display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none">
          {sections.map((s) => <li><a class="chip" href={`#t-${s.id}`}>{G.sections[s.id]?.title ?? s.id} · {num(s.items.length, lang)}</a></li>)}
        </ul>
      </nav>
      <h2 id="topics-title" style="font-size:1.1rem">{G.topics_title}</h2>
      <p class="ui" style="display:flex;flex-wrap:wrap;gap:6px;margin:0 0 1rem">
        {topicCounts.map((t) => (
          <button type="button" class="chip" data-ie-topic={t.id} aria-pressed="false" style="cursor:pointer;font:inherit">{topicLabel(t.id)} · {num(t.n, lang)}</button>
        ))}
      </p>
      <p class="ui" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 1rem">
        <label for="ie-filter">{G.filter_label}</label>
        <input id="ie-filter" type="search" data-ie-filter autocomplete="off" style="font:inherit;min-height:44px;min-width:min(100%,260px);padding:6px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)" />
      </p>
      <div data-pagefind-ignore>
        {sections.map((s) => (
          <section data-ie-section aria-labelledby={`t-${s.id}`} style="margin:1.4rem 0">
            <h3 id={`t-${s.id}`} style="font-size:1.1rem;margin:0 0 .2rem">{G.sections[s.id]?.title ?? s.id}</h3>
            <p class="muted" style="max-width:var(--measure);margin:0 0 .6rem">{G.sections[s.id]?.desc}</p>
            <ol role="list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">
              {s.items.map((i) => (
                <li data-ie-row data-topics={i.topics.join(" ")} data-search={searchText(i)} class="panel" style="padding:14px 16px">
                  <a href={href(lang, i.node.id)} style="font-weight:600">{label(i.node)}</a>
                  {i.node.class === "passage" && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem" dir="auto">
                      {workLabel(i.node)}{refOf(i.node) ? <bdi> · {refOf(i.node)}</bdi> : null}
                      {i.topics.map((t) => <span class="chip" style="font-size:.75rem;padding:1px 8px;margin-inline-start:4px">{topicLabel(t)}</span>)}
                    </p>
                  )}
                  {i.node.class !== "passage" && i.topics.length > 0 && (
                    <p class="ui muted" style="margin:.15rem 0 0;font-size:.82rem">
                      {i.topics.map((t) => <span class="chip" style="font-size:.75rem;padding:1px 8px;margin-inline-start:4px">{topicLabel(t)}</span>)}
                    </p>
                  )}
                  <p class="muted" style="margin:.3rem 0 0;font-size:.92rem" dir="auto">{excerptOf(i.node)}</p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
      <p class="panel ui" data-ie-none hidden>{G.filter_none}</p>
      {ieItems.length === 0 && <p class="panel ui">{G.empty}</p>}
    </section>
  </div>
  <script src="../../../scripts/ie-filter.ts"></script>
</BaseLayout>
