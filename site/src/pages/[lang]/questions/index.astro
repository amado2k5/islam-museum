---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ExploreBar from "../../../components/ExploreBar.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { href, labelLang, labelOf, realNodes, summaryLang, summaryOf } from "../../../lib/graph";
import LangSpan from "../../../components/LangSpan.astro";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const items = realNodes.filter((n) => n.class === "question");
---
<BaseLayout lang={lang} title={T.questions.title} description={T.questions.lede} path={`/${lang}/questions/`}>
  <PageHeader title={T.questions.title} lede={T.questions.lede} crumbs={[{ label: T.entity.breadcrumb, href: `/${lang}/` }, { label: T.questions.title }]} crumbsLabel={T.entity.breadcrumb} />
  <div class="wrap" style="padding-block:24px 20px" data-pagefind-ignore>
    {items.length === 0 ? <p class="panel ui">{T.questions.empty}</p> : (
      <ul class="grid-cards">{items.map((n) => <li><a class="card" href={href(lang, n.id)}><h2 class="card-title"><LangSpan text={labelOf(n, lang)} source={labelLang(n, lang)} page={lang} /></h2><span><LangSpan text={summaryOf(n, lang)} source={summaryLang(n, lang)} page={lang} /></span></a></li>)}</ul>
    )}
  </div>
  <ExploreBar lang={lang} />
</BaseLayout>
