---
// Seasonal packs index (docs/delegation/education-master-plan.md §5 E3, step 4): the four dated packs.
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { ui, LANGS, type Lang } from "../../../../../lib/i18n";
import { loadPacks, viewPack } from "../../../../../lib/packs";
import "../../../../../styles/edu.css";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const E = ui(lang).edu;
const path = `/${lang}/learn/teachers/packs/`;
const packs = loadPacks().map((p) => viewPack(p, lang));
---
<BaseLayout lang={lang} title={E.pk_title} description={E.pk_desc} path={path}>
  <div class="wrap edu" style="padding-block:10px 24px">
    <nav class="ui muted no-print" aria-label="breadcrumb"><a href={`/${lang}/learn/`}>{E.title}</a> › <a href={`/${lang}/learn/teachers/`}>{E.teachers_title}</a> › {E.pk_title}</nav>
    <h1>{E.pk_title}</h1>
    <p style="font-size:1.1rem;max-width:var(--measure)">{E.pk_desc}</p>
    <ul class="edu-adult">
      {packs.map((p) => (
        <li><a href={`/${lang}/learn/teachers/packs/${p.id}/`}><span class="ic" aria-hidden="true">🗓</span><span><h2>{p.title}</h2><p>{p.when} — {p.lede}</p></span></a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
