---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LearnPicker from "../../../islands/LearnPicker.svelte";
import { ui, LEARN_LANGS, type Lang } from "../../../lib/i18n";
import { nodes, href, labelOf, summaryOf } from "../../../lib/graph";

export function getStaticPaths() { return LEARN_LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);

const courses = nodes.filter((n) => n.class === "course");
const pickerNodes = courses.map((n) => ({
  id: n.id, kind: n.data?.kind, parent: n.data?.part_of,
  label: labelOf(n, lang), summary: summaryOf(n, lang), grade: n.data?.grade_number, order: n.data?.order,
}));
const subjects = courses.filter((n) => n.data?.kind === "subject");
---
<BaseLayout lang={lang} title={T.learn.title} description={T.learn.lede} path={`/${lang}/learn/`} alternates={Object.fromEntries(LEARN_LANGS.map((l) => [l, `/${l}/learn/`]))}>
  <div class="wrap" style="padding-block:10px 20px">
    <h1>{T.learn.title}</h1>
    <p style="font-size:1.2rem;max-width:var(--measure)">{T.learn.lede}</p>

    <section class="panel" style="margin-block:1.5rem;padding:18px 20px">
      <LearnPicker client:load nodes={pickerNodes} lang={lang} labels={{ country: T.learn.country, grade: T.learn.grade, subject: T.learn.subject, open: T.learn.open }} />
      <noscript><p class="ui">{T.learn.noscript}</p></noscript>
    </section>

    <ul class="grid-cards" style="margin-top:1.5rem">
      {subjects.map((s) => (
        <li><a class="card" href={href(lang, s.id)}><b>{labelOf(s, lang)}</b><span>{summaryOf(s, lang)}</span></a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
