---
// Every dated event on the Hijri timeline, as a plain list (no JavaScript). The timeline itself draws a capped set of
// markers; this page is where the rest are reached.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { ui, LANGS, fmt, type Lang } from "../../../../lib/i18n";
import { num } from "../../../../lib/nav";
import { timelineModel } from "../../../../lib/timeline-model";

// 2,000 events a page, in date order (audit S18: the one page was 863 KB). Page 1 is /timeline/events/, page n /timeline/events/n/.
export function getStaticPaths() {
  return LANGS.flatMap((lang) => Array.from({ length: Math.max(1, Math.ceil(timelineModel(lang).all.length / 2000)) }, (_x, k) => ({ params: { lang, page: k === 0 ? undefined : String(k + 1) }, props: { lang, pageNo: k + 1 } })));
}
const { lang, pageNo } = Astro.props as { lang: Lang; pageNo: number };
const T = ui(lang);
const { all, yearLabel } = timelineModel(lang);
const events = [...all].sort((a, b) => a.y - b.y);
const PER = 2000; // repeated in getStaticPaths, which cannot read this scope
const pages = Math.max(1, Math.ceil(events.length / PER));
const url = (n: number) => (n <= 1 ? `/${lang}/timeline/events/` : `/${lang}/timeline/events/${n}/`);
const path = url(pageNo);
const shown = events.slice((pageNo - 1) * PER, pageNo * PER);
const P = (T as any).paged;
---
<BaseLayout lang={lang} title={pageNo > 1 ? `${T.timeline.all_events_title} · ${pageNo}` : T.timeline.all_events_title} description={T.timeline.all_events_lede} path={path}>
  <div class="wrap" style="padding-block:10px 24px">
    <nav class="ui muted no-print" aria-label="breadcrumb"><a href={`/${lang}/`}>{T.timeline.title}</a> › {T.timeline.all_events_title}</nav>
    <h1>{T.timeline.all_events_title}</h1>
    <p style="max-width:var(--measure)">{T.timeline.all_events_lede}</p>
    <ul>
      {shown.map((e) => <li><a href={e.href}>{e.label}</a> <span class="muted">· {yearLabel(Math.floor(e.y), lang)}</span></li>)}
    </ul>
    {pages > 1 && (
      <nav class="ui paged-nav" aria-label={P.nav_label} style="margin:1rem 0;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px">
        <span class="muted">{fmt(P.range, { from: num((pageNo - 1) * PER + 1, lang), to: num((pageNo - 1) * PER + shown.length, lang), total: num(events.length, lang) })}</span>
        {pageNo > 1 ? <a class="chip" rel="prev" href={url(pageNo - 1)}>{P.prev}</a> : null}
        {Array.from({ length: pages }, (_x, k) => k + 1).map((n) => n === pageNo
          ? <span class="chip" aria-current="page" style="border:1px solid var(--gold)">{num(n, lang)}</span>
          : <a class="chip" href={url(n)} aria-label={fmt(P.page_n, { n: num(n, lang) })}>{num(n, lang)}</a>)}
        {pageNo < pages ? <a class="chip" rel="next" href={url(pageNo + 1)}>{P.next}</a> : null}
      </nav>
    )}
  </div>
</BaseLayout>
