---
// Method: how the museum chooses, classifies and refuses — the reader-facing digest of its editorial doctrine.
// Plain prose from i18n, no scripts. The governing documents are linked at the foot; where this page and a document disagree, the document wins.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { REPO } from "../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const M = T.method;
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "holds", title: M.holds_title, body: [M.holds_body] },
  { id: "standard", title: M.standard_title, body: [M.standard_body] },
  { id: "choose", title: M.choose_title, body: [M.choose_1, M.choose_2] },
  { id: "classify", title: M.classify_title, body: [M.classify_1, M.classify_2] },
  { id: "not", title: M.not_title, body: [M.not_body] },
  { id: "ages", title: M.ages_title, body: [M.ages_body] },
  { id: "corrections", title: M.corrections_title, body: [M.corrections_body] },
];
---
<BaseLayout lang={lang} title={M.title} description={M.lede} path={`/${lang}/method/`}>
  <PageHeader title={M.title} lede={M.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: M.title }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated">{M.updated}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
        </section>
      ))}
      <section aria-labelledby="rules-h" class="p-sec">
        <h2 id="rules-h">{M.rules_title}</h2>
        <p class="ui p-links">
          <a href={`/${lang}/authenticity/`}>{T.authenticity.title}</a> ·
          <a href={`/${lang}/coverage/`}>{T.nav.coverage}</a>
        </p>
        <p class="ui p-links">
          <a href={`${REPO}/blob/main/docs/plan/05-editorial.md`} rel="noopener">{M.link_editorial}</a> ·
          <a href={`${REPO}/blob/main/docs/scope.md`} rel="noopener">{M.link_scope}</a> ·
          <a href={`${REPO}/blob/main/docs/sources-policy.md`} rel="noopener">{M.link_sources}</a> ·
          <a href={`${REPO}/blob/main/docs/agents/publication-standard.md`} rel="noopener">{M.link_standard}</a>
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
</style>
