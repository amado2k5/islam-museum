---
// Accessibility statement (EU model format; AODA/ACA feedback process; DPGA indicator 8).
// Plain prose from i18n, no scripts. Every new section ships ar/en/ur in the same commit.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ui, LANGS, type Lang } from "../../../lib/i18n";
import { REPO } from "../../../lib/graph";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Lang };
const T = ui(lang);
const A = T.accessibility;
const sections: { id: string; title: string; body: string[] }[] = [
  { id: "commit", title: A.commit_title, body: [A.commit_body] },
  { id: "status", title: A.status_title, body: [A.status_1, A.status_2] },
  { id: "standards", title: A.standards_title, body: [A.standards_1, A.standards_2, A.standards_3, A.standards_4] },
  { id: "blind", title: A.blind_title, body: [A.blind_1, A.blind_2, A.blind_3, A.blind_4] },
  { id: "vision", title: A.vision_title, body: [A.vision_1, A.vision_2] },
  { id: "deaf", title: A.deaf_title, body: [A.deaf_1, A.deaf_2, A.deaf_3] },
  { id: "speech", title: A.speech_title, body: [A.speech_1] },
  { id: "keyboard", title: A.keyboard_title, body: [A.keyboard_1, A.keyboard_2] },
  { id: "limits", title: A.limits_title, body: [A.limits_1, A.limits_2, A.limits_3] },
  { id: "tech", title: A.tech_title, body: [A.tech_1] },
  { id: "formats", title: A.formats_title, body: [A.formats_body] },
  { id: "law", title: A.law_title, body: [A.law_body] },
  { id: "method", title: A.method_title, body: [A.method_body] },
];
---
<BaseLayout lang={lang} title={A.title} description={A.lede} path={`/${lang}/accessibility/`}>
  <PageHeader title={A.title} lede={A.lede} crumbs={[{ label: T.nav.home, href: `/${lang}/` }, { label: A.title }]} crumbsLabel={T.entity.breadcrumb} />

  <div class="wrap" style="padding-block:40px 20px">
    <article class="reading ui-body">
      <p class="ui muted p-updated">{A.updated}</p>
      {sections.map((s) => (
        <section aria-labelledby={`${s.id}-h`} class="p-sec">
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          {s.body.map((t) => <p>{t}</p>)}
          {s.id === "formats" && <p class="p-links"><a href={`/${lang}/books/`}>{A.formats_books_link}</a></p>}
        </section>
      ))}

      <section aria-labelledby="feedback-h" class="p-sec">
        <h2 id="feedback-h">{A.feedback_title}</h2>
        <p>{A.feedback_1}</p>
        <p>{A.feedback_2}</p>
        <p class="p-links">
          <a href="mailto:discover@islam.museum?subject=Accessibility%20barrier">{A.feedback_cta}</a>
          {" · "}
          <a href={`${REPO}/issues/new?template=accessibility.yml`} rel="noopener">{A.feedback_issue}</a>
        </p>
      </section>

      <section aria-labelledby="more-h" class="p-sec">
        <h2 id="more-h">{A.more_title}</h2>
        <p>{A.more_body}</p>
        <p class="p-links">
          <a href={`${REPO}/blob/main/docs/site/design-and-accessibility.md`} rel="noopener">{A.more_link_rules}</a>
          {" · "}
          <a href={`/${lang}/coverage/`}>{T.nav.coverage}</a>
          {" · "}
          <a href={`/${lang}/privacy/`}>{T.footer.privacy_policy}</a>
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .p-updated { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .p-sec { margin-block: 2rem 0; }
  .p-sec h2 { margin-top: 0; }
  .p-links { margin-top: 0.5rem; }
</style>
