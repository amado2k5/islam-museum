---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui } from "../lib/i18n";
const T = ui("ar");
---
<BaseLayout lang="ar" title={T.not_found.title} path="/404/" noindex alternates={{ ar: "/404/" }}>
  <div class="wrap" style="padding-block:6vh">
    <h1>{T.not_found.title}</h1>
    <p>{T.not_found.body} <a href="/ar/">{T.not_found.home}</a></p>
  </div>
</BaseLayout>
