{
  "name": "islam-museum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "islam.museum — an open, free, all-digital museum of Islam, built as a knowledge graph in git.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "schema": "tsx scripts/gen-schema.ts",
    "validate": "tsx scripts/validate.ts && tsx scripts/check-encoding.ts && tsx scripts/check-authenticity.ts && tsx scripts/check-extremism.ts && tsx scripts/check-harvest-register.ts && tsx scripts/check-enrichment-register.ts && tsx scripts/decisions/check-records.ts && tsx scripts/decisions/benchmark.ts && tsx scripts/decisions/sweep.ts",
    "check:authenticity": "tsx scripts/check-authenticity.ts",
    "cite-check": "tsx scripts/cite-check.ts",
    "wordmap": "tsx scripts/wordmap.ts",
    "graph": "tsx scripts/build-graph.ts",
    "derive": "tsx scripts/derive.ts",
    "api": "tsx scripts/export-api.ts",
    "coverage": "tsx scripts/report/coverage.ts",
    "inventions:census": "tsx scripts/report/inventions-census.ts",
    "modern:census": "tsx scripts/modern/census.ts",
    "daily": "tsx scripts/edu-daily.ts",
    "dashboard": "node tools/dashboard/generate.mjs && open http://localhost:8899",
    "test": "vitest run",
    "decisions:benchmark": "tsx scripts/decisions/benchmark.ts",
    "decisions:digest": "tsx scripts/decisions/digest.ts",
    "decisions:check": "tsx scripts/decisions/check-records.ts",
    "decisions:extract": "tsx scripts/decisions/extract-precedents.ts --write",
    "decisions:local": "DECIDE_JUDGE_URL=http://localhost:11434/v1/chat/completions DECIDE_JUDGE_MODEL=qwen2.5:32b DECIDE_EMBED_URL=http://localhost:11434 DECIDE_EMBED_MODEL=qwen3-embedding:0.6b tsx scripts/decisions/decide.ts",
    "decisions:triage": "DECIDE_JUDGE_URL=http://localhost:11434/v1/chat/completions DECIDE_JUDGE_MODEL=qwen2.5:32b DECIDE_EMBED_URL=http://localhost:11434 DECIDE_EMBED_MODEL=qwen3-embedding:0.6b tsx scripts/decisions/triage.ts",
    "axe": "tsx scripts/axe-scan.ts",
    "books": "tsx scripts/a11y-books.ts",
    "prebuild": "npm run validate && npm run graph && tsx scripts/time-browser.ts && tsx scripts/time-browser-explorer.ts && npm run derive && npm run api && npm run daily",
    "dev": "npm run graph && npm run derive && npm run api && npm --prefix site run dev",
    "build": "npm --prefix site run build && npm run check:site && npm run check:weight && npm run books",
    "check:harvest-register": "tsx scripts/check-harvest-register.ts",
    "check:enrichment-register": "tsx scripts/check-enrichment-register.ts",
    "enrichment-queue": "tsx scripts/enrichment-queue.ts",
    "check:static": "tsx scripts/check-static.ts",
    "check:site": "tsx scripts/check-site.ts",
    "check:encoding": "tsx scripts/check-encoding.ts",
    "sample:routes": "tsx scripts/sample-routes.ts",
    "sample:stubs": "tsx scripts/sample-stubs.ts",
    "check:weight": "tsx scripts/check-weight.ts"
  },
  "dependencies": {
    "@umalqura/core": "^0.0.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "edtf": "^4.6.0",
    "graphology": "^0.26.0",
    "qrcode-generator": "^2.0.4",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-generator": "^0.0.16",
    "liblouis": "^0.4.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
