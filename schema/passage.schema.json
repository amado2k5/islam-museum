{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "passage.schema.json",
  "title": "Museum entity: passage",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "passage"
    },
    "work": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "ref": {
      "type": "string"
    },
    "unit": {
      "enum": [
        "sura",
        "ayah",
        "hadith",
        "poem-line",
        "chapter",
        "other"
      ]
    },
    "sura": {
      "type": "integer"
    },
    "aya": {
      "type": "integer"
    },
    "text": {
      "type": "string"
    },
    "text_search": {
      "type": "string"
    },
    "revelation_order": {
      "type": "integer"
    },
    "revelation_place": {
      "enum": [
        "meccan",
        "medinan"
      ]
    },
    "metre": {
      "enum": [
        "tawil",
        "basit",
        "wafir",
        "kamil",
        "hazaj",
        "rajaz",
        "ramal",
        "sari",
        "munsarih",
        "khafif",
        "mudari",
        "muqtadab",
        "mujtath",
        "mutaqarib",
        "mutadarik",
        "madid",
        "other"
      ]
    },
    "rhyme": {
      "type": "string"
    },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "translator": {
            "type": "string"
          },
          "license": {
            "enum": [
              "CC0",
              "CC-BY",
              "CC-BY-SA",
              "PD",
              "VAM-NC"
            ]
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "chain": {
      "type": "array",
      "description": "ordered isnad as stated in the source: first narrator nearest the work; person/muhammad is the terminal when the report reaches him (marfu'), otherwise the last element is the Companion the report stops at",
      "items": {
        "type": "string",
        "pattern": "^person/[a-z0-9][a-z0-9-]*$"
      },
      "minItems": 1
    },
    "context": {
      "$ref": "_base.schema.json#/$defs/localized"
    }
  },
  "required": [
    "work",
    "ref"
  ],
  "unevaluatedProperties": false
}
