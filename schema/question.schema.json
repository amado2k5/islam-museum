{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "Museum entity: question",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "question"
    },
    "question": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "short_answer": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "long_answer": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "responses"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "textual",
              "between-schools",
              "ideal-and-history",
              "tradition-and-modernity"
            ]
          },
          "statement": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "raised_by": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "who"
              ],
              "properties": {
                "who": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "passages": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tradition",
                "summary"
              ],
              "properties": {
                "tradition": {
                  "enum": [
                    "sunni",
                    "sunni-hanafi",
                    "sunni-maliki",
                    "sunni-shafii",
                    "sunni-hanbali",
                    "shia-twelver",
                    "shia-ismaili",
                    "shia-zaydi",
                    "ibadi",
                    "sufi",
                    "ahmadiyya",
                    "quranist",
                    "academic",
                    "other"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "question"
  ],
  "unevaluatedProperties": false
}
