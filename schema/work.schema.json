{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work.schema.json",
  "title": "Museum entity: work",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "work"
    },
    "kind": {
      "enum": [
        "book",
        "treatise",
        "poem",
        "diwan",
        "map",
        "composition",
        "film",
        "website",
        "other",
        "app",
        "online-library",
        "fatwa",
        "declaration",
        "charter",
        "constitution",
        "law",
        "court-judgment",
        "report",
        "survey",
        "standard",
        "curriculum",
        "sermon",
        "lecture-series",
        "podcast",
        "newspaper",
        "journal"
      ]
    },
    "made": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_muslims",
        "basis"
      ],
      "properties": {
        "by_muslims": {
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "self-identified",
            "documented",
            "unverified"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "genre": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "composed": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "structure": {
      "type": "string"
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openiti_uri": {
      "type": "string"
    },
    "commentaries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "manuscripts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "launched": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "closed": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "archive_url": {
      "type": "string",
      "format": "uri"
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "self-described",
            "documented"
          ]
        }
      }
    },
    "content_type": {
      "enum": [
        "scripture",
        "hadith",
        "fatwa",
        "library",
        "education",
        "news",
        "community",
        "children",
        "academic",
        "apologetics",
        "criticism"
      ]
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
