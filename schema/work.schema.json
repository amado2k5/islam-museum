{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work.schema.json",
  "title": "Museum entity: work",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "work"
    },
    "kind": {
      "enum": [
        "book",
        "treatise",
        "poem",
        "diwan",
        "map",
        "composition",
        "film",
        "website",
        "other",
        "app",
        "online-library",
        "fatwa",
        "fatwa-collection",
        "declaration",
        "charter",
        "constitution",
        "law",
        "court-judgment",
        "report",
        "survey",
        "standard",
        "curriculum",
        "sermon",
        "lecture",
        "lecture-series",
        "podcast",
        "newspaper",
        "journal"
      ]
    },
    "made": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_muslims",
        "basis"
      ],
      "properties": {
        "by_muslims": {
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "self-identified",
            "documented",
            "unverified"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "genre": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "composed": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "structure": {
      "type": "string"
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openiti_uri": {
      "type": "string"
    },
    "commentaries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "manuscripts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "text_source": {
      "type": "object"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "launched": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "closed": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "archive_url": {
      "type": "string",
      "format": "uri"
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "self-described",
            "documented"
          ]
        }
      }
    },
    "content_type": {
      "enum": [
        "scripture",
        "hadith",
        "fatwa",
        "library",
        "education",
        "news",
        "community",
        "children",
        "academic",
        "apologetics",
        "criticism"
      ]
    },
    "sermon_type": {
      "enum": [
        "jumu'a",
        "eid-al-fitr",
        "eid-al-adha",
        "istisqa",
        "kusuf",
        "hajj-arafa",
        "nikah",
        "occasion",
        "farewell",
        "other"
      ]
    },
    "delivered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "co_speakers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          }
        },
        "moderator": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "audience": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "occasion": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "ruler_at_time": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "who",
          "role"
        ],
        "properties": {
          "who": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "enum": [
              "patron",
              "addressee",
              "named-in-dua",
              "subject",
              "opponent",
              "contemporary"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "book_studied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work"
      ],
      "properties": {
        "work": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "range": {
          "type": "string"
        }
      }
    },
    "order": {
      "type": "integer"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "minutes"
    },
    "delivery_date_status": {
      "enum": [
        "delivered",
        "uploaded",
        "broadcast"
      ]
    },
    "consequence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "reception": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "approval",
              "objection",
              "fatwa",
              "ban",
              "cut",
              "award",
              "protest",
              "release",
              "withdrawal",
              "other"
            ]
          },
          "by": {
            "type": "string"
          },
          "where": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
