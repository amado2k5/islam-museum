{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exhibit.schema.json",
  "title": "Museum entity: exhibit",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "exhibit"
    },
    "kind": {
      "enum": [
        "exhibition",
        "story",
        "tour",
        "lesson",
        "trail"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_minutes": {
      "type": "integer"
    },
    "curator": {
      "type": "string"
    },
    "opened": {
      "type": "string",
      "format": "date"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "goal": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "path_kind": {
      "enum": [
        "era",
        "personalities",
        "events",
        "ideas",
        "places",
        "texts",
        "art",
        "culture",
        "hard-question",
        "starter"
      ]
    },
    "level": {
      "enum": [
        "intro",
        "standard",
        "deep"
      ]
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "body": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "depth": {
            "enum": [
              "brief",
              "standard",
              "deep"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "why_next": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "branch_of": {
            "type": "integer"
          }
        }
      }
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "course",
        "grade",
        "strand",
        "expectation"
      ],
      "properties": {
        "jurisdiction": {
          "enum": [
            "on-ca"
          ]
        },
        "course": {
          "type": "string",
          "pattern": "^(G[1-8]-[A-Z]{2,4}|[A-Z]{3}[1-4][A-Z])$"
        },
        "course_title": {
          "$ref": "_base.schema.json#/$defs/localized"
        },
        "grade": {
          "type": "string",
          "pattern": "^([1-9]|1[0-2])$"
        },
        "strand": {
          "type": "string",
          "pattern": "^[A-F]$"
        },
        "strand_title": {
          "$ref": "_base.schema.json#/$defs/localized"
        },
        "expectations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-F][1-4]$"
          },
          "minItems": 1
        },
        "expectation": {
          "$ref": "_base.schema.json#/$defs/localized"
        },
        "document": {
          "type": "string"
        },
        "verified": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "q",
          "options",
          "answer",
          "teaches"
        ],
        "additionalProperties": false,
        "properties": {
          "q": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "_base.schema.json#/$defs/localized"
            }
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "teaches": {
            "type": "integer"
          }
        }
      }
    },
    "worksheet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
