{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exhibit.schema.json",
  "title": "Museum entity: exhibit",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "exhibit"
    },
    "kind": {
      "enum": [
        "exhibition",
        "story",
        "tour",
        "lesson",
        "trail"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_minutes": {
      "type": "integer"
    },
    "curator": {
      "type": "string"
    },
    "opened": {
      "type": "string",
      "format": "date"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "body": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          }
        }
      }
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
