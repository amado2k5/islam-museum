{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.schema.json",
  "title": "Museum entity: media",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "media"
    },
    "kind": {
      "enum": [
        "image",
        "audio",
        "video",
        "model3d",
        "tileset",
        "map",
        "illustration"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "iiif_image": {
      "type": "string",
      "format": "uri"
    },
    "thumbnail": {
      "type": "string"
    },
    "license": {
      "enum": [
        "CC0",
        "CC-BY",
        "CC-BY-SA",
        "PD",
        "VAM-NC",
        "AI-GENERATED"
      ]
    },
    "attribution": {
      "type": "string"
    },
    "creator": {
      "type": "string"
    },
    "depicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "alt": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "generated": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "inputs_hash": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "prompt_hash": {
          "type": "string"
        }
      }
    },
    "precision": {
      "enum": [
        "site",
        "locality",
        "approximate",
        "schematic"
      ]
    },
    "basemap_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "kind",
    "license",
    "alt"
  ],
  "unevaluatedProperties": false
}
