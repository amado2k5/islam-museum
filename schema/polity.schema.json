{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polity.schema.json",
  "title": "Museum entity: polity",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "polity"
    },
    "kind": {
      "enum": [
        "caliphate",
        "dynasty",
        "emirate",
        "sultanate",
        "empire",
        "kingdom",
        "state",
        "nation",
        "city-state"
      ]
    },
    "start": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "end": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "capitals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "place"
        ],
        "properties": {
          "place": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          }
        }
      }
    },
    "extent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "geojson",
          "precision"
        ],
        "properties": {
          "at": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "geojson": {
            "type": "string"
          },
          "precision": {
            "enum": [
              "schematic",
              "approximate",
              "documented"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "predecessor": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "successor": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "official_languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "religious_policy": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "story_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "enum": [
              "prophet-figure",
              "family-of-the-prophet",
              "companion",
              "successor",
              "scholar",
              "jurist",
              "transmitter",
              "preacher",
              "saint",
              "reformer",
              "revivalist",
              "founder",
              "missionary",
              "ruler",
              "commander",
              "official",
              "patron",
              "legislator",
              "colonial-administrator",
              "resistance-leader",
              "opponent",
              "military-opponent",
              "persecutor",
              "rival-claimant",
              "rebel",
              "protector",
              "ally",
              "host",
              "interlocutor",
              "collaborator",
              "convert",
              "left-islam",
              "changed-sides",
              "critic",
              "polemicist",
              "apologist",
              "orientalist-scholar",
              "historian",
              "translator",
              "traveller-observer",
              "journalist",
              "artist-on-islam",
              "scientist",
              "physician",
              "philosopher",
              "poet",
              "artist",
              "architect",
              "traveller",
              "merchant",
              "martyr",
              "victim",
              "witness"
            ]
          },
          "toward": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "perspective": {
            "enum": [
              "sunni",
              "sunni-hanafi",
              "sunni-maliki",
              "sunni-shafii",
              "sunni-hanbali",
              "shia-twelver",
              "shia-ismaili",
              "shia-zaydi",
              "ibadi",
              "sufi",
              "ahmadiyya",
              "quranist",
              "academic",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "labelled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "by"
        ],
        "properties": {
          "label": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "by": {
            "type": "string"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
