{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "person.schema.json",
  "title": "Museum entity: person",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "person"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "_base.schema.json#/$defs/name"
      }
    },
    "gender": {
      "enum": [
        "male",
        "female",
        "unknown"
      ]
    },
    "born": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "died": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "floruit": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traditions": {
      "type": "array",
      "items": {
        "enum": [
          "sunni",
          "sunni-hanafi",
          "sunni-maliki",
          "sunni-shafii",
          "sunni-hanbali",
          "sunni-ashari",
          "sunni-maturidi",
          "shia-twelver",
          "shia-ismaili",
          "shia-zaydi",
          "zahiri",
          "ibadi",
          "sufi",
          "ahmadiyya",
          "quranist",
          "academic",
          "other"
        ]
      }
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "story_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "enum": [
              "prophet-figure",
              "family-of-the-prophet",
              "companion",
              "successor",
              "scholar",
              "jurist",
              "transmitter",
              "preacher",
              "saint",
              "reformer",
              "revivalist",
              "founder",
              "missionary",
              "ruler",
              "commander",
              "official",
              "patron",
              "legislator",
              "colonial-administrator",
              "resistance-leader",
              "opponent",
              "military-opponent",
              "persecutor",
              "rival-claimant",
              "rebel",
              "protector",
              "ally",
              "host",
              "interlocutor",
              "collaborator",
              "convert",
              "left-islam",
              "changed-sides",
              "critic",
              "polemicist",
              "apologist",
              "orientalist-scholar",
              "historian",
              "translator",
              "traveller-observer",
              "journalist",
              "artist-on-islam",
              "scientist",
              "physician",
              "philosopher",
              "poet",
              "artist",
              "architect",
              "traveller",
              "merchant",
              "martyr",
              "victim",
              "witness"
            ]
          },
          "toward": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "perspective": {
            "enum": [
              "sunni",
              "sunni-hanafi",
              "sunni-maliki",
              "sunni-shafii",
              "sunni-hanbali",
              "sunni-ashari",
              "sunni-maturidi",
              "shia-twelver",
              "shia-ismaili",
              "shia-zaydi",
              "zahiri",
              "ibadi",
              "sufi",
              "ahmadiyya",
              "quranist",
              "academic",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "faith": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "basis"
        ],
        "properties": {
          "value": {
            "enum": [
              "sunni",
              "sunni-hanafi",
              "sunni-maliki",
              "sunni-shafii",
              "sunni-hanbali",
              "zahiri",
              "shia-twelver",
              "shia-ismaili",
              "shia-zaydi",
              "alawite",
              "ibadi",
              "sufi",
              "ahmadiyya",
              "quranist",
              "academic",
              "other",
              "christian",
              "jewish",
              "zoroastrian",
              "hindu",
              "buddhist",
              "sikh",
              "sabian",
              "manichaean",
              "arabian-polytheism",
              "hanif",
              "deist",
              "atheist-or-sceptic",
              "unknown"
            ]
          },
          "basis": {
            "enum": [
              "self-identified",
              "documented",
              "tradition",
              "debated",
              "unknown"
            ]
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "labelled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "by"
        ],
        "properties": {
          "label": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "by": {
            "type": "string"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job",
          "kind",
          "sources"
        ],
        "properties": {
          "job": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "primary",
              "secondary",
              "episodic",
              "honorary"
            ]
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "place": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "polity": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "under": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "trained_under": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "certification": {
            "type": "string"
          },
          "family_business": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "being": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sources"
      ],
      "properties": {
        "kind": {
          "enum": [
            "angel",
            "jinn"
          ]
        },
        "note": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invention",
          "role",
          "sources"
        ],
        "properties": {
          "invention": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "enum": [
              "inventor",
              "co-inventor",
              "improver",
              "describer",
              "transmitter",
              "translator",
              "commissioner",
              "commercializer",
              "disputed"
            ]
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "place": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sport",
          "sources"
        ],
        "properties": {
          "sport": {
            "enum": [
              "football",
              "cricket",
              "basketball",
              "boxing",
              "mixed-martial-arts",
              "wrestling",
              "judo",
              "taekwondo",
              "karate",
              "athletics",
              "swimming",
              "fencing",
              "weightlifting",
              "gymnastics",
              "tennis",
              "squash",
              "table-tennis",
              "badminton",
              "cycling",
              "motorsport",
              "golf",
              "chess",
              "rowing",
              "sailing",
              "equestrian",
              "archery",
              "shooting",
              "volleyball",
              "handball",
              "rugby",
              "american-football",
              "baseball",
              "ice-hockey",
              "skiing",
              "mountaineering",
              "bodybuilding",
              "kabaddi",
              "hockey",
              "esports",
              "paralympic"
            ]
          },
          "discipline": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "teams": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "national_team": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "name_parts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Classical Arabic name as structured data (founder approved 21 Nov 2026, docs/data/name-parts.md): each element supports several values, each with its own sources, certainty and an optional link to a record that does not assert birth or descent.",
      "properties": {
        "ism": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        },
        "kunya": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        },
        "nasab": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        },
        "laqab": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        },
        "khitab": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        },
        "nisba": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        },
        "ancestral": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        },
        "shuhra": {
          "$ref": "#/$defs/name_part"
        },
        "spellings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_part"
          }
        }
      }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "name_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "translit": {
          "type": "string"
        },
        "meaning": {
          "$ref": "_base.schema.json#/$defs/localized"
        },
        "certainty": {
          "enum": [
            "attested",
            "disputed",
            "uncertain"
          ]
        },
        "link": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "link_kind": {
          "enum": [
            "place",
            "tribe",
            "occupation",
            "dynasty",
            "school",
            "ancestor",
            "other"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
