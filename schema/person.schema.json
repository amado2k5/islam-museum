{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "person.schema.json",
  "title": "Museum entity: person",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "person"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "_base.schema.json#/$defs/name"
      }
    },
    "gender": {
      "enum": [
        "male",
        "female",
        "unknown"
      ]
    },
    "born": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "died": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "floruit": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traditions": {
      "type": "array",
      "items": {
        "enum": [
          "sunni",
          "sunni-hanafi",
          "sunni-maliki",
          "sunni-shafii",
          "sunni-hanbali",
          "sunni-ashari",
          "sunni-maturidi",
          "shia-twelver",
          "shia-ismaili",
          "shia-zaydi",
          "ibadi",
          "sufi",
          "ahmadiyya",
          "quranist",
          "academic",
          "other"
        ]
      }
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "story_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "enum": [
              "prophet-figure",
              "family-of-the-prophet",
              "companion",
              "successor",
              "scholar",
              "jurist",
              "transmitter",
              "preacher",
              "saint",
              "reformer",
              "revivalist",
              "founder",
              "missionary",
              "ruler",
              "commander",
              "official",
              "patron",
              "legislator",
              "colonial-administrator",
              "resistance-leader",
              "opponent",
              "military-opponent",
              "persecutor",
              "rival-claimant",
              "rebel",
              "protector",
              "ally",
              "host",
              "interlocutor",
              "collaborator",
              "convert",
              "left-islam",
              "changed-sides",
              "critic",
              "polemicist",
              "apologist",
              "orientalist-scholar",
              "historian",
              "translator",
              "traveller-observer",
              "journalist",
              "artist-on-islam",
              "scientist",
              "physician",
              "philosopher",
              "poet",
              "artist",
              "architect",
              "traveller",
              "merchant",
              "martyr",
              "victim",
              "witness"
            ]
          },
          "toward": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "perspective": {
            "enum": [
              "sunni",
              "sunni-hanafi",
              "sunni-maliki",
              "sunni-shafii",
              "sunni-hanbali",
              "sunni-ashari",
              "sunni-maturidi",
              "shia-twelver",
              "shia-ismaili",
              "shia-zaydi",
              "ibadi",
              "sufi",
              "ahmadiyya",
              "quranist",
              "academic",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "faith": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "basis"
        ],
        "properties": {
          "value": {
            "enum": [
              "sunni",
              "sunni-hanafi",
              "sunni-maliki",
              "sunni-shafii",
              "sunni-hanbali",
              "zahiri",
              "shia-twelver",
              "shia-ismaili",
              "shia-zaydi",
              "alawite",
              "ibadi",
              "sufi",
              "ahmadiyya",
              "quranist",
              "academic",
              "other",
              "christian",
              "jewish",
              "zoroastrian",
              "hindu",
              "buddhist",
              "sikh",
              "sabian",
              "manichaean",
              "arabian-polytheism",
              "hanif",
              "deist",
              "atheist-or-sceptic",
              "unknown"
            ]
          },
          "basis": {
            "enum": [
              "self-identified",
              "documented",
              "tradition",
              "debated",
              "unknown"
            ]
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "labelled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "by"
        ],
        "properties": {
          "label": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "by": {
            "type": "string"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
