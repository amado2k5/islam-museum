{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journey.schema.json",
  "title": "Museum entity: journey",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "journey"
    },
    "kind": {
      "enum": [
        "travel",
        "pilgrimage_route",
        "trade_route",
        "diffusion",
        "migration",
        "military_campaign"
      ]
    },
    "travelers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "distance_km": {
      "type": "number"
    },
    "geometry": {
      "type": "string"
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "mode": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "place",
          "day",
          "title",
          "narrative"
        ],
        "properties": {
          "place": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "day": {
            "type": "integer"
          },
          "day_status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "day_note": {
            "type": "string"
          },
          "date": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "title": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "narrative": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coordinates_note": {
            "type": "string"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job",
          "relation",
          "sources"
        ],
        "properties": {
          "job": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "relation": {
            "enum": [
              "made-by",
              "used-by",
              "built-by",
              "staffed-by",
              "reference-for",
              "body-of",
              "gathering-of",
              "produced-by",
              "workplace-of",
              "route-of"
            ]
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
