{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invention.schema.json",
  "title": "Museum entity: invention",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "invention"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "_base.schema.json#/$defs/name"
      }
    },
    "domain": {
      "enum": [
        "astronomy-instruments",
        "mathematics",
        "medicine-surgery",
        "pharmacy-chemistry",
        "optics-physics",
        "mechanics-automata",
        "water-agriculture",
        "navigation-geography",
        "architecture-building",
        "materials-industry",
        "military",
        "food-drink",
        "music-instruments",
        "timekeeping",
        "institutions-systems",
        "everyday-life",
        "modern-science",
        "modern-technology",
        "modern-medicine"
      ]
    },
    "kind": {
      "enum": [
        "device",
        "instrument",
        "machine",
        "technique",
        "process",
        "substance",
        "material",
        "method",
        "concept",
        "system",
        "institution",
        "crop",
        "recipe",
        "structure",
        "software",
        "algorithm",
        "discovery"
      ]
    },
    "disciplines": {
      "type": "array",
      "items": {
        "enum": [
          "medicine",
          "philosophy",
          "logic",
          "astronomy",
          "mathematics",
          "optics",
          "chemistry",
          "geography",
          "history",
          "law",
          "theology",
          "hadith",
          "tafsir",
          "grammar",
          "poetry",
          "music",
          "architecture",
          "calligraphy",
          "agriculture",
          "engineering"
        ]
      }
    },
    "era": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origins",
        "first_attested",
        "status_today"
      ],
      "properties": {
        "origins": {
          "enum": [
            "pre-islamic-inherited",
            "first-century",
            "abbasid-golden",
            "middle-period",
            "gunpowder-empires",
            "nineteenth-century",
            "twentieth-century",
            "twenty-first-century"
          ]
        },
        "first_attested": {
          "$ref": "_base.schema.json#/$defs/date"
        },
        "status_today": {
          "enum": [
            "living",
            "transformed",
            "replaced",
            "extinct",
            "revived"
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context"
      ],
      "properties": {
        "place": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "polity": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ar",
            "en",
            "ur"
          ],
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            }
          }
        }
      }
    },
    "makers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person",
          "role",
          "sources"
        ],
        "properties": {
          "person": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "enum": [
              "inventor",
              "co-inventor",
              "improver",
              "describer",
              "transmitter",
              "translator",
              "commissioner",
              "commercializer",
              "disputed"
            ]
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "place": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "claim",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "original",
            "improvement",
            "transmission",
            "contested",
            "legend"
          ]
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ar",
            "en",
            "ur"
          ],
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            }
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ar",
            "en",
            "ur"
          ],
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            }
          }
        },
        "perspectives": {
          "type": "array",
          "items": {
            "$ref": "_base.schema.json#/$defs/perspective"
          }
        }
      }
    },
    "precursors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invention",
              "sources"
            ],
            "properties": {
              "invention": {
                "type": "string",
                "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
              },
              "note": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "external",
              "note",
              "sources"
            ],
            "properties": {
              "external": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ar",
                  "en"
                ],
                "properties": {
                  "ar": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              },
              "note": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "dependents": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invention",
              "sources"
            ],
            "properties": {
              "invention": {
                "type": "string",
                "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
              },
              "note": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "external",
              "note",
              "sources"
            ],
            "properties": {
              "external": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ar",
                  "en"
                ],
                "properties": {
                  "ar": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              },
              "note": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "spread": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "place",
          "start",
          "sources"
        ],
        "properties": {
          "place": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "via": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "changed",
        "history"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "astronomy-instruments",
              "mathematics",
              "medicine-surgery",
              "pharmacy-chemistry",
              "optics-physics",
              "mechanics-automata",
              "water-agriculture",
              "navigation-geography",
              "architecture-building",
              "materials-industry",
              "military",
              "food-drink",
              "music-instruments",
              "timekeeping",
              "institutions-systems",
              "everyday-life",
              "modern-science",
              "modern-technology",
              "modern-medicine"
            ]
          }
        },
        "changed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ar",
            "en",
            "ur"
          ],
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ar",
            "en",
            "ur"
          ],
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            }
          }
        },
        "significance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "why": {
          "type": "string"
        }
      }
    },
    "described_in": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "today": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "descendants"
      ],
      "properties": {
        "form": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ar",
            "en",
            "ur"
          ],
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            }
          }
        },
        "descendants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ar",
            "en",
            "ur"
          ],
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagram"
      ],
      "properties": {
        "hero": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          }
        },
        "map": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        },
        "diagram": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  },
  "required": [
    "names",
    "domain",
    "kind",
    "disciplines",
    "era",
    "origin",
    "makers",
    "attribution",
    "precursors",
    "dependents",
    "spread",
    "impact",
    "described_in",
    "examples",
    "sites",
    "concepts",
    "today",
    "media",
    "sources",
    "provenance"
  ],
  "unevaluatedProperties": false
}
