{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group.schema.json",
  "title": "Museum entity: group",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "group"
    },
    "kind": {
      "enum": [
        "tribe",
        "clan",
        "family",
        "people",
        "denomination",
        "madhhab",
        "order",
        "movement",
        "organization",
        "institution",
        "guild",
        "army",
        "sect",
        "school",
        "faction",
        "party",
        "militia",
        "council",
        "charity",
        "relief-agency",
        "foundation",
        "certifier",
        "standards-body",
        "bank",
        "university",
        "seminary",
        "student-association",
        "women's-organisation",
        "professional-association",
        "interfaith-body",
        "international-organisation",
        "community-organisation",
        "mosque-association",
        "population"
      ]
    },
    "made": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_muslims",
        "basis"
      ],
      "properties": {
        "by_muslims": {
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "self-identified",
            "documented",
            "unverified"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "founded": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "dissolved": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "founder": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "headquarters": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "members_estimate": {
      "type": "integer"
    },
    "active_regions": {
      "type": "array",
      "items": {
        "enum": [
          "arabia",
          "levant-iraq",
          "egypt-nile",
          "maghreb",
          "andalus-europe",
          "anatolia-balkans",
          "persia-central-asia",
          "south-asia",
          "southeast-asia",
          "china-east-asia",
          "west-africa-sahel",
          "east-africa",
          "africa",
          "arab-world",
          "americas-oceania",
          "global"
        ]
      }
    },
    "story_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "enum": [
              "prophet-figure",
              "family-of-the-prophet",
              "companion",
              "successor",
              "scholar",
              "jurist",
              "transmitter",
              "preacher",
              "saint",
              "reformer",
              "revivalist",
              "founder",
              "missionary",
              "ruler",
              "commander",
              "official",
              "patron",
              "legislator",
              "colonial-administrator",
              "resistance-leader",
              "opponent",
              "military-opponent",
              "persecutor",
              "rival-claimant",
              "rebel",
              "protector",
              "ally",
              "host",
              "interlocutor",
              "collaborator",
              "convert",
              "left-islam",
              "changed-sides",
              "critic",
              "polemicist",
              "apologist",
              "orientalist-scholar",
              "historian",
              "translator",
              "traveller-observer",
              "journalist",
              "artist-on-islam",
              "scientist",
              "physician",
              "philosopher",
              "poet",
              "artist",
              "architect",
              "traveller",
              "merchant",
              "martyr",
              "victim",
              "witness"
            ]
          },
          "toward": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "start": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "end": {
            "$ref": "_base.schema.json#/$defs/date"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "perspective": {
            "enum": [
              "sunni",
              "sunni-hanafi",
              "sunni-maliki",
              "sunni-shafii",
              "sunni-hanbali",
              "sunni-ashari",
              "sunni-maturidi",
              "shia-twelver",
              "shia-ismaili",
              "shia-zaydi",
              "ibadi",
              "sufi",
              "ahmadiyya",
              "quranist",
              "academic",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "labelled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "by"
        ],
        "properties": {
          "label": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "by": {
            "type": "string"
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job",
          "relation",
          "sources"
        ],
        "properties": {
          "job": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "relation": {
            "enum": [
              "made-by",
              "used-by",
              "built-by",
              "staffed-by",
              "reference-for",
              "body-of",
              "gathering-of",
              "produced-by",
              "workplace-of",
              "route-of"
            ]
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
