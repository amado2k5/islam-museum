      },
      "uniqueItems": true
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sprouts",
              "explorers",
              "scholars"
            ]
          }
        },
        "flagged_for_kids": {
          "type": "boolean"
        },
        "did_you_know": {
          "type": "object",
          "additionalProperties": false,
          "description": "One authored, sourced fact («هل تعلم؟») in the three published languages; at most 40 words each, at least two cited sources (docs/delegation/education-master-plan.md §5 E3).",
          "properties": {
            "ar": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "ur": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "ar",
            "en",
            "ur",
            "sources"
          ]
        },
        "exclude": {
          "type": "boolean"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "generated_by": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "run": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "layer": {
          "enum": [
            "cc0",
            "by",
            "by-sa",
            "odbl",
            "nc",
            "pd",
            "copyrighted-reference",
            "link-only",
            "unverified",
            "own-research"
          ]
        },
        "source": {
          "type": "string"
        },
        "harvested": {
          "type": "string"
        },
        "submitted_via": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        }
      }
    },
    "kids": {
      "$ref": "#/$defs/localized",
      "description": "Optional kids text for ages 6-12 (Time Browser, DESIGN decision 13): localized, ar/en/ur, each with a citation like the adult text."
    }
  },
  "required": [
    "id",
    "class",
    "label",
    "summary",
    "status"
  ]
}
