          "violent-extremism-and-the-muslim-response",
          "diplomacy-and-envoys",
          "armies-and-navies",
          "pilgrimages-and-mass-gatherings",
          "conferences-and-declarations",
          "community-conventions",
          "scholarly-councils",
          "international-bodies",
          "religious-authorities",
          "movements-and-mass-organisations",
          "education",
          "mosques",
          "waqf",
          "websites-and-apps",
          "history-of-islam-online",
