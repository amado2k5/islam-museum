{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Museum entity: event",
  "allOf": [
    {
      "$ref": "_base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "class": {
      "const": "event"
    },
    "kind": {
      "enum": [
        "battle",
        "treaty",
        "revelation",
        "migration",
        "founding",
        "death",
        "birth",
        "conquest",
        "discovery",
        "publication",
        "conference",
        "siege",
        "pilgrimage",
        "other",
        "war",
        "campaign",
        "skirmish",
        "raid",
        "naval-battle",
        "revolt",
        "civil-war",
        "mutiny",
        "desertion",
        "defection",
        "massacre",
        "expulsion",
        "persecution",
        "truce",
        "schism",
        "council",
        "congress",
        "declaration",
        "fatwa-event",
        "gathering",
        "pilgrimage-season",
        "famine",
        "epidemic",
        "disaster-relief",
        "law-enacted",
        "court-ruling",
        "census"
      ]
    },
    "date": {
      "$ref": "_base.schema.json#/$defs/dateRange"
    },
    "places": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "outcome": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "part_of": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
    },
    "casualties": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number"
            },
            "range": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "scriptural",
                "tradition",
                "historical",
                "debated",
                "legend"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    },
    "significance": {
      "$ref": "_base.schema.json#/$defs/localized"
    },
    "sides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "$ref": "_base.schema.json#/$defs/localized"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "commanders": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
            }
          },
          "strength": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "scriptural",
                  "tradition",
                  "historical",
                  "debated",
                  "legend"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "laws_of_war": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "precision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "locator",
            "battle",
            "siege",
            "naval",
            "campaign",
            "route",
            "area"
          ]
        },
        "precision": {
          "enum": [
            "site",
            "locality",
            "approximate",
            "schematic"
          ]
        },
        "center": {
          "$ref": "_base.schema.json#/$defs/coordinates"
        },
        "extent_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "basemap": {
          "enum": [
            "terrain",
            "plain",
            "sea"
          ]
        },
        "date_for_borders": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "role"
            ],
            "properties": {
              "type": {
                "enum": [
                  "point",
                  "line",
                  "polygon"
                ]
              },
              "role": {
                "enum": [
                  "well",
                  "spring",
                  "camp",
                  "line",
                  "advance",
                  "retreat",
                  "flank",
                  "march",
                  "siege_line",
                  "wall",
                  "gate",
                  "fort",
                  "ship",
                  "landmark",
                  "terrain",
                  "city",
                  "area",
                  "event_point"
                ]
              },
              "subkind": {
                "type": "string"
              },
              "side": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "$ref": "_base.schema.json#/$defs/localized"
              },
              "at": {
                "$ref": "_base.schema.json#/$defs/coordinates"
              },
              "from": {
                "$ref": "_base.schema.json#/$defs/coordinates"
              },
              "to": {
                "$ref": "_base.schema.json#/$defs/coordinates"
              },
              "path": {
                "type": "array",
                "items": {
                  "$ref": "_base.schema.json#/$defs/coordinates"
                },
                "minItems": 2
              },
              "geometry": {
                "type": "string"
              },
              "precision": {
                "enum": [
                  "site",
                  "locality",
                  "approximate",
                  "schematic"
                ]
              },
              "source": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "legend": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "$ref": "_base.schema.json#/$defs/localized"
        }
      }
    },
    "recurs": {
      "type": "string"
    },
    "first_held": {
      "$ref": "_base.schema.json#/$defs/date"
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "attendance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "scriptural",
                  "tradition",
                  "historical",
                  "debated",
                  "legend"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job",
          "relation",
          "sources"
        ],
        "properties": {
          "job": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9-]*$"
          },
          "relation": {
            "enum": [
              "made-by",
              "used-by",
              "built-by",
              "staffed-by",
              "reference-for",
              "body-of",
              "gathering-of",
              "produced-by",
              "workplace-of",
              "route-of"
            ]
          },
          "status": {
            "enum": [
              "scriptural",
              "tradition",
              "historical",
              "debated",
              "legend"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "kind"
  ],
  "unevaluatedProperties": false
}
